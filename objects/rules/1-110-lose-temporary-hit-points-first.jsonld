  "htmlPage": {
    "@id": "https://cheeleong.dev/graph20/records/rules/1-110-lose-temporary-hit-points-first/"
  },
  "section": "1.110",
  "rulesText": "If you have Temporary Hit Points and take damage, those points are lost first, and any leftover damage carries over to your Hit Points. For example, if you have 5 Temporary Hit Points and take 7 damage, you lose those points and then lose 2 Hit Points."
}
