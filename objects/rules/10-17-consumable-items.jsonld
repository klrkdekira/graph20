    "chapter": "Magic Items",
    "section": "10.17",
    "heading": "Consumable Items",
    "lineStart": 14686,
    "lineEnd": 14688
  },
  "section": "10.17",
  "rulesText": "Some items are consumed - used up, in other words - when they are activated. A Potion of Healing must be swallowed, for example, while the writing vanishes from a scroll when it is read. Once used, a consumable item loses its magic."
}
