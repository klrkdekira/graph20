  "sourceLocator": {
    "chapter": "Character Creation",
    "section": "2.6",
    "heading": "Note Armor Training",
    "lineStart": 1752,
    "lineEnd": 1754
  },
  "section": "2.6",
  "rulesText": "Your class might give you training with certain categories of armor. Note your armor training on your character sheet. Armor training with a kind of armor means you can wear that armor effectively, gaining defensive bonuses from it. The categories of armor are described in “Equipment.”"
}
