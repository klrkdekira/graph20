  "sourceLocator": {
    "chapter": "Equipment",
    "section": "6.169",
    "heading": "Ending Attunement",
    "lineStart": 7072,
    "lineEnd": 7076
  },
  "section": "6.169",
  "rulesText": "Your Attunement to an item ends if you no longer satisfy the prerequisites for Attunement, if the item has been more than 100 feet away for at least 24 hours, if you die, or if another creature attunes to\n\nthe item. You can also voluntarily end Attunement by spending another Short Rest focused on the item unless the item is cursed."
}
