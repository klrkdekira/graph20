  "sourceLocator": {
    "chapter": "Classes",
    "section": "3.77",
    "heading": "Level 17: Supreme Healing",
    "lineStart": 2788,
    "lineEnd": 2790
  },
  "section": "3.77",
  "rulesText": "When you would normally roll one or more dice to restore Hit Points to a creature with a spell or Channel Divinity, don't roll those dice for the healing; instead use the highest number possible for each die. For example, instead of restoring 2d6 Hit Points to a creature with a spell, you restore 12."
}
