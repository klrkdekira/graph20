  "sourceLocator": {
    "chapter": "Spells",
    "section": "7.14",
    "heading": "One Spell with a Spell Slot per Turn",
    "lineStart": 7175,
    "lineEnd": 7177
  },
  "section": "7.14",
  "rulesText": "On a turn, you can expend only one spell slot to cast a spell. This rule means you can't, for example, cast a spell with a spell slot using the Magic action and another one using a Bonus Action on the same turn."
}
