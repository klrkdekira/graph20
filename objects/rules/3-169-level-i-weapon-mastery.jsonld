  "sourceLocator": {
    "chapter": "Classes",
    "section": "3.169",
    "heading": "Level I: Weapon Mastery",
    "lineStart": 3414,
    "lineEnd": 3418
  },
  "section": "3.169",
  "rulesText": "Your training with weapons allows you to use the mastery properties of two kinds of weapons of your choice with which you have proficiency, such as Longswords and Javelins.\n\nWhenever you finish a Long Rest, you can change the kinds of weapons you chose. For example, you could switch to using the mastery properties of Halberds and Flails."
}
