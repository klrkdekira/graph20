    {
      "name": "Traits",
      "rulesText": "Death Burst. The magmin explodes when it dies. Dexterity Saving Throw: DC 11, each creature in a 10-foot Emanation originating from the magmin. Failure: 7 (2d6) Fire damage. Success: Half damage.",
      "sourceLocator": {
        "chapter": "Monsters A-Z",
        "section": "12.156",
        "heading": "Traits",
        "lineStart": 22931,
        "lineEnd": 22933
      }
    },
    {
      "name": "Actions",
      "rulesText": "Touch. Melee Attack Roll: +4, reach 5 ft. Hit: 7 (2d4 + 2) Fire damage. If the target is a creature or a flammable object that isn't being worn or carried, it starts burning.",
      "sourceLocator": {
        "chapter": "Monsters A-Z",
        "section": "12.156",
        "heading": "Actions",
        "lineStart": 22935,
        "lineEnd": 22937
      }
    },
    {
      "name": "Bonus Actions",
      "rulesText": "Ignited Illumination. The magmin sets itself ablaze or extinguishes its flames. While ablaze, the magmin sheds Bright Light in a 10-foot radius and Dim Light for an additional 10 feet.",
      "sourceLocator": {
        "chapter": "Monsters A-Z",
        "section": "12.156",
        "heading": "Bonus Actions",
        "lineStart": 22939,
        "lineEnd": 22941
