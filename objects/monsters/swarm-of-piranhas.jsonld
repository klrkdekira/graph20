      }
    },
    {
      "name": "Actions",
      "rulesText": "Bites. Melee Attack Roll: +5 (with Advantage if the target doesn't have all its Hit Points), reach 5 ft. Hit: 8 (2d4 + 3) Piercing damage, or 5 (1d4 + 3) Piercing damage if the swarm is Bloodied.",
      "sourceLocator": {
        "chapter": "Animals",
