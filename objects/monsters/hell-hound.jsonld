    {
      "name": "Traits",
      "rulesText": "Pack Tactics. The hound has Advantage on an attack roll against a creature if at least one of the hound's allies is within 5 feet of the creature and the ally doesn't have the Incapacitated condition.",
      "sourceLocator": {
        "chapter": "Monsters A-Z",
        "section": "12.131",
        "heading": "Traits",
        "lineStart": 22025,
        "lineEnd": 22027
      }
    },
    {
      "name": "Actions",
      "rulesText": "Multiattack. The hound makes two Bite attacks.\n\nBite. Melee Attack Roll: +5, reach 5 ft. Hit: 7 (1d8 + 3) Piercing damage plus 3 (1d6) Fire damage.\n\nFire Breath (Recharge 5–6). Dexterity Saving Throw: DC 12, each creature in a 15-foot Cone. Failure: 17 (5d6) Fire damage. Success: Half damage.",
      "sourceLocator": {
        "chapter": "Monsters A-Z",
        "section": "12.131",
        "heading": "Actions",
