  "statSections": [
    {
      "name": "Traits",
      "rulesText": "Air Form. The elemental can enter a creature's space and stop there. It can move through a space as narrow as 1 inch without expending extra movement to do so.",
      "sourceLocator": {
        "chapter": "Monsters A-Z",
        "section": "12.3",
        "heading": "Traits",
        "lineStart": 18009,
        "lineEnd": 18011
      }
    },
    {
      "name": "Actions",
      "rulesText": "Multiattack. The elemental makes two Thunderous Slam attacks.\n\nThunderous Slam. Melee Attack Roll: +8, reach 10 ft.\nHit: 14 (2d8 + 5) Thunder damage.\n\nWhirlwind (Recharge 4–6). Strength Saving Throw: DC 13, one Medium or smaller creature in the elemental's space. Failure: 24 (4d10 + 2) Thunder damage, and the target is pushed up to 20 feet straight away from the elemental and has the Prone condition. Success: Half damage only.",
      "sourceLocator": {
        "chapter": "Monsters A-Z",
        "section": "12.3",
        "heading": "Actions",
        "lineStart": 18013,
