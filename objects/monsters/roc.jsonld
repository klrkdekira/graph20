  "statSections": [
    {
      "name": "Actions",
      "rulesText": "Multiattack. The roc makes two Beak attacks. It can replace one attack with a Talons attack.\n\nBeak. Melee Attack Roll: +13, reach 10 ft. Hit: 28 (3d12 + 9) Piercing damage.\n\nTalons. Melee Attack Roll: +13, reach 5 ft. Hit: 23 (4d6 + 9) Slashing damage. If the target is a Huge or smaller creature, it has the Grappled condition (escape DC 19) from both talons, and it has the Restrained condition until the grapple ends."
    },
    {
      "name": "Bonus Actions",
      "rulesText": "Swoop (Recharge 5–6). If the roc has a creature Grappled, the roc flies up to half its Fly Speed without provoking Opportunity Attacks and drops that creature."
    }
  ],
