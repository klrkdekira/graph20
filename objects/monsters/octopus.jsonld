  "statSections": [
    {
      "name": "Traits",
      "rulesText": "Compression. The octopus can move through a space as narrow as 1 inch without expending extra movement to do so.\n\nWater Breathing. The octopus can breathe only underwater.",
      "sourceLocator": {
        "chapter": "Animals",
        "section": "13.66",
        "heading": "Traits",
        "lineStart": 28292,
        "lineEnd": 28296
      }
    },
    {
      "name": "Actions",
      "rulesText": "Tentacles. Melee Attack Roll: +4, reach 5 ft. Hit: 1 Bludgeoning damage.",
      "sourceLocator": {
        "chapter": "Animals",
        "section": "13.66",
        "heading": "Actions",
        "lineStart": 28298,
        "lineEnd": 28300
      }
    },
    {
      "name": "Reactions",
      "rulesText": "Ink Cloud (1/Day). Trigger: A creature ends its turn within 5 feet of the octopus while underwater. Response: The octopus releases ink that fills a 5-foot Cube centered on itself, and the octopus moves up to its Swim Speed. The Cube is Heavily Obscured for 1 minute or until a strong current or similar effect disperses the ink.",
      "sourceLocator": {
        "chapter": "Animals",
        "section": "13.66",
        "heading": "Reactions",
        "lineStart": 28302,
        "lineEnd": 28304
      }
    }
  ],
  "rulesText": "Small Beast, Unaligned\n\nAC 12\nInitiative +2 (12)\nHP 3 (1d6)\nSpeed 5 ft., Swim 30 ft.\n\nSkills Perception +2, Stealth +6\nSenses Darkvision 30 ft.; Passive Perception 12\nLanguages None\nCR 0 (XP 10; PB +2)\n\nTraits\n\nCompression. The octopus can move through a space as narrow as 1 inch without expending extra movement to do so.\n\nWater Breathing. The octopus can breathe only underwater.\n\nActions\n\nTentacles. Melee Attack Roll: +4, reach 5 ft. Hit: 1 Bludgeoning damage.\n\nReactions\n\nInk Cloud (1/Day). Trigger: A creature ends its turn within 5 feet of the octopus while underwater. Response: The octopus releases ink that fills a 5-foot Cube centered on itself, and the octopus moves up to its Swim Speed. The Cube is Heavily Obscured for 1 minute or until a strong current or similar effect disperses the ink.",
