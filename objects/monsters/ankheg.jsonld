  "statSections": [
    {
      "name": "Traits",
      "rulesText": "Tunneler. The ankheg can burrow through solid rock at half its Burrow Speed and leaves a 10-foot-diameter tunnel in its wake.",
      "sourceLocator": {
        "chapter": "Monsters A-Z",
        "section": "12.8",
        "heading": "Traits",
        "lineStart": 18113,
        "lineEnd": 18115
      }
    },
    {
      "name": "Actions",
      "rulesText": "Bite. Melee Attack Roll: +5 (with Advantage if the target is Grappled by the ankheg), reach 5 ft. Hit: 10 (2d6 + 3) Slashing damage plus 3 (1d6) Acid damage. If the target is a Large or smaller creature, it has the Grappled condition (escape DC 13).\n\nAcid Spray (Recharge 6). Dexterity Saving Throw: DC 12, each creature in a 30-foot-long, 5-foot-wide Line. Failure: 14 (4d6) Acid damage. Success: Half damage.",
      "sourceLocator": {
        "chapter": "Monsters A-Z",
        "section": "12.8",
        "heading": "Actions",
        "lineStart": 18117,
        "lineEnd": 18121
      }
    }
