  "statSections": [
    {
      "name": "Actions",
      "rulesText": "Multiattack. The bulette makes two Bite attacks.\n\nBite. Melee Attack Roll: +7, reach 5 ft. Hit: 17 (2d12 + 4) Piercing damage.\n\nDeadly Leap. The bulette spends 5 feet of movement to jump to a space within 15 feet that contains one or more Large or smaller creatures. Dexterity Saving Throw: DC 15, each creature in the bulette's destination space. Failure: 19 (3d12) Bludgeoning damage, and the target has the Prone condition. Success: Half damage, and the target is pushed 5 feet straight away from the bulette."
    },
    {
      "name": "Bonus Actions",
      "rulesText": "Leap. The bulette jumps up to 30 feet by spending 10 feet of movement."
    }
  ],
