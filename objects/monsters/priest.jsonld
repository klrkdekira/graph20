  "statSections": [
    {
      "name": "Actions",
      "rulesText": "Multiattack. The priest makes two attacks, using Mace or Radiant Flame in any combination.\n\nMace. Melee Attack Roll: +5, reach 5 ft. Hit: 6 (1d6 + 3) Bludgeoning damage plus 5 (2d4) Radiant damage.\n\nRadiant Flame. Ranged Attack Roll: +5, range 60 ft.\nHit: 11 (2d10) Radiant damage.\n\nSpellcasting. The priest casts one of the following spells, using Wisdom as the spellcasting ability (spell save DC 13):\n\nAt Will: Light, Thaumaturgy\n\n1/Day: Spirit Guardians",
      "sourceLocator": {
        "chapter": "Monsters A-Z",
        "section": "12.191",
        "heading": "Actions",
        "lineStart": 23851,
        "lineEnd": 23864
      }
    },
    {
      "name": "Bonus Actions",
      "rulesText": "Divine Aid (3/Day). The priest casts Bless, Dispel Magic, Healing Word, or Lesser Restoration, using the same spellcasting ability as Spellcasting.",
      "sourceLocator": {
        "chapter": "Monsters A-Z",
        "section": "12.191",
        "heading": "Bonus Actions",
        "lineStart": 23866,
        "lineEnd": 23868
      }
    }
  ],
