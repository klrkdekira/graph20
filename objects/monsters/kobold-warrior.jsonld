  "statSections": [
    {
      "name": "Traits",
      "rulesText": "Pack Tactics. The kobold has Advantage on an attack roll against a creature if at least one of the kobold's allies is within 5 feet of the creature and the ally doesn't have the Incapacitated condition.\n\nSunlight Sensitivity. While in sunlight, the kobold has Disadvantage on ability checks and attack rolls."
    },
