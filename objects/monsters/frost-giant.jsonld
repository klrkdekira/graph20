    {
      "name": "Actions",
      "rulesText": "Multiattack. The giant makes two attacks, using Frost Axe or Great Bow in any combination.\n\nFrost Axe. Melee Attack Roll: +9, reach 10 ft. Hit: 19 (2d12 + 6) Slashing damage plus 9 (2d8) Cold damage.\n\nGreat Bow. Ranged Attack Roll: +9, range 150/600 ft. Hit: 17 (2d10 + 6) Piercing damage plus 7 (2d6) Cold damage, and the target's Speed decreases by 10 feet until the end of its next turn.",
      "sourceLocator": {
        "chapter": "Monsters A-Z",
        "section": "12.91",
        "heading": "Actions",
        "lineStart": 20905,
        "lineEnd": 20911
      }
    },
    {
      "name": "Bonus Actions",
      "rulesText": "War Cry (Recharge 5–6). The giant or one creature of its choice that can see or hear it gains 16 (2d10 + 5) Temporary Hit Points and has Advantage on attack rolls until the start of the giant's next turn.",
