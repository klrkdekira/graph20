  "statSections": [
    {
      "name": "Actions",
      "rulesText": "Multiattack. The ettin makes one Battleaxe attack and one Morningstar attack.\n\nBattleaxe. Melee Attack Roll: +7, reach 5 ft. Hit: 14 (2d8 + 5) Slashing damage. If the target is a Large or smaller creature, it has the Prone condition.\n\nMorningstar. Melee Attack Roll: +7, reach 5 ft. Hit: 14 (2d8 + 5) Piercing damage, and the target has Disadvantage on the next attack roll it makes before the end of its next turn."
    }
  ],
