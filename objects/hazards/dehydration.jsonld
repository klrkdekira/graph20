  "htmlPage": {
    "@id": "https://cheeleong.dev/graph20/records/hazards/dehydration/"
  },
  "rulesText": "A creature requires an amount of water per day based on its size, as shown in the Water Needs per Day table. A creature that drinks less than half the required water for a day gains 1 Exhaustion level at the day's end. Exhaustion caused by dehydration can't be removed until the creature drinks the full amount of water required for a day. See also \"Exhaustion.\"\n\nWater Needs per Day\n\n| Size   | Water      | Size       | Water      |\n| :----- | :--------- | :--------- | :--------- |\n| Tiny   | 1/4 gallon | Large      | 4 gallons  |\n| Small  | 1 gallon   | Huge       | 16 gallons |\n| Medium | 1 gallon   | Gargantuan | 64 gallons |",
  "seeAlso": [
    {
      "@id": "https://cheeleong.dev/graph20/objects/conditions/exhaustion"
    }
  ]
}
