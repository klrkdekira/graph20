  "htmlPage": {
    "@id": "https://cheeleong.dev/graph20/records/conditions/exhaustion/"
  },
  "rulesText": "While you have the Exhaustion condition, you experience the following effects.\n\nExhaustion Levels. This condition is cumulative. Each time you receive it, you gain 1 Exhaustion level. You die if your Exhaustion level is 6.\n\nD20 Tests Affected. When you make a D20 Test, the roll is reduced by 2 times your Exhaustion level.\n\nSpeed Reduced. Your Speed is reduced by a number of feet equal to 5 times your Exhaustion level.\n\nRemoving Exhaustion Levels. Finishing a Long Rest removes 1 of your Exhaustion levels. When your Exhaustion level reaches 0, the condition ends.",
  "effects": [
    {
      "name": "Exhaustion Levels",
      "rulesText": "This condition is cumulative. Each time you receive it, you gain 1 Exhaustion level. You die if your Exhaustion level is 6."
    },
    {
      "name": "D20 Tests Affected",
      "rulesText": "When you make a D20 Test, the roll is reduced by 2 times your Exhaustion level."
    },
    {
      "name": "Speed Reduced",
      "rulesText": "Your Speed is reduced by a number of feet equal to 5 times your Exhaustion level."
    },
    {
      "name": "Removing Exhaustion Levels",
      "rulesText": "Finishing a Long Rest removes 1 of your Exhaustion levels. When your Exhaustion level reaches 0, the condition ends."
    }
  ],
