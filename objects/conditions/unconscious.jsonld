      "name": "Saving Throws Affected",
      "rulesText": "You automatically fail Strength and Dexterity saving throws."
    },
    {
      "name": "Automatic Critical Hits",
      "rulesText": "Any attack roll that hits you is a Critical Hit if the attacker is within 5 feet of you."
    },
    {
      "name": "Unaware",
      "rulesText": "You're unaware of your surroundings."
    }
