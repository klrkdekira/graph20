  "sourceLocator": {
    "chapter": "Rules Glossary",
    "section": "8.90",
    "heading": "Incapacitated [Condition]",
    "lineStart": 13359,
    "lineEnd": 13369
  },
  "rulesText": "While you have the Incapacitated condition, you experience the following effects.\n\nInactive. You can't take any action, Bonus Action, or Reaction.\n\nNo Concentration. Your Concentration is broken.\n\nSpeechless. You can't speak.\n\nSurprised. If you're Incapacitated when you roll Initiative, you have Disadvantage on the roll."
}
