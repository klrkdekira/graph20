{
  "@context": "https://cheeleong.dev/graph20/systems/context.jsonld",
  "@id": "https://cheeleong.dev/graph20/objects/tables/10-34-sentient-items-special-purpose",
  "@type": "Table",
  "name": "Sentient Item's Special Purpose",
  "slug": "10-34-sentient-items-special-purpose",
  "source": {
    "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
  },
  "sourceLocator": {
    "chapter": "Magic Items",
    "section": "10.34",
    "heading": "Special Purpose",
    "lineStart": 14837,
    "lineEnd": 14848
  },
  "columns": [
    "1d10",
    "Special Purpose"
  ],
  "rows": [
    {
      "position": 1,
      "cells": [
        {
          "value": "1"
        },
        {
          "value": "Aligned. The item seeks to defeat or destroy those of a diametrically opposed alignment.Such an item is never Neutral."
        }
      ]
    },
    {
      "position": 2,
      "cells": [
        {
          "value": "2"
        },
        {
          "value": "Bane. The item seeks to thwart or destroy creatures of a particular type, such as Constructs, Fiends, or Undead."
        }
      ]
    },
    {
      "position": 3,
      "cells": [
        {
          "value": "3"
        },
        {
          "value": "Creator Seeker. The item seeks its creator and wants to understand why it was created."
        }
      ]
    },
    {
      "position": 4,
      "cells": [
        {
          "value": "4"
        },
        {
          "value": "Destiny Seeker. The item believes it and its bearer have key roles to play in future events."
        }
      ]
    },
    {
      "position": 5,
      "cells": [
        {
          "value": "5"
        },
        {
          "value": "Destroyer. The item craves destruction and goads its user to fight arbitrarily."
        }
      ]
    },
    {
      "position": 6,
      "cells": [
        {
          "value": "6"
        },
        {
          "value": "Glory Seeker. The item seeks renown as the greatest magic item in the world by winning fame or notoriety for its user."
        }
      ]
    },
    {
      "position": 7,
      "cells": [
        {
          "value": "7"
        },
        {
          "value": "Lore Seeker. The item craves knowledge or is determined to solve a mystery, learn a secret, or unravel a cryptic prophecy."
        }
      ]
    },
    {
      "position": 8,
      "cells": [
        {
          "value": "8"
        },
        {
          "value": "Protector. The item seeks to defend a particular kind of creature, such as elves or werewolves."
        }
      ]
    },
    {
      "position": 9,
      "cells": [
        {
          "value": "9"
        },
        {
          "value": "Soulmate Seeker. The item seeks another sentient magic item, perhaps one that is similar to itself."
        }
      ]
    },
    {
      "position": 10,
      "cells": [
        {
          "value": "10"
        },
        {
          "value": "Templar. The item seeks to defend the servants and interests of a particular deity."
        }
      ]
    }
  ]
}
