  "sourceLocator": {
    "chapter": "Magic Items",
    "section": "10.132",
    "heading": "Hat of Many Spells",
    "lineStart": 15621,
    "lineEnd": 15621
  },
  "columns": [
    "86–90",
    "A Hostile Swarm of Bats flies out of the hat, occupies your space, and attacks you."
  ],
  "rows": [
    {
      "position": 1,
      "cells": [
        {
          "value": "91–95"
        },
        {
          "value": "A vertical, 10-foot-diameter, two-way portal to another plane of existence opens in an unoccupied space within 30 feet of you and remains open until the end of your next turn. The GM determines where it leads."
        }
      ]
    },
    {
      "position": 2,
      "cells": [
        {
          "value": "96–00"
        },
        {
          "value": "You pull a magic item out of the hat. Roll 1d6 to determine the item’s rarity: on a 1–3, Common; on a 4–5, Uncommon; on a 6, Rare. The GM chooses the item, which disappears after 1 hour if it’s not consumed or destroyed before then."
        }
      ]
    }
  ]
}
