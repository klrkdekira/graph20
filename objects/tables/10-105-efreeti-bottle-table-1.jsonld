  "rows": [
    {
      "position": 1,
      "cells": [
        {
          "value": "1"
        },
        {
          "value": "The efreeti attacks you. After fighting for 5 rounds, the efreeti disappears, and the bottle loses its magic."
        }
      ]
    },
    {
      "position": 2,
      "cells": [
        {
          "value": "2–9"
        },
        {
          "value": "The efreeti understands your languages and obeys your commands for 1 hour, after which it returns to the bottle, and a new stopper contains it. The stopper can’t be removed for 24 hours. The next two times the bottle is opened, the same effect occurs. If the bottle is opened a fourth time, the efreeti escapes and disappears, and the bottle loses its magic."
        }
      ]
    },
    {
      "position": 3,
      "cells": [
        {
          "value": "10"
        },
        {
          "value": "The efreeti understands your languages and can cast Wish once for you. It disappears when it grants the wish or after 1 hour, and the bottle loses its magic."
        }
      ]
    }
  ]
}
