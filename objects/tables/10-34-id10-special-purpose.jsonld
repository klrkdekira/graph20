    "chapter": "Magic Items",
    "section": "10.34",
    "heading": "Special Purpose",
    "lineStart": 14656,
    "lineEnd": 14656
  },
  "columns": [
    "5",
    "Destroyer. The item craves destruction and goads its user to fight arbitrarily."
  ],
  "rows": [
    {
      "position": 1,
      "cells": [
        {
          "value": "6"
        },
        {
          "value": "Glory Seeker. The item seeks renown as the greatest magic item in the world by winning fame or notoriety for its user."
        }
      ]
    },
    {
      "position": 2,
      "cells": [
        {
          "value": "7"
        },
        {
          "value": "Lore Seeker. The item craves knowledge or is determined to solve a mystery, learn a secret, or unravel a cryptic prophecy."
        }
      ]
    },
    {
      "position": 3,
      "cells": [
        {
          "value": "8"
        },
        {
          "value": "Protector. The item seeks to defend a particular kind of creature, such as elves or werewolves."
        }
      ]
    },
    {
      "position": 4,
      "cells": [
        {
          "value": "9"
        },
        {
          "value": "Soulmate Seeker. The item seeks another sentient magic item, perhaps one that is similar to itself."
        }
      ]
    },
    {
      "position": 5,
      "cells": [
        {
          "value": "10"
        },
        {
          "value": "Templar. The item seeks to defend the servants and interests of a particular deity."
        }
      ]
    }
  ]
}
