      "statSections": [
        {
          "name": "Traits",
          "rulesText": "Spider Climb. The drider can climb difficult surfaces, including along ceilings, without needing to make an ability check.\n\nSunlight Sensitivity. While in sunlight, the drider has Disadvantage on ability checks and attack rolls.\n\nWeb Walker. The drider ignores movement restrictions caused by webs, and the drider knows the location of any other creature in contact with the same web.",
          "sourceLocator": {
            "chapter": "Monsters A-Z",
            "section": "12.80",
            "heading": "Traits",
            "lineStart": 20473,
            "lineEnd": 20479
          }
        },
        {
          "name": "Actions",
          "rulesText": "Multiattack. The drider makes three attacks, using Foreleg or Poison Burst in any combination.\n\nForeleg. Melee Attack Roll: +7, reach 10 ft. Hit: 13 (2d8 + 4) Piercing damage.\n\nPoison Burst. Ranged Attack Roll: +6, range 120 ft. Hit: 13 (3d6 + 3) Poison damage.",
          "sourceLocator": {
