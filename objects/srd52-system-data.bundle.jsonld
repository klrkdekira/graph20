            },
            {
              "averageDamage": 2,
              "damageType": "Cold",
              "damageRoll": {
                "expression": "1d4",
                "count": 1,
                "sides": 4
              }
            }
          ],
          "sourceText": "Rend. Melee Attack Roll: +7, reach 10 ft. Hit: 9 (2d4 + 4) Slashing damage plus 2 (1d4) Cold damage.",
