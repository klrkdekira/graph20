      "languages": "None",
      "challenge": "1/2 (XP 100; PB +2)",
      "armorClassValue": 9,
      "hitPointsValue": 22,
      "hitPointsRoll": {
        "expression": "3d8+9",
        "count": 3,
        "sides": 8,
        "modifier": 9
      },
      "challengeRating": "1/2",
      "experiencePoints": 100,
      "proficiencyBonus": 2,
      "abilities": {
        "str": {
          "score": 12,
          "modifier": 1,
          "savingThrow": 1
        },
        "dex": {
          "score": 6,
          "modifier": -2,
          "savingThrow": -2
        },
        "con": {
          "score": 16,
          "modifier": 3,
          "savingThrow": 3
        },
        "int": {
          "score": 1,
          "modifier": -5,
          "savingThrow": -5
        },
        "wis": {
          "score": 6,
          "modifier": -2,
          "savingThrow": -2
        },
        "cha": {
          "score": 2,
          "modifier": -4,
          "savingThrow": -4
        }
      },
      "statSections": [
        {
          "name": "Traits",
          "rulesText": "Amorphous. The ooze can move through a space as narrow as 1 inch without expending extra movement to do so.\n\nCorrosive Form. Nonmagical ammunition is destroyed immediately after hitting the ooze and dealing any damage. Any nonmagical weapon takes a cumulative -1 penalty to attack rolls immediately after dealing damage to the ooze and coming into contact with it. The weapon is destroyed if the penalty reaches -5. The penalty can be removed by casting the Mending spell on the weapon.\n\nThe ooze can eat through 2-inch-thick, nonmagical metal or wood in 1 round.",
          "sourceLocator": {
            "chapter": "Monsters A-Z",
            "section": "12.115",
            "heading": "Traits",
            "lineStart": 21621,
            "lineEnd": 21627
          }
        },
        {
          "name": "Actions",
          "rulesText": "Pseudopod. Melee Attack Roll: +3, reach 5 ft. Hit: 10 (2d8 + 1) Acid damage. Nonmagical armor worn by the target takes a -1 penalty to the AC it offers. The armor is destroyed if the penalty reduces its AC to 10. The penalty can be removed by casting the Mending spell on the armor.",
          "sourceLocator": {
            "chapter": "Monsters A-Z",
            "section": "12.115",
            "heading": "Actions",
            "lineStart": 21629,
            "lineEnd": 21631
          }
        }
      ],
      "rulesText": "Medium Ooze, Unaligned\n\nAC 9\nInitiative -2 (13)\nHP 22 (3d8 + 9)\nSpeed 10 ft., Climb 10 ft.\n\nSkills Stealth +2\nResistances Acid, Cold, Fire\nImmunities Blinded, Charmed, Deafened, Exhaustion, Frightened, Grappled, Prone, Restrained\nSenses Blindsight 60 ft.; Passive Perception 8\nLanguages None\nCR 1/2 (XP 100; PB +2)\n\nTraits\n\nAmorphous. The ooze can move through a space as narrow as 1 inch without expending extra movement to do so.\n\nCorrosive Form. Nonmagical ammunition is destroyed immediately after hitting the ooze and dealing any damage. Any nonmagical weapon takes a cumulative -1 penalty to attack rolls immediately after dealing damage to the ooze and coming into contact with it. The weapon is destroyed if the penalty reaches -5. The penalty can be removed by casting the Mending spell on the weapon.\n\nThe ooze can eat through 2-inch-thick, nonmagical metal or wood in 1 round.\n\nActions\n\nPseudopod. Melee Attack Roll: +3, reach 5 ft. Hit: 10 (2d8 + 1) Acid damage. Nonmagical armor worn by the target takes a -1 penalty to the AC it offers. The armor is destroyed if the penalty reduces its AC to 10. The penalty can be removed by casting the Mending spell on the armor.",
      "conditionImmunities": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/conditions/blinded"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/conditions/charmed"
