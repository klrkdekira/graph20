    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/12-250-warriors",
      "@type": "Rule",
      "name": "Warriors",
      "slug": "12-250-warriors",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters A-Z",
        "section": "12.250",
        "heading": "Warriors",
        "lineStart": 25994,
        "lineEnd": 25994
      },
