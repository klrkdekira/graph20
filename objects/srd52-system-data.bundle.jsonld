    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/4-1-character-origins",
      "@type": "Rule",
      "name": "Character Origins",
      "slug": "4-1-character-origins",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Character Origins",
        "section": "4.1",
        "heading": "Character Origins",
        "lineStart": 5419,
        "lineEnd": 5419
      },
      "section": "4.1"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/4-14-character-species",
      "@type": "Rule",
      "name": "Character Species",
      "slug": "4-14-character-species",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Character Origins",
        "section": "4.14",
        "heading": "Character Species",
        "lineStart": 5501,
        "lineEnd": 5509
      },
      "section": "4.14",
      "rulesText": "When you choose your character's species, you determine whether your character is a human or a member of a fantastical species, such as dragonborn or gnome.\n\nThe peoples of the multiverse hail from different worlds and include many kinds of sapient life forms. A player character's species is the set of game traits that an adventurer gains from being one of those life forms.\n\nSome species can trace their origin to a single world, plane of existence, or god, while other species first appeared in multiple realms at once. Whatever a species' genesis, its members have spread across the multiverse and contribute to many different cultures.\n\nMembers of most species live for about 80 years, with exceptions noted in the text about the species in “Character Origins.” Regardless of life span, members of all species reach physical maturity at about the same age. Your character can be any age that isn’t beyond their species’ normal life span."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/4-15-parts-of-a-species",
      "@type": "Rule",
      "name": "Parts of a Species",
      "slug": "4-15-parts-of-a-species",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Character Origins",
        "section": "4.15",
        "heading": "Parts of a Species",
        "lineStart": 5511,
        "lineEnd": 5513
      },
      "section": "4.15",
      "rulesText": "A species includes the following parts."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/4-16-creature-type",
      "@type": "Rule",
      "name": "Creature Type",
      "slug": "4-16-creature-type",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Character Origins",
        "section": "4.16",
        "heading": "Creature Type",
        "lineStart": 5515,
        "lineEnd": 5517
      },
      "section": "4.16",
      "rulesText": "A character's species determines the character's creature type, which is described in “Rules Glossary.” Every species in “Character Origins” is Humanoid; playable non-Humanoid species appear in other books."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/4-17-size",
      "@type": "Rule",
      "name": "Size",
      "slug": "4-17-size",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Character Origins",
        "section": "4.17",
        "heading": "Size",
        "lineStart": 5519,
        "lineEnd": 5523
      },
      "section": "4.17",
      "rulesText": "Your character's species determines the character's size. Individuals within a species cover a wide range of heights, and some species include such diversity\n\nof size that you can choose whether your character is Small or Medium."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/4-18-speed",
      "@type": "Rule",
      "name": "Speed",
      "slug": "4-18-speed",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Character Origins",
        "section": "4.18",
        "heading": "Speed",
        "lineStart": 5525,
        "lineEnd": 5527
      },
      "section": "4.18",
      "rulesText": "Your character's species determines the character's Speed."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/4-19-special-traits",
      "@type": "Rule",
      "name": "Special Traits",
      "slug": "4-19-special-traits",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Character Origins",
        "section": "4.19",
        "heading": "Special Traits",
        "lineStart": 5529,
        "lineEnd": 5531
      },
      "section": "4.19",
      "rulesText": "Each species gives a character special traits - unique characteristics based on the species' physiology or magical nature. When you choose a species, your character gets all the special traits listed for it. Some traits involve making a choice from a handful of options."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/4-2-character-backgrounds",
      "@type": "Rule",
      "name": "Character Backgrounds",
      "slug": "4-2-character-backgrounds",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Character Origins",
        "section": "4.2",
        "heading": "Character Backgrounds",
        "lineStart": 5421,
        "lineEnd": 5423
      },
      "section": "4.2",
      "rulesText": "Your character's background is a collection of characteristics that represent the place and occupation that were most formative before your character embarked on a life of adventure."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/4-20-species-descriptions",
      "@type": "Rule",
      "name": "Species Descriptions",
      "slug": "4-20-species-descriptions",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Character Origins",
        "section": "4.20",
        "heading": "Species Descriptions",
        "lineStart": 5533,
        "lineEnd": 5533
      },
      "section": "4.20"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/4-3-parts-of-a-background",
      "@type": "Rule",
      "name": "Parts of a Background",
      "slug": "4-3-parts-of-a-background",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Character Origins",
        "section": "4.3",
        "heading": "Parts of a Background",
        "lineStart": 5425,
        "lineEnd": 5427
      },
      "section": "4.3",
      "rulesText": "A background includes the following parts."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/4-4-ability-scores",
      "@type": "Rule",
      "name": "Ability Scores",
      "slug": "4-4-ability-scores",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Character Origins",
        "section": "4.4",
        "heading": "Ability Scores",
        "lineStart": 5429,
        "lineEnd": 5431
      },
      "section": "4.4",
      "rulesText": "A background lists three of your character's ability scores. Increase one by 2 and another one by 1, or increase all three by 1. None of these increases can raise a score above 20."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/4-5-feat",
      "@type": "Rule",
      "name": "Feat",
      "slug": "4-5-feat",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Character Origins",
        "section": "4.5",
        "heading": "Feat",
        "lineStart": 5433,
        "lineEnd": 5435
      },
      "section": "4.5",
      "rulesText": "A background gives your character a specified Origin feat (described in \"Feats\")."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/4-6-skill-proficiencies",
      "@type": "Rule",
      "name": "Skill Proficiencies",
      "slug": "4-6-skill-proficiencies",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Character Origins",
        "section": "4.6",
        "heading": "Skill Proficiencies",
        "lineStart": 5437,
        "lineEnd": 5439
      },
      "section": "4.6",
      "rulesText": "A background gives your character proficiency in two specified skills."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/4-7-tool-proficiency",
      "@type": "Rule",
      "name": "Tool Proficiency",
      "slug": "4-7-tool-proficiency",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Character Origins",
        "section": "4.7",
        "heading": "Tool Proficiency",
        "lineStart": 5441,
        "lineEnd": 5445
      },
      "section": "4.7",
      "rulesText": "Each background gives a character proficiency with one tool - either a specific tool or one chosen from the Artisan's Tools category. Tools are detailed in \"Equipment.\"\n\n---"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/4-8-equipment",
      "@type": "Rule",
      "name": "Equipment",
      "slug": "4-8-equipment",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Character Origins",
        "section": "4.8",
        "heading": "Equipment",
        "lineStart": 5447,
        "lineEnd": 5449
      },
      "section": "4.8",
      "rulesText": "Each background offers a choice between a package of equipment and 50 GP."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/4-9-background-descriptions",
      "@type": "Rule",
      "name": "Background Descriptions",
      "slug": "4-9-background-descriptions",
      "source": {
