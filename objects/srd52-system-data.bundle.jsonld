        "heading": "Sea Hag",
        "lineStart": 24617,
        "lineEnd": 24651
      },
      "sizeTypeAlignment": "Medium Fey, Chaotic Evil",
      "sizeAndType": "Medium Fey",
      "alignment": "Chaotic Evil",
