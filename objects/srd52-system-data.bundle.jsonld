      ],
      "rows": [
        {
          "position": 1,
          "cells": [
            {
              "value": "1"
            },
            {
              "value": "Legs extend, allowing the apparatus to walk and swim."
            },
            {
              "value": "Legs retract, reducing the apparatus’s Speed and Swim Speed to 0 and making it unable to benefit from bonuses to speed."
            }
          ]
        },
        {
          "position": 2,
          "cells": [
            {
              "value": "2"
            },
            {
              "value": "Forward window shutter opens."
            },
            {
              "value": "Forward window shutter closes."
            }
          ]
        },
        {
          "position": 3,
          "cells": [
            {
              "value": "3"
            },
            {
              "value": "Side window shutters open (two per side)."
            },
            {
              "value": "Side window shutters close (two per side)."
            }
          ]
        },
        {
          "position": 4,
          "cells": [
            {
              "value": "4"
            },
            {
              "value": "Two claws extend from the front side of the apparatus."
            },
            {
              "value": "The claws retract."
            }
          ]
        },
        {
          "position": 5,
          "cells": [
            {
              "value": "5"
            },
            {
              "value": "Each extended claw makes the following melee attack: +8 to hit, reach 5 ft. Hit: 7 (2d6) Bludgeoning damage."
            },
            {
              "value": "Each extended claw makes the following melee attack: +8 to hit, reach 5 ft. Hit: The target has the Grappled condition (escape DC 15)."
            }
          ]
        },
        {
          "position": 6,
          "cells": [
            {
              "value": "6"
            },
            {
              "value": "The apparatus walks or swims forward provided its legs are extended."
            },
            {
              "value": "The apparatus walks or swims backward provided its legs are extended."
            }
          ]
        },
        {
          "position": 7,
          "cells": [
            {
              "value": "7"
            },
            {
              "value": "The apparatus turns 90 degrees counterclockwise provided its legs are extended."
            },
            {
              "value": "The apparatus turns 90 degrees clockwise provided its legs are extended."
            }
          ]
        },
        {
          "position": 8,
          "cells": [
            {
              "value": "8"
            },
            {
              "value": "Eyelike fixtures emit Bright Light in a 30-foot radius and Dim Light for an additional 30 feet."
            },
            {
              "value": "The light turns off."
            }
          ]
        },
        {
          "position": 9,
          "cells": [
            {
              "value": "9"
            },
            {
              "value": "The apparatus sinks up to 20 feet if it’s in liquid."
            },
            {
              "value": "The apparatus rises up to 20 feet if it’s in liquid."
            }
          ]
        },
        {
          "position": 10,
          "cells": [
            {
              "value": "10"
            },
            {
              "value": "The rear hatch unseals and opens."
            },
            {
              "value": "The rear hatch closes and seals."
            }
          ]
        }
      ],
      "rawText": "| Lever | Up                                                                                                           | Down                                                                                                                                   |\n| :---- | :----------------------------------------------------------------------------------------------------------- | :------------------------------------------------------------------------------------------------------------------------------------- |\n| 1     | Legs extend, allowing the apparatus to walk and swim.                                                        | Legs retract, reducing the apparatus’s Speed and Swim Speed to 0 and making it unable to benefit from bonuses to speed.                |\n| 2     | Forward window shutter opens.                                                                                | Forward window shutter closes.                                                                                                         |\n| 3     | Side window shutters open (two per side).                                                                    | Side window shutters close (two per side).                                                                                             |\n| 4     | Two claws extend from the front side of the apparatus.                                                       | The claws retract.                                                                                                                     |\n| 5     | Each extended claw makes the following melee attack: +8 to hit, reach 5 ft. Hit: 7 (2d6) Bludgeoning damage. | Each extended claw makes the following melee attack: +8 to hit, reach 5 ft. Hit: The target has the Grappled condition (escape DC 15). |\n| 6     | The apparatus walks or swims forward provided its legs are extended.                                         | The apparatus walks or swims backward provided its legs are extended.                                                                  |\n| 7     | The apparatus turns 90 degrees counterclockwise provided its legs are extended.                              | The apparatus turns 90 degrees clockwise provided its legs are extended.                                                               |\n| 8     | Eyelike fixtures emit Bright Light in a 30-foot radius and Dim Light for an additional 30 feet.              | The light turns off.                                                                                                                   |\n| 9     | The apparatus sinks up to 20 feet if it’s in liquid.                                                         | The apparatus rises up to 20 feet if it’s in liquid.                                                                                   |\n| 10    | The rear hatch unseals and opens.                                                                            | The rear hatch closes and seals.                                                                                                       |"
