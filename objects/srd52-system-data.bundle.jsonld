        }
      ],
      "damage": [
        {
          "damageType": "Psychic",
          "damageRoll": {
            "expression": "12d12",
            "count": 12,
            "sides": 12
          }
        }
      ],
      "scalesWithSlotLevel": false,
      "concentration": false,
      "ritual": false
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/spells/power-word-stun",
      "@type": "Spell",
      "name": "Power Word Stun",
      "slug": "power-word-stun",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.269",
        "heading": "Power Word Stun",
        "lineStart": 11068,
        "lineEnd": 11079
      },
      "level": 8,
      "school": "Enchantment",
      "classAvailability": [
        "Bard",
        "Sorcerer",
        "Warlock",
        "Wizard"
      ],
      "castingTime": "Action",
      "range": "60 feet",
      "components": "V",
      "duration": "Instantaneous",
      "rulesText": "Level 8 Enchantment (Bard, Sorcerer, Warlock, Wizard)\n\nCasting Time: Action\nRange: 60 feet\nComponents: V\nDuration: Instantaneous\n\nYou overwhelm the mind of one creature you can see within range. If the target has 150 Hit Points or fewer, it has the Stunned condition. Otherwise, its Speed is 0 until the start of your next turn.\n\nThe Stunned target makes a Constitution saving throw at the end of each of its turns, ending the condition on itself on a success.",
      "classes": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/classes/bard"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/classes/sorcerer"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/classes/warlock"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/classes/wizard"
        }
      ],
      "savingThrowAbility": "Constitution",
      "scalesWithSlotLevel": false,
      "concentration": false,
      "ritual": false
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/spells/prayer-of-healing",
      "@type": "Spell",
      "name": "Prayer of Healing",
      "slug": "prayer-of-healing",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.270",
        "heading": "Prayer of Healing",
        "lineStart": 11081,
        "lineEnd": 11092
      },
      "level": 2,
      "school": "Abjuration",
      "classAvailability": [
        "Cleric",
        "Paladin"
      ],
      "castingTime": "10 minutes",
      "range": "30 feet",
      "components": "V",
      "duration": "Instantaneous",
      "rulesText": "Level 2 Abjuration (Cleric, Paladin)\n\nCasting Time: 10 minutes\nRange: 30 feet\nComponents: V\nDuration: Instantaneous\n\nUp to five creatures of your choice who remain within range for the spell's entire casting gain the benefits of a Short Rest and also regain 2d8 Hit Points. A creature can't be affected by this spell again until that creature finishes a Long Rest.\n\nUsing a Higher-Level Spell Slot. The healing increases by 1d8 for each spell slot level above 2.",
      "classes": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/classes/cleric"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/classes/paladin"
        }
      ],
      "scalesWithSlotLevel": true,
      "concentration": false,
      "ritual": false
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/spells/prestidigitation",
      "@type": "Spell",
      "name": "Prestidigitation",
      "slug": "prestidigitation",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.271",
        "heading": "Prestidigitation",
        "lineStart": 11094,
        "lineEnd": 11115
      },
      "level": 0,
      "school": "Transmutation",
      "classAvailability": [
        "Bard",
        "Sorcerer",
        "Warlock",
        "Wizard"
      ],
      "castingTime": "Action",
      "range": "10 feet",
      "components": "V, S",
      "duration": "Up to 1 hour",
      "rulesText": "Transmutation Cantrip (Bard, Sorcerer, Warlock, Wizard)\n\nCasting Time: Action\nRange: 10 feet\nComponents: V, S\nDuration: Up to 1 hour\n\nYou create a magical effect within range. Choose the effect from the options below. If you cast this spell multiple times, you can have up to three of its non-instantaneous effects active at a time.\n\nSensory Effect. You create an instantaneous, harmless sensory effect, such as a shower of sparks, a puff of wind, faint musical notes, or an odd odor.\n\nFire Play. You instantaneously light or snuff out a candle, a torch, or a small campfire.\n\nClean or Soil. You instantaneously clean or soil an object no larger than 1 cubic foot.\n\nMinor Sensation. You chill, warm, or flavor up to 1 cubic foot of nonliving material for 1 hour.\n\nMagic Mark. You make a color, a small mark, or a symbol appear on an object or a surface for 1 hour.\n\nMinor Creation. You create a nonmagical trinket or an illusory image that can fit in your hand. It lasts until the end of your next turn. A trinket can deal no damage and has no monetary worth.",
      "classes": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/classes/bard"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/classes/sorcerer"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/classes/warlock"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/classes/wizard"
        }
      ],
      "scalesWithSlotLevel": false,
      "concentration": false,
      "ritual": false
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/spells/prismatic-spray",
      "@type": "Spell",
      "name": "Prismatic Spray",
      "slug": "prismatic-spray",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.272",
        "heading": "Prismatic Spray",
        "lineStart": 11117,
        "lineEnd": 11145
      },
      "level": 7,
      "school": "Evocation",
      "classAvailability": [
        "Bard",
        "Sorcerer",
        "Wizard"
      ],
      "castingTime": "Action",
      "range": "Self",
      "components": "V, S",
      "duration": "Instantaneous",
      "rulesText": "Level 7 Evocation (Bard, Sorcerer, Wizard)\n\nCasting Time: Action\nRange: Self\nComponents: V, S\nDuration: Instantaneous\n\nEight rays of light flash from you in a 60-foot Cone. Each creature in the Cone makes a Dexterity saving throw. For each target, roll 1d8 to determine which color ray affects it, consulting the Prismatic Rays table.\n\nPrismatic Rays\n\n| 1d8 | Ray                                                                               |\n| :--- | :-------------------------------------------------------------------------------- |\n| 1   | Red. Failed Save: 12d6 Fire damage. Successful Save: Half as much damage.         |\n| 2   | Orange. Failed Save: 12d6 Acid damage. Successful Save: Half as much damage.      |\n| 3   | Yellow. Failed Save: 12d6 Lightning damage. Successful Save: Half as much damage. |\n| 4   | Green. Failed Save: 12d6 Poison damage. Successful Save: Half as much damage.     |\n\n1d8 Ray\n\n5 Blue. Failed Save: 12d6 Cold damage. Successful Save: Half as much damage.\n\n6 Indigo. Failed Save: The target has the Restrained condition and makes a Constitution saving throw at the end of each of its turns. If it successfully saves three times, the condition ends. If it fails three times, it has the Petrified condition until it is freed by an effect like the Greater Restoration spell. The successes and failures needn't be consecutive; keep track of both until the target collects three of a kind.\n\n7 Violet. Failed Save: The target has the Blinded condition and makes a Wisdom saving throw at the start of your next turn. On a successful save, the condition ends. On a failed save, the condition ends, and the creature teleports to another plane of existence (GM's choice).\n\n8 Special. The target is struck by two rays. Roll twice, rerolling any 8.",
      "classes": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/classes/bard"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/classes/sorcerer"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/classes/wizard"
        }
      ],
      "savingThrowAbility": "Dexterity",
      "damage": [
        {
          "damageType": "Fire",
          "damageRoll": {
            "expression": "12d6",
            "count": 12,
            "sides": 6
          }
        },
        {
          "damageType": "Acid",
          "damageRoll": {
            "expression": "12d6",
            "count": 12,
            "sides": 6
          }
        },
        {
          "damageType": "Lightning",
          "damageRoll": {
