    {
      "@id": "https://cheeleong.dev/graph20/objects/spells/beacon-of-hope",
      "@type": "Spell",
      "name": "Beacon of Hope",
      "slug": "beacon-of-hope",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.56",
        "heading": "Beacon of Hope",
        "lineStart": 7766,
        "lineEnd": 7775
      },
      "level": 3,
      "school": "Abjuration",
      "classAvailability": [
        "Cleric"
      ],
      "castingTime": "Action",
      "range": "30 feet",
      "components": "V, S",
      "duration": "Concentration, up to 1 minute",
      "rulesText": "Level 3 Abjuration (Cleric)\n\nCasting Time: Action\nRange: 30 feet\nComponents: V, S\nDuration: Concentration, up to 1 minute\n\nChoose any number of creatures within range. For the duration, each target has Advantage on Wisdom saving throws and Death Saving Throws and regains the maximum number of Hit Points possible from any healing.",
      "classes": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/classes/cleric"
        }
      ],
      "savingThrowAbility": "Wisdom",
      "scalesWithSlotLevel": false,
