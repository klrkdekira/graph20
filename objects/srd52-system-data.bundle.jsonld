        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters A-Z",
        "section": "12.115",
        "heading": "Gray Ooze",
        "lineStart": 21598,
        "lineEnd": 21631
      },
      "sizeTypeAlignment": "Medium Ooze, Unaligned",
      "sizeAndType": "Medium Ooze",
      "alignment": "Unaligned",
      "armorClass": "9",
      "initiative": "-2 (13)",
      "hitPoints": "22 (3d8 + 9)",
