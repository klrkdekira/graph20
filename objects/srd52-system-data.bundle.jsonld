        {
          "name": "Actions",
          "rulesText": "Slam. Melee Attack Roll: +3, reach 5 ft. Hit: 5 (1d8 + 1) Bludgeoning damage.",
          "sourceLocator": {
            "chapter": "Monsters A-Z",
