          "damageType": "Psychic",
          "damageRoll": {
            "expression": "5d10",
            "count": 5,
            "sides": 10
          }
        }
      ],
      "scalesWithSlotLevel": true,
      "concentration": false,
      "ritual": false
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/spells/gentle-repose",
      "@type": "Spell",
      "name": "Gentle Repose",
      "slug": "gentle-repose",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.173",
        "heading": "Gentle Repose",
        "lineStart": 9614,
        "lineEnd": 9625
      },
      "level": 2,
      "school": "Necromancy",
      "classAvailability": [
        "Cleric",
        "Paladin",
        "Wizard"
      ],
      "castingTime": "Action or Ritual",
      "range": "Touch",
      "components": "V, S, M (2 Copper Pieces, which the spell consumes)",
      "duration": "10 days",
      "rulesText": "Level 2 Necromancy (Cleric, Paladin, Wizard)\n\nCasting Time: Action or Ritual\nRange: Touch\nComponents: V, S, M (2 Copper Pieces, which the spell consumes)\nDuration: 10 days\n\nYou touch a corpse or other remains. For the duration, the target is protected from decay and can't become Undead.\n\nThe spell also effectively extends the time limit on raising the target from the dead, since days spent under the influence of this spell don't count against the time limit of spells such as Raise Dead.",
      "classes": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/classes/cleric"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/classes/paladin"
        },
