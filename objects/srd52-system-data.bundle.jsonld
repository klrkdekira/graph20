      "section": "5.9"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-1-equipment",
      "@type": "Rule",
      "name": "Equipment",
      "slug": "6-1-equipment",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.1",
        "heading": "Equipment",
        "lineStart": 5939,
        "lineEnd": 5939
      },
      "section": "6.1"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-10-light",
      "@type": "Rule",
      "name": "Light",
      "slug": "6-10-light",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.10",
        "heading": "Light",
        "lineStart": 5995,
        "lineEnd": 5997
      },
      "section": "6.10",
      "rulesText": "When you take the Attack action on your turn and attack with a Light weapon, you can make one extra attack as a Bonus Action later on the same turn. That extra attack must be made with a different Light weapon, and you don't add your ability modifier to the extra attack's damage unless that modifier is negative. For example, you can attack with a Shortsword in one hand and a Dagger in the other using the Attack action and a Bonus Action, but you don't add your Strength or Dexterity modifier to the damage roll of the Bonus Action unless that modifier is negative."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-100-holy-water-25-gp",
      "@type": "Rule",
      "name": "Holy Water (25 GP)",
      "slug": "6-100-holy-water-25-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.100",
        "heading": "Holy Water (25 GP)",
        "lineStart": 6686,
        "lineEnd": 6688
      },
      "section": "6.100",
      "rulesText": "When you take the Attack action, you can replace one of your attacks with throwing a flask of Holy Water. Target one creature you can see within 20 feet of yourself. The target must succeed on a Dexterity saving throw (DC 8 plus your Dexterity modifier and Proficiency Bonus) or take 2d8 Radiant damage if it is a Fiend or an Undead."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-101-hunting-trap-5-gp",
      "@type": "Rule",
      "name": "Hunting Trap (5 GP)",
      "slug": "6-101-hunting-trap-5-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.101",
        "heading": "Hunting Trap (5 GP)",
        "lineStart": 6690,
        "lineEnd": 6694
      },
      "section": "6.101",
      "rulesText": "As a Utilize action, you can set a Hunting Trap, which is a sawtooth steel ring that snaps shut when a creature steps on a pressure plate in the center.\n\nThe trap is affixed by a heavy chain to an immobile object, such as a tree or a spike driven into the ground. A creature that steps on the plate must succeed on a DC 13 Dexterity saving throw or take 1d4 Piercing damage and have its Speed reduced to 0 until the start of its next turn. Thereafter, until the creature breaks free of the trap, its movement is limited by the length of the chain (typically 3 feet). A creature can use its action to make a DC 13 Strength (Athletics) check, freeing itself or another creature within its reach on a success. Each failed check deals 1 Piercing damage to the trapped creature."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-102-ink-10-gp",
      "@type": "Rule",
      "name": "Ink (10 GP)",
      "slug": "6-102-ink-10-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.102",
        "heading": "Ink (10 GP)",
        "lineStart": 6696,
        "lineEnd": 6698
      },
      "section": "6.102",
      "rulesText": "Ink comes in a 1-ounce bottle, which provides enough ink to write about 500 pages."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-103-ink-pen-2-cp",
      "@type": "Rule",
      "name": "Ink Pen (2 CP)",
      "slug": "6-103-ink-pen-2-cp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.103",
        "heading": "Ink Pen (2 CP)",
        "lineStart": 6700,
        "lineEnd": 6702
      },
      "section": "6.103",
      "rulesText": "Using Ink, an Ink Pen is used to write or draw."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-104-jug-2-cp",
      "@type": "Rule",
      "name": "Jug (2 CP)",
      "slug": "6-104-jug-2-cp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.104",
        "heading": "Jug (2 CP)",
        "lineStart": 6704,
        "lineEnd": 6706
      },
      "section": "6.104",
      "rulesText": "A Jug holds up to 1 gallon."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-105-ladder-1-sp",
      "@type": "Rule",
      "name": "Ladder (1 SP)",
      "slug": "6-105-ladder-1-sp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.105",
        "heading": "Ladder (1 SP)",
        "lineStart": 6708,
        "lineEnd": 6710
      },
      "section": "6.105",
      "rulesText": "A Ladder is 10 feet tall. You must climb to move up or down it."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-106-lamp-5-sp",
      "@type": "Rule",
      "name": "Lamp (5 SP)",
      "slug": "6-106-lamp-5-sp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.106",
        "heading": "Lamp (5 SP)",
        "lineStart": 6712,
        "lineEnd": 6714
      },
      "section": "6.106",
      "rulesText": "A Lamp burns Oil as fuel to cast Bright Light in a 15-foot radius and Dim Light for an additional 30 feet."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-107-lantern-bullseye-10-gp",
      "@type": "Rule",
      "name": "Lantern, Bullseye (10 GP)",
      "slug": "6-107-lantern-bullseye-10-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.107",
        "heading": "Lantern, Bullseye (10 GP)",
        "lineStart": 6716,
        "lineEnd": 6718
      },
      "section": "6.107",
      "rulesText": "A Bullseye Lantern burns Oil as fuel to cast Bright Light in a 60-foot Cone and Dim Light for an additional 60 feet."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-108-lantern-hooded-5-gp",
      "@type": "Rule",
      "name": "Lantern, Hooded (5 GP)",
      "slug": "6-108-lantern-hooded-5-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.108",
        "heading": "Lantern, Hooded (5 GP)",
        "lineStart": 6720,
        "lineEnd": 6722
      },
      "section": "6.108",
      "rulesText": "A Hooded Lantern burns Oil as fuel to cast Bright Light in a 30-foot radius and Dim Light for an additional 30 feet. As a Bonus Action, you can lower the hood, reducing the light to Dim Light in a 5-foot radius, or raise it again."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-109-lock-10-gp",
      "@type": "Rule",
      "name": "Lock (10 GP)",
      "slug": "6-109-lock-10-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.109",
        "heading": "Lock (10 GP)",
        "lineStart": 6724,
        "lineEnd": 6726
      },
      "section": "6.109",
      "rulesText": "A Lock comes with a key. Without the key, a creature can use Thieves' Tools to pick this Lock with a successful DC 15 Dexterity (Sleight of Hand) check."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-11-loading",
      "@type": "Rule",
      "name": "Loading",
      "slug": "6-11-loading",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.11",
        "heading": "Loading",
        "lineStart": 5999,
        "lineEnd": 6001
      },
      "section": "6.11",
      "rulesText": "You can fire only one piece of ammunition from a Loading weapon when you use an action, a Bonus Action, or a Reaction to fire it, regardless of the number of attacks you can normally make."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-110-magnifying-glass-100-gp",
      "@type": "Rule",
      "name": "Magnifying Glass (100 GP)",
      "slug": "6-110-magnifying-glass-100-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.110",
        "heading": "Magnifying Glass (100 GP)",
        "lineStart": 6728,
        "lineEnd": 6730
      },
      "section": "6.110",
      "rulesText": "A Magnifying Glass grants Advantage on any ability check made to appraise or inspect a highly detailed item. Lighting a fire with a Magnifying Glass requires light as bright as sunlight to focus, tinder to ignite, and about 5 minutes for the fire to ignite."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-111-manacles-2-gp",
      "@type": "Rule",
      "name": "Manacles (2 GP)",
      "slug": "6-111-manacles-2-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.111",
        "heading": "Manacles (2 GP)",
        "lineStart": 6732,
        "lineEnd": 6738
      },
      "section": "6.111",
      "rulesText": "As a Utilize action, you can use Manacles to bind an unwilling Small or Medium creature within 5 feet of yourself that has the Grappled, Incapacitated, or Restrained condition if you succeed on a DC 13\n\nDexterity (Sleight of Hand) check. While bound, a creature has Disadvantage on attack rolls, and the creature is Restrained if the Manacles are attached to a chain or hook that is fixed in place. Escaping the Manacles requires a successful DC 20 Dexterity (Sleight of Hand) check as an action. Bursting them requires a successful DC 25 Strength (Athletics) check as an action.\n\nEach set of Manacles comes with a key. Without the key, a creature can use Thieves' Tools to pick the Manacles' lock with a successful DC 15 Dexterity (Sleight of Hand) check."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-112-map-1-gp",
      "@type": "Rule",
      "name": "Map (1 GP)",
      "slug": "6-112-map-1-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.112",
        "heading": "Map (1 GP)",
        "lineStart": 6740,
        "lineEnd": 6742
      },
      "section": "6.112",
      "rulesText": "If you consult an accurate Map, you gain a +5 bonus to Wisdom (Survival) checks you make to find your way in the place represented on it."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-113-mirror-5-gp",
      "@type": "Rule",
      "name": "Mirror (5 GP)",
      "slug": "6-113-mirror-5-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.113",
        "heading": "Mirror (5 GP)",
        "lineStart": 6744,
        "lineEnd": 6746
      },
      "section": "6.113",
      "rulesText": "A handheld steel Mirror is useful for personal cosmetics but also for peeking around corners and reflecting light as a signal."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-114-net-1-gp",
      "@type": "Rule",
      "name": "Net (1 GP)",
      "slug": "6-114-net-1-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.114",
        "heading": "Net (1 GP)",
        "lineStart": 6748,
        "lineEnd": 6752
      },
      "section": "6.114",
      "rulesText": "When you take the Attack action, you can replace one of your attacks with throwing a Net. Target a creature you can see within 15 feet of yourself. The target must succeed on a Dexterity saving throw (DC 8 plus your Dexterity modifier and Proficiency Bonus) or have the Restrained condition until it escapes. The target succeeds automatically if it is Huge or larger.\n\nTo escape, the target or a creature within 5 feet of it must take an action to make a DC 10 Strength (Athletics) check, freeing the Restrained creature on a success. Destroying the Net (AC 10; 5 HP; Immunity to Bludgeoning, Poison, and Psychic damage) also frees the target, ending the effect."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-115-oil-1-sp",
      "@type": "Rule",
      "name": "Oil (1 SP)",
      "slug": "6-115-oil-1-sp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.115",
        "heading": "Oil (1 SP)",
        "lineStart": 6754,
        "lineEnd": 6762
      },
      "section": "6.115",
      "rulesText": "You can douse a creature, object, or space with Oil or use it as fuel, as detailed below.\n\nDousing a Creature or an Object. When you take the Attack action, you can replace one of your attacks with throwing an Oil flask. Target one creature or object within 20 feet of yourself. The target must succeed on a Dexterity saving throw (DC 8 plus your Dexterity modifier and Proficiency Bonus) or be covered in oil. If the target takes Fire damage before the oil dries (after 1 minute), the target takes an extra 5 Fire damage from burning oil.\n\nDousing a Space. You can take the Utilize action to pour an Oil flask on level ground to cover a 5-foot-square area within 5 feet of yourself. If lit, the oil burns until the end of the turn 2 rounds from when the oil was lit (or 12 seconds) and deals 5 Fire damage to any creature that enters the area or ends its turn there. A creature can take this damage only once per turn.\n\nFuel. Oil serves as fuel for Lamps and Lanterns. Once lit, a flask of Oil burns for 6 hours in a Lamp or Lantern. That duration doesn't need to be consecutive; you can extinguish the burning Oil (as a Utilize action) and rekindle it again until it has burned for a total of 6 hours."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-116-paper-2-sp",
      "@type": "Rule",
      "name": "Paper (2 SP)",
      "slug": "6-116-paper-2-sp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.116",
        "heading": "Paper (2 SP)",
        "lineStart": 6764,
        "lineEnd": 6766
      },
      "section": "6.116",
      "rulesText": "One sheet of Paper can hold about 250 handwritten words."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-117-parchment-1-sp",
      "@type": "Rule",
      "name": "Parchment (1 SP)",
      "slug": "6-117-parchment-1-sp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.117",
        "heading": "Parchment (1 SP)",
        "lineStart": 6768,
        "lineEnd": 6770
      },
      "section": "6.117",
      "rulesText": "One sheet of Parchment can hold about 250 handwritten words."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-118-perfume-5-gp",
      "@type": "Rule",
      "name": "Perfume (5 GP)",
      "slug": "6-118-perfume-5-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.118",
        "heading": "Perfume (5 GP)",
        "lineStart": 6772,
        "lineEnd": 6774
      },
      "section": "6.118",
      "rulesText": "Perfume comes in a 4-ounce vial. For 1 hour after applying Perfume to yourself, you have Advantage on Charisma (Persuasion) checks made to influence an Indifferent Humanoid within 5 feet of yourself."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-119-poison-basic-100-gp",
      "@type": "Rule",
      "name": "Poison, Basic (100 GP)",
      "slug": "6-119-poison-basic-100-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.119",
        "heading": "Poison, Basic (100 GP)",
        "lineStart": 6776,
        "lineEnd": 6778
      },
      "section": "6.119",
      "rulesText": "As a Bonus Action, you can use a vial of Basic Poison to coat one weapon or up to three pieces of ammunition. A creature that takes Piercing or Slashing damage from the poisoned weapon or ammunition takes an extra 1d4 Poison damage. Once applied, the poison retains potency for 1 minute or until its damage is dealt, whichever comes first."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-12-range",
      "@type": "Rule",
      "name": "Range",
      "slug": "6-12-range",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.12",
        "heading": "Range",
        "lineStart": 6003,
        "lineEnd": 6005
      },
      "section": "6.12",
      "rulesText": "A Range weapon has a range in parentheses after the Ammunition or Thrown property. The range lists two numbers. The first is the weapon's normal range in feet, and the second is the weapon's long range. When attacking a target beyond normal range, you have Disadvantage on the attack roll. You can't attack a target beyond the long range."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-120-pole-5-cp",
      "@type": "Rule",
      "name": "Pole (5 CP)",
      "slug": "6-120-pole-5-cp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.120",
        "heading": "Pole (5 CP)",
        "lineStart": 6780,
        "lineEnd": 6782
      },
      "section": "6.120",
      "rulesText": "A Pole is 10 feet long. You can use it to touch something up to 10 feet away. If you must make a Strength (Athletics) check as part of a High or Long Jump, you can use the Pole to vault, giving yourself Advantage on the check."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-121-pot-iron-2-gp",
      "@type": "Rule",
      "name": "Pot, Iron (2 GP)",
      "slug": "6-121-pot-iron-2-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.121",
        "heading": "Pot, Iron (2 GP)",
        "lineStart": 6784,
        "lineEnd": 6786
      },
      "section": "6.121",
      "rulesText": "An Iron Pot holds up to 1 gallon."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-122-potion-of-healing-50-gp",
      "@type": "Rule",
      "name": "Potion of Healing (50 GP)",
      "slug": "6-122-potion-of-healing-50-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.122",
        "heading": "Potion of Healing (50 GP)",
        "lineStart": 6788,
        "lineEnd": 6790
      },
      "section": "6.122",
      "rulesText": "This potion is a magic item. As a Bonus Action, you can drink it or administer it to another creature within 5 feet of yourself. The creature that drinks the magical red fluid in this vial regains 2d4 + 2 Hit Points."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-123-pouch-5-sp",
      "@type": "Rule",
      "name": "Pouch (5 SP)",
      "slug": "6-123-pouch-5-sp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.123",
        "heading": "Pouch (5 SP)",
        "lineStart": 6792,
        "lineEnd": 6794
      },
      "section": "6.123",
      "rulesText": "A Pouch holds up to 6 pounds within one-fifth of a cubic foot."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-124-priests-pack-33-gp",
      "@type": "Rule",
      "name": "Priest's Pack (33 GP)",
      "slug": "6-124-priests-pack-33-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.124",
        "heading": "Priest's Pack (33 GP)",
        "lineStart": 6796,
        "lineEnd": 6798
      },
      "section": "6.124",
      "rulesText": "A Priest's Pack contains the following items: Backpack, Blanket, Holy Water, Lamp, 7 days of Rations, Robe, and Tinderbox."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-125-quiver-1-gp",
      "@type": "Rule",
      "name": "Quiver (1 GP)",
      "slug": "6-125-quiver-1-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.125",
        "heading": "Quiver (1 GP)",
        "lineStart": 6800,
        "lineEnd": 6802
      },
      "section": "6.125",
      "rulesText": "A Quiver holds up to 20 Arrows."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-126-ram-portable-4-gp",
      "@type": "Rule",
      "name": "Ram, Portable (4 GP)",
      "slug": "6-126-ram-portable-4-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.126",
        "heading": "Ram, Portable (4 GP)",
        "lineStart": 6804,
        "lineEnd": 6806
      },
      "section": "6.126",
      "rulesText": "You can use a Portable Ram to break down doors. When doing so, you gain a +4 bonus to the Strength check. One other character can help you use the ram, giving you Advantage on this check."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-127-rations-5-sp",
      "@type": "Rule",
      "name": "Rations (5 SP)",
      "slug": "6-127-rations-5-sp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.127",
        "heading": "Rations (5 SP)",
        "lineStart": 6808,
        "lineEnd": 6810
      },
      "section": "6.127",
      "rulesText": "Rations consist of travel-ready food, including jerky, dried fruit, hardtack, and nuts. See “Malnutrition” in “Rules Glossary” for the risks of not eating."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-128-robe-1-gp",
      "@type": "Rule",
      "name": "Robe (1 GP)",
      "slug": "6-128-robe-1-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.128",
        "heading": "Robe (1 GP)",
        "lineStart": 6812,
        "lineEnd": 6814
      },
      "section": "6.128",
      "rulesText": "A Robe has vocational or ceremonial significance. Some events and locations admit only people wearing a Robe bearing certain colors or symbols."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-129-rope-1-gp",
      "@type": "Rule",
      "name": "Rope (1 GP)",
      "slug": "6-129-rope-1-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.129",
        "heading": "Rope (1 GP)",
        "lineStart": 6816,
        "lineEnd": 6820
      },
      "section": "6.129",
      "rulesText": "As a Utilize action, you can tie a knot with Rope if you succeed on a DC 10 Dexterity (Sleight of Hand) check. The Rope can be burst with a successful DC 20 Strength (Athletics) check.\n\nYou can bind an unwilling creature with the Rope only if the creature has the Grappled, Incapacitated, or Restrained condition. If the creature's legs are bound, the creature has the Restrained condition until it escapes. Escaping the Rope requires the creature to make a successful DC 15 Dexterity (Ac-robatics) check as an action."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-13-reach",
      "@type": "Rule",
      "name": "Reach",
      "slug": "6-13-reach",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.13",
        "heading": "Reach",
        "lineStart": 6007,
        "lineEnd": 6009
      },
      "section": "6.13",
      "rulesText": "A Reach weapon adds 5 feet to your reach when you attack with it, as well as when determining your reach for Opportunity Attacks with it."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-130-sack-1-cp",
      "@type": "Rule",
      "name": "Sack (1 CP)",
      "slug": "6-130-sack-1-cp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.130",
        "heading": "Sack (1 CP)",
        "lineStart": 6822,
        "lineEnd": 6824
      },
      "section": "6.130",
      "rulesText": "A Sack holds up to 30 pounds within 1 cubic foot."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-131-scholars-pack-40-gp",
      "@type": "Rule",
      "name": "Scholar's Pack (40 GP)",
      "slug": "6-131-scholars-pack-40-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.131",
        "heading": "Scholar's Pack (40 GP)",
        "lineStart": 6826,
        "lineEnd": 6828
      },
      "section": "6.131",
      "rulesText": "A Scholar's Pack contains the following items: Backpack, Book, Ink, Ink Pen, Lamp, 10 flasks of Oil, 10 sheets of Parchment, and Tinderbox."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-132-shovel-2-gp",
      "@type": "Rule",
      "name": "Shovel (2 GP)",
      "slug": "6-132-shovel-2-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.132",
        "heading": "Shovel (2 GP)",
        "lineStart": 6830,
        "lineEnd": 6832
      },
      "section": "6.132",
      "rulesText": "Working for 1 hour, you can use a Shovel to dig a hole that is 5 feet on each side in soil or similar material."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-133-signal-whistle-5-cp",
      "@type": "Rule",
      "name": "Signal Whistle (5 CP)",
      "slug": "6-133-signal-whistle-5-cp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.133",
        "heading": "Signal Whistle (5 CP)",
        "lineStart": 6834,
        "lineEnd": 6836
      },
      "section": "6.133",
      "rulesText": "When blown as a Utilize action, a Signal Whistle produces a sound that can be heard up to 600 feet away."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-134-spell-scroll-cantrip-30-gp-level-1-50-gp",
      "@type": "Rule",
      "name": "Spell Scroll (Cantrip, 30 GP; Level 1, 50 GP)",
      "slug": "6-134-spell-scroll-cantrip-30-gp-level-1-50-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.134",
        "heading": "Spell Scroll (Cantrip, 30 GP; Level 1, 50 GP)",
        "lineStart": 6838,
        "lineEnd": 6842
      },
      "section": "6.134",
      "rulesText": "A Spell Scroll (Cantrip) or Spell Scroll (Level 1) is a magic item that bears the words of a cantrip or level 1 spell, respectively, determined by the scroll's creator. If the spell is on your class's spell list, you can read the scroll and cast the spell using its normal casting time and without providing any Material components.\n\nIf the spell requires a saving throw or an attack roll, the spell save DC is 13, and the attack bonus is +5. The scroll disintegrates when the casting is completed."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-135-spikes-iron-1-gp",
      "@type": "Rule",
      "name": "Spikes, Iron (1 GP)",
      "slug": "6-135-spikes-iron-1-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.135",
        "heading": "Spikes, Iron (1 GP)",
        "lineStart": 6844,
        "lineEnd": 6846
      },
      "section": "6.135",
      "rulesText": "Iron Spikes come in bundles of ten. As a Utilize action, you can use a blunt object, such as a Light Hammer, to hammer a spike into wood, earth, or a similar material. You can do so to jam a door shut or to then tie a Rope or Chain to the Spike."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-136-spyglass-1-000-gp",
      "@type": "Rule",
      "name": "Spyglass (1,000 GP)",
      "slug": "6-136-spyglass-1-000-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.136",
        "heading": "Spyglass (1,000 GP)",
        "lineStart": 6848,
        "lineEnd": 6850
      },
      "section": "6.136",
      "rulesText": "Objects viewed through a Spyglass are magnified to twice their size."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-137-string-1-sp",
      "@type": "Rule",
      "name": "String (1 SP)",
      "slug": "6-137-string-1-sp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.137",
        "heading": "String (1 SP)",
        "lineStart": 6852,
        "lineEnd": 6854
      },
      "section": "6.137",
      "rulesText": "String is 10 feet long. You can tie a knot in it as a Utilize action."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-138-tent-2-gp",
      "@type": "Rule",
      "name": "Tent (2 GP)",
      "slug": "6-138-tent-2-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.138",
        "heading": "Tent (2 GP)",
        "lineStart": 6856,
        "lineEnd": 6858
      },
      "section": "6.138",
      "rulesText": "A Tent sleeps up to two Small or Medium creatures."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-139-tinderbox-5-sp",
      "@type": "Rule",
      "name": "Tinderbox (5 SP)",
      "slug": "6-139-tinderbox-5-sp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.139",
        "heading": "Tinderbox (5 SP)",
        "lineStart": 6860,
        "lineEnd": 6862
      },
      "section": "6.139",
      "rulesText": "A Tinderbox is a small container holding flint, fire steel, and tinder (usually dry cloth soaked in light oil) used to kindle a fire. Using it to light a Candle, Lamp, Lantern, or Torch - or anything else with exposed fuel - takes a Bonus Action. Lighting any other fire takes 1 minute."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-14-thrown",
      "@type": "Rule",
      "name": "Thrown",
      "slug": "6-14-thrown",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.14",
        "heading": "Thrown",
        "lineStart": 6011,
        "lineEnd": 6013
      },
      "section": "6.14",
      "rulesText": "If a weapon has the Thrown property, you can throw the weapon to make a ranged attack, and you can draw that weapon as part of the attack. If the weapon is a Melee weapon, use the same ability modifier for the attack and damage rolls that you use for a melee attack with that weapon."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-140-torch-1-cp",
      "@type": "Rule",
      "name": "Torch (1 CP)",
      "slug": "6-140-torch-1-cp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.140",
        "heading": "Torch (1 CP)",
        "lineStart": 6864,
        "lineEnd": 6866
      },
      "section": "6.140",
      "rulesText": "A Torch burns for 1 hour, casting Bright Light in a 20-foot radius and Dim Light for an additional 20 feet. When you take the Attack action, you can attack with the Torch, using it as a Simple Melee weapon. On a hit, the target takes 1 Fire damage."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-141-vial-1-gp",
      "@type": "Rule",
      "name": "Vial (1 GP)",
      "slug": "6-141-vial-1-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.141",
        "heading": "Vial (1 GP)",
        "lineStart": 6868,
        "lineEnd": 6870
      },
      "section": "6.141",
      "rulesText": "A Vial holds up to 4 ounces."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-142-waterskin-2-sp",
      "@type": "Rule",
      "name": "Waterskin (2 SP)",
      "slug": "6-142-waterskin-2-sp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.142",
        "heading": "Waterskin (2 SP)",
        "lineStart": 6872,
        "lineEnd": 6874
      },
      "section": "6.142",
      "rulesText": "A Waterskin holds up to 4 pints. If you don't drink sufficient water, you risk dehydration (see “Rules Glossary”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-143-mounts-and-vehicles",
      "@type": "Rule",
      "name": "Mounts and Vehicles",
      "slug": "6-143-mounts-and-vehicles",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.143",
        "heading": "Mounts and Vehicles",
        "lineStart": 6876,
        "lineEnd": 6878
      },
      "section": "6.143",
      "rulesText": "A mount can help you move more quickly through the wilderness, but its primary purpose is to carry gear that would otherwise slow you down. The Mounts and Other Animals table shows each animal's carrying capacity. See “Monsters” for the animals' stat blocks."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-144-mounts-and-cargo",
      "@type": "Rule",
      "name": "Mounts and Cargo",
      "slug": "6-144-mounts-and-cargo",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.144",
        "heading": "Mounts and Cargo",
        "lineStart": 6880,
        "lineEnd": 6882
      },
      "section": "6.144",
      "rulesText": "An animal pulling a carriage, cart, chariot, sled, or wagon can move weight up to five times its base carrying capacity, including the weight of the vehicle. If multiple animals pull the same vehicle, add their carrying capacities together."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-145-barding",
      "@type": "Rule",
      "name": "Barding",
      "slug": "6-145-barding",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.145",
        "heading": "Barding",
        "lineStart": 6884,
        "lineEnd": 6888
      },
      "section": "6.145",
      "rulesText": "Barding is armor designed for a mount. Any type of armor on the Armor table in “Equipment” can\n\nbe purchased as barding. The cost is four times the normal cost, and it weighs twice as much."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-146-saddles",
      "@type": "Rule",
      "name": "Saddles",
      "slug": "6-146-saddles",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.146",
        "heading": "Saddles",
        "lineStart": 6890,
        "lineEnd": 6921
      },
      "section": "6.146",
      "rulesText": "A saddle comes with a bit, a bridle, reins, and any other equipment needed to use the saddle. A Military Saddle gives Advantage on any ability check you make to remain mounted. An Exotic Saddle is required for riding an aquatic or a flying mount.\n\nMounts and Other Animals\n\nTack, Harness, and Drawn Vehicles",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/6-146-mounts-and-other-animals"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/6-146-tack-harness-and-drawn-vehicles"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-147-large-vehicles",
      "@type": "Rule",
      "name": "Large Vehicles",
      "slug": "6-147-large-vehicles",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.147",
        "heading": "Large Vehicles",
        "lineStart": 6923,
        "lineEnd": 6925
      },
      "section": "6.147",
      "rulesText": "The Airborne and Waterborne Vehicles table provides statistics for various types of large vehicles. The following notes apply."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-148-speed",
      "@type": "Rule",
      "name": "Speed",
      "slug": "6-148-speed",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.148",
        "heading": "Speed",
        "lineStart": 6927,
        "lineEnd": 6941
      },
      "section": "6.148",
      "rulesText": "A ship sailing against a strong wind moves at half speed. In a dead calm (no wind), waterborne ships can't move under sail and must be rowed. Keelboats and Rowboats are used on lakes and rivers. If going downstream, add the speed of the current (typically 3 miles per hour) to the speed of the vehicle. These vehicles can't be rowed against any significant current, but they can be pulled upstream by draft animals on the shores. A Rowboat can be carried and weighs 100 pounds.\n\nAirborne and Waterborne Vehicles",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/6-148-airborne-and-waterborne-vehicles"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-149-crew",
      "@type": "Rule",
      "name": "Crew",
      "slug": "6-149-crew",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.149",
        "heading": "Crew",
        "lineStart": 6943,
        "lineEnd": 6945
      },
      "section": "6.149",
      "rulesText": "A ship larger than a Keelboat or Rowboat needs a crew of skilled hirelings (see “Hirelings” later in “Equipment”) to function. The minimum number of skilled hirelings needed to crew a ship depends on the type of ship, as shown in the table."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-15-two-handed",
      "@type": "Rule",
      "name": "Two-Handed",
      "slug": "6-15-two-handed",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.15",
        "heading": "Two-Handed",
        "lineStart": 6015,
        "lineEnd": 6017
      },
      "section": "6.15",
      "rulesText": "A Two-Handed weapon requires two hands when you attack with it."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-150-passengers",
      "@type": "Rule",
      "name": "Passengers",
      "slug": "6-150-passengers",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.150",
        "heading": "Passengers",
        "lineStart": 6947,
        "lineEnd": 6949
      },
      "section": "6.150",
      "rulesText": "The table lists the number of Small and Medium passengers the ship can accommodate using hammocks. A ship outfitted with private accommodations can carry one-fifth as many passengers. A passenger usually pays 5 SP per day for a hammock, but prices can vary from ship to ship. A small private cabin usually costs 2 GP per day."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-151-damage-threshold",
      "@type": "Rule",
      "name": "Damage Threshold",
      "slug": "6-151-damage-threshold",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.151",
        "heading": "Damage Threshold",
        "lineStart": 6951,
        "lineEnd": 6953
      },
      "section": "6.151",
      "rulesText": "If a vehicle has a damage threshold (see “Rules Glossary”), it’s noted in the table."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-152-ship-repair",
      "@type": "Rule",
      "name": "Ship Repair",
      "slug": "6-152-ship-repair",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.152",
        "heading": "Ship Repair",
        "lineStart": 6955,
        "lineEnd": 6957
      },
      "section": "6.152",
      "rulesText": "Repairs to a damaged ship can be made while the vessel is berthed. Repairing 1 Hit Point of damage requires 1 day and costs 20 GP for materials and labor. If the repairs are made in a location where supplies and skilled labor are abundant, such as a city shipyard, the repair time and cost are halved."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-153-lifestyle-expenses",
      "@type": "Rule",
      "name": "Lifestyle Expenses",
      "slug": "6-153-lifestyle-expenses",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.153",
        "heading": "Lifestyle Expenses",
        "lineStart": 6959,
        "lineEnd": 6965
      },
      "section": "6.153",
      "rulesText": "Lifestyle expenses summarize the cost of living in a fantasy world. They cover lodging, food, equipment maintenance, and other necessities.\n\nAt the start of each week or month (GM's choice), choose a lifestyle below - Wretched, Squalid, Poor, Modest, Comfortable, Wealthy, or Aristocratic - and pay the price to sustain that lifestyle.\n\nLifestyles have no inherent consequences, but the GM might take them into account when determining risks or how others perceive your character."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-154-wretched-free",
      "@type": "Rule",
      "name": "Wretched (Free)",
      "slug": "6-154-wretched-free",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.154",
        "heading": "Wretched (Free)",
        "lineStart": 6967,
        "lineEnd": 6969
      },
      "section": "6.154",
      "rulesText": "You survive via chance and charity. You're often exposed to natural dangers as a result of sleeping outside."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-155-squalid-1-sp-per-day",
      "@type": "Rule",
      "name": "Squalid (1 SP per Day)",
      "slug": "6-155-squalid-1-sp-per-day",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.155",
        "heading": "Squalid (1 SP per Day)",
        "lineStart": 6971,
        "lineEnd": 6973
      },
      "section": "6.155",
      "rulesText": "You spend the bare minimum for your necessities. You might be exposed to unhealthy conditions and opportunistic criminals."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-156-poor-2-sp-per-day",
      "@type": "Rule",
      "name": "Poor (2 SP per Day)",
      "slug": "6-156-poor-2-sp-per-day",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.156",
        "heading": "Poor (2 SP per Day)",
        "lineStart": 6975,
        "lineEnd": 6977
      },
      "section": "6.156",
      "rulesText": "You spend frugally for your necessities."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-157-modest-1-gp-per-day",
      "@type": "Rule",
      "name": "Modest (1 GP per Day)",
      "slug": "6-157-modest-1-gp-per-day",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.157",
        "heading": "Modest (1 GP per Day)",
        "lineStart": 6979,
        "lineEnd": 6981
      },
      "section": "6.157",
      "rulesText": "You support yourself at an average level."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-158-comfortable-2-gp-per-day",
      "@type": "Rule",
      "name": "Comfortable (2 GP per Day)",
      "slug": "6-158-comfortable-2-gp-per-day",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.158",
        "heading": "Comfortable (2 GP per Day)",
        "lineStart": 6983,
        "lineEnd": 6985
      },
      "section": "6.158",
      "rulesText": "You spend modestly for your necessities and enjoy a few luxuries."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-159-wealthy-4-gp-per-day",
      "@type": "Rule",
      "name": "Wealthy (4 GP per Day)",
      "slug": "6-159-wealthy-4-gp-per-day",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.159",
        "heading": "Wealthy (4 GP per Day)",
        "lineStart": 6987,
        "lineEnd": 6989
      },
      "section": "6.159",
      "rulesText": "You're accustomed to the finer things in life and might have servants."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-16-versatile",
      "@type": "Rule",
      "name": "Versatile",
      "slug": "6-16-versatile",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.16",
        "heading": "Versatile",
        "lineStart": 6019,
        "lineEnd": 6021
      },
      "section": "6.16",
      "rulesText": "A Versatile weapon can be used with one or two hands. A damage value in parentheses appears with the property. The weapon deals that damage when used with two hands to make a melee attack."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-160-aristocratic-10-gp-per-day",
      "@type": "Rule",
      "name": "Aristocratic (10 GP per Day)",
      "slug": "6-160-aristocratic-10-gp-per-day",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.160",
        "heading": "Aristocratic (10 GP per Day)",
        "lineStart": 6991,
        "lineEnd": 6993
      },
      "section": "6.160",
      "rulesText": "You pay for the best and might have a staff that supports your lifestyle. Others notice your wealth and might encourage you to share it, either legally or otherwise."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-161-food-drink-and-lodging",
      "@type": "Rule",
      "name": "Food, Drink, and Lodging",
      "slug": "6-161-food-drink-and-lodging",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.161",
        "heading": "Food, Drink, and Lodging",
        "lineStart": 6995,
        "lineEnd": 7012
      },
      "section": "6.161",
      "rulesText": "The Food, Drink, and Lodging table gives prices for food and a single night's lodging. Prices for daily lodging and meals are included in your lifestyle's expenses.\n\nFood, Drink, and Lodging",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/6-161-food-drink-and-lodging"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-162-hirelings",
      "@type": "Rule",
      "name": "Hirelings",
      "slug": "6-162-hirelings",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.162",
        "heading": "Hirelings",
        "lineStart": 7014,
        "lineEnd": 7024
      },
      "section": "6.162",
      "rulesText": "Skilled hirelings include anyone hired to perform a service that involves a proficiency (including weapon, tool, or skill): a mercenary, an artisan, a scribe, or the like. The pay shown on the Hirelings table is a minimum; some expert hirelings require more pay. Untrained hirelings are hired for work that requires no particular proficiencies; they include laborers and porters.\n\nHirelings",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/6-162-hirelings"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-163-spellcasting",
      "@type": "Rule",
      "name": "Spellcasting",
      "slug": "6-163-spellcasting",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.163",
        "heading": "Spellcasting",
        "lineStart": 7026,
        "lineEnd": 7042
      },
      "section": "6.163",
      "rulesText": "Most settlements contain individuals who are willing to cast spells in exchange for payment. If a spell has expensive components, add the cost of those components to the cost listed in the Spellcasting Services table. The higher the level of a desired spell, the harder it is to find someone to cast it.\n\nSpellcasting Services\n\n---",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/6-163-spellcasting-services"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-164-magic-items",
      "@type": "Rule",
      "name": "Magic Items",
      "slug": "6-164-magic-items",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.164",
        "heading": "Magic Items",
        "lineStart": 7044,
        "lineEnd": 7046
      },
      "section": "6.164",
      "rulesText": "Adventures hold the promise - but not a guarantee - of finding magic items. Hundreds of magic items are detailed in “Magic Items” later in this document. Here’s what you need to know about using magic items."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-165-identifying-a-magic-item",
      "@type": "Rule",
      "name": "Identifying a Magic Item",
      "slug": "6-165-identifying-a-magic-item",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.165",
        "heading": "Identifying a Magic Item",
        "lineStart": 7048,
        "lineEnd": 7058
      },
      "section": "6.165",
      "rulesText": "Some magic items are indistinguishable from their nonmagical counterparts, while others are conspicuously magical. Handling a magic item is enough to\n\ngive you a sense that it is extraordinary, but learning a magic item's properties isn't automatic.\n\nThe Identify spell is the fastest way to reveal an item's properties. Alternatively, you can focus on one magic item during a Short Rest while being in physical contact with the item. At the end of the rest, you learn its properties and how to use them (but not any curse the item might bear).\n\nSometimes a magic item carries a clue to its properties. The command word to activate a ring might be etched inside the band, or a feathered design might hint that it's a Ring of Feather Falling.\n\nWearing or experimenting with an item can also offer hints about its properties. In the specific case of Potions, a little taste is enough to tell the taster what a potion does. Other items might require more experimentation. For example, if your character puts on a Ring of Swimming, the GM might say, \"Your movement feels strangely fluid.\" Perhaps you then dive into a river to see what happens. The GM would then say you swim unexpectedly well."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-166-attunement",
      "@type": "Rule",
      "name": "Attunement",
      "slug": "6-166-attunement",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.166",
        "heading": "Attunement",
        "lineStart": 7060,
        "lineEnd": 7062
      },
      "section": "6.166",
      "rulesText": "Some magic items require a creature to form a bond - called Attunement - with them before the creature can use an item's magical properties. Without becoming attuned to an item that requires Attunement, you gain only its nonmagical benefits unless its description states otherwise. For example, a magic Shield that requires Attunement provides the benefits of a normal Shield if you aren't attuned to it, but none of its magical properties."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-167-attune-during-a-short-rest",
      "@type": "Rule",
      "name": "Attune during a Short Rest",
      "slug": "6-167-attune-during-a-short-rest",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.167",
        "heading": "Attune during a Short Rest",
        "lineStart": 7064,
        "lineEnd": 7066
      },
      "section": "6.167",
      "rulesText": "Attuning to an item requires you to spend a Short Rest focused on only that item while being in physical contact with it (this can't be the same Short Rest used to learn the item's properties). This focus can take the form of weapon practice (for a Weapon), meditation (for a Wand), or some other appropriate activity. If the Short Rest is interrupted, the Attunement attempt fails. Otherwise, at the end of the Short Rest, you're attuned to the magic item and can access its full magical capabilities."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-168-no-more-than-three-items",
      "@type": "Rule",
      "name": "No More Than Three Items",
      "slug": "6-168-no-more-than-three-items",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.168",
        "heading": "No More Than Three Items",
        "lineStart": 7068,
        "lineEnd": 7070
      },
      "section": "6.168",
      "rulesText": "You can be attuned to no more than three magic items at a time. Any attempt to attune to a fourth item fails; you must end your Attunement to an item first. Additionally, you can't attune to more than one copy of an item. For example, you can't attune to more than one Ring of Protection at a time."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-169-ending-attunement",
      "@type": "Rule",
      "name": "Ending Attunement",
      "slug": "6-169-ending-attunement",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.169",
        "heading": "Ending Attunement",
        "lineStart": 7072,
        "lineEnd": 7076
      },
      "section": "6.169",
      "rulesText": "Your Attunement to an item ends if you no longer satisfy the prerequisites for Attunement, if the item has been more than 100 feet away for at least 24 hours, if you die, or if another creature attunes to\n\nthe item. You can also voluntarily end Attunement by spending another Short Rest focused on the item unless the item is cursed."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-17-mastery-properties",
      "@type": "Rule",
      "name": "Mastery Properties",
      "slug": "6-17-mastery-properties",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.17",
        "heading": "Mastery Properties",
        "lineStart": 6023,
        "lineEnd": 6025
      },
      "section": "6.17",
      "rulesText": "Each weapon has a mastery property, which is usable only by a character who has a feature, such as Weapon Mastery, that unlocks the property for the character. The properties are defined below."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-170-wearing-and-wielding-items",
      "@type": "Rule",
      "name": "Wearing and Wielding Items",
      "slug": "6-170-wearing-and-wielding-items",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.170",
        "heading": "Wearing and Wielding Items",
        "lineStart": 7078,
        "lineEnd": 7082
      },
      "section": "6.170",
      "rulesText": "Using a magic item's properties might mean wearing or wielding it. A magic item meant to be worn must be donned in the intended fashion: boots go on feet, gloves on hands, hats and helmets on a head, and rings on a finger. Magic armor must be donned, a Shield strapped to the arm, a cloak fastened about the shoulders. A weapon must be held.\n\nIn most cases, a magic item that's meant to be worn can fit a creature regardless of size or build. Magic garments are made to be easily adjustable, or they magically adjust themselves to the wearer."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-171-multiple-items-of-the-same-kind",
      "@type": "Rule",
      "name": "Multiple Items of the Same Kind",
      "slug": "6-171-multiple-items-of-the-same-kind",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.171",
        "heading": "Multiple Items of the Same Kind",
        "lineStart": 7084,
        "lineEnd": 7086
      },
      "section": "6.171",
      "rulesText": "You can't wear more than one of certain magic items. You can't normally wear more than one pair of footwear, one pair of gloves or gauntlets, one pair of bracers, one suit of armor, one item of headwear, or one cloak. The GM might make exceptions."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-172-paired-items",
      "@type": "Rule",
      "name": "Paired Items",
      "slug": "6-172-paired-items",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.172",
        "heading": "Paired Items",
        "lineStart": 7088,
        "lineEnd": 7090
      },
      "section": "6.172",
      "rulesText": "Items that come in pairs - such as boots, bracers, gauntlets, and gloves - impart their benefits only if both items of the pair are worn. For example, a character wearing a Boot of Striding and Springing on one foot and a Boot of Elvenkind on the other foot gains no benefit from either."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-173-crafting-nonmagical-items",
      "@type": "Rule",
      "name": "Crafting Nonmagical Items",
      "slug": "6-173-crafting-nonmagical-items",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.173",
        "heading": "Crafting Nonmagical Items",
        "lineStart": 7092,
        "lineEnd": 7094
      },
      "section": "6.173",
      "rulesText": "To craft a nonmagical item, you need tools, raw materials, and time, each of which is detailed below. If you meet the requirements, you make the item, and you can use it or sell it at its normal price."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-174-tools",
      "@type": "Rule",
      "name": "Tools",
      "slug": "6-174-tools",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.174",
        "heading": "Tools",
        "lineStart": 7096,
        "lineEnd": 7100
      },
      "section": "6.174",
      "rulesText": "The “Tools” section of “Equipment” lists which tools are required to make certain items. The GM assigns required tools for items not listed there.\n\nYou must use the required tool to make an item and have proficiency with that tool. Anyone who helps you must also have proficiency with it."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-175-raw-materials",
      "@type": "Rule",
      "name": "Raw Materials",
      "slug": "6-175-raw-materials",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.175",
        "heading": "Raw Materials",
        "lineStart": 7102,
        "lineEnd": 7104
      },
      "section": "6.175",
      "rulesText": "To make an item, you need raw materials worth half its purchase cost (round down). For example, you need 750 GP of raw materials to make Plate Armor, which sells for 1,500 GP. The GM determines whether appropriate raw materials are available."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-176-time",
      "@type": "Rule",
      "name": "Time",
      "slug": "6-176-time",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.176",
        "heading": "Time",
        "lineStart": 7106,
        "lineEnd": 7114
      },
      "section": "6.176",
      "rulesText": "To determine how many days (working 8 hours a day) it takes to make an item, divide its purchase cost in GP by 10 (round a fraction up to a day). For\n\nexample, you need 5 days to make a Heavy Crossbow, which sells for 50 GP.\n\nIf an item requires multiple days, the days needn't be consecutive.\n\nCharacters can combine their efforts to shorten the crafting time. Divide the time needed to create an item by the number of characters working on it. Normally, only one other character can assist you, but the GM might allow more assistants."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-177-brewing-potions-of-healing",
      "@type": "Rule",
      "name": "Brewing Potions of Healing",
      "slug": "6-177-brewing-potions-of-healing",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.177",
        "heading": "Brewing Potions of Healing",
        "lineStart": 7116,
        "lineEnd": 7118
      },
      "section": "6.177",
      "rulesText": "A character who has proficiency with the Herbalism Kit can create a Potion of Healing. Doing so requires using that kit and 25 GP of raw material over the course of 1 day (8 hours of work)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-178-scribing-spell-scrolls",
      "@type": "Rule",
      "name": "Scribing Spell Scrolls",
      "slug": "6-178-scribing-spell-scrolls",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.178",
        "heading": "Scribing Spell Scrolls",
        "lineStart": 7120,
        "lineEnd": 7122
      },
      "section": "6.178",
      "rulesText": "A spellcaster can transfer a spell to a scroll and create a Spell Scroll, using the rules below."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-179-time-and-cost",
      "@type": "Rule",
      "name": "Time and Cost",
      "slug": "6-179-time-and-cost",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.179",
        "heading": "Time and Cost",
        "lineStart": 7124,
        "lineEnd": 7126
      },
      "section": "6.179",
      "rulesText": "Scribing a scroll takes an amount of time and money based on the level of the spell, as shown in the Spell Scroll Costs table. For each day of inscription, you must work for 8 hours. If a scroll requires multiple days, those days needn't be consecutive."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-18-improvised-weapons",
      "@type": "Rule",
      "name": "IMPROVISED WEAPONS",
      "slug": "6-18-improvised-weapons",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.18",
        "heading": "IMPROVISED WEAPONS",
        "lineStart": 6027,
        "lineEnd": 6029
      },
      "section": "6.18",
      "rulesText": "If you use an object - such as a table leg, frying pan, or bottle - as a makeshift weapon, see “Improvised Weapons” in “Rules Glossary.” Also see those rules if you wield a weapon in an unusual way, such as using a Ranged weapon to make a melee attack."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-180-prerequisites-for-the-scribe",
      "@type": "Rule",
      "name": "Prerequisites for the Scribe",
      "slug": "6-180-prerequisites-for-the-scribe",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.180",
        "heading": "Prerequisites for the Scribe",
        "lineStart": 7128,
        "lineEnd": 7130
      },
      "section": "6.180",
      "rulesText": "To scribe a scroll, you must have proficiency in the Arcana skill or with Calligrapher's Supplies and have the spell prepared on each day of the inscription. You must also have at hand any Material components required by the spell; if the spell consumes its Material components, they are consumed only when you complete the scroll. The scroll's spell uses your spell save DC and spell attack bonus."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-181-cantrips",
      "@type": "Rule",
      "name": "Cantrips",
      "slug": "6-181-cantrips",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.181",
        "heading": "Cantrips",
        "lineStart": 7132,
        "lineEnd": 7151
      },
      "section": "6.181",
      "rulesText": "If the scribed spell is a cantrip, the version on the scroll works as if the caster were your level.\n\nSpell Scroll Costs\n\n---",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/6-181-spell-scroll-costs"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-19-cleave",
      "@type": "Rule",
      "name": "Cleave",
      "slug": "6-19-cleave",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.19",
        "heading": "Cleave",
        "lineStart": 6031,
        "lineEnd": 6033
      },
      "section": "6.19",
      "rulesText": "If you hit a creature with a melee attack roll using this weapon, you can make a melee attack roll with the weapon against a second creature within 5 feet of the first that is also within your reach. On a hit, the second creature takes the weapon's damage, but don't add your ability modifier to that damage unless that modifier is negative. You can make this extra attack only once per turn."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-2-coins",
      "@type": "Rule",
      "name": "Coins",
      "slug": "6-2-coins",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.2",
        "heading": "Coins",
        "lineStart": 5941,
        "lineEnd": 5955
      },
      "section": "6.2",
      "rulesText": "Characters often find coins on their adventures and can spend those coins in shops, inns, and other businesses. Coins come in different denominations based on the relative worth of their material. The Coin Values table lists coins and how much they're worth relative to the Gold Piece, which is the game's main coin. For example, 100 Copper Pieces are worth 1 Gold Piece.\n\nA coin weighs about a third of an ounce, so fifty coins weigh a pound.\n\nCoin Values",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/6-2-coin-values"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-20-graze",
      "@type": "Rule",
      "name": "Graze",
      "slug": "6-20-graze",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.20",
        "heading": "Graze",
        "lineStart": 6035,
        "lineEnd": 6037
      },
      "section": "6.20",
      "rulesText": "If your attack roll with this weapon misses a creature, you can deal damage to that creature equal to the ability modifier you used to make the attack roll. This damage is the same type dealt by the weapon, and the damage can be increased only by increasing the ability modifier."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-21-nick",
      "@type": "Rule",
      "name": "Nick",
      "slug": "6-21-nick",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.21",
        "heading": "Nick",
        "lineStart": 6039,
        "lineEnd": 6041
      },
      "section": "6.21",
      "rulesText": "When you make the extra attack of the Light property, you can make it as part of the Attack action instead of as a Bonus Action. You can make this extra attack only once per turn."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-22-push",
      "@type": "Rule",
      "name": "Push",
      "slug": "6-22-push",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.22",
        "heading": "Push",
        "lineStart": 6043,
        "lineEnd": 6045
      },
      "section": "6.22",
      "rulesText": "If you hit a creature with this weapon, you can push the creature up to 10 feet straight away from yourself if it is Large or smaller."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-23-sap",
      "@type": "Rule",
      "name": "Sap",
      "slug": "6-23-sap",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.23",
        "heading": "Sap",
        "lineStart": 6047,
        "lineEnd": 6049
      },
      "section": "6.23",
      "rulesText": "If you hit a creature with this weapon, that creature has Disadvantage on its next attack roll before the start of your next turn."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-24-slow",
      "@type": "Rule",
      "name": "Slow",
      "slug": "6-24-slow",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.24",
        "heading": "Slow",
        "lineStart": 6051,
        "lineEnd": 6053
      },
      "section": "6.24",
      "rulesText": "If you hit a creature with this weapon and deal damage to it, you can reduce its Speed by 10 feet until the start of your next turn. If the creature is hit more than once by weapons that have this property, the Speed reduction doesn't exceed 10 feet."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-25-topple",
      "@type": "Rule",
      "name": "Topple",
      "slug": "6-25-topple",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.25",
        "heading": "Topple",
        "lineStart": 6055,
        "lineEnd": 6057
      },
      "section": "6.25",
      "rulesText": "If you hit a creature with this weapon, you can force the creature to make a Constitution saving throw (DC 8 plus the ability modifier used to make the attack roll and your Proficiency Bonus). On a failed save, the creature has the Prone condition."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-26-vex",
      "@type": "Rule",
      "name": "Vex",
      "slug": "6-26-vex",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.26",
        "heading": "Vex",
        "lineStart": 6059,
        "lineEnd": 6108
      },
      "section": "6.26",
      "rulesText": "If you hit a creature with this weapon and deal damage to the creature, you have Advantage on your next attack roll against that creature before the end of your next turn.\n\nWeapons",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/6-26-weapons"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-27-armor",
      "@type": "Rule",
      "name": "Armor",
      "slug": "6-27-armor",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.27",
        "heading": "Armor",
        "lineStart": 6110,
        "lineEnd": 6120
      },
      "section": "6.27",
      "rulesText": "The Armor table lists the game's main armor. The table includes the cost and weight of armor, as well as the following details:\n\nCategory. Every type of armor falls into a category: Light, Medium, or Heavy. The category determines how long it takes to don or doff the armor (as shown in the table).\n\nArmor Class (AC). The table's Armor Class column tells you what your base AC is when you wear a type of armor. For example, if you wear Leather Armor, your base AC is 11 plus your Dexterity modifier, whereas your AC is 16 in Chain Mail.\n\nStrength. If the table shows a Strength score in the Strength column for an armor type, that armor reduces the wearer's speed by 10 feet unless the wearer has a Strength score equal to or higher than the listed score.\n\nStealth. If the table shows “Disadvantage” in the Stealth column for an armor type, the wearer has Disadvantage on Dexterity (Stealth) checks."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-28-armor-training",
      "@type": "Rule",
      "name": "Armor Training",
      "slug": "6-28-armor-training",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.28",
        "heading": "Armor Training",
        "lineStart": 6122,
        "lineEnd": 6124
      },
      "section": "6.28",
      "rulesText": "Anyone can don armor or hold a Shield, but only those with training can use them effectively, as explained below. A character's class and other features determine the character's armor training. A monster has training with any armor in its stat block."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-29-light-medium-or-heavy-armor",
      "@type": "Rule",
      "name": "Light, Medium, or Heavy Armor",
      "slug": "6-29-light-medium-or-heavy-armor",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.29",
        "heading": "Light, Medium, or Heavy Armor",
        "lineStart": 6126,
        "lineEnd": 6128
      },
      "section": "6.29",
      "rulesText": "If you wear Light, Medium, or Heavy armor and lack training with it, you have Disadvantage on any D20 Test that involves Strength or Dexterity, and you can't cast spells."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-3-weapons",
      "@type": "Rule",
      "name": "Weapons",
      "slug": "6-3-weapons",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.3",
        "heading": "Weapons",
        "lineStart": 5957,
        "lineEnd": 5969
      },
      "section": "6.3",
      "rulesText": "The Weapons table in this section shows the game's main weapons. The table lists the cost and weight of each weapon, as well as the following details:\n\nCategory. Every weapon falls into a category: Simple or Martial. Weapon proficiencies are usually tied to one of these categories. For example, you might have proficiency with Simple weapons.\n\nMelee or Ranged. A weapon is classified as either Melee or Ranged. A Melee weapon is used to attack a target within 5 feet, whereas a Ranged weapon is used to attack at a greater distance.\n\nDamage. The table lists the amount of damage a weapon deals when an attacker hits with it as well as the type of that damage.\n\nProperties. Any properties a weapon has are listed in the Properties column. Each property is defined in the “Properties” section.\n\nMastery. Each weapon has a mastery property, which is defined in the “Mastery Properties” section. To use that property, you must have a feature that lets you use it."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-30-shield",
      "@type": "Rule",
      "name": "Shield",
      "slug": "6-30-shield",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.30",
        "heading": "Shield",
        "lineStart": 6130,
        "lineEnd": 6132
      },
      "section": "6.30",
      "rulesText": "You gain the Armor Class benefit of a Shield only if you have training with it."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-31-one-at-a-time",
      "@type": "Rule",
      "name": "One at a Time",
      "slug": "6-31-one-at-a-time",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.31",
        "heading": "One at a Time",
        "lineStart": 6134,
        "lineEnd": 6158
      },
      "section": "6.31",
      "rulesText": "A creature can wear only one suit of armor at a time and wield only one Shield at a time.\n\nArmor",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/6-31-armor"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-32-tools",
      "@type": "Rule",
      "name": "Tools",
      "slug": "6-32-tools",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.32",
        "heading": "Tools",
        "lineStart": 6160,
        "lineEnd": 6170
      },
      "section": "6.32",
      "rulesText": "A tool helps you make specialized ability checks, craft certain items, or both. A tool's description includes the tool's cost and weight, as well as the following entries:\n\nAbility. This entry lists the ability to use when making an ability check with the tool.\n\nUtilize. This entry lists things you can do with the tool when you take the Utilize action. You can do one of those things each time you take the action. This entry also provides the DC for the action.\n\nCraft. This entry lists what, if anything, you can craft with the tool. For crafting rules, see \"Crafting Nonmagical Items,\" \"Brewing Potions of Healing,\" and \"Scribing Spell Scrolls\" later in \"Equipment.\"\n\nVariants. This entry appears if the tool has variants, which are listed. Each requires a separate proficiency."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-33-tool-proficiency",
      "@type": "Rule",
      "name": "Tool Proficiency",
      "slug": "6-33-tool-proficiency",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.33",
        "heading": "Tool Proficiency",
        "lineStart": 6172,
        "lineEnd": 6176
      },
      "section": "6.33",
      "rulesText": "If you have proficiency with a tool, add your Proficiency Bonus to any ability check you make that uses the tool. If you have proficiency in a skill that's used with that check, you have Advantage on the check too.\n\nYour features might give you proficiency with a tool. A monster has proficiency with any tool in its stat block."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-34-artisans-tools",
      "@type": "Rule",
      "name": "Artisan's Tools",
      "slug": "6-34-artisans-tools",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.34",
        "heading": "Artisan's Tools",
        "lineStart": 6178,
        "lineEnd": 6180
      },
      "section": "6.34",
      "rulesText": "Artisan's Tools are each focused on crafting items and pursuing a trade. Each of these tools requires a separate proficiency."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-35-alchemists-supplies-50-gp",
      "@type": "Rule",
      "name": "Alchemist's Supplies (50 GP)",
      "slug": "6-35-alchemists-supplies-50-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.35",
        "heading": "Alchemist's Supplies (50 GP)",
        "lineStart": 6182,
        "lineEnd": 6188
      },
      "section": "6.35",
      "rulesText": "Ability: Intelligence Weight: 8 lb.\n\nUtilize: Identify a substance (DC 15), or start a fire (DC 15)\n\nCraft: Acid, Alchemist's Fire, Component Pouch, Oil, Paper, Perfume"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-36-brewers-supplies-20-gp",
      "@type": "Rule",
      "name": "Brewer's Supplies (20 GP)",
      "slug": "6-36-brewers-supplies-20-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.36",
        "heading": "Brewer's Supplies (20 GP)",
        "lineStart": 6190,
        "lineEnd": 6196
      },
      "section": "6.36",
      "rulesText": "Ability: Intelligence Weight: 9 lb.\n\nUtilize: Detect poisoned drink (DC 15), or identify alcohol (DC 10)\n\nCraft: Antitoxin"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-37-calligraphers-supplies-10-gp",
      "@type": "Rule",
      "name": "Calligrapher's Supplies (10 GP)",
      "slug": "6-37-calligraphers-supplies-10-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.37",
        "heading": "Calligrapher's Supplies (10 GP)",
        "lineStart": 6198,
        "lineEnd": 6204
      },
      "section": "6.37",
      "rulesText": "Ability: Dexterity Weight: 5 lb.\n\nUtilize: Write text with impressive flourishes that guard against forgery (DC 15)\n\nCraft: Ink, Spell Scroll"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-38-carpenters-tools-8-gp",
      "@type": "Rule",
      "name": "Carpenter's Tools (8 GP)",
      "slug": "6-38-carpenters-tools-8-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.38",
        "heading": "Carpenter's Tools (8 GP)",
        "lineStart": 6206,
        "lineEnd": 6212
      },
      "section": "6.38",
      "rulesText": "Ability: Strength Weight: 6 lb.\n\nUtilize: Seal or pry open a door or container (DC 20)\n\nCraft: Club, Greatclub, Quarterstaff, Barrel, Chest, Ladder, Pole, Portable Ram, Torch"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-39-cartographers-tools-15-gp",
      "@type": "Rule",
      "name": "Cartographer's Tools (15 GP)",
      "slug": "6-39-cartographers-tools-15-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.39",
        "heading": "Cartographer's Tools (15 GP)",
        "lineStart": 6214,
        "lineEnd": 6220
      },
      "section": "6.39",
      "rulesText": "Ability: Wisdom Weight: 6 lb.\n\nUtilize: Draft a map of a small area (DC 15)\n\nCraft: Map"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-4-selling-equipment",
      "@type": "Rule",
      "name": "SELLING EQUIPMENT",
      "slug": "6-4-selling-equipment",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.4",
        "heading": "SELLING EQUIPMENT",
        "lineStart": 5971,
        "lineEnd": 5973
      },
      "section": "6.4",
      "rulesText": "Equipment fetches half its cost when sold. In contrast, trade goods and valuables - like gems and art objects - retain their full value in the marketplace. \"Magic Items\" has prices for magic items."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-40-cobblers-tools-5-gp",
      "@type": "Rule",
      "name": "Cobbler's Tools (5 GP)",
      "slug": "6-40-cobblers-tools-5-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.40",
        "heading": "Cobbler's Tools (5 GP)",
        "lineStart": 6222,
        "lineEnd": 6228
      },
      "section": "6.40",
      "rulesText": "Ability: Dexterity Weight: 5 lb.\n\nUtilize: Modify footwear to give Advantage on the wearer's next Dexterity (Acrobatics) check (DC 10)\n\nCraft: Climber's Kit"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-41-cooks-utensils-1-gp",
      "@type": "Rule",
      "name": "Cook's Utensils (1 GP)",
      "slug": "6-41-cooks-utensils-1-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.41",
        "heading": "Cook's Utensils (1 GP)",
        "lineStart": 6230,
        "lineEnd": 6236
      },
      "section": "6.41",
      "rulesText": "Ability: Wisdom Weight: 8 lb.\n\nUtilize: Improve food's flavor (DC 10), or detect spoiled or poisoned food (DC 15)\n\nCraft: Rations"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-42-glassblowers-tools-30-gp",
      "@type": "Rule",
      "name": "Glassblower's Tools (30 GP)",
      "slug": "6-42-glassblowers-tools-30-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
