      "statSections": [
        {
          "name": "Traits",
          "rulesText": "Blurred Form. Attack rolls against the mephit are made with Disadvantage unless the mephit has the Incapacitated condition.\n\nDeath Burst. The mephit explodes when it dies. Dexterity Saving Throw: DC 10, each creature in a 5-foot Emanation originating from the mephit. Failure: 5 (2d4) Fire damage. Success: Half damage.",
          "sourceLocator": {
            "chapter": "Monsters A-Z",
            "section": "12.164",
            "heading": "Traits",
            "lineStart": 23173,
            "lineEnd": 23177
          }
