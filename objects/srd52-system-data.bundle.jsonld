      },
      "sizeTypeAlignment": "Large Elemental (Genie), Neutral",
      "sizeAndType": "Large Elemental (Genie)",
      "alignment": "Neutral",
      "armorClass": "17",
      "initiative": "+1 (11)",
      "hitPoints": "212 (17d10 + 119)",
