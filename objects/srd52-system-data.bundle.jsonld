      "proficiencyBonus": 2,
      "abilities": {
        "str": {
          "score": 27,
          "modifier": 8,
          "savingThrow": 8
        },
        "dex": {
          "score": 14,
          "modifier": 2,
          "savingThrow": 9
        },
        "con": {
          "score": 25,
          "modifier": 7,
          "savingThrow": 7
        },
        "int": {
          "score": 16,
          "modifier": 3,
          "savingThrow": 3
        },
        "wis": {
          "score": 15,
