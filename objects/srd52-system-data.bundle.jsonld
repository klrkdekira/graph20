      "statSections": [
        {
          "name": "Traits",
          "rulesText": "Demonic Restoration. If the hezrou dies outside the Abyss, its body dissolves into ichor, and it gains a new body instantly, reviving with all its Hit Points somewhere in the Abyss.\n\nMagic Resistance. The hezrou has Advantage on saving throws against spells and other magical effects.\n\nStench. Constitution Saving Throw: DC 16, any creature that starts its turn in a 10-foot Emanation originating from the hezrou. Failure: The target has the Poisoned condition until the start of its next turn.",
          "sourceLocator": {
            "chapter": "Monsters A-Z",
            "section": "12.132",
            "heading": "Traits",
            "lineStart": 22135,
            "lineEnd": 22141
          }
        },
        {
          "name": "Actions",
          "rulesText": "Multiattack. The hezrou makes three Rend attacks.\n\nRend. Melee Attack Roll: +7, reach 5 ft. Hit: 6 (1d4 + 4) Slashing damage plus 9 (2d8) Poison damage.",
          "sourceLocator": {
            "chapter": "Monsters A-Z",
