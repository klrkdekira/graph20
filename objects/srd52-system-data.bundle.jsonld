        "section": "4.9",
        "heading": "Background Descriptions",
        "lineStart": 5451,
        "lineEnd": 5451
      },
      "section": "4.9"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/5-1-feats",
      "@type": "Rule",
      "name": "Feats",
      "slug": "5-1-feats",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Feats",
        "section": "5.1",
        "heading": "Feats",
        "lineStart": 5751,
        "lineEnd": 5751
      },
      "section": "5.1"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/5-12-fighting-style-feats",
      "@type": "Rule",
      "name": "Fighting Style Feats",
      "slug": "5-12-fighting-style-feats",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
