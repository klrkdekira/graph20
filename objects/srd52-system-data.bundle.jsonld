    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-5-weapon-proficiency",
      "@type": "Rule",
      "name": "Weapon Proficiency",
      "slug": "6-5-weapon-proficiency",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.5",
        "heading": "Weapon Proficiency",
        "lineStart": 5975,
        "lineEnd": 5977
      },
      "section": "6.5",
      "rulesText": "Anyone can wield a weapon, but you must have proficiency with it to add your Proficiency Bonus to an attack roll you make with it. A player character's features can provide weapon proficiencies. A monster is proficient with any weapon in its stat block."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-50-weavers-tools-1-gp",
