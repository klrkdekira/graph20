    {
      "@id": "https://cheeleong.dev/graph20/objects/monsters/couatl",
      "@type": "Monster",
      "name": "Couatl",
      "slug": "couatl",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters A-Z",
        "section": "12.67",
        "heading": "Couatl",
        "lineStart": 20057,
        "lineEnd": 20100
      },
      "sizeTypeAlignment": "Medium Celestial, Lawful Good",
      "sizeAndType": "Medium Celestial",
      "alignment": "Lawful Good",
      "armorClass": "19",
      "initiative": "+5 (15)",
      "hitPoints": "60 (8d8 + 24)",
      "speed": "30 ft., Fly 90 ft.",
      "resistances": "Bludgeoning, Piercing, Slashing",
      "immunities": "Psychic, Radiant",
      "senses": "Truesight 120 ft.; Passive Perception 15",
      "languages": "All; telepathy 120 ft.",
      "challenge": "4 (XP 1,100; PB +2)",
      "armorClassValue": 19,
      "hitPointsValue": 60,
      "hitPointsRoll": {
        "expression": "8d8+24",
        "count": 8,
        "sides": 8,
        "modifier": 24
      },
      "challengeRating": "4",
      "experiencePoints": 1100,
      "proficiencyBonus": 2,
      "abilities": {
        "str": {
          "score": 16,
          "modifier": 3,
          "savingThrow": 3
        },
