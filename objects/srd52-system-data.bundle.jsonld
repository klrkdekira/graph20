      "sourceLocator": {
        "chapter": "Monsters A-Z",
        "section": "12.30",
        "heading": "Black Pudding",
        "lineStart": 18867,
        "lineEnd": 18906
      },
      "sizeTypeAlignment": "Large Ooze, Unaligned",
      "sizeAndType": "Large Ooze",
      "alignment": "Unaligned",
      "armorClass": "7",
      "initiative": "-3 (7)",
      "hitPoints": "68 (8d10 + 24)",
      "speed": "20 ft., Climb 20 ft.",
      "immunities": "Acid, Cold, Lightning, Slashing; Charmed, Deafened, Exhaustion, Frightened, Grappled, Prone, Restrained",
      "senses": "Blindsight 60 ft.; Passive Perception 8",
      "languages": "None",
      "challenge": "4 (XP 1,100; PB +2)",
      "armorClassValue": 7,
      "hitPointsValue": 68,
      "hitPointsRoll": {
        "expression": "8d10+24",
        "count": 8,
        "sides": 10,
        "modifier": 24
      },
      "challengeRating": "4",
