      "abilityScores": "Strength, Dexterity, Constitution",
      "feat": "Savage Attacker (see “Feats”)",
      "skillProficiencies": "Athletics and Intimidation",
      "toolProficiency": "Choose one kind of Gaming Set (see \"Equipment\")",
      "startingEquipment": "Choose A or B: (A) Spear, Shortbow, 20 Arrows, Gaming Set (same as above), Healer's Kit, Quiver, Traveler's Clothes, 14 GP; or (B) 50 GP",
