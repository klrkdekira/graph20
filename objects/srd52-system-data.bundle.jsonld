      "challenge": "2 (XP 450; PB +2)",
      "armorClassValue": 6,
      "hitPointsValue": 63,
      "hitPointsRoll": {
        "expression": "6d10+30",
        "count": 6,
        "sides": 10,
        "modifier": 30
      },
      "challengeRating": "2",
      "experiencePoints": 450,
      "proficiencyBonus": 2,
      "abilities": {
        "str": {
          "score": 14,
          "modifier": 2,
