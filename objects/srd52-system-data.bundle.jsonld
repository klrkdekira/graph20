      "statSections": [
        {
          "name": "Traits",
          "rulesText": "Incorporeal Movement. The specter can move through other creatures and objects as if they were Difficult Terrain. It takes 5 (1d10) Force damage if it ends its turn inside an object.\n\nSunlight Sensitivity. While in sunlight, the specter has Disadvantage on ability checks and attack rolls.",
          "sourceLocator": {
