            "lineEnd": 26123
          }
        },
        {
          "name": "Bonus Actions",
          "rulesText": "Shape-Shift. The werebear shape-shifts into a Large bear-humanoid hybrid form or a Large bear, or it returns to its true humanoid form. Its game statistics, other than its size, are the same in each form. Any equipment it is wearing or carrying isn't transformed.",
          "sourceLocator": {
            "chapter": "Monsters A-Z",
            "section": "12.254",
            "heading": "Bonus Actions",
            "lineStart": 26125,
            "lineEnd": 26127
          }
        }
      ],
