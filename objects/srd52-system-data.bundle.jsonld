    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/equipment/antitoxin",
      "@type": "Equipment",
      "name": "Antitoxin",
      "slug": "antitoxin",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.64",
        "heading": "Adventuring Gear",
        "lineStart": 6418,
        "lineEnd": 6460
      },
