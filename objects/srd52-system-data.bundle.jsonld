        "Sorcerer",
        "Wizard"
      ],
      "castingTime": "Action",
      "range": "Self",
      "components": "V",
      "duration": "Concentration, up to 1 minute",
      "rulesText": "Level 2 Illusion (Sorcerer, Wizard)\n\nCasting Time: Action\nRange: Self\nComponents: V\nDuration: Concentration, up to 1 minute\n\nYour body becomes blurred. For the duration, any creature has Disadvantage on attack rolls against you. An attacker is immune to this effect if it perceives you with Blindsight or Truesight.",
      "classes": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/classes/sorcerer"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/classes/wizard"
        }
      ],
      "scalesWithSlotLevel": false,
