            {
              "value": "15"
            }
          ]
        },
        {
          "position": 3,
          "cells": [
            {
              "value": "A portal to the Abyss opens, revealing a nightmarish realm of torment and slaughter."
            },
            {
              "value": "20"
            }
          ]
        }
      ],
