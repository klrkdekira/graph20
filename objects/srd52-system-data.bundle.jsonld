    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-1-playing-the-game",
      "@type": "Rule",
      "name": "Playing the Game",
      "slug": "1-1-playing-the-game",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.1",
        "heading": "Playing the Game",
        "lineStart": 29,
        "lineEnd": 29
      },
      "section": "1.1"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-10-ability-modifier",
      "@type": "Rule",
      "name": "Ability Modifier",
      "slug": "1-10-ability-modifier",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.10",
        "heading": "Ability Modifier",
        "lineStart": 117,
        "lineEnd": 130
      },
      "section": "1.10",
      "rulesText": "An ability check is named for the ability modifier it uses: a Strength check, an Intelligence check, and so on. Different ability checks are called for in different situations, depending on which ability is most relevant. See the Ability Check Examples table for examples of each check's use.\n\nAbility Check Examples",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/1-10-ability-check-examples"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-100-immunity",
      "@type": "Rule",
      "name": "Immunity",
      "slug": "1-100-immunity",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.100",
        "heading": "Immunity",
        "lineStart": 785,
        "lineEnd": 787
      },
      "section": "1.100",
      "rulesText": "Some creatures and objects have Immunity to certain damage types and conditions. Immunity to a damage type means you don't take damage of that type, and Immunity to a condition means you aren't affected by it."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-101-healing",
      "@type": "Rule",
      "name": "Healing",
      "slug": "1-101-healing",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.101",
        "heading": "Healing",
        "lineStart": 789,
        "lineEnd": 791
      },
      "section": "1.101",
      "rulesText": "Hit Points can be restored by magic, such as the Cure Wounds spell or a Potion of Healing, or by a Short or Long Rest (see “Rules Glossary”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-102-knocking-out-a-creature",
      "@type": "Rule",
      "name": "Knocking Out a Creature",
      "slug": "1-102-knocking-out-a-creature",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.102",
        "heading": "Knocking Out a Creature",
        "lineStart": 793,
        "lineEnd": 797
      },
      "section": "1.102",
      "rulesText": "When you would reduce a creature to 0 Hit Points with a melee attack, you can instead reduce the creature to 1 Hit Point and give it the Unconscious condition. It then starts a Short Rest, at the end of which that condition ends on it. The condition ends early if the creature regains any Hit Points or if someone takes an action to administer first aid to it, making a successful DC 10 Wisdom (Medicine) check.\n\nWhen you receive healing, add the restored Hit Points to your current Hit Points. Your Hit Points can't exceed your Hit Point maximum, so any Hit Points regained in excess of the maximum are lost. For example, if you receive 8 Hit Points of healing and have 14 Hit Points and a Hit Point maximum of 20, you regain 6 Hit Points, not 8."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-103-dropping-to-0-hit-points",
      "@type": "Rule",
      "name": "Dropping to 0 Hit Points",
      "slug": "1-103-dropping-to-0-hit-points",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.103",
        "heading": "Dropping to 0 Hit Points",
        "lineStart": 799,
        "lineEnd": 801
      },
      "section": "1.103",
      "rulesText": "When a creature drops to 0 Hit Points, it either dies outright or falls unconscious, as explained below."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-104-instant-death",
      "@type": "Rule",
      "name": "Instant Death",
      "slug": "1-104-instant-death",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.104",
        "heading": "Instant Death",
        "lineStart": 803,
        "lineEnd": 811
      },
      "section": "1.104",
      "rulesText": "Here are the main ways a creature can die instantly.\n\nMonster Death. A monster dies the instant it drops to 0 Hit Points, although a Game Master can ignore this rule for an individual monster and treat it like a character.\n\nHit Point Maximum of 0. A creature dies if its Hit Point maximum reaches 0. Certain effects drain life energy, reducing a creature's Hit Point maximum.\n\nMassive Damage. When damage reduces a character to 0 Hit Points and damage remains, the character dies if the remainder equals or exceeds their Hit Point maximum. For example, if your character has a Hit Point maximum of 12, currently has 6 Hit Points, and takes 18 damage, the character drops to 0 Hit Points, but 12 damage remains. The character then dies, since 12 equals their Hit Point maximum."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-105-character-demise",
      "@type": "Rule",
      "name": "Character Demise",
      "slug": "1-105-character-demise",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.105",
        "heading": "Character Demise",
        "lineStart": 813,
        "lineEnd": 815
      },
      "section": "1.105",
      "rulesText": "If your character dies, others might find a magical way to revive your character, such as with the Raise Dead spell. Or talk with the GM about making a new character to join the group. “Rules Glossary” has more information on being dead."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-106-falling-unconscious",
      "@type": "Rule",
      "name": "Falling Unconscious",
      "slug": "1-106-falling-unconscious",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.106",
        "heading": "Falling Unconscious",
        "lineStart": 817,
        "lineEnd": 819
      },
      "section": "1.106",
      "rulesText": "If you reach 0 Hit Points and don't die instantly, you have the Unconscious condition (see “Rules Glossary”) until you regain any Hit Points, and you now face making Death Saving Throws (see below)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-107-death-saving-throws",
      "@type": "Rule",
      "name": "Death Saving Throws",
      "slug": "1-107-death-saving-throws",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.107",
        "heading": "Death Saving Throws",
        "lineStart": 821,
        "lineEnd": 831
      },
      "section": "1.107",
      "rulesText": "Whenever you start your turn with 0 Hit Points, you must make a Death Saving Throw to determine whether you creep closer to death or hang on to life. Unlike other saving throws, this one isn't tied to an ability score. You're in the hands of fate now.\n\nThree Successes/Failures. Roll 1d20. If the roll is 10 or higher, you succeed. Otherwise, you fail. A success or failure has no effect by itself. On your third success, you become Stable (see “Stabilizing a Character” below). On your third failure, you die.\n\nThe successes and failures don't need to be consecutive; keep track of both until you collect three of a kind. The number of both is reset to zero when you regain any Hit Points or become Stable.\n\nRolling a 1 or 20. When you roll a 1 on the d20 for a Death Saving Throw, you suffer two failures. If you roll a 20 on the d20, you regain 1 Hit Point.\n\nDamage at 0 Hit Points. If you take any damage while you have 0 Hit Points, you suffer a Death Saving Throw failure. If the damage is from a Critical Hit, you suffer two failures instead. If the damage equals or exceeds your Hit Point maximum, you die."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-108-stabilizing-a-character",
      "@type": "Rule",
      "name": "Stabilizing a Character",
      "slug": "1-108-stabilizing-a-character",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.108",
        "heading": "Stabilizing a Character",
        "lineStart": 833,
        "lineEnd": 837
      },
      "section": "1.108",
      "rulesText": "You can take the Help action to try to stabilize a creature with 0 Hit Points, which requires a successful DC 10 Wisdom (Medicine) check.\n\nA Stable creature doesn't make Death Saving Throws even though it has 0 Hit Points, but it still has the Unconscious condition. If the creature takes damage, it stops being Stable and starts making Death Saving Throws again. A Stable creature that isn't healed regains 1 Hit Point after 1d4 hours."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-109-temporary-hit-points",
      "@type": "Rule",
      "name": "Temporary Hit Points",
      "slug": "1-109-temporary-hit-points",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.109",
        "heading": "Temporary Hit Points",
        "lineStart": 839,
        "lineEnd": 841
      },
      "section": "1.109",
      "rulesText": "Some spells and other effects confer Temporary Hit Points, which are a buffer against losing actual Hit Points, as explained below."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-11-proficiency-bonus",
      "@type": "Rule",
      "name": "Proficiency Bonus",
      "slug": "1-11-proficiency-bonus",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.11",
        "heading": "Proficiency Bonus",
        "lineStart": 132,
        "lineEnd": 134
      },
      "section": "1.11",
      "rulesText": "Add your Proficiency Bonus to an ability check when the GM determines that a skill or tool proficiency is relevant to the check and you have that proficiency. For example, if a rule refers to a Strength (Acrobatics or Athletics) check, you can add your Proficiency Bonus to the check if you have proficiency in the Acrobatics or Athletics skill. See “Proficiency” later in “Playing the Game” for more information about skill and tool proficiencies."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-110-lose-temporary-hit-points-first",
      "@type": "Rule",
      "name": "Lose Temporary Hit Points First",
      "slug": "1-110-lose-temporary-hit-points-first",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.110",
        "heading": "Lose Temporary Hit Points First",
        "lineStart": 843,
        "lineEnd": 845
      },
      "section": "1.110",
      "rulesText": "If you have Temporary Hit Points and take damage, those points are lost first, and any leftover damage carries over to your Hit Points. For example, if you have 5 Temporary Hit Points and take 7 damage, you lose those points and then lose 2 Hit Points."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-111-duration",
      "@type": "Rule",
      "name": "Duration",
      "slug": "1-111-duration",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.111",
        "heading": "Duration",
        "lineStart": 847,
        "lineEnd": 849
      },
      "section": "1.111",
      "rulesText": "Temporary Hit Points last until they're depleted or you finish a Long Rest (see \"Rules Glossary\")."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-112-they-dont-stack",
      "@type": "Rule",
      "name": "They Don't Stack",
      "slug": "1-112-they-dont-stack",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.112",
        "heading": "They Don't Stack",
        "lineStart": 851,
        "lineEnd": 853
      },
      "section": "1.112",
      "rulesText": "Temporary Hit Points can't be added together. If you have Temporary Hit Points and receive more of them, you decide whether to keep the ones you have or to gain the new ones. For example, if a spell grants you 12 Temporary Hit Points when you already have 10, you can have 12 or 10, not 22."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-113-theyre-not-hit-points-or-healing",
      "@type": "Rule",
      "name": "They're Not Hit Points or Healing",
      "slug": "1-113-theyre-not-hit-points-or-healing",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.113",
        "heading": "They're Not Hit Points or Healing",
        "lineStart": 855,
        "lineEnd": 861
      },
      "section": "1.113",
      "rulesText": "Temporary Hit Points can't be added to your Hit Points, healing can't restore them, and receiving Temporary Hit Points doesn't count as healing. Because Temporary Hit Points aren't Hit Points, a creature can be at full Hit Points and receive Temporary Hit Points.\n\nIf you have 0 Hit Points, receiving Temporary Hit Points doesn't restore you to consciousness. Only true healing can save you.\n\n---"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-12-difficulty-class",
      "@type": "Rule",
      "name": "Difficulty Class",
      "slug": "1-12-difficulty-class",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.12",
        "heading": "Difficulty Class",
        "lineStart": 136,
        "lineEnd": 147
      },
      "section": "1.12",
      "rulesText": "The Difficulty Class of an ability check represents the task's difficulty. The more difficult the task, the higher its DC. The rules provide DCs for certain checks, but the GM ultimately sets them. The Typical Difficulty Classes table presents a range of possible DCs for ability checks.\n\nTypical Difficulty Classes",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/1-12-typical-difficulty-classes"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-13-saving-throws",
      "@type": "Rule",
      "name": "Saving Throws",
      "slug": "1-13-saving-throws",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.13",
        "heading": "Saving Throws",
        "lineStart": 149,
        "lineEnd": 153
      },
      "section": "1.13",
      "rulesText": "A saving throw - also called a save - represents an attempt to evade or resist a threat, such as a fiery explosion, a blast of poisonous gas, or a spell trying to invade your mind. You don’t normally choose to make a save; you must make one because your character or a monster (if you’re the GM) is at risk. A save’s result is detailed in the effect that caused it.\n\nIf you don't want to resist the effect, you can choose to fail the save without rolling."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-14-ability-modifier",
      "@type": "Rule",
      "name": "Ability Modifier",
      "slug": "1-14-ability-modifier",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.14",
        "heading": "Ability Modifier",
        "lineStart": 155,
        "lineEnd": 168
      },
      "section": "1.14",
      "rulesText": "Saving throws are named for the ability modifiers they use: a Constitution saving throw, a Wisdom saving throw, and so on. Different saving throws are used to resist different kinds of effects, as shown on the Saving Throw Examples table.\n\nSaving Throw Examples",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/1-14-saving-throw-examples"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-15-proficiency-bonus",
      "@type": "Rule",
      "name": "Proficiency Bonus",
      "slug": "1-15-proficiency-bonus",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.15",
        "heading": "Proficiency Bonus",
        "lineStart": 170,
        "lineEnd": 172
      },
      "section": "1.15",
      "rulesText": "You add your Proficiency Bonus to your saving throw if you have proficiency in that kind of save. See “Proficiency” later in “Playing the Game.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-16-difficulty-class",
      "@type": "Rule",
      "name": "Difficulty Class",
      "slug": "1-16-difficulty-class",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.16",
        "heading": "Difficulty Class",
        "lineStart": 174,
        "lineEnd": 176
      },
      "section": "1.16",
      "rulesText": "The Difficulty Class for a saving throw is determined by the effect that causes it or by the GM. For example, if a spell forces you to make a save, the DC is determined by the caster's spellcasting ability and Proficiency Bonus. Monster abilities that call for saves specify the DC."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-17-attack-rolls",
      "@type": "Rule",
      "name": "Attack Rolls",
      "slug": "1-17-attack-rolls",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.17",
        "heading": "Attack Rolls",
        "lineStart": 178,
        "lineEnd": 180
      },
      "section": "1.17",
      "rulesText": "An attack roll determines whether an attack hits a target. An attack roll hits if the roll equals or exceeds the target's Armor Class. Attack rolls usually occur in battle, described in “Combat” later in “Playing the Game,” but the GM might also ask for an attack roll in other situations, such as an archery competition."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-18-ability-modifier",
      "@type": "Rule",
      "name": "Ability Modifier",
      "slug": "1-18-ability-modifier",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.18",
        "heading": "Ability Modifier",
        "lineStart": 182,
        "lineEnd": 194
      },
      "section": "1.18",
      "rulesText": "The Attack Roll Abilities table shows which ability modifier to use for different types of attack rolls.\n\nAttack Roll Abilities\n\nSome features let you use different ability modifiers from those listed. For example, the Finesse property (see “Equipment”) lets you use Strength or Dexterity with a weapon that has that property.",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/1-18-attack-roll-abilities"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-19-proficiency-bonus",
      "@type": "Rule",
      "name": "Proficiency Bonus",
      "slug": "1-19-proficiency-bonus",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.19",
        "heading": "Proficiency Bonus",
        "lineStart": 196,
        "lineEnd": 198
      },
      "section": "1.19",
      "rulesText": "You add your Proficiency Bonus to your attack roll when you attack using a weapon you have proficiency with, as well as when you attack with a spell. See “Proficiency” later in “Playing the Game” for more information about weapon proficiencies."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-2-rhythm-of-play",
      "@type": "Rule",
      "name": "Rhythm of Play",
      "slug": "1-2-rhythm-of-play",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.2",
        "heading": "Rhythm of Play",
        "lineStart": 31,
        "lineEnd": 41
      },
      "section": "1.2",
      "rulesText": "The three main pillars of D&D play are social interaction, exploration, and combat. Whichever one you're experiencing, the game unfolds according to this basic pattern:\n\n1: The Game Master Describes a Scene. The GM tells the players where their adventurers are and what's around them (how many doors lead out of a room, what's on a table, and so on).\n\n2: The Players Describe What Their Characters Do. Typically, the characters stick together as they travel through a dungeon or another environment. Sometimes different adventurers do different things: one adventurer might search a treasure chest while a second examines a mysterious symbol engraved on a wall and a third keeps watch for monsters. Outside combat, the GM ensures that every character has a chance to act and decides how to resolve their activity. In combat, the characters take turns.\n\n3: The GM Narrates the Results of the Adventurers' Actions. Sometimes resolving a task is easy. If an adventurer walks across a room and tries to open a door, the GM might say the door opens and describe what lies beyond. But the door might be locked, the floor might hide a trap, or some other circumstance might make it challenging for an adventurer to complete a task. In those cases, the GM might ask the player to roll a die to help determine what happens. Describing the results often leads to another decision point, which brings the game back to step 1.\n\nThis pattern holds during every game session (each time you sit down to play D&D), whether the adventurers are talking to a noble, exploring a ruin, or fighting a dragon. In certain situations - particularly combat - the action is more structured, and everyone takes turns."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-20-armor-class",
      "@type": "Rule",
      "name": "Armor Class",
      "slug": "1-20-armor-class",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.20",
        "heading": "Armor Class",
        "lineStart": 200,
        "lineEnd": 210
      },
      "section": "1.20",
      "rulesText": "A creature's Armor Class represents how well the creature avoids being wounded in combat. The AC of a character is determined at character creation (see “Character Creation”), whereas the AC of a monster appears in its stat block.\n\nCalculating AC. All creatures start with the same base AC calculation:\n\nBase AC = 10 + the creature's Dexterity modifier\n\nA creature's AC can then be modified by armor, magic items, spells, and more.\n\nOnly One Base AC. Some spells and class features give characters a different way to calculate their AC. A character with multiple features that give different ways to calculate AC must choose which one to use; only one base calculation can be in effect for a creature."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-21-rolling-20-or-1",
      "@type": "Rule",
      "name": "Rolling 20 or 1",
      "slug": "1-21-rolling-20-or-1",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.21",
        "heading": "Rolling 20 or 1",
        "lineStart": 212,
        "lineEnd": 216
      },
      "section": "1.21",
      "rulesText": "If you roll a 20 on the d20 (called a “natural 20”) for an attack roll, the attack hits regardless of any modifiers or the target’s AC. This is called a Critical Hit (see “Combat” later in “Playing the Game”).\n\nIf you roll a 1 on the d20 (a “natural 1”) for an attack roll, the attack misses regardless of any modifiers or the target’s AC."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-22-advantage-disadvantage",
      "@type": "Rule",
      "name": "Advantage/Disadvantage",
      "slug": "1-22-advantage-disadvantage",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.22",
        "heading": "Advantage/Disadvantage",
        "lineStart": 218,
        "lineEnd": 222
      },
      "section": "1.22",
      "rulesText": "Sometimes a D20 Test is modified by Advantage or Disadvantage. Advantage reflects the positive circumstances surrounding a d20 roll, while Disadvantage reflects negative circumstances.\n\nYou usually acquire Advantage or Disadvantage through the use of special abilities and actions. The GM can also decide that circumstances grant Advantage or impose Disadvantage."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-23-heroic-inspiration",
      "@type": "Rule",
      "name": "Heroic Inspiration",
      "slug": "1-23-heroic-inspiration",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.23",
        "heading": "Heroic Inspiration",
        "lineStart": 224,
        "lineEnd": 232
      },
      "section": "1.23",
      "rulesText": "Sometimes the GM or a rule gives you Heroic Inspiration. If you have Heroic Inspiration, you can expend it to reroll any die immediately after rolling it, and you must use the new roll.\n\nOnly One at a Time. You can never have more than one instance of Heroic Inspiration. If something gives you Heroic Inspiration and you already have it, you can give it to a player character in your group who lacks it.\n\nGaining Heroic Inspiration. Your GM can give you Heroic Inspiration for a variety of reasons. Typically, GMs award it when you do something particularly heroic, in character, or entertaining. It's a reward for making the game more fun for everyone playing.\n\nOther rules might allow your character to gain Heroic Inspiration independent of the GM's decision. For example, Human characters start each day with Heroic Inspiration."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-24-roll-two-d20s",
      "@type": "Rule",
      "name": "Roll Two D20s",
      "slug": "1-24-roll-two-d20s",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.24",
        "heading": "Roll Two D20s",
        "lineStart": 234,
        "lineEnd": 236
      },
      "section": "1.24",
      "rulesText": "When a roll has either Advantage or Disadvantage, roll a second d20 when you make the roll. Use the higher of the two rolls if you have Advantage, and use the lower roll if you have Disadvantage. For example, if you have Disadvantage and roll an 18 and a 3, use the 3. If you instead have Advantage and roll those numbers, use the 18."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-25-they-dont-stack",
      "@type": "Rule",
      "name": "They Don't Stack",
      "slug": "1-25-they-dont-stack",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.25",
        "heading": "They Don't Stack",
        "lineStart": 238,
        "lineEnd": 242
      },
      "section": "1.25",
      "rulesText": "If multiple situations affect a roll and they all grant Advantage on it, you still roll only two d20s. Similarly, if multiple situations impose Disadvantage on a roll, you roll only two d20s.\n\nIf circumstances cause a roll to have both Advantage and Disadvantage, the roll has neither of them, and you roll one d20. This is true even if multiple circumstances impose Disadvantage and only one grants Advantage or vice versa. In such a situation, you have neither Advantage nor Disadvantage."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-26-interactions-with-rerolls",
      "@type": "Rule",
      "name": "Interactions with Rerolls",
      "slug": "1-26-interactions-with-rerolls",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.26",
        "heading": "Interactions with Rerolls",
        "lineStart": 244,
        "lineEnd": 248
      },
      "section": "1.26",
      "rulesText": "When you have Advantage or Disadvantage and something in the game lets you reroll or replace the d20, you can reroll or replace only one die, not both. You choose which one.\n\nFor example, if you have Heroic Inspiration (see the sidebar below) and roll a 3 and an 18 on an ability check that has Advantage or Disadvantage, you could expend your Heroic Inspiration to reroll one of those dice, not both of them."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-27-proficiency",
      "@type": "Rule",
      "name": "Proficiency",
      "slug": "1-27-proficiency",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.27",
        "heading": "Proficiency",
        "lineStart": 250,
        "lineEnd": 263
      },
      "section": "1.27",
      "rulesText": "Characters and monsters are good at various things. Some are skilled with many weapons, while others can use only a few. Some are better at understanding people's motives, and others are better at unlocking the secrets of the multiverse. All creatures have a Proficiency Bonus, which reflects the impact that training has on the creature's capabilities. A character's Proficiency Bonus increases as the character gains levels (described in “Character Creation”). A monster's Proficiency Bonus is based on its Challenge Rating (see “Rules Glossary”). The Proficiency Bonus table shows how the bonus is determined.\n\nThis bonus is applied to a D20 Test when the creature has proficiency in a skill, in a saving throw, or with an item that the creature uses to make the D20 Test. The bonus is also used for spell attacks and for calculating the DC of saving throws for spells.\n\nProficiency Bonus",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/1-27-proficiency-bonus"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-28-the-bonus-doesnt-stack",
      "@type": "Rule",
      "name": "The Bonus Doesn't Stack",
      "slug": "1-28-the-bonus-doesnt-stack",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.28",
        "heading": "The Bonus Doesn't Stack",
        "lineStart": 265,
        "lineEnd": 269
      },
      "section": "1.28",
      "rulesText": "Your Proficiency Bonus can't be added to a die roll or another number more than once. For example, if a rule allows you to make a Charisma (Deception or Persuasion) check, you add your Proficiency Bonus if you're proficient in either skill, but you don't add it twice if you're proficient in both skills.\n\nOccasionally, a Proficiency Bonus might be multiplied or divided (doubled or halved, for example) before being added. For example, the Expertise feature (see “Rules Glossary”) doubles the Proficiency Bonus for certain ability checks. Whenever the bonus is used, it can be multiplied only once and divided only once."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-29-skill-proficiencies",
      "@type": "Rule",
      "name": "Skill Proficiencies",
      "slug": "1-29-skill-proficiencies",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.29",
        "heading": "Skill Proficiencies",
        "lineStart": 271,
        "lineEnd": 300
      },
      "section": "1.29",
      "rulesText": "Most ability checks involve using a skill, which represents a category of things creatures try to do with an ability check. The descriptions of the actions you take (see “Actions” later in “Playing the Game”) specify which skill applies if you make an ability check for that action, and many other rules note when a skill is relevant. The GM has the ultimate say on whether a skill is relevant in a situation.\n\nIf a creature is proficient in a skill, the creature applies its Proficiency Bonus to ability checks involving that skill. Without proficiency in a skill, a creature can still make ability checks involving\n\nSkills\n\nthat skill but doesn't add its Proficiency Bonus. For example, if a character tries to climb a cliff, the GM might ask for a Strength (Athletics) check. If the character has Athletics proficiency, the character adds their Proficiency Bonus to the Strength check. If the character lacks that proficiency, they make the check without adding their Proficiency Bonus.",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/1-29-skills"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-3-exceptions-supersede-general-rules",
      "@type": "Rule",
      "name": "Exceptions Supersede General Rules",
      "slug": "1-3-exceptions-supersede-general-rules",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.3",
        "heading": "Exceptions Supersede General Rules",
        "lineStart": 43,
        "lineEnd": 47
      },
      "section": "1.3",
      "rulesText": "General rules govern each part of the game. For example, the combat rules tell you that melee attacks use Strength and ranged attacks use Dexterity. That's a general rule, and a general rule is in effect as long as something in the game doesn't explicitly say otherwise.\n\nThe game also includes elements - class features, feats, weapon properties, spells, magic items, monster abilities, and the like - that sometimes contradict a general rule. When an exception and a general rule disagree, the exception wins. For example, if a feature says you can make melee attacks using your Charisma, you can do so, even though that statement disagrees with the general rule."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-30-skill-list",
      "@type": "Rule",
      "name": "Skill List",
      "slug": "1-30-skill-list",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.30",
        "heading": "Skill List",
        "lineStart": 302,
        "lineEnd": 304
      },
      "section": "1.30",
      "rulesText": "The skills are shown on the Skills table, which notes example uses for each skill proficiency as well as the ability check the skill most often applies to."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-31-determining-skills",
      "@type": "Rule",
      "name": "Determining Skills",
      "slug": "1-31-determining-skills",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.31",
        "heading": "Determining Skills",
        "lineStart": 306,
        "lineEnd": 308
      },
      "section": "1.31",
      "rulesText": "A character's starting skill proficiencies are determined at character creation, and a monster's skill proficiencies appear in its stat block."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-32-saving-throw-proficiencies",
      "@type": "Rule",
      "name": "Saving Throw Proficiencies",
      "slug": "1-32-saving-throw-proficiencies",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.32",
        "heading": "Saving Throw Proficiencies",
        "lineStart": 310,
        "lineEnd": 314
      },
      "section": "1.32",
      "rulesText": "Proficiency in a saving throw lets a character add their Proficiency Bonus to saves that use a particular ability. For example, proficiency in Wisdom saves lets you add your Proficiency Bonus to your Wisdom saves. Some monsters also have saving throw proficiencies, as noted in their stat blocks.\n\nEach class gives proficiency in at least two saving throws, representing that class's training in evading or resisting certain threats. Wizards, for example, are proficient in Intelligence and Wisdom saves; they train to resist mental assault."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-33-equipment-proficiencies",
      "@type": "Rule",
      "name": "Equipment Proficiencies",
      "slug": "1-33-equipment-proficiencies",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.33",
        "heading": "Equipment Proficiencies",
        "lineStart": 316,
        "lineEnd": 322
      },
      "section": "1.33",
      "rulesText": "A character gains proficiency with various weapons and tools from their class and background. There are two categories of equipment proficiency:\n\nWeapons. Anyone can wield a weapon, but proficiency makes you better at wielding it. If you have proficiency with a weapon, you add your Proficiency Bonus to attack rolls you make with it.\n\nTools. If you have proficiency with a tool, you can add your Proficiency Bonus to any ability check you make that uses the tool. If you have proficiency in the skill that's also used with that check, you have Advantage on the check too. This means you can benefit from both skill proficiency and tool proficiency on the same ability check."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-34-actions",
      "@type": "Rule",
      "name": "Actions",
      "slug": "1-34-actions",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.34",
        "heading": "Actions",
        "lineStart": 324,
        "lineEnd": 345
      },
      "section": "1.34",
      "rulesText": "When you do something other than moving or communicating, you typically take an action. The Action table lists the game's main actions, which are defined in more detail in “Rules Glossary.”\n\nActions\n\nPlayer characters and monsters can also do things not covered by these actions. Many class features and other abilities provide additional action options, and you can improvise other actions. When you describe an action not detailed elsewhere in the rules, the Game Master tells you whether that action is possible and what kind of D20 Test you need to make, if any.",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/1-34-actions"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-35-one-thing-at-a-time",
      "@type": "Rule",
      "name": "One Thing at a Time",
      "slug": "1-35-one-thing-at-a-time",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.35",
        "heading": "One Thing at a Time",
        "lineStart": 347,
        "lineEnd": 351
      },
      "section": "1.35",
      "rulesText": "The game uses actions to govern how much you can do at one time. You can take only one action at a time. This principle is most important in combat, as explained in “Combat” later in “Playing the Game.”\n\nActions can come up in other situations, too: in a social interaction, you can try to Influence a creature or use the Search action to read the creature's body language, but you can't do both at the same time. And when you're exploring a dungeon, you can't simultaneously use the Search action to look for traps and use the Help action to aid another character who's trying to open a stuck door (with the Utilize action)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-36-bonus-actions",
      "@type": "Rule",
      "name": "Bonus Actions",
      "slug": "1-36-bonus-actions",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.36",
        "heading": "Bonus Actions",
        "lineStart": 353,
        "lineEnd": 361
      },
      "section": "1.36",
      "rulesText": "Various class features, spells, and other abilities let you take an additional action on your turn called a Bonus Action. The Cunning Action feature, for\n\nexample, allows a Rogue to take a Bonus Action. You can take a Bonus Action only when a special ability, a spell, or another feature of the game states that you can do something as a Bonus Action. You otherwise don't have a Bonus Action to take.\n\nYou can take only one Bonus Action on your turn, so you must choose which Bonus Action to use if you have more than one available.\n\nYou choose when to take a Bonus Action during your turn unless the Bonus Action's timing is specified. Anything that deprives you of your ability to take actions also prevents you from taking a Bonus Action."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-37-reactions",
      "@type": "Rule",
      "name": "Reactions",
      "slug": "1-37-reactions",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.37",
        "heading": "Reactions",
        "lineStart": 363,
        "lineEnd": 369
      },
      "section": "1.37",
      "rulesText": "Certain special abilities, spells, and situations allow you to take a special action called a Reaction. A Reaction is an instant response to a trigger of some kind, which can occur on your turn or on someone else's. The Opportunity Attack, described later in \"Playing the Game,\" is the most common type of Reaction.\n\nWhen you take a Reaction, you can't take another one until the start of your next turn. If the reaction interrupts another creature's turn, that creature can continue its turn right after the Reaction.\n\nIn terms of timing, a Reaction takes place immediately after its trigger unless the Reaction's description says otherwise."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-38-social-interaction",
      "@type": "Rule",
      "name": "Social Interaction",
      "slug": "1-38-social-interaction",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.38",
        "heading": "Social Interaction",
        "lineStart": 371,
        "lineEnd": 377
      },
      "section": "1.38",
      "rulesText": "During their adventures, player characters meet many different people and face some monsters that would rather talk than fight. In those situations, it's time for social interaction, which takes many forms. For example, you might try to convince a burglar to confess to wrongdoing or try to flatter a guard. The Game Master assumes the roles of any nonplayer characters who are participating.\n\nAn NPC's attitude toward your character is Friendly, Indifferent, or Hostile, as defined in “Rules Glossary.” Friendly NPCs are predisposed to help, and Hostile ones are inclined to hinder.\n\nSocial interactions progress in two ways: through roleplaying and ability checks."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-39-roleplaying",
      "@type": "Rule",
      "name": "Roleplaying",
      "slug": "1-39-roleplaying",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.39",
        "heading": "Roleplaying",
        "lineStart": 379,
        "lineEnd": 391
      },
      "section": "1.39",
      "rulesText": "Roleplaying is, literally, the act of playing out a role. In this case, it's you as a player determining how your character thinks, acts, and talks. Roleplaying is part of every aspect of the game, and it comes to the fore during social interactions.\n\nAs you roleplay, consider whether you prefer an active approach or a descriptive approach.\n\nThe GM uses an NPC's personality and your character's actions and attitudes to determine how an\n\nNPC reacts. A cowardly bandit might buckle under threats of imprisonment. A stubborn merchant refuses to help if the characters badger her. A vain dragon laps up flattery.\n\nWhen interacting with an NPC, pay attention to the GM's portrayal of the NPC's personality. You might be able to learn an NPC's goals and then use that information to influence the NPC.\n\nIf you offer NPCs something they want or play on their sympathies, fears, or goals, you can form friendships, ward off violence, or learn a key piece of information. On the other hand, if you insult a proud warrior or speak ill of a noble's allies, your efforts to convince or deceive will likely fail."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-4-the-six-abilities",
      "@type": "Rule",
      "name": "The Six Abilities",
      "slug": "1-4-the-six-abilities",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.4",
        "heading": "The Six Abilities",
        "lineStart": 49,
        "lineEnd": 62
      },
      "section": "1.4",
      "rulesText": "All creatures - characters and monsters - have six abilities that measure physical and mental characteristics, as shown on the Ability Descriptions table.\n\nAbility Descriptions",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/1-4-ability-descriptions"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-40-ability-checks",
      "@type": "Rule",
      "name": "Ability Checks",
      "slug": "1-40-ability-checks",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.40",
        "heading": "Ability Checks",
        "lineStart": 393,
        "lineEnd": 397
      },
      "section": "1.40",
      "rulesText": "Ability checks can be key in determining the outcome of a social interaction. Your roleplaying efforts can alter an NPC's attitude, but there might still be an element of chance if the GM wants dice to play a role in determining an NPC's response to you. In such situations, the GM will typically ask you to take the Influence action.\n\nPay attention to your skill proficiencies when thinking of how you will interact with an NPC; use an approach that relies on your group's skill proficiencies. For example, if the group needs to trick a guard into letting them into a castle, the Rogue who is proficient in Deception should lead the discussion."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-41-exploration",
      "@type": "Rule",
      "name": "Exploration",
      "slug": "1-41-exploration",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.41",
        "heading": "Exploration",
        "lineStart": 399,
        "lineEnd": 401
      },
      "section": "1.41",
      "rulesText": "Exploration involves delving into places that are dangerous and full of mystery. The rules in this section detail some of the ways adventurers interact with the environment in such places."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-42-adventuring-equipment",
      "@type": "Rule",
      "name": "Adventuring Equipment",
      "slug": "1-42-adventuring-equipment",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.42",
        "heading": "Adventuring Equipment",
        "lineStart": 403,
        "lineEnd": 407
      },
      "section": "1.42",
      "rulesText": "As adventurers explore, their equipment can help them in many ways. For example, they can reach out-of-the-way places with a Ladder, perceive things they wouldn't otherwise notice with a Torch or another light source, bypass locked doors and containers with Thieves' Tools, and create obstacles for pursuers with Caltrops.\n\nSee “Equipment” for rules on many items that are useful on adventures. The items in the “Tools” and “Adventuring Gear” sections are especially useful. The weapons in “Equipment” can also be used for more than battle; you could use a Quarterstaff, for example, to push a sinister-looking button that you’re reluctant to touch."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-43-vision-and-light",
      "@type": "Rule",
      "name": "Vision and Light",
      "slug": "1-43-vision-and-light",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.43",
        "heading": "Vision and Light",
        "lineStart": 409,
        "lineEnd": 411
      },
      "section": "1.43",
      "rulesText": "Some adventuring tasks - such as noticing danger, hitting an enemy, and targeting certain spells - are affected by sight, so effects that obscure vision can hinder you, as explained below."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-44-obscured-areas",
      "@type": "Rule",
      "name": "Obscured Areas",
      "slug": "1-44-obscured-areas",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.44",
        "heading": "Obscured Areas",
        "lineStart": 413,
        "lineEnd": 417
      },
      "section": "1.44",
      "rulesText": "An area might be Lightly or Heavily Obscured. In a Lightly Obscured area - such as an area with Dim Light, patchy fog, or moderate foliage - you have Disadvantage on Wisdom (Perception) checks that rely on sight.\n\nA Heavily Obscured area - such as an area with Darkness, heavy fog, or dense foliage - is opaque. You have the Blinded condition (see “Rules Glossary”) when trying to see something there."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-45-light",
      "@type": "Rule",
      "name": "Light",
      "slug": "1-45-light",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.45",
        "heading": "Light",
        "lineStart": 419,
        "lineEnd": 427
      },
      "section": "1.45",
      "rulesText": "The presence or absence of light determines the category of illumination in an area, as defined below.\n\nBright Light. Bright Light lets most creatures see normally. Even gloomy days provide Bright Light, as do torches, lanterns, fires, and other sources of illumination within a specific radius.\n\nDim Light. Dim Light, also called shadows, creates a Lightly Obscured area. An area of Dim Light is usually a boundary between Bright Light and surrounding Darkness. The soft light of twilight and dawn also counts as Dim Light. A full moon might bathe the land in Dim Light.\n\nDarkness. Darkness creates a Heavily Obscured area. Characters face Darkness outdoors at night (even most moonlit nights), within the confines of an unlit dungeon, or in an area of magical Darkness."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-46-special-senses",
      "@type": "Rule",
      "name": "Special Senses",
      "slug": "1-46-special-senses",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.46",
        "heading": "Special Senses",
        "lineStart": 429,
        "lineEnd": 439
      },
      "section": "1.46",
      "rulesText": "Some creatures have special senses that help them perceive things in certain situations. “Rules Glossary” defines the following special senses:\n\nBlindsight\n\nDarkvision\n\nTremorsense\n\nTruesight"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-47-hiding",
      "@type": "Rule",
      "name": "Hiding",
      "slug": "1-47-hiding",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.47",
        "heading": "Hiding",
        "lineStart": 441,
        "lineEnd": 443
      },
      "section": "1.47",
      "rulesText": "Adventurers and monsters often hide, whether to spy on one another, sneak past a guardian, or set an ambush. The Game Master decides when circumstances are appropriate for hiding. When you try to hide, you take the Hide action."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-48-interacting-with-objects",
      "@type": "Rule",
      "name": "Interacting with Objects",
      "slug": "1-48-interacting-with-objects",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.48",
        "heading": "Interacting with Objects",
        "lineStart": 445,
        "lineEnd": 449
      },
      "section": "1.48",
      "rulesText": "Interacting with objects is often simple to resolve. The player tells the GM that their character is doing something, such as moving a lever or opening\n\na door, and the GM describes what happens. Sometimes, however, rules govern what you can do with an object, as detailed in the following sections."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-49-what-is-an-object",
      "@type": "Rule",
      "name": "What Is an Object?",
      "slug": "1-49-what-is-an-object",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.49",
        "heading": "What Is an Object?",
        "lineStart": 451,
        "lineEnd": 453
      },
      "section": "1.49",
      "rulesText": "For the purpose of the rules, an object is a discrete, inanimate item like a window, door, sword, book, table, chair, or stone. It isn't a building or a vehicle, which are composed of many objects."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-5-ability-scores",
      "@type": "Rule",
      "name": "Ability Scores",
      "slug": "1-5-ability-scores",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.5",
        "heading": "Ability Scores",
        "lineStart": 64,
        "lineEnd": 78
      },
      "section": "1.5",
      "rulesText": "Each ability has a score from 1 to 20, although some monsters have a score as high as 30. The score represents the magnitude of an ability. The Ability Scores table summarizes what the scores mean.\n\nAbility Scores",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/1-5-ability-scores"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-50-time-limited-object-interactions",
      "@type": "Rule",
      "name": "Time-Limited Object Interactions",
      "slug": "1-50-time-limited-object-interactions",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.50",
        "heading": "Time-Limited Object Interactions",
        "lineStart": 455,
        "lineEnd": 457
      },
      "section": "1.50",
      "rulesText": "When time is short, such as in combat, interactions with objects are limited: one free interaction per turn. That interaction must occur during a creature's movement or action. Any additional interactions require the Utilize action, as explained in \"Combat\" later in \"Playing the Game.\""
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-51-finding-hidden-objects",
      "@type": "Rule",
      "name": "Finding Hidden Objects",
      "slug": "1-51-finding-hidden-objects",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.51",
        "heading": "Finding Hidden Objects",
        "lineStart": 459,
        "lineEnd": 463
      },
      "section": "1.51",
      "rulesText": "When your character searches for hidden things, such as a secret door or a trap, the GM typically asks you to make a Wisdom (Perception) check, provided you describe the character searching in the hidden object's vicinity. On a success, you find the object, other important details, or both.\n\nIf you describe your character searching nowhere near a hidden object, a Wisdom (Perception) check won't reveal the object, no matter the check's total."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-52-carrying-objects",
      "@type": "Rule",
      "name": "Carrying Objects",
      "slug": "1-52-carrying-objects",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.52",
        "heading": "Carrying Objects",
        "lineStart": 465,
        "lineEnd": 467
      },
      "section": "1.52",
      "rulesText": "You can usually carry your gear and treasure without worrying about the weight of those objects. If you try to haul an unusually heavy object or a massive number of lighter objects, the GM might require you to abide by the rules for carrying capacity in \"Rules Glossary.\""
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-53-breaking-objects",
      "@type": "Rule",
      "name": "Breaking Objects",
      "slug": "1-53-breaking-objects",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.53",
        "heading": "Breaking Objects",
        "lineStart": 469,
        "lineEnd": 471
      },
      "section": "1.53",
      "rulesText": "As an action, you can automatically break or otherwise destroy a fragile, nonmagical object, such as a glass container or a piece of paper. If you try to damage something more resilient, the GM might use the rules on breaking objects in “Rules Glossary.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-54-marching-order",
      "@type": "Rule",
      "name": "MARCHING ORDER",
      "slug": "1-54-marching-order",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.54",
        "heading": "MARCHING ORDER",
        "lineStart": 473,
        "lineEnd": 475
      },
      "section": "1.54",
      "rulesText": "The adventurers should establish a marching order while they travel, whether indoors or outdoors. A marching order makes it easier to determine which characters are affected by traps, which ones can spot hidden enemies, and which ones are the closest to those enemies if a fight breaks out. You can change your marching order outside combat and record the order any way you like: write it down, for example, or arrange miniatures to show it."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-55-hazards",
      "@type": "Rule",
      "name": "Hazards",
      "slug": "1-55-hazards",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.55",
        "heading": "Hazards",
        "lineStart": 477,
        "lineEnd": 483
      },
      "section": "1.55",
      "rulesText": "Monsters are the main perils characters face, but other dangers await. “Rules Glossary” defines the following hazards:",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/1-55-hazards-table-1"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-56-travel",
      "@type": "Rule",
      "name": "Travel",
      "slug": "1-56-travel",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.56",
        "heading": "Travel",
        "lineStart": 485,
        "lineEnd": 489
      },
      "section": "1.56",
      "rulesText": "During an adventure, the characters might travel long distances on trips that could take hours or days. The GM can summarize this travel without calculating exact distances or travel times, or the GM might have you use the travel pace rules below.\n\nIf you need to know how fast you can move when every second matters, see the movement rules in “Combat” later in “Playing the Game.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-57-travel-pace",
      "@type": "Rule",
      "name": "Travel Pace",
      "slug": "1-57-travel-pace",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.57",
        "heading": "Travel Pace",
        "lineStart": 491,
        "lineEnd": 510
      },
      "section": "1.57",
      "rulesText": "While traveling outside combat, a group can move at a Fast, Normal, or Slow pace, as shown on the Travel Pace table. The table states how far the party can move in a period of time; if riding horses or other mounts, the group can move twice that distance for 1 hour, after which the mounts need a Short or Long Rest before they can move at that increased pace again (see “Equipment” for a selection of mounts for sale). “Gameplay Toolbox” has rules that affect which pace you can choose in certain types of terrain.\n\nTravel Pace\nDistance Traveled Per ...\n\nEach travel pace has a game effect, as defined below.\n\nFast. Traveling at a Fast pace imposes Disadvantage on a traveler's Wisdom (Perception or Survival) and Dexterity (Stealth) checks.\n\nNormal. Traveling at a Normal pace imposes Disadvantage on Dexterity (Stealth) checks.\n\nSlow. Traveling at a Slow pace grants Advantage on Wisdom (Perception or Survival) checks.",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/1-57-travel-pace-table-1"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-58-vehicles",
      "@type": "Rule",
      "name": "Vehicles",
      "slug": "1-58-vehicles",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.58",
        "heading": "Vehicles",
        "lineStart": 512,
        "lineEnd": 514
      },
      "section": "1.58",
      "rulesText": "Travelers in wagons, carriages, or other land vehicles choose a pace as normal. Characters in a waterborne vessel are limited to the speed of the vessel, and they don't choose a travel pace. Depending on the vessel and the size of the crew, ships might be able to travel for up to 24 hours per day. \"Equipment\" includes vehicles for sale."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-59-combat",
      "@type": "Rule",
      "name": "Combat",
      "slug": "1-59-combat",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.59",
        "heading": "Combat",
        "lineStart": 516,
        "lineEnd": 518
      },
      "section": "1.59",
      "rulesText": "Adventurers encounter many dangerous monsters and nefarious villains. In those moments, combat often breaks out."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-6-ability-modifiers",
      "@type": "Rule",
      "name": "Ability Modifiers",
      "slug": "1-6-ability-modifiers",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.6",
        "heading": "Ability Modifiers",
        "lineStart": 80,
        "lineEnd": 82
      },
      "section": "1.6",
      "rulesText": "Each ability has a modifier that you apply whenever you make a D20 Test with that ability (explained in \"D20 Tests\"). An ability modifier is derived from its score, as shown in the Ability Modifiers table."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-60-the-order-of-combat",
      "@type": "Rule",
      "name": "The Order of Combat",
      "slug": "1-60-the-order-of-combat",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.60",
        "heading": "The Order of Combat",
        "lineStart": 520,
        "lineEnd": 522
      },
      "section": "1.60",
      "rulesText": "A typical combat encounter is a clash between two sides: a flurry of weapon swings, feints, parries, footwork, and spellcasting. The game organizes combat into a cycle of rounds and turns. A round represents about 6 seconds in the game world. During a round, each participant in a battle takes a turn. The order of turns is determined at the beginning of combat when everyone rolls Initiative. Once everyone has taken a turn, the fight continues to the next round if neither side is defeated."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-61-combat-step-by-step",
      "@type": "Rule",
      "name": "Combat Step by Step",
      "slug": "1-61-combat-step-by-step",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.61",
        "heading": "Combat Step by Step",
        "lineStart": 524,
        "lineEnd": 530
      },
      "section": "1.61",
      "rulesText": "Combat unfolds in these steps:\n\n1: Establish Positions. The Game Master determines where all the characters and monsters are located. Given the adventurers' marching order or their stated positions in the room or other location, the GM figures out where the adversaries are - how far away and in what direction.\n2: Roll Initiative. Everyone involved in the combat encounter rolls Initiative, determining the order of combatants' turns.\n3: Take Turns. Each participant in the battle takes a turn in Initiative order. When everyone involved in the combat has had a turn, the round ends. Repeat this step until the fighting stops."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-62-initiative",
      "@type": "Rule",
      "name": "Initiative",
      "slug": "1-62-initiative",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.62",
        "heading": "Initiative",
        "lineStart": 532,
        "lineEnd": 542
      },
      "section": "1.62",
      "rulesText": "Initiative determines the order of turns during combat. When combat starts, every participant rolls Initiative; they make a Dexterity check that determines their place in the Initiative order. The GM rolls for monsters. For a group of identical creatures, the GM makes a single roll, so each member of the group has the same Initiative.\n\nSurprise. If a combatant is surprised by combat starting, that combatant has Disadvantage on their Initiative roll. For example, if an ambusher starts combat while hidden from a foe who is unaware that combat is starting, that foe is surprised.\n\nInitiative Order. A combatant's check total is called their Initiative count, or Initiative for short. The GM ranks the combatants, from highest to lowest Initiative. This is the order in which they act during each round. The Initiative order remains the same from round to round.\n\nTies. If a tie occurs, the GM decides the order among tied monsters, and the players decide the order among tied characters. The GM decides the\n\norder if the tie is between a monster and a player character."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-63-your-turn",
      "@type": "Rule",
      "name": "Your Turn",
      "slug": "1-63-your-turn",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.63",
        "heading": "Your Turn",
        "lineStart": 544,
        "lineEnd": 556
      },
      "section": "1.63",
      "rulesText": "On your turn, you can move a distance up to your Speed and take one action. You decide whether to move first or take your action first.\n\nThe main actions you can take are listed in “Actions” earlier in “Playing the Game.” A character’s features and a monster’s stat block also provide action options. “Movement and Position” later in “Playing the Game” gives the rules for movement.\n\nCommunicating. You can communicate however you are able - through brief utterances and gestures - as you take your turn. Doing so uses neither your action nor your move.\n\nExtended communication, such as a detailed explanation of something or an attempt to persuade a foe, requires an action. The Influence action is the main way you try to influence a monster.\n\nInteracting with Things. You can interact with one object or feature of the environment for free, during either your move or action. For example, you could open a door during your move as you stride toward a foe.\n\nIf you want to interact with a second object, you need to take the Utilize action. Some magic items and other special objects always require an action to use, as stated in their descriptions."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-64-playing-on-a-grid",
      "@type": "Rule",
      "name": "PLAYING ON A GRID",
      "slug": "1-64-playing-on-a-grid",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.64",
        "heading": "PLAYING ON A GRID",
        "lineStart": 558,
        "lineEnd": 574
      },
      "section": "1.64",
      "rulesText": "If you play using a square grid and miniatures or other tokens, follow these rules.\n\nSquares. Each square represents 5 feet.\n\nSpeed. Rather than moving foot by foot, move square by square on the grid, using your Speed in 5-foot segments. You can translate your Speed into squares by dividing it by 5. For example, a Speed of 30 feet translates into 6 squares. If you use a grid often, consider writing your Speed in squares on your character sheet.\n\nEntering a Square. To enter a square, you must have enough movement left to pay for entering. It costs 1 square of movement to enter an unoccupied square that's adjacent to your space (orthogonally or diagonally adjacent). A square of Difficult Terrain costs 2 squares to enter. Other effects might make a square cost even more.\n\nCorners. Diagonal movement can't cross the corner of a wall, a large tree, or another terrain feature that fills its space.\n\nRanges. To determine the range on a grid between two things - whether creatures or objects - count squares from a square adjacent to one of them and stop counting in the space of the other one. Count by the shortest route.\n\nThe GM might require you to use an action for any of these activities when it needs special care or when it presents an unusual obstacle. For instance, the GM might require you to take the Utilize action to open a stuck door or turn a crank to lower a drawbridge.\n\nDoing Nothing on Your Turn. You can forgo moving, taking an action, or doing anything at all on your turn. If you can't decide what to do, consider taking the defensive Dodge action or the Ready action to delay acting."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-65-ending-combat",
      "@type": "Rule",
      "name": "Ending Combat",
      "slug": "1-65-ending-combat",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.65",
        "heading": "Ending Combat",
        "lineStart": 576,
        "lineEnd": 578
      },
      "section": "1.65",
      "rulesText": "Combat ends when one side or the other is defeated, which can mean the creatures are killed or knocked out or have surrendered or fled. Combat can also end when both sides agree to end it."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-66-movement-and-position",
      "@type": "Rule",
      "name": "Movement and Position",
      "slug": "1-66-movement-and-position",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.66",
        "heading": "Movement and Position",
        "lineStart": 580,
        "lineEnd": 588
      },
      "section": "1.66",
      "rulesText": "On your turn, you can move a distance equal to your Speed or less. Or you can decide not to move.\n\nYour movement can include climbing, crawling, jumping, and swimming (each explained in “Rules Glossary”). These different modes of movement can be combined with your regular movement, or they can constitute your entire move.\n\nHowever you're moving with your Speed, you deduct the distance of each part of your move from it until it is used up or until you are done moving, whichever comes first.\n\nA character's Speed is determined during character creation. A monster's Speed is noted in the monster's stat block. See “Rules Glossary” for more about Speed as well as about special speeds, such as a Climb Speed, Fly Speed, or Swim Speed."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-67-difficult-terrain",
      "@type": "Rule",
      "name": "Difficult Terrain",
      "slug": "1-67-difficult-terrain",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.67",
        "heading": "Difficult Terrain",
        "lineStart": 590,
        "lineEnd": 594
      },
      "section": "1.67",
      "rulesText": "Combatants are often slowed down by Difficult Terrain. Low furniture, rubble, undergrowth, steep stairs, snow, and shallow bogs are examples of Difficult Terrain.\n\nEvery foot of movement in Difficult Terrain costs 1 extra foot, even if multiple things in a space count as Difficult Terrain."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-68-breaking-up-your-move",
      "@type": "Rule",
      "name": "Breaking Up Your Move",
      "slug": "1-68-breaking-up-your-move",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.68",
        "heading": "Breaking Up Your Move",
        "lineStart": 596,
        "lineEnd": 598
      },
      "section": "1.68",
      "rulesText": "You can break up your move, using some of its movement before and after any action, Bonus Action, or Reaction you take on the same turn. For example, if you have a Speed of 30 feet, you could go 10 feet, take an action, and then go 20 feet."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-69-dropping-prone",
      "@type": "Rule",
      "name": "Dropping Prone",
      "slug": "1-69-dropping-prone",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.69",
        "heading": "Dropping Prone",
        "lineStart": 600,
        "lineEnd": 602
      },
      "section": "1.69",
      "rulesText": "On your turn, you can give yourself the Prone condition (see “Rules Glossary”) without using an action or any of your Speed, but you can’t do so if your Speed is 0."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-7-round-down",
      "@type": "Rule",
      "name": "Round Down",
      "slug": "1-7-round-down",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.7",
        "heading": "Round Down",
        "lineStart": 84,
        "lineEnd": 99
      },
      "section": "1.7",
      "rulesText": "Whenever you divide or multiply a number in the game, round down if you end up with a fraction, even if the fraction is one-half or greater. Some rules make an exception and tell you to round up.\n\nAbility Modifiers",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/1-7-ability-modifiers"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-70-creature-size",
      "@type": "Rule",
      "name": "Creature Size",
      "slug": "1-70-creature-size",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.70",
        "heading": "Creature Size",
        "lineStart": 604,
        "lineEnd": 619
      },
      "section": "1.70",
      "rulesText": "A creature belongs to a size category, which determines the width of the square space the creature occupies on a map, as shown on the Creature Size and Space table. That table lists the sizes from smallest (Tiny) to largest (Gargantuan). A creature's space is the area that it effectively controls in combat and the area it needs to fight effectively.\n\nA character's size is determined by species, and a monster's size is specified in the monster's stat block.\n\nCreature Size and Space",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/1-70-creature-size-and-space"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-71-moving-around-other-creatures",
      "@type": "Rule",
      "name": "Moving around Other Creatures",
      "slug": "1-71-moving-around-other-creatures",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.71",
        "heading": "Moving around Other Creatures",
        "lineStart": 621,
        "lineEnd": 627
      },
      "section": "1.71",
      "rulesText": "During your move, you can pass through the space of an ally, a creature that has the Incapacitated condition (see “Rules Glossary”), a Tiny creature, or a creature that is two sizes larger or smaller than you.\n\nAnother creature's space is Difficult Terrain for you unless that creature is Tiny or your ally.\n\nYou can't willingly end a move in a space occupied by another creature. If you somehow end a turn in a space with another creature, you have the Prone condition (see “Rules Glossary”) unless you are Tiny or are of a larger size than the other creature."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-72-making-an-attack",
      "@type": "Rule",
      "name": "Making an Attack",
      "slug": "1-72-making-an-attack",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.72",
        "heading": "Making an Attack",
        "lineStart": 629,
        "lineEnd": 631
      },
      "section": "1.72",
      "rulesText": "When you take the Attack action, you make an attack. Some other actions, Bonus Actions, and Reactions also let you make an attack. Whether you strike with a Melee weapon, fire a Ranged weapon,"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-73-unseen-attackers-and-targets",
      "@type": "Rule",
      "name": "UNSEEN ATTACKERS AND TARGETS",
      "slug": "1-73-unseen-attackers-and-targets",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.73",
        "heading": "UNSEEN ATTACKERS AND TARGETS",
        "lineStart": 633,
        "lineEnd": 645
      },
      "section": "1.73",
      "rulesText": "When you make an attack roll against a target you can't see, you have Disadvantage on the roll. This is true whether you're guessing the target's location or targeting a creature you can hear but not see. If the target isn't in the location you targeted, you miss.\n\nWhen a creature can't see you, you have Advantage on attack rolls against it.\n\nIf you are hidden when you make an attack roll, you give away your location when the attack hits or misses.\n\nor make an attack roll as part of a spell, an attack has the following structure:\n\n1: Choose a Target. Pick a target within your attack's range: a creature, an object, or a location.\n2: Determine Modifiers. The GM determines whether the target has Cover (see the next section) and whether you have Advantage or Disadvantage against the target. In addition, spells, special abilities, and other effects can apply penalties or bonuses to your attack roll.\n3: Resolve the Attack. Make the attack roll, as detailed earlier in “Playing the Game.” On a hit, you roll damage unless the particular attack has rules that specify otherwise. Some attacks cause special effects in addition to or instead of damage."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-74-cover",
      "@type": "Rule",
      "name": "Cover",
      "slug": "1-74-cover",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.74",
        "heading": "Cover",
        "lineStart": 647,
        "lineEnd": 659
      },
      "section": "1.74",
      "rulesText": "Walls, trees, creatures, and other obstacles can provide cover, making a target more difficult to harm. As detailed in the Cover table, there are three degrees of cover, each of which gives a different benefit to a target.\n\nA target can benefit from cover only when an attack or other effect originates on the opposite side of the cover. If a target is behind multiple sources of cover, only the most protective degree of cover applies; the degrees aren't added together. For example, if a target is behind a creature that gives Half Cover and a tree trunk that gives Three-Quarters Cover, the target has Three-Quarters Cover.\n\nCover",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/1-74-cover"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-75-ranged-attacks",
      "@type": "Rule",
      "name": "Ranged Attacks",
      "slug": "1-75-ranged-attacks",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.75",
        "heading": "Ranged Attacks",
        "lineStart": 661,
        "lineEnd": 663
      },
      "section": "1.75",
      "rulesText": "When you make a ranged attack, you fire a bow, hurl an axe, or otherwise send projectiles to strike a foe at a distance. Many spells also involve making a ranged attack."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-76-range",
      "@type": "Rule",
      "name": "Range",
      "slug": "1-76-range",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.76",
        "heading": "Range",
        "lineStart": 665,
        "lineEnd": 669
      },
      "section": "1.76",
      "rulesText": "You can make ranged attacks only against targets within a specified range. If a ranged attack, such as one made with a spell, has a single range, you can't attack a target beyond this range.\n\nSome ranged attacks, such as those made with a Longbow, have two ranges. The smaller number is the normal range, and the larger number is the long range. Your attack roll has Disadvantage when your target is beyond normal range, and you can't attack a target beyond long range."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-77-ranged-attacks-in-close-combat",
      "@type": "Rule",
      "name": "Ranged Attacks in Close Combat",
      "slug": "1-77-ranged-attacks-in-close-combat",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.77",
        "heading": "Ranged Attacks in Close Combat",
        "lineStart": 671,
        "lineEnd": 673
      },
      "section": "1.77",
      "rulesText": "Aiming a ranged attack is more difficult when a foe is next to you. When you make a ranged attack roll with a weapon, a spell, or some other means, you have Disadvantage on the roll if you are within 5 feet of an enemy who can see you and doesn't have the Incapacitated condition (see “Rules Glossary”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-78-melee-attacks",
      "@type": "Rule",
      "name": "Melee Attacks",
      "slug": "1-78-melee-attacks",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.78",
        "heading": "Melee Attacks",
        "lineStart": 675,
        "lineEnd": 677
      },
      "section": "1.78",
      "rulesText": "A melee attack allows you to attack a target within your reach. A melee attack typically uses a hand-held weapon or an Unarmed Strike. Many monsters make melee attacks with claws, teeth, or other body parts. A few spells also involve melee attacks."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-79-reach",
      "@type": "Rule",
      "name": "Reach",
      "slug": "1-79-reach",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.79",
        "heading": "Reach",
        "lineStart": 679,
        "lineEnd": 681
      },
      "section": "1.79",
      "rulesText": "A creature has a 5-foot reach and can thus attack targets within 5 feet when making a melee attack. Certain creatures have melee attacks with a reach greater than 5 feet, as noted in their descriptions."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-8-d20-tests",
      "@type": "Rule",
      "name": "D20 Tests",
      "slug": "1-8-d20-tests",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.8",
        "heading": "D20 Tests",
        "lineStart": 101,
        "lineEnd": 111
      },
      "section": "1.8",
      "rulesText": "When the outcome of an action is uncertain, the game uses a d20 roll to determine success or failure. These rolls are called D20 Tests, and they come in three kinds: ability checks, saving throws, and attack rolls. They follow these steps:\n\n4: Roll 1d20. You always want to roll high. If the roll has Advantage or Disadvantage (described later in \"Playing the Game\"), you roll two d20s, but you use the number from only one of them - the higher one if you have Advantage or the lower one if you have Disadvantage.\n5: Add Modifiers. Add these modifiers to the number rolled on the d20:\n\n- The Relevant Ability Modifier. “Playing the Game” and “Rules Glossary” explain which ability modifiers to use for various D20 Tests.\n- Your Proficiency Bonus If Relevant. Each creature has a Proficiency Bonus, a number added when making a D20 Test that uses something, such as a skill, in which the creature has proficiency. See “Proficiency” later in “Playing the Game.”\n- Circumstantial Bonuses and Penalties. A class feature, a spell, or another rule might give a bonus or penalty to the die roll.\n6: Compare the Total to a Target Number. If the total of the d20 and its modifiers equals or exceeds the target number, the D20 Test succeeds. Otherwise, it fails. The Game Master determines target numbers and tells players whether their rolls are successful. The target number for an ability check or a saving throw is called a Difficulty Class (DC). The target number for an attack roll is called an Armor Class (AC), which appears on a character sheet or in a stat block (see “Rules Glossary”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-80-opportunity-attacks",
      "@type": "Rule",
      "name": "Opportunity Attacks",
      "slug": "1-80-opportunity-attacks",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.80",
        "heading": "Opportunity Attacks",
        "lineStart": 683,
        "lineEnd": 689
      },
      "section": "1.80",
      "rulesText": "Combatants watch for enemies to drop their guard. If you move heedlessly past your foes, you put yourself in danger by provoking an Opportunity Attack.\n\nAvoiding Opportunity Attacks. You can avoid provoking an Opportunity Attack by taking the Disengage action. You also don't provoke an Opportunity Attack when you Teleport or when you are moved without using your movement, action, Bonus Action, or Reaction. For example, you don't provoke an Opportunity Attack if an explosion hurls you out of a foe's reach or if you fall past an enemy.\n\nMaking an Opportunity Attack. You can make an Opportunity Attack when a creature that you can see leaves your reach. To make the attack, take a Reaction to make one melee attack with a weapon or an Unarmed Strike against that creature. The attack occurs right before it leaves your reach."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-81-mounted-combat",
      "@type": "Rule",
      "name": "Mounted Combat",
      "slug": "1-81-mounted-combat",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.81",
        "heading": "Mounted Combat",
        "lineStart": 691,
        "lineEnd": 693
      },
      "section": "1.81",
      "rulesText": "A willing creature that is at least one size larger than a rider and that has an appropriate anatomy can serve as a mount, using the following rules."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-82-mounting-and-dismounting",
      "@type": "Rule",
      "name": "Mounting and Dismounting",
      "slug": "1-82-mounting-and-dismounting",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.82",
        "heading": "Mounting and Dismounting",
        "lineStart": 695,
        "lineEnd": 697
      },
      "section": "1.82",
      "rulesText": "During your move, you can mount a creature that is within 5 feet of you or dismount. Doing so costs an amount of movement equal to half your Speed (round down). For example, if your Speed is 30 feet, you spend 15 feet of movement to mount a horse."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-83-controlling-a-mount",
      "@type": "Rule",
      "name": "Controlling a Mount",
      "slug": "1-83-controlling-a-mount",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.83",
        "heading": "Controlling a Mount",
        "lineStart": 699,
        "lineEnd": 705
      },
      "section": "1.83",
      "rulesText": "You can control a mount only if it has been trained to accept a rider. Domesticated horses, mules, and similar creatures have such training.\n\nThe Initiative of a controlled mount changes to match yours when you mount it. It moves on your turn as you direct it, and it has only three action options during that turn: Dash, Disengage, and Dodge. A controlled mount can move and act even on the turn that you mount it.\n\nIn contrast, an independent mount - one that lets you ride but ignores your control - retains its place in the Initiative order and moves and acts as it likes."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-84-falling-off",
      "@type": "Rule",
      "name": "Falling Off",
      "slug": "1-84-falling-off",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.84",
        "heading": "Falling Off",
        "lineStart": 707,
        "lineEnd": 711
      },
      "section": "1.84",
      "rulesText": "If an effect is about to move your mount against its will while you're on it, you must succeed on a DC 10 Dexterity saving throw or fall off, landing with the Prone condition (see “Rules Glossary”) in an unoccupied space within 5 feet of the mount.\n\nWhile mounted, you must make the same save if you're knocked Prone or the mount is."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-85-underwater-combat",
      "@type": "Rule",
      "name": "Underwater Combat",
      "slug": "1-85-underwater-combat",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.85",
        "heading": "Underwater Combat",
        "lineStart": 713,
        "lineEnd": 715
      },
      "section": "1.85",
      "rulesText": "A fight underwater follows these rules."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-86-impeded-weapons",
      "@type": "Rule",
      "name": "Impeded Weapons",
      "slug": "1-86-impeded-weapons",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.86",
        "heading": "Impeded Weapons",
        "lineStart": 717,
        "lineEnd": 721
      },
      "section": "1.86",
      "rulesText": "When making a melee attack roll with a weapon underwater, a creature that lacks a Swim Speed has Disadvantage on the attack roll unless the weapon deals Piercing damage.\n\nA ranged attack roll with a weapon underwater automatically misses a target beyond the weapon's normal range, and the attack roll has Disadvantage against a target within normal range."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-87-fire-resistance",
      "@type": "Rule",
      "name": "Fire Resistance",
      "slug": "1-87-fire-resistance",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.87",
        "heading": "Fire Resistance",
        "lineStart": 723,
        "lineEnd": 725
      },
      "section": "1.87",
      "rulesText": "Anything underwater has Resistance to Fire damage (explained in “Damage and Healing”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-88-damage-and-healing",
      "@type": "Rule",
      "name": "Damage and Healing",
      "slug": "1-88-damage-and-healing",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.88",
        "heading": "Damage and Healing",
        "lineStart": 727,
        "lineEnd": 729
      },
      "section": "1.88",
      "rulesText": "Injury and death are frequent threats, as detailed in the following rules."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-89-hit-points",
      "@type": "Rule",
      "name": "Hit Points",
      "slug": "1-89-hit-points",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.89",
        "heading": "Hit Points",
        "lineStart": 731,
        "lineEnd": 737
      },
      "section": "1.89",
      "rulesText": "Hit Points represent durability and the will to live. Creatures with more Hit Points are more difficult to kill. Your Hit Point maximum is the number of Hit Points you have when uninjured. Your current Hit Points can be any number from that maximum down to 0, which is the lowest Hit Points can go.\n\nWhenever you take damage, subtract it from your Hit Points. Hit Point loss has no effect on your capabilities until you reach 0 Hit Points.\n\nIf you have half your Hit Points or fewer, you're Bloodied, which has no game effect on its own but which might trigger other game effects."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-9-ability-checks",
      "@type": "Rule",
      "name": "Ability Checks",
      "slug": "1-9-ability-checks",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.9",
        "heading": "Ability Checks",
        "lineStart": 113,
        "lineEnd": 115
      },
      "section": "1.9",
      "rulesText": "An ability check represents a creature using talent and training to try to overcome a challenge, such as forcing open a stuck door, picking a lock, entertaining a crowd, or deciphering a cipher. The GM and the rules often call for an ability check when a creature attempts something other than an attack that has a chance of meaningful failure. When the outcome is uncertain and narratively interesting, the dice determine the result."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-90-resting",
      "@type": "Rule",
      "name": "Resting",
      "slug": "1-90-resting",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.90",
        "heading": "Resting",
        "lineStart": 739,
        "lineEnd": 741
      },
      "section": "1.90",
      "rulesText": "Adventurers can't spend every hour adventuring. They need rest. Any creature can take hour-long Short Rests in the midst of a day and an 8-hour Long Rest to end it. Regaining Hit Points is one of the main benefits of a rest. “Rules Glossary” provides the rules for Short and Long Rests."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-91-damage-rolls",
      "@type": "Rule",
      "name": "Damage Rolls",
      "slug": "1-91-damage-rolls",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.91",
        "heading": "Damage Rolls",
        "lineStart": 743,
        "lineEnd": 747
      },
      "section": "1.91",
      "rulesText": "Each weapon, spell, and damaging monster ability specifies the damage it deals. You roll the damage dice, add any modifiers, and deal the damage to your target. If there's a penalty to the damage, it's possible to deal 0 damage but not negative damage.\n\nWhen attacking with a weapon, you add your ability modifier - the same modifier used for the attack roll - to the damage roll. A spell tells you which dice to roll for damage and whether to add any modifiers. Unless a rule says otherwise, you don't add your ability modifier to a fixed damage amount that doesn't use a roll, such as the damage of a Blowgun. See “Equipment” for weapons' damage dice and “Spells” for spells' damage dice."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-92-critical-hits",
      "@type": "Rule",
      "name": "Critical Hits",
      "slug": "1-92-critical-hits",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.92",
        "heading": "Critical Hits",
        "lineStart": 749,
        "lineEnd": 751
      },
      "section": "1.92",
      "rulesText": "When you score a Critical Hit, you deal extra damage. Roll the attack's damage dice twice, add them together, and add any relevant modifiers as normal. For example, if you score a Critical Hit with a Dagger, roll 2d4 for the damage rather than 1d4, and add your relevant ability modifier. If the attack involves other damage dice, such as from the Rogue's Sneak Attack feature, you also roll those dice twice."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-93-saving-throws-and-damage",
      "@type": "Rule",
      "name": "Saving Throws and Damage",
      "slug": "1-93-saving-throws-and-damage",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.93",
        "heading": "Saving Throws and Damage",
        "lineStart": 753,
        "lineEnd": 755
      },
      "section": "1.93",
      "rulesText": "Damage dealt via saving throws uses these rules."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-94-damage-against-multiple-targets",
      "@type": "Rule",
      "name": "Damage against Multiple Targets",
      "slug": "1-94-damage-against-multiple-targets",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.94",
        "heading": "Damage against Multiple Targets",
        "lineStart": 757,
        "lineEnd": 759
      },
      "section": "1.94",
      "rulesText": "When you create a damaging effect that forces two or more targets to make saving throws against it at the same time, roll the damage once for all the targets. For example, when a wizard casts Fireball, the spell's damage is rolled once for all creatures caught in the blast."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-95-half-damage",
      "@type": "Rule",
      "name": "Half Damage",
      "slug": "1-95-half-damage",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.95",
        "heading": "Half Damage",
        "lineStart": 761,
        "lineEnd": 763
      },
      "section": "1.95",
      "rulesText": "Many saving throw effects deal half damage (round down) to a target when the target succeeds on the saving throw. The halved damage is equal to half the damage that would be dealt on a failed save."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-96-damage-types",
      "@type": "Rule",
      "name": "Damage Types",
      "slug": "1-96-damage-types",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.96",
        "heading": "Damage Types",
        "lineStart": 765,
        "lineEnd": 769
      },
      "section": "1.96",
      "rulesText": "Each instance of damage has a type, like Fire or Slashing. Damage types are listed in “Rules\n\nGlossary\" and have no rules of their own, but other rules, such as Resistance, rely on damage types."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-97-resistance-and-vulnerability",
      "@type": "Rule",
      "name": "Resistance and Vulnerability",
      "slug": "1-97-resistance-and-vulnerability",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.97",
        "heading": "Resistance and Vulnerability",
        "lineStart": 771,
        "lineEnd": 773
      },
      "section": "1.97",
      "rulesText": "Some creatures and objects have Resistance or Vulnerability to certain damage types. If you have Resistance to a damage type, damage of that type is halved against you (round down). If you have Vulnerability to a damage type, damage of that type is doubled against you. For example, if you have Resistance to Cold damage, such damage is halved against you, and if you have Vulnerability to Fire damage, such damage is doubled against you."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-98-no-stacking",
      "@type": "Rule",
      "name": "No Stacking",
      "slug": "1-98-no-stacking",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.98",
        "heading": "No Stacking",
        "lineStart": 775,
        "lineEnd": 777
      },
      "section": "1.98",
      "rulesText": "Multiple instances of Resistance or Vulnerability that affect the same damage type count as only one instance. For example, if you have Resistance to Necrotic damage as well as Resistance to all damage, Necrotic damage is reduced by half against you."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/1-99-order-of-application",
      "@type": "Rule",
      "name": "Order of Application",
      "slug": "1-99-order-of-application",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Playing the Game",
        "section": "1.99",
        "heading": "Order of Application",
        "lineStart": 779,
        "lineEnd": 783
      },
      "section": "1.99",
      "rulesText": "Modifiers to damage are applied in the following order: adjustments such as bonuses, penalties, or multipliers are applied first; Resistance is applied second; and Vulnerability is applied third.\n\nFor example, a creature has Resistance to all damage and Vulnerability to Fire damage, and it's within a magical aura that reduces all damage by 5. If it takes 28 Fire damage, the damage is first reduced by 5 (to 23), then halved for the creature's Resistance (and rounded down to 11), then doubled for its Vulnerability (to 22)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-1-magic-items",
      "@type": "Rule",
      "name": "Magic Items",
      "slug": "10-1-magic-items",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.1",
        "heading": "Magic Items",
        "lineStart": 14551,
        "lineEnd": 14553
      },
      "section": "10.1",
      "rulesText": "Magic items are gleaned from the hoards of felled monsters or discovered in long-lost vaults. Such items grant capabilities a character could rarely have otherwise, or they complement their owner's capabilities in wondrous ways."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-10-weapons",
      "@type": "Rule",
      "name": "Weapons",
      "slug": "10-10-weapons",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.10",
        "heading": "Weapons",
        "lineStart": 14632,
        "lineEnd": 14636
      },
      "section": "10.10",
      "rulesText": "A magic weapon is typically a magical version of a weapon from “Equipment.” Some magic weapons specify the type of weapon they are in their descriptions, such as a Longsword or Longbow. If no weapon type is specified, you may choose the type or determine it randomly.\n\nAmmunition. If a magic weapon has the Ammunition property, ammunition fired from it is considered magical for the purpose of any rule that cares whether a weapon is magical or not."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-11-wondrous-items",
      "@type": "Rule",
      "name": "Wondrous Items",
      "slug": "10-11-wondrous-items",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.11",
        "heading": "Wondrous Items",
        "lineStart": 14638,
        "lineEnd": 14640
      },
      "section": "10.11",
      "rulesText": "Wondrous Items include wearable items such as boots, belts, capes, amulets, brooches, and circlets. Bags, carpets, figurines, horns, musical instruments, and more also fall into this category."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-12-magic-item-rules",
      "@type": "Rule",
      "name": "MAGIC ITEM RULES",
      "slug": "10-12-magic-item-rules",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.12",
        "heading": "MAGIC ITEM RULES",
        "lineStart": 14642,
        "lineEnd": 14652
      },
      "section": "10.12",
      "rulesText": "Rules for identifying, attuning to, and using magic items appear in “Equipment.” Additional rules are presented below.\n\nAttunement Prerequisites. If a magic item has a class prerequisite, a creature must be a member of that class to attune to the item. If a creature must be a spellcaster to attune to an item, the creature qualifies if it can cast at least one spell using its traits or features, not by using a magic item or the like.\n\nItems Made for Specific Creatures. Magic items that are meant to be worn tend to magically adjust themselves to the wearer. However, you can decide that a magic item doesn't adjust its size to fit any wearer. For example, a particular armorer might make items usable only by folk who are sized and shaped like dwarves.\n\nUnusual Anatomy. Use your discretion to decide whether a creature can wear an item not made for its anatomy. A ring placed on a tentacle might work, but a yuan-ti with a snakelike tail instead of legs can't wear magic boots.\n\nPaired Items. You can allow exceptions to the rule that paired items must both be worn. For example, a character with only one arm might be able to use a single Glove of Missile Snaring so long as the matching glove is on their person."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-13-magic-item-rarity",
      "@type": "Rule",
      "name": "Magic Item Rarity",
      "slug": "10-13-magic-item-rarity",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.13",
        "heading": "Magic Item Rarity",
        "lineStart": 14654,
        "lineEnd": 14658
      },
      "section": "10.13",
      "rulesText": "Every magic item has a rarity, which provides a rough measure of an item's power relative to other magic items. The rarities are shown in the Magic Item Rarities and Values table.\n\nCommon magic items, such as a Potion of Healing, are the most plentiful. Artifacts, such as the Dragon Orb, are priceless, unique, and difficult to acquire."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-14-magic-item-values-by-rarity",
      "@type": "Rule",
      "name": "Magic Item Values by Rarity",
      "slug": "10-14-magic-item-values-by-rarity",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.14",
        "heading": "Magic Item Values by Rarity",
        "lineStart": 14660,
        "lineEnd": 14676
      },
      "section": "10.14",
      "rulesText": "Common magic items can often be bought in a town or city. Uncommon and Rare magic items are usually found only in cities, and rarer magic items might be sold only in wondrous locations, such as a city on another plane of existence. If you allow characters to buy and sell magic items in your campaign, rarity can help you set prices for those items. Gold Piece values are provided in the Magic Item Rarities and Values table, though a seller might ask for a service rather than coin as payment.\n\nIf a magic item incorporates an item that has a purchase cost in “Equipment” (such as a weapon or a suit of armor), add that item’s cost to the magic item’s value. For example, +1 Armor (Plate Armor)\n\nhas a value of 5,500 GP, which is the sum of a Rare magic item's value (4,000 GP) and the cost of Plate Armor (1,500 GP).\n\nMagic Item Rarities and Values\n\n*Halve the value for a consumable item other than a Spell Scroll. The value of a Spell Scroll is double what it costs to scribe the scroll (as specified in the “Scribing Spell Scrolls” section of “Equipment”).",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/10-14-magic-item-rarities-and-values"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-15-activating-a-magic-item",
      "@type": "Rule",
      "name": "Activating a Magic Item",
      "slug": "10-15-activating-a-magic-item",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.15",
        "heading": "Activating a Magic Item",
        "lineStart": 14678,
        "lineEnd": 14680
      },
      "section": "10.15",
      "rulesText": "It usually takes a Magic action to activate a magic item. The item's user might also need to do something special. The description of each item category or individual item details how an item is activated. Certain items use the following rules for their activation."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-16-command-word",
      "@type": "Rule",
      "name": "Command Word",
      "slug": "10-16-command-word",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.16",
        "heading": "Command Word",
        "lineStart": 14682,
        "lineEnd": 14684
      },
      "section": "10.16",
      "rulesText": "A command word is a word or short phrase that must be spoken or signed for an item to work. Spoken command words must be audible and fail to work in areas where all sound is suppressed, as in the area of the Silence spell."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-17-consumable-items",
      "@type": "Rule",
      "name": "Consumable Items",
      "slug": "10-17-consumable-items",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.17",
        "heading": "Consumable Items",
        "lineStart": 14686,
        "lineEnd": 14688
      },
      "section": "10.17",
      "rulesText": "Some items are consumed - used up, in other words - when they are activated. A Potion of Healing must be swallowed, for example, while the writing vanishes from a scroll when it is read. Once used, a consumable item loses its magic."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-18-spells-cast-from-items",
      "@type": "Rule",
      "name": "Spells Cast from Items",
      "slug": "10-18-spells-cast-from-items",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.18",
        "heading": "Spells Cast from Items",
        "lineStart": 14690,
        "lineEnd": 14696
      },
      "section": "10.18",
      "rulesText": "Some magic items allow the user to cast a spell from the item. The spell is cast at the lowest possible spell and caster level, doesn't expend any of the user's spell slots, and requires no components unless the item's description notes otherwise. The spell uses its normal casting time, range, and duration, and the user of the item must concentrate if the spell requires Concentration. Many items, such as Potions, bypass the casting of a spell and confer the spell's effects with its usual duration. Certain items make exceptions to these rules, changing the casting time, duration, or other parts of a spell.\n\nA magic item may require the user to use their own spellcasting ability when casting a spell from the item. If the user has more than one spellcasting ability, the user chooses which one to use with the item. If the user doesn't have a spellcasting ability,\n\ntheir spellcasting ability modifier is +0 for the item, and the user's Proficiency Bonus applies."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-19-charges",
      "@type": "Rule",
      "name": "Charges",
      "slug": "10-19-charges",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.19",
        "heading": "Charges",
        "lineStart": 14698,
        "lineEnd": 14700
      },
      "section": "10.19",
      "rulesText": "Some magic items have charges that must be expended to activate their properties. The number of charges an item has remaining is revealed when the Identify spell is cast on it. A creature attuned to an item knows how many charges the item has and how many it regains."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-2-magic-item-categories",
      "@type": "Rule",
      "name": "Magic Item Categories",
      "slug": "10-2-magic-item-categories",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.2",
        "heading": "Magic Item Categories",
        "lineStart": 14555,
        "lineEnd": 14571
      },
      "section": "10.2",
      "rulesText": "Every magic item belongs to a category. The Magic Item Categories table lists the nine categories and provides examples. Rules for the categories appear after the table.\n\nMagic Item Categories",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/10-2-magic-item-categories"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-20-the-next-dawn",
      "@type": "Rule",
      "name": "\"The Next Dawn\"",
      "slug": "10-20-the-next-dawn",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.20",
        "heading": "\"The Next Dawn\"",
        "lineStart": 14702,
        "lineEnd": 14704
      },
      "section": "10.20",
      "rulesText": "Magic items often have charges or properties that recharge at the next dawn or some other specified time. If such an item is on a world or plane of existence where the specified event doesn't occur, the GM determines when the item recharges."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-21-cursed-items",
      "@type": "Rule",
      "name": "Cursed Items",
      "slug": "10-21-cursed-items",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.21",
        "heading": "Cursed Items",
        "lineStart": 14706,
        "lineEnd": 14710
      },
      "section": "10.21",
      "rulesText": "A magic item's description specifies whether it bears a curse. Most methods of identifying items, including the Identify spell, fail to reveal such a curse.\n\nAttunement to a cursed item can't be ended voluntarily unless the curse is broken first, such as with a Remove Curse spell."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-22-magic-item-resilience",
      "@type": "Rule",
      "name": "Magic Item Resilience",
      "slug": "10-22-magic-item-resilience",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.22",
        "heading": "Magic Item Resilience",
        "lineStart": 14712,
        "lineEnd": 14716
      },
      "section": "10.22",
      "rulesText": "A magic item is at least as durable as a nonmagical item of its kind. Most magic items, other than Potions and Scrolls, have Resistance to all damage.\n\nAn Artifact can be destroyed only in some special way. Otherwise, it is impervious to damage. Learning how to destroy an Artifact usually requires research or the completion of a quest."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-23-crafting-magic-items",
      "@type": "Rule",
      "name": "Crafting Magic Items",
      "slug": "10-23-crafting-magic-items",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.23",
        "heading": "Crafting Magic Items",
        "lineStart": 14718,
        "lineEnd": 14720
      },
      "section": "10.23",
      "rulesText": "“Equipment” contains rules on brewing Potions of Healing and scribing Spell Scrolls. To create other magic items, follow the rules below. In these rules, “you” refers to the character crafting the magic item."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-24-arcana-proficiency",
      "@type": "Rule",
      "name": "Arcana Proficiency",
      "slug": "10-24-arcana-proficiency",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.24",
        "heading": "Arcana Proficiency",
        "lineStart": 14722,
        "lineEnd": 14724
      },
      "section": "10.24",
      "rulesText": "To craft a magic item, you and any assistants must have proficiency in the Arcana skill."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-25-tools",
      "@type": "Rule",
      "name": "Tools",
      "slug": "10-25-tools",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.25",
        "heading": "Tools",
        "lineStart": 14726,
        "lineEnd": 14744
      },
      "section": "10.25",
      "rulesText": "The Magic Item Tools table lists which tool is required to make a magic item of each category. You must use the required tool to make an item and have proficiency with that tool. Any assistants must also have proficiency with it. For more information on the tools, see “Equipment.”\n\nMagic Item Tools\n\n---",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/10-25-magic-item-tools"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-26-spells",
      "@type": "Rule",
      "name": "Spells",
      "slug": "10-26-spells",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.26",
        "heading": "Spells",
        "lineStart": 14746,
        "lineEnd": 14748
      },
      "section": "10.26",
      "rulesText": "If a magic item allows its user to cast any spells from it, you must have all those spells prepared every day you spend crafting the item."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-27-time-and-cost",
      "@type": "Rule",
      "name": "Time and Cost",
      "slug": "10-27-time-and-cost",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.27",
        "heading": "Time and Cost",
        "lineStart": 14750,
        "lineEnd": 14772
      },
      "section": "10.27",
      "rulesText": "Crafting a magic item takes an amount of time and money based on the item's rarity as shown in the Magic Item Crafting Time and Cost table.\n\nWork per Day. For each day of crafting, you must work for 8 hours. If an item requires multiple days, those days needn't be consecutive.\n\nAssistants. Characters can combine their efforts to shorten the crafting time. Divide the time needed to create an item by the number of characters working on it. Normally, only one other character can assist you, but the GM might allow more assistants.\n\nRaw Materials. The cost in the table represents the raw materials needed to make a magic item. The GM determines whether appropriate raw materials are available. In a city, there is a 75 percent chance that the materials are available, and in any other settlement, that chance is 25 percent. If materials aren't available, you must wait at least 7 days before checking on the availability again.\n\nIf a magic item incorporates an item that has a purchase cost (such as a weapon or a suit of armor), you must also pay that entire cost or craft that item using the rules in “Equipment.” For example, to make +1 Armor (Plate Armor), you must pay 3,500 GP or pay 2,000 GP and craft the armor.\n\nMagic Item Crafting Time and Cost\n\n*The time and cost are halved for a consumable item other than a Spell Scroll, whose crafting time and cost are given in “Equipment.”",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/10-27-magic-item-crafting-time-and-cost"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-28-sentient-magic-items",
      "@type": "Rule",
      "name": "Sentient Magic Items",
      "slug": "10-28-sentient-magic-items",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.28",
        "heading": "Sentient Magic Items",
        "lineStart": 14774,
        "lineEnd": 14780
      },
      "section": "10.28",
      "rulesText": "Some magic items have sentience and personality. Such an item might be possessed, haunted by the spirit of a previous owner, or self-aware thanks to the magic used to create it. A sentient item might be a cherished ally to its wielder or a continual thorn in the side.\n\nMost sentient items are weapons, but other kinds of items can manifest sentience. Single-use items such as potions and scrolls are never sentient.\n\nThe GM controls sentient magic items and their activated properties. A bearer who maintains a good relationship with the item can access those properties. If the relationship is strained, a conflict can ensue (see “Conflict” below)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-29-sentient-magic-item-traits",
      "@type": "Rule",
      "name": "Sentient Magic Item Traits",
      "slug": "10-29-sentient-magic-item-traits",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.29",
        "heading": "Sentient Magic Item Traits",
        "lineStart": 14782,
        "lineEnd": 14784
      },
      "section": "10.29",
      "rulesText": "When you make a sentient magic item, you create the item's persona much as you would create an NPC, with these exceptions."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-3-armor",
      "@type": "Rule",
      "name": "Armor",
      "slug": "10-3-armor",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.3",
        "heading": "Armor",
        "lineStart": 14573,
        "lineEnd": 14577
      },
      "section": "10.3",
      "rulesText": "An item in the Armor category is typically a magical version of armor from “Equipment.” Unless an armor’s description notes otherwise, the armor must be worn for its magic to function.\n\nSome suits of magic armor specify the type of armor they are, such as Chain Mail or Plate Armor. If no type is specified, choose the type or determine it randomly."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-30-abilities",
      "@type": "Rule",
      "name": "Abilities",
      "slug": "10-30-abilities",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.30",
        "heading": "Abilities",
        "lineStart": 14786,
        "lineEnd": 14788
      },
      "section": "10.30",
      "rulesText": "A sentient magic item has Intelligence, Wisdom, and Charisma scores. Choose the item's abilities, or determine them randomly as follows: roll 4d6 for each one, dropping the lowest roll and totaling the rest."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-31-alignment",
      "@type": "Rule",
      "name": "Alignment",
      "slug": "10-31-alignment",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.31",
        "heading": "Alignment",
        "lineStart": 14790,
        "lineEnd": 14792
      },
      "section": "10.31",
      "rulesText": "A sentient magic item has an alignment. Its creator or nature might suggest an alignment. Otherwise, pick an alignment or roll on the Sentient Item's Alignment table."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-32-communication",
      "@type": "Rule",
      "name": "Communication",
      "slug": "10-32-communication",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.32",
        "heading": "Communication",
        "lineStart": 14794,
        "lineEnd": 14796
      },
      "section": "10.32",
      "rulesText": "A sentient item communicates by sharing its emotions, broadcasting its thoughts telepathically, or speaking aloud. You can choose how it communicates or roll on the Sentient Item's Communication table."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-33-senses",
      "@type": "Rule",
      "name": "Senses",
      "slug": "10-33-senses",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.33",
        "heading": "Senses",
        "lineStart": 14798,
        "lineEnd": 14800
      },
      "section": "10.33",
      "rulesText": "A sentient item can perceive its surroundings out to a limited range. You can choose its senses or roll on the Sentient Item's Senses table."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-34-special-purpose",
      "@type": "Rule",
      "name": "Special Purpose",
      "slug": "10-34-special-purpose",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.34",
        "heading": "Special Purpose",
        "lineStart": 14802,
        "lineEnd": 14846
      },
      "section": "10.34",
      "rulesText": "You can give a sentient item an objective it pursues, perhaps to the exclusion of all else. As long as the wielder's use of the item aligns with that special purpose, the item remains cooperative. Deviating from this course might cause conflict between the wielder and the item (see “Conflict” below). You can pick a special purpose or roll on the Sentient Item's Special Purpose table.\n\nSentient Item's Alignment\n\nSentient Item's Communication\n\nSentient Item's Senses\n\nSentient Item's Special Purpose",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/10-34-sentient-items-alignment"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/10-34-sentient-items-communication"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/10-34-sentient-items-senses"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/10-34-sentient-items-special-purpose"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-35-conflict",
      "@type": "Rule",
      "name": "Conflict",
      "slug": "10-35-conflict",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.35",
        "heading": "Conflict",
        "lineStart": 14848,
        "lineEnd": 14864
      },
      "section": "10.35",
      "rulesText": "When the bearer of a sentient item acts in a manner opposed to the item's alignment or purpose, conflict can arise. When such a conflict occurs, the item's bearer makes a Charisma saving throw (DC 12 plus the item's Charisma modifier). On a failed save, the item makes one or more of the following demands:\n\nChase My Dreams. The item demands that its bearer pursue the item's goals to the exclusion of all other goals.\n\nGet Rid of It. The item demands that its bearer dispose of anything the item finds repugnant.\n\nIt's Time for a Change. The item demands to be given to someone else.\n\nKeep Me Close. The item insists on being carried or worn at all times.\n\nIf its bearer refuses to comply with the item's demands, the item can do any of the following:\n\n- Make it impossible for its bearer to attune to it.\n- Suppress one or more of its activated properties.\n- Attempt to take control of its bearer, whereupon the bearer makes a Charisma saving throw (DC 12 plus the item's Charisma modifier). On a failed save, the bearer has the Charmed condition for 1d12 hours. While Charmed in this way, the bearer must try to follow the item's commands. If the bearer takes damage, it repeats the save, ending the effect on a success. Whether or not the attempt to control its bearer succeeds, the item can't use this power again until the next dawn."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-36-magic-items-a-z",
      "@type": "Rule",
      "name": "Magic Items A-Z",
      "slug": "10-36-magic-items-a-z",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.36",
        "heading": "Magic Items A-Z",
        "lineStart": 14866,
        "lineEnd": 14870
      },
      "section": "10.36",
      "rulesText": "Magic items are presented in alphabetical order.\n\nIf a magic item description capitalizes a creature's name and presents it in bold type, that's a visual cue pointing you to the creature's stat block. Unless the text states otherwise, the stat block is in “Monsters.” How to read and use a stat block is explained in “Monsters.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-4-potions",
      "@type": "Rule",
      "name": "Potions",
      "slug": "10-4-potions",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.4",
        "heading": "Potions",
        "lineStart": 14579,
        "lineEnd": 14600
      },
      "section": "10.4",
      "rulesText": "An item in the Potion category might be a magical brew that must be imbibed or an oil that must be applied to a creature or an object. A typical potion consists of 1 ounce of liquid in a vial.\n\nUsing a Potion. Potions are consumable items. Drinking a potion or administering it to another creature requires a Bonus Action. Applying an oil might take longer as specified in its description. Once used, a potion takes effect immediately, and it is used up.\n\nMixing Potions. A character might drink one potion while still under the effects of another or pour several potions into a single container. The strange ingredients used in creating potions can result in unpredictable interactions.\n\nWhen a character mixes two potions together, roll on the Potion Miscibility table. If more than two are combined, roll again for each subsequent potion, combining the results. Unless the effects are immediately obvious, reveal them only when they become evident.\n\nPotion Miscibility",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/10-4-potion-miscibility"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-5-rings",
      "@type": "Rule",
      "name": "Rings",
      "slug": "10-5-rings",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.5",
        "heading": "Rings",
        "lineStart": 14602,
        "lineEnd": 14604
      },
      "section": "10.5",
      "rulesText": "For its magic to function, an item in the Ring category must be worn on a finger or a similar digit unless its description notes otherwise."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-6-rods",
      "@type": "Rule",
      "name": "Rods",
      "slug": "10-6-rods",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.6",
        "heading": "Rods",
        "lineStart": 14606,
        "lineEnd": 14610
      },
      "section": "10.6",
      "rulesText": "An item in the Rod category is a scepter usually made of metal, wood, or bone. A typical rod weighs 2 to 5 pounds.\n\nUnless its description notes otherwise, a rod can be used as an Arcane Focus."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-7-scrolls",
      "@type": "Rule",
      "name": "Scrolls",
      "slug": "10-7-scrolls",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.7",
        "heading": "Scrolls",
        "lineStart": 14612,
        "lineEnd": 14618
      },
      "section": "10.7",
      "rulesText": "An item in the Scroll category is a roll of paper or parchment, sometimes attached to wooden rods and typically kept safe in a tube of ivory, jade, leather, metal, or wood. The most prevalent scroll is the Spell Scroll, a spell stored in written form.\n\nUsing a Scroll. Scrolls are consumable items. Unleashing the magic in a scroll requires the user to read the scroll. When its magic has been invoked, the scroll can't be used again. Its words fade, or it crumbles into dust.\n\nAny creature that can understand a written language can read a scroll and attempt to activate it unless its description notes otherwise."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-8-staffs",
      "@type": "Rule",
      "name": "Staffs",
      "slug": "10-8-staffs",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.8",
        "heading": "Staffs",
        "lineStart": 14620,
        "lineEnd": 14624
      },
      "section": "10.8",
      "rulesText": "Items in the Staff category vary widely in appearance: some are of nearly equal diameter throughout and smooth, others are gnarled and twisted, some are made of wood, and others are composed of polished metal or crystal. A staff weighs between 2 and 7 pounds and serves well as a walking stick or cane.\n\nUnless its description notes otherwise, a staff can be used as a nonmagical Quarterstaff and an Arcane Focus."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/10-9-wands",
      "@type": "Rule",
      "name": "Wands",
      "slug": "10-9-wands",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Magic Items",
        "section": "10.9",
        "heading": "Wands",
        "lineStart": 14626,
        "lineEnd": 14630
      },
      "section": "10.9",
      "rulesText": "An item in the Wand category is typically 12 to 15 inches long and crafted of metal, bone, or wood. It is tipped with metal, crystal, stone, or some other material.\n\nUnless its description notes otherwise, a wand can be used as an Arcane Focus."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-1-monsters",
      "@type": "Rule",
      "name": "Monsters",
      "slug": "11-1-monsters",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.1",
        "heading": "Monsters",
        "lineStart": 17785,
        "lineEnd": 17785
      },
      "section": "11.1"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-10-hit-points",
      "@type": "Rule",
      "name": "Hit Points",
      "slug": "11-10-hit-points",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.10",
        "heading": "Hit Points",
        "lineStart": 17869,
        "lineEnd": 17888
      },
      "section": "11.10",
      "rulesText": "A monster's Hit Points are presented as a number followed by parentheses, where the monster's Hit Point Dice are provided, along with any contribution from its Constitution. Either use the number for the monster's Hit Points or roll the die expression in parentheses to determine the monster's Hit Points randomly; don't use both.\n\nA monster's size typically determines the die used to calculate its Hit Points, as shown in the Hit Dice by Size table.\n\nHit Dice by Size\n\nA monster's Constitution modifier is multiplied by the number of Hit Dice it possesses, and the result is added to its Hit Points. For example, if a monster has a Constitution of 12 (+1 modifier) and 2d8 Hit Dice, it has 2d8 + 2 Hit Points (average 11).\n\nFor more on Hit Points, see “Playing the Game.”",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/11-10-hit-dice-by-size"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-11-speed",
      "@type": "Rule",
      "name": "Speed",
      "slug": "11-11-speed",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.11",
        "heading": "Speed",
        "lineStart": 17890,
        "lineEnd": 17892
      },
      "section": "11.11",
      "rulesText": "The Speed entry specifies a monster's Speed. Some monsters have one or more of the following speeds: Burrow, Climb, Fly, Swim. Rules for Speed and these specials speeds appear in “Rules Glossary.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-12-ability-scores",
      "@type": "Rule",
      "name": "Ability Scores",
      "slug": "11-12-ability-scores",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.12",
        "heading": "Ability Scores",
        "lineStart": 17894,
        "lineEnd": 17896
      },
      "section": "11.12",
      "rulesText": "Every monster has six ability scores along with corresponding ability score modifiers and saving throw modifiers. For more information on ability scores and saving throws, see “Playing the Game.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-13-skills",
      "@type": "Rule",
      "name": "Skills",
      "slug": "11-13-skills",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.13",
        "heading": "Skills",
        "lineStart": 17898,
        "lineEnd": 17900
      },
      "section": "11.13",
      "rulesText": "The Skills entry specifies a monster's skill proficiencies, if any. For example, a monster that is very perceptive and stealthy might have bonuses to Wisdom (Perception) and Dexterity (Stealth) checks. A skill bonus is the sum of a monster's relevant ability modifier and its Proficiency Bonus. Other modifiers might apply."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-14-resistances-and-vulnerabilities",
      "@type": "Rule",
      "name": "Resistances and Vulnerabilities",
      "slug": "11-14-resistances-and-vulnerabilities",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.14",
        "heading": "Resistances and Vulnerabilities",
        "lineStart": 17902,
        "lineEnd": 17904
      },
      "section": "11.14",
      "rulesText": "These entries list a monster's Resistances and Vulnerabilities, if any. See “Playing the Game” for more information."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-15-running-a-monster",
      "@type": "Rule",
      "name": "RUNNING A MONSTER",
      "slug": "11-15-running-a-monster",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.15",
        "heading": "RUNNING A MONSTER",
        "lineStart": 17906,
        "lineEnd": 17914
      },
      "section": "11.15",
      "rulesText": "To ensure a monster acts in accordance with its Challenge Rating, follow these rules during combat:\n\nSpecial Abilities. If the monster has a special ability that deals a lot of damage but has a limited number of uses, such as a recharging breath weapon or a spell it can cast only once per day, have it use that special ability as quickly and as often as possible.\n\nMultiattack. If the monster has Multiattack, have it use Multiattack on any of its turns in which it's not using one of its more powerful abilities.\n\nBonus Actions, Reactions, Legendary Actions. If the monster has Bonus Actions, Reactions, or Legendary Actions in its stat block, make sure it uses them as often as it can."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-16-immunities",
      "@type": "Rule",
      "name": "Immunities",
      "slug": "11-16-immunities",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.16",
        "heading": "Immunities",
        "lineStart": 17916,
        "lineEnd": 17918
      },
      "section": "11.16",
      "rulesText": "This entry lists the monster's Immunities, if any. If the monster has damage and condition Immunities, the damage types are listed before the conditions. See “Playing the Game” for details."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-17-gear",
      "@type": "Rule",
      "name": "Gear",
      "slug": "11-17-gear",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.17",
        "heading": "Gear",
        "lineStart": 17920,
        "lineEnd": 17926
      },
      "section": "11.17",
      "rulesText": "Monsters have proficiency with their equipment. If a monster has equipment that can be given away or retrieved, the items are listed in the Gear entry. The monster's stat block might include special flourishes that happen when the monster uses an item, and the stat block might ignore the rules in “Equipment” for that item. When used by someone else, a retrievable item uses its “Equipment” rules, ignoring any special flourishes in the stat block.\n\nThe Gear entry doesn't necessarily list all of a monster's equipment. For example, a monster that wears clothes is assumed to be dressed appropriately, and those clothes aren't in this entry.\n\nEquipment mentioned outside the Gear entry is considered to be supernatural or highly specialized, and it is unusable when the monster is defeated."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-18-ammunition-and-ranged-attacks",
      "@type": "Rule",
      "name": "Ammunition and Ranged Attacks",
      "slug": "11-18-ammunition-and-ranged-attacks",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.18",
        "heading": "Ammunition and Ranged Attacks",
        "lineStart": 17928,
        "lineEnd": 17930
      },
      "section": "11.18",
      "rulesText": "A monster that requires ammunition to make ranged attacks carries the necessary ammunition."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-19-equipping-a-monster-with-other-items",
      "@type": "Rule",
      "name": "Equipping a Monster with Other Items",
      "slug": "11-19-equipping-a-monster-with-other-items",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.19",
        "heading": "Equipping a Monster with Other Items",
        "lineStart": 17932,
        "lineEnd": 17936
      },
      "section": "11.19",
      "rulesText": "You may equip monsters with additional gear however you like, using the items in “Equipment” for inspiration. You decide how much of a monster’s equipment is recoverable after the creature is slain and whether any of that equipment is still usable.\n\nBeware of giving a monster combat-oriented magic items, since those might alter the monster's Challenge Rating. If you do give a monster a magic item, the monster can have Attunement with magic items as noted in “Equipment.” A monster with a class tag after its creature type is considered a member of that class for Attunement purposes."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-2-stat-block-overview",
      "@type": "Rule",
      "name": "Stat Block Overview",
      "slug": "11-2-stat-block-overview",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.2",
        "heading": "Stat Block Overview",
        "lineStart": 17787,
        "lineEnd": 17805
      },
      "section": "11.2",
      "rulesText": "A monster has a stat block that contains the rules necessary to use it in the game. Stat blocks are divided into the following parts:\n\nName and General Details. The name of the monster is followed by its size, creature type (along with any descriptive tags), and alignment.\n\nCombat Highlights. Armor Class, Hit Points, Speed, and Initiative are provided here.\n\nAbility Scores. A monster's ability scores, ability modifiers, and saving throws are listed here.\n\nOther Details. The monster's Senses, Languages, and CR entries appear here. Additional details appear in some monsters, such as skill proficiencies, Resistances, Immunities, and Gear. If a monster lacks those details, entries for them don't appear.\n\nTraits. Monster characteristics that are active at all times or during certain situations appear here.\n\nActions. The monster can take the actions here in addition to those in “Playing the Game.”\n\nBonus Actions. This section provides a monster's Bonus Actions, if any.\n\nReactions and Legendary Actions. These sections provide Reactions and Legendary Actions, if any."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-20-senses",
      "@type": "Rule",
      "name": "Senses",
      "slug": "11-20-senses",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.20",
        "heading": "Senses",
        "lineStart": 17938,
        "lineEnd": 17940
      },
      "section": "11.20",
      "rulesText": "The Senses entry specifies a monster's Passive Perception score, as well as any special senses the monster possesses. Passive Perception and special senses are described in “Rules Glossary.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-21-languages",
      "@type": "Rule",
      "name": "Languages",
      "slug": "11-21-languages",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.21",
        "heading": "Languages",
        "lineStart": 17942,
        "lineEnd": 17944
      },
      "section": "11.21",
      "rulesText": "This entry lists languages that the monster can use to communicate. Sometimes a monster can understand a language but can't communicate with it, which is noted in its entry. \"None\" indicates that a creature doesn't comprehend any language."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-22-telepathy",
      "@type": "Rule",
      "name": "Telepathy",
      "slug": "11-22-telepathy",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.22",
        "heading": "Telepathy",
        "lineStart": 17946,
        "lineEnd": 17948
      },
      "section": "11.22",
      "rulesText": "Telepathy is a magical ability that allows a creature to communicate mentally with another creature within a specified range. See “Rules Glossary” for more information."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-23-challenge-rating",
      "@type": "Rule",
      "name": "Challenge Rating",
      "slug": "11-23-challenge-rating",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.23",
        "heading": "Challenge Rating",
        "lineStart": 17950,
        "lineEnd": 17952
      },
      "section": "11.23",
      "rulesText": "Challenge Rating is defined in “Rules Glossary,” while guidance on using CR to plan potential combat encounters is in “Gameplay Toolbox.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-24-experience-points",
      "@type": "Rule",
      "name": "Experience Points",
      "slug": "11-24-experience-points",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.24",
        "heading": "Experience Points",
        "lineStart": 17954,
        "lineEnd": 17983
      },
      "section": "11.24",
      "rulesText": "The number of Experience Points (XP) a monster is worth is based on its CR, as detailed in the Experience Points by Challenge Rating table. XP is awarded for defeating the monster in combat or otherwise neutralizing it.\n\nUnless a rule says otherwise, a monster summoned by a spell or another magical ability is worth the XP noted in its stat block.\n\nExperience Points by Challenge Rating",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/11-24-experience-points-by-challenge-rating"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/11-24-experience-points-by-challenge-rating-2"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-25-proficiency-bonus",
      "@type": "Rule",
      "name": "Proficiency Bonus",
      "slug": "11-25-proficiency-bonus",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.25",
        "heading": "Proficiency Bonus",
        "lineStart": 17985,
        "lineEnd": 17996
      },
      "section": "11.25",
      "rulesText": "A monster's Proficiency Bonus (PB) is determined by its CR, as shown in the Proficiency Bonus by Challenge Rating table, and is reflected in saving throws, skills, and other statistics where the monster's exceptional aptitude is a factor.\n\nProficiency Bonus by Challenge Rating",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/11-25-proficiency-bonus-by-challenge-rating"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-26-traits",
      "@type": "Rule",
      "name": "Traits",
      "slug": "11-26-traits",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.26",
        "heading": "Traits",
        "lineStart": 17998,
        "lineEnd": 18000
      },
      "section": "11.26",
      "rulesText": "A monster's traits, if any, are features that are active at all times or in certain situations."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-27-actions",
      "@type": "Rule",
      "name": "Actions",
      "slug": "11-27-actions",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.27",
        "heading": "Actions",
        "lineStart": 18002,
        "lineEnd": 18004
      },
      "section": "11.27",
      "rulesText": "A monster can take the actions in this section or take one of the actions available to all creatures, as described in “Playing the Game.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-28-attack-notation",
      "@type": "Rule",
      "name": "Attack Notation",
      "slug": "11-28-attack-notation",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.28",
        "heading": "Attack Notation",
        "lineStart": 18006,
        "lineEnd": 18014
      },
      "section": "11.28",
      "rulesText": "The entry for a monster's attack identifies whether the attack is a melee or a ranged attack and then provides the attack roll's bonus, its reach or range, and what happens on a hit. An attack is against one target unless its entry says otherwise. For details on different kinds of attacks, see “Playing the Game” and “Spells.”\n\nHit. Any damage dealt or other effects that occur as a result of an attack hitting a target are described after the “Hit:” notation.\n\nMiss. If an attack has an effect that occurs on a miss, that information follows the “Miss:” notation.\n\nHit or Miss. If an attack has an effect that occurs regardless of whether it hits or misses its target, that information follows the “Hit or Miss:” notation."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-29-saving-throw-effect-notation",
      "@type": "Rule",
      "name": "Saving Throw Effect Notation",
      "slug": "11-29-saving-throw-effect-notation",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.29",
        "heading": "Saving Throw Effect Notation",
        "lineStart": 18016,
        "lineEnd": 18020
      },
      "section": "11.29",
      "rulesText": "If an effect forces a saving throw, the effect identifies the kind of save required and then provides the save's DC, a description of which creatures make the save, and an explanation of what happens on a failed or successful save.\n\n“Half damage only” on a successful save means the target takes half as much damage (round down) as targets that fail the save, while also ignoring all other parts of the effect."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-3-parts-of-a-stat-block",
      "@type": "Rule",
      "name": "Parts of a Stat Block",
      "slug": "11-3-parts-of-a-stat-block",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.3",
        "heading": "Parts of a Stat Block",
        "lineStart": 17807,
        "lineEnd": 17809
      },
      "section": "11.3",
      "rulesText": "The rules for a stat block are detailed in “Rules Glossary” and in this section."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-30-damage-notation",
      "@type": "Rule",
      "name": "Damage Notation",
      "slug": "11-30-damage-notation",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.30",
        "heading": "Damage Notation",
        "lineStart": 18022,
        "lineEnd": 18024
      },
      "section": "11.30",
      "rulesText": "A stat block usually provides both a number and a die expression for each instance of damage. For example, an attack might deal 4 (1d4 + 2) damage on a hit. You decide whether to use the number or the die expression in parentheses; don't use both."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-31-multiattack",
      "@type": "Rule",
      "name": "Multiattack",
      "slug": "11-31-multiattack",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.31",
        "heading": "Multiattack",
        "lineStart": 18026,
        "lineEnd": 18028
      },
      "section": "11.31",
      "rulesText": "Some creatures can make more than one attack when they take the Attack action. Such creatures have the Multiattack entry in the “Actions” section of their stat block. This entry details the attacks a creature can make, as well as any additional abilities it can use, as part of the Attack action."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-32-spellcasting",
      "@type": "Rule",
      "name": "Spellcasting",
      "slug": "11-32-spellcasting",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.32",
        "heading": "Spellcasting",
        "lineStart": 18030,
        "lineEnd": 18038
      },
      "section": "11.32",
      "rulesText": "If a monster can cast any spells, its stat block lists the spells and provides the monster's spellcasting ability, spell save DC (if any spells require a saving throw), and spell attack bonus (if any spells require an attack roll). Unless noted otherwise, a spell of level 1 or higher is always cast at its lowest possible level and can't be cast at a higher level.\n\nA monster's spell can have special rules or restrictions. For example, a green hag can cast the Invisibility spell, but the spell has a “self only” restriction, which means the spell affects only the hag.\n\nSpell Components. The Spellcasting trait notes whether the monster's spellcasting ignores the need for certain spell components. If any spell components are required, describe the monster's use of Verbal, Somatic, or Material components to signal to characters that it is casting a spell. A monster that requires Material components has them.\n\nCasting Times of 1+ Minutes. If a spell has a casting time of 1 minute or more yet is listed in a spellcasting action, the monster doesn't cast the spell in just one action unless the action's description states otherwise; the monster must take the Magic action on each of its turns and maintain Concentration to cast the spell, as described in \"Rules Glossary.\""
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-33-bonus-action",
      "@type": "Rule",
      "name": "Bonus Action",
      "slug": "11-33-bonus-action",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.33",
        "heading": "Bonus Action",
        "lineStart": 18040,
        "lineEnd": 18042
      },
      "section": "11.33",
      "rulesText": "If a monster has Bonus Action options, they are listed in this section. See “Playing the Game” for details on Bonus Actions."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-34-reactions",
      "@type": "Rule",
      "name": "Reactions",
      "slug": "11-34-reactions",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.34",
        "heading": "Reactions",
        "lineStart": 18044,
        "lineEnd": 18046
      },
      "section": "11.34",
      "rulesText": "If the monster has Reaction options, those are listed in this section along with their triggers. See “Playing the Game” for details on Reactions."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-35-legendary-actions",
      "@type": "Rule",
      "name": "Legendary Actions",
      "slug": "11-35-legendary-actions",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.35",
        "heading": "Legendary Actions",
        "lineStart": 18048,
        "lineEnd": 18052
      },
      "section": "11.35",
      "rulesText": "If the monster has Legendary Action options, those are listed in this section. A Legendary Action is an action that a monster can take immediately after another creature's turn. Only one of these actions can be taken at a time and only after another creature's turn ends. The monster can't take a Legendary Action if it has the Incapacitated condition or is otherwise unable to take actions.\n\nThe monster has a limited number of Legendary Action uses, and that number is specified in the stat block. The monster expends one use whenever it takes a Legendary Action, and it regains all expended uses at the start of each of its turns."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-36-limited-usage",
      "@type": "Rule",
      "name": "Limited Usage",
      "slug": "11-36-limited-usage",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.36",
        "heading": "Limited Usage",
        "lineStart": 18054,
        "lineEnd": 18064
      },
      "section": "11.36",
      "rulesText": "Some parts of a stat block have restrictions on the number of times they can be used. Here are the most common ways that usage is limited:\n\nX/Day. This notation means the stat block part can be used a certain number of times (represented by X) and that a monster must finish a Long Rest to regain expended uses. For example, a Reaction that includes “1/Day” means the Reaction can be taken once and that the monster must finish a Long Rest to take it again.\n\nRecharge X–Y. This notation means a monster can use the stat block part once. At the start of each of the monster's turns, roll 1d6. If the roll is within the number range given in the notation (represented by X–Y), the monster regains the use of that part, which also recharges when the monster finishes a Short or Long Rest. For example, \"Recharge 5–6\" in an action means a monster can take the action once. Then, at the start of each of the monster's turns, it regains the use of that action if it rolls a 5 or 6 on 1d6.\n\nRecharge after a Short or Long Rest. This notation means the monster can use the stat block part once and must then finish a Short or Long Rest to use it again.\n\n---"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-4-size",
      "@type": "Rule",
      "name": "Size",
      "slug": "11-4-size",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.4",
        "heading": "Size",
        "lineStart": 17811,
        "lineEnd": 17813
      },
      "section": "11.4",
      "rulesText": "A monster is Tiny, Small, Medium, Large, Huge, or Gargantuan. If size options are presented, you choose the creature's size from those options. See \"Playing the Game\" for information on size."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-5-creature-type",
      "@type": "Rule",
      "name": "Creature Type",
      "slug": "11-5-creature-type",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.5",
        "heading": "Creature Type",
        "lineStart": 17815,
        "lineEnd": 17847
      },
      "section": "11.5",
      "rulesText": "Each monster has a tag that identifies the type of creature it is. Certain spells, magic items, class features, and other effects in the game interact in special ways with creatures of a particular type.\n\nThe game includes the following creature types, which have no rules of their own:\n\nAberrations are utterly alien beings, such as aboleths and cloakers.\n\nBeasts are non-Humanoid natural creatures, like horses and wolves, as well as most giant animals.\n\nCelestials are magical creatures, such as angels and pegasi, with ties to the Upper Planes.\n\nConstructs are magically created creatures such as homunculi and shield guardians.\n\nDragons are scaly beings of ancient origin, such as red dragons and wyverns.\n\nElementals are beings from the Elemental Planes, such as efreet and water elementals.\n\nFey are creatures tied to the Feywild or the forces of nature, such as dryads and goblins.\n\nFiends are creatures tied to terrifying Lower Planes, such as balors and hell hounds.\n\nGiants are towering beings with humanlike shapes, like fire giants and trolls.\n\nHumanoids are people defined by their roles and professions, such as mages, pirates, and warriors. They include members of varied species.\n\nMonstrosities are unnatural creatures with strange origins, such as mimics and owlbears.\n\nOozes are gelatinous creatures, including black puddings and gelatinous cubes.\n\nPlants are sentient vegetation and fungal monsters, such as shambling mounds and treants.\n\nUndead are spirits and the reanimated dead, such as ghosts, vampires, and zombies."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-6-descriptive-tags",
      "@type": "Rule",
      "name": "Descriptive Tags",
      "slug": "11-6-descriptive-tags",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.6",
        "heading": "Descriptive Tags",
        "lineStart": 17849,
        "lineEnd": 17851
      },
      "section": "11.6",
      "rulesText": "A monster might have one or more tags in parentheses following its type. Such tags provide additional categorization and have no rules of their own, but certain game effects might refer to them."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-7-alignment",
      "@type": "Rule",
      "name": "Alignment",
      "slug": "11-7-alignment",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.7",
        "heading": "Alignment",
        "lineStart": 17853,
        "lineEnd": 17857
      },
      "section": "11.7",
      "rulesText": "The alignment specified in a monster's stat block is a default suggestion of how to roleplay the monster, inspired by its traditional role in the game or real-world folklore. Change a monster's alignment to suit your storytelling needs. The Neutral alignment, in particular, is an invitation for you to consider whether an individual leans toward one of the other alignments.\n\n\"Character Creation\" describes the nine alignments and unaligned creatures."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-8-armor-class",
      "@type": "Rule",
      "name": "Armor Class",
      "slug": "11-8-armor-class",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.8",
        "heading": "Armor Class",
        "lineStart": 17859,
        "lineEnd": 17861
      },
      "section": "11.8",
      "rulesText": "A monster's Armor Class (AC) includes its natural armor, Dexterity, gear, and other defenses. See \"Playing the Game\" for information on Armor Class."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/11-9-initiative",
      "@type": "Rule",
      "name": "Initiative",
      "slug": "11-9-initiative",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Monsters",
        "section": "11.9",
        "heading": "Initiative",
        "lineStart": 17863,
        "lineEnd": 17867
      },
      "section": "11.9",
      "rulesText": "The Initiative entry specifies the monster's Initiative modifier followed by the monster's Initiative score in parentheses. Use the modifier when you roll to determine a monster's Initiative. A monster's Initiative modifier is typically equal to its Dexterity modifier, but some monsters have additional modifiers, such as Proficiency Bonus, applied to that number.\n\nIf you don't want to roll a monster's Initiative, use the Initiative score as the monster's Initiative in combat. Initiative is further detailed in “Playing the Game.”"
    },
