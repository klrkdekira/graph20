              }
            },
            {
              "averageDamage": 36,
              "damageType": "Radiant",
              "damageRoll": {
                "expression": "8d8",
                "count": 8,
                "sides": 8
              }
            }
          ],
          "sourceText": "Flying Sword. Melee or Ranged Attack Roll: +15, reach 10 ft. or range 120 ft. Hit: 22 (4d6 + 8) Slashing damage plus 36 (8d8) Radiant damage. Hit or Miss: The sword magically returns to the solar's hand or hovers within 5 feet of the solar immediately after a ranged attack.",
          "path": "statSections[1].rulesText.paragraphs[1]",
          "parseStatus": "parsed",
          "attackBonus": 15,
          "reachFeet": 10,
          "rangeFeet": {
            "normal": 120
          }
