          ],
          "sourceText": "Crush. Melee Attack Roll: +5, reach 5 ft. Hit: 6 (1d6 + 3) Bludgeoning damage, and the darkmantle attaches to the target. If the target is a Medium or smaller creature and the darkmantle had Advantage on the attack roll, it covers the target, which has the Blinded condition and is suffocating while the darkmantle is attached in this way.",
          "path": "statSections[0].rulesText.paragraphs[0]",
          "parseStatus": "parsed",
          "attackBonus": 5,
          "reachFeet": 5
        }
