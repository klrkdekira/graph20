      "sizeAndType": "Gargantuan Monstrosity",
      "alignment": "Unaligned",
      "armorClass": "18",
      "initiative": "+3 (13)",
      "hitPoints": "247 (15d20 + 90)",
      "speed": "50 ft., Burrow 50 ft.",
      "senses": "Blindsight 30 ft., Tremorsense 60 ft.; Passive Perception 9",
