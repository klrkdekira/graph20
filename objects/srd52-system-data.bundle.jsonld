      "@id": "https://cheeleong.dev/graph20/objects/monsters/rakshasa",
      "@type": "Monster",
      "name": "Rakshasa",
      "slug": "rakshasa",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
