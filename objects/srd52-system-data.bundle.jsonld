    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-6-properties",
      "@type": "Rule",
      "name": "Properties",
      "slug": "6-6-properties",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.6",
        "heading": "Properties",
        "lineStart": 5979,
        "lineEnd": 5981
      },
      "section": "6.6",
      "rulesText": "Here are definitions of the properties in the Properties column of the Weapons table."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-60-thieves-tools-25-gp",
      "@type": "Rule",
      "name": "Thieves' Tools (25 GP)",
      "slug": "6-60-thieves-tools-25-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.60",
        "heading": "Thieves' Tools (25 GP)",
        "lineStart": 6392,
        "lineEnd": 6398
      },
      "section": "6.60",
      "rulesText": "Ability: Dexterity\n\nWeight: 1 lb.\n\nUtilize: Pick a lock (DC 15), or disarm a trap (DC 15)"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-61-adventuring-gear",
      "@type": "Rule",
      "name": "Adventuring Gear",
      "slug": "6-61-adventuring-gear",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.61",
        "heading": "Adventuring Gear",
        "lineStart": 6400,
        "lineEnd": 6402
      },
      "section": "6.61",
      "rulesText": "The Adventuring Gear table in this section includes gear that adventurers often find useful. These items are described here in alphabetical order, with an item's price appearing after its name."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-62-acid-25-gp",
      "@type": "Rule",
      "name": "Acid (25 GP)",
      "slug": "6-62-acid-25-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.62",
        "heading": "Acid (25 GP)",
        "lineStart": 6404,
        "lineEnd": 6406
      },
      "section": "6.62",
      "rulesText": "When you take the Attack action, you can replace one of your attacks with throwing a vial of Acid. Target one creature or object you can see within 20 feet of yourself. The target must succeed on a Dexterity saving throw (DC 8 plus your Dexterity modifier and Proficiency Bonus) or take 2d6 Acid damage."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-63-alchemists-fire-50-gp",
      "@type": "Rule",
      "name": "Alchemist's Fire (50 GP)",
      "slug": "6-63-alchemists-fire-50-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.63",
        "heading": "Alchemist's Fire (50 GP)",
        "lineStart": 6408,
        "lineEnd": 6410
      },
      "section": "6.63",
      "rulesText": "When you take the Attack action, you can replace one of your attacks with throwing a flask of Alchemist's Fire. Target one creature or object you can see within 20 feet of yourself. The target must succeed on a Dexterity saving throw (DC 8 plus your Dexterity modifier and Proficiency Bonus) or take 1d4 Fire damage and start burning (see “Rules Glossary”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-64-ammunition-varies",
      "@type": "Rule",
      "name": "Ammunition (Varies)",
      "slug": "6-64-ammunition-varies",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.64",
        "heading": "Ammunition (Varies)",
        "lineStart": 6412,
        "lineEnd": 6514
      },
      "section": "6.64",
      "rulesText": "Ammunition is required by a weapon that has the Ammunition property. A weapon's description specifies the type of ammunition used by the weapon. The Ammunition table lists the different types and the amount you get when you buy them. The table also lists the item that is typically used to store each type; storage must be bought separately.\n\nAdventuring Gear\n\nAmmunition",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/6-64-adventuring-gear"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/6-64-adventuring-gear-2"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/6-64-ammunition"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-65-antitoxin-50-gp",
      "@type": "Rule",
      "name": "Antitoxin (50 GP)",
      "slug": "6-65-antitoxin-50-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.65",
        "heading": "Antitoxin (50 GP)",
        "lineStart": 6516,
        "lineEnd": 6518
      },
      "section": "6.65",
      "rulesText": "As a Bonus Action, you can drink a vial of Antitoxin to gain Advantage on saving throws to avoid or end the Poisoned condition for 1 hour."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-66-arcane-focus-varies",
      "@type": "Rule",
      "name": "Arcane Focus (Varies)",
      "slug": "6-66-arcane-focus-varies",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.66",
        "heading": "Arcane Focus (Varies)",
        "lineStart": 6520,
        "lineEnd": 6532
      },
      "section": "6.66",
      "rulesText": "An Arcane Focus takes one of the forms in the Arcane Focuses table and is be jeweled or carved to channel arcane magic. A Sorcerer, Warlock, or Wizard can use such an item as a Spellcasting Focus.\n\nArcane Focuses",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/6-66-arcane-focuses"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-67-backpack-2-gp",
      "@type": "Rule",
      "name": "Backpack (2 GP)",
      "slug": "6-67-backpack-2-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.67",
        "heading": "Backpack (2 GP)",
        "lineStart": 6534,
        "lineEnd": 6536
      },
      "section": "6.67",
      "rulesText": "A Backpack holds up to 30 pounds within 1 cubic foot. It can also serve as a saddlebag."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-68-ball-bearings-1-gp",
      "@type": "Rule",
      "name": "Ball Bearings (1 GP)",
      "slug": "6-68-ball-bearings-1-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.68",
        "heading": "Ball Bearings (1 GP)",
        "lineStart": 6538,
        "lineEnd": 6540
      },
      "section": "6.68",
      "rulesText": "As a Utilize action, you can spill Ball Bearings from their pouch. They spread to cover a level, 10-foot-square area within 10 feet of yourself. A creature that enters this area for the first time on a turn must succeed on a DC 10 Dexterity saving throw or have the Prone condition. It takes 10 minutes to recover the Ball Bearings."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-69-barrel-2-gp",
      "@type": "Rule",
      "name": "Barrel (2 GP)",
      "slug": "6-69-barrel-2-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.69",
        "heading": "Barrel (2 GP)",
        "lineStart": 6542,
        "lineEnd": 6544
      },
      "section": "6.69",
      "rulesText": "A Barrel holds up to 40 gallons of liquid or up to 4 cubic feet of dry goods."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-7-ammunition",
      "@type": "Rule",
      "name": "Ammunition",
      "slug": "6-7-ammunition",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.7",
        "heading": "Ammunition",
        "lineStart": 5983,
        "lineEnd": 5985
      },
      "section": "6.7",
      "rulesText": "You can use a weapon that has the Ammunition property to make a ranged attack only if you have ammunition to fire from it. The type of ammunition required is specified with the weapon's range. Each attack expends one piece of ammunition. Drawing the ammunition is part of the attack (you need a free hand to load a one-handed weapon). After a fight, you can spend 1 minute to recover half the ammunition (round down) you used in the fight; the rest is lost."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-70-basket-4-sp",
      "@type": "Rule",
      "name": "Basket (4 SP)",
      "slug": "6-70-basket-4-sp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.70",
        "heading": "Basket (4 SP)",
        "lineStart": 6546,
        "lineEnd": 6548
      },
      "section": "6.70",
      "rulesText": "A Basket holds up to 40 pounds within 2 cubic feet."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-71-bedroll-1-gp",
      "@type": "Rule",
      "name": "Bedroll (1 GP)",
      "slug": "6-71-bedroll-1-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.71",
        "heading": "Bedroll (1 GP)",
        "lineStart": 6550,
        "lineEnd": 6552
      },
      "section": "6.71",
      "rulesText": "A Bedroll sleeps one Small or Medium creature. While in a Bedroll, you automatically succeed on saving throws against extreme cold (see “Gameplay Toolbox”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-72-bell-1-gp",
      "@type": "Rule",
      "name": "Bell (1 GP)",
      "slug": "6-72-bell-1-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.72",
        "heading": "Bell (1 GP)",
        "lineStart": 6554,
        "lineEnd": 6556
      },
      "section": "6.72",
      "rulesText": "When rung as a Utilize action, a Bell produces a sound that can be heard up to 60 feet away."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-73-blanket-5-sp",
      "@type": "Rule",
      "name": "Blanket (5 SP)",
      "slug": "6-73-blanket-5-sp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.73",
        "heading": "Blanket (5 SP)",
        "lineStart": 6558,
        "lineEnd": 6560
      },
      "section": "6.73",
      "rulesText": "While wrapped in a blanket, you have Advantage on saving throws against extreme cold (see “Gameplay Toolbox”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-74-block-and-tackle-1-gp",
      "@type": "Rule",
      "name": "Block and Tackle (1 GP)",
      "slug": "6-74-block-and-tackle-1-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.74",
        "heading": "Block and Tackle (1 GP)",
        "lineStart": 6562,
        "lineEnd": 6564
      },
      "section": "6.74",
      "rulesText": "A Block and Tackle allows you to hoist up to four times the weight you can normally lift."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-75-book-25-gp",
      "@type": "Rule",
      "name": "Book (25 GP)",
      "slug": "6-75-book-25-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.75",
        "heading": "Book (25 GP)",
        "lineStart": 6566,
        "lineEnd": 6568
      },
      "section": "6.75",
      "rulesText": "A Book contains fiction or nonfiction. If you consult an accurate nonfiction Book about its topic, you gain a +5 bonus to Intelligence (Arcana, History, Nature, or Religion) checks you make about that topic."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-76-bottle-glass-2-gp",
      "@type": "Rule",
      "name": "Bottle, Glass (2 GP)",
      "slug": "6-76-bottle-glass-2-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.76",
        "heading": "Bottle, Glass (2 GP)",
        "lineStart": 6570,
        "lineEnd": 6572
      },
      "section": "6.76",
      "rulesText": "A Glass Bottle holds up to 1½ pints."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-77-bucket-5-cp",
      "@type": "Rule",
      "name": "Bucket (5 CP)",
      "slug": "6-77-bucket-5-cp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.77",
        "heading": "Bucket (5 CP)",
        "lineStart": 6574,
        "lineEnd": 6576
      },
      "section": "6.77",
      "rulesText": "A Bucket holds up to half a cubic foot of contents."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-78-burglars-pack-16-gp",
      "@type": "Rule",
      "name": "Burglar's Pack (16 GP)",
      "slug": "6-78-burglars-pack-16-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.78",
        "heading": "Burglar's Pack (16 GP)",
        "lineStart": 6578,
        "lineEnd": 6580
      },
      "section": "6.78",
      "rulesText": "A Burglar's Pack contains the following items: Backpack, Ball Bearings, Bell, 10 Candles, Crowbar, Hooded Lantern, 7 flasks of Oil, 5 days of Rations, Rope, Tinderbox, and Waterskin."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-79-caltrops-1-gp",
      "@type": "Rule",
      "name": "Caltrops (1 GP)",
      "slug": "6-79-caltrops-1-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.79",
        "heading": "Caltrops (1 GP)",
        "lineStart": 6582,
        "lineEnd": 6584
      },
      "section": "6.79",
      "rulesText": "As a Utilize action, you can spread Caltrops from their bag to cover a 5-foot-square area within 5 feet of yourself. A creature that enters this area for the first time on a turn must succeed on a DC 15 Dexterity saving throw or take 1 Piercing damage and have its Speed reduced to 0 until the start of its next turn. It takes 10 minutes to recover the Caltrops."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-8-finesse",
      "@type": "Rule",
      "name": "Finesse",
      "slug": "6-8-finesse",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.8",
        "heading": "Finesse",
        "lineStart": 5987,
        "lineEnd": 5989
      },
      "section": "6.8",
      "rulesText": "When making an attack with a Finesse weapon, use your choice of your Strength or Dexterity modifier for the attack and damage rolls. You must use the same modifier for both rolls."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-80-candle-1-cp",
      "@type": "Rule",
      "name": "Candle (1 CP)",
      "slug": "6-80-candle-1-cp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.80",
        "heading": "Candle (1 CP)",
        "lineStart": 6586,
        "lineEnd": 6588
      },
      "section": "6.80",
      "rulesText": "For 1 hour, a lit Candle sheds Bright Light in a 5-foot radius and Dim Light for an additional 5 feet."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-81-case-crossbow-bolt-1-gp",
      "@type": "Rule",
      "name": "Case, Crossbow Bolt (1 GP)",
      "slug": "6-81-case-crossbow-bolt-1-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.81",
        "heading": "Case, Crossbow Bolt (1 GP)",
        "lineStart": 6590,
        "lineEnd": 6592
      },
      "section": "6.81",
      "rulesText": "A Crossbow Bolt Case holds up to 20 Bolts."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-82-case-map-or-scroll-1-gp",
      "@type": "Rule",
      "name": "Case, Map or Scroll (1 GP)",
      "slug": "6-82-case-map-or-scroll-1-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.82",
        "heading": "Case, Map or Scroll (1 GP)",
        "lineStart": 6594,
        "lineEnd": 6596
      },
      "section": "6.82",
      "rulesText": "A Map or Scroll Case holds up to 10 sheets of paper or 5 sheets of parchment."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-83-chain-5-gp",
      "@type": "Rule",
      "name": "Chain (5 GP)",
      "slug": "6-83-chain-5-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.83",
        "heading": "Chain (5 GP)",
        "lineStart": 6598,
        "lineEnd": 6600
      },
      "section": "6.83",
      "rulesText": "As a Utilize action, you can wrap a Chain around an unwilling creature within 5 feet of yourself that has the Grappled, Incapacitated, or Restrained condition if you succeed on a DC 13 Strength (Athletics) check. If the creature's legs are bound, the creature has the Restrained condition until it escapes. Escaping the Chain requires the creature to make a successful DC 18 Dexterity (Acrobatics) check as an action. Bursting the Chain requires a successful DC 20 Strength (Athletics) check as an action."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-84-chest-5-gp",
      "@type": "Rule",
      "name": "Chest (5 GP)",
      "slug": "6-84-chest-5-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.84",
        "heading": "Chest (5 GP)",
        "lineStart": 6602,
        "lineEnd": 6604
      },
      "section": "6.84",
      "rulesText": "A Chest holds up to 12 cubic feet of contents."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-85-climbers-kit-25-gp",
      "@type": "Rule",
      "name": "Climber's Kit (25 GP)",
      "slug": "6-85-climbers-kit-25-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.85",
        "heading": "Climber's Kit (25 GP)",
        "lineStart": 6606,
        "lineEnd": 6608
      },
      "section": "6.85",
      "rulesText": "A Climber's Kit includes boot tips, gloves, pitons, and a harness. As a Utilize action, you can use the Climber's Kit to anchor yourself; when you do, you can't fall more than 25 feet from the anchor point, and you can't move more than 25 feet from there without undoing the anchor as a Bonus Action."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-86-clothes-fine-15-gp",
      "@type": "Rule",
      "name": "Clothes, Fine (15 GP)",
      "slug": "6-86-clothes-fine-15-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.86",
        "heading": "Clothes, Fine (15 GP)",
        "lineStart": 6610,
        "lineEnd": 6612
      },
      "section": "6.86",
      "rulesText": "Fine Clothes are made of expensive fabrics and adorned with expertly crafted details. Some events and locations admit only people wearing these clothes."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-87-clothes-travelers-2-gp",
      "@type": "Rule",
      "name": "Clothes, Traveler's (2 GP)",
      "slug": "6-87-clothes-travelers-2-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.87",
        "heading": "Clothes, Traveler's (2 GP)",
        "lineStart": 6614,
        "lineEnd": 6616
      },
      "section": "6.87",
      "rulesText": "Traveler's Clothes are resilient garments designed for travel in various environments."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-88-component-pouch-25-gp",
      "@type": "Rule",
      "name": "Component Pouch (25 GP)",
      "slug": "6-88-component-pouch-25-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.88",
        "heading": "Component Pouch (25 GP)",
        "lineStart": 6618,
        "lineEnd": 6620
      },
      "section": "6.88",
      "rulesText": "A Component Pouch is watertight and filled with compartments that hold all the free Material components of your spells."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-89-costume-5-gp",
      "@type": "Rule",
      "name": "Costume (5 GP)",
      "slug": "6-89-costume-5-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.89",
        "heading": "Costume (5 GP)",
        "lineStart": 6622,
        "lineEnd": 6624
      },
      "section": "6.89",
      "rulesText": "While wearing a Costume, you have Advantage on any ability check you make to impersonate the person or type of person it represents."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-9-heavy",
      "@type": "Rule",
      "name": "Heavy",
      "slug": "6-9-heavy",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.9",
        "heading": "Heavy",
        "lineStart": 5991,
        "lineEnd": 5993
      },
      "section": "6.9",
      "rulesText": "You have Disadvantage on attack rolls with a Heavy weapon if it's a Melee weapon and your Strength score isn't at least 13 or if it's a Ranged weapon and your Dexterity score isn't at least 13."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-90-crowbar-2-gp",
      "@type": "Rule",
      "name": "Crowbar (2 GP)",
      "slug": "6-90-crowbar-2-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.90",
        "heading": "Crowbar (2 GP)",
        "lineStart": 6626,
        "lineEnd": 6628
      },
      "section": "6.90",
      "rulesText": "Using a Crowbar gives you Advantage on Strength checks where the Crowbar's leverage can be applied."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-91-diplomats-pack-39-gp",
      "@type": "Rule",
      "name": "Diplomat's Pack (39 GP)",
      "slug": "6-91-diplomats-pack-39-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.91",
        "heading": "Diplomat's Pack (39 GP)",
        "lineStart": 6630,
        "lineEnd": 6632
      },
      "section": "6.91",
      "rulesText": "A Diplomat's Pack contains the following items: Chest, Fine Clothes, Ink, 5 Ink Pens, Lamp, 2 Map or Scroll Cases, 4 flasks of Oil, 5 sheets of Paper, 5 sheets of Parchment, Perfume, and Tinderbox."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-92-druidic-focus-varies",
      "@type": "Rule",
      "name": "Druidic Focus (Varies)",
      "slug": "6-92-druidic-focus-varies",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.92",
        "heading": "Druidic Focus (Varies)",
        "lineStart": 6634,
        "lineEnd": 6644
      },
      "section": "6.92",
      "rulesText": "A Druidic Focus takes one of the forms in the Druidic Focuses table and is carved, tied with ribbon, or painted to channel primal magic. A Druid or Ranger can use such an object as a Spellcasting Focus.\n\nDruidic Focuses",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/6-92-druidic-focuses"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-93-dungeoneers-pack-12-gp",
      "@type": "Rule",
      "name": "Dungeoneer's Pack (12 GP)",
      "slug": "6-93-dungeoneers-pack-12-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.93",
        "heading": "Dungeoneer's Pack (12 GP)",
        "lineStart": 6646,
        "lineEnd": 6650
      },
      "section": "6.93",
      "rulesText": "A Dungeoneer's Pack contains the following items: Backpack, Caltrops, Crowbar, 2 flasks of Oil, 10\n\ndays of Rations, Rope, Tinderbox, 10 Torches, and Waterskin."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-94-entertainers-pack-40-gp",
      "@type": "Rule",
      "name": "Entertainer's Pack (40 GP)",
      "slug": "6-94-entertainers-pack-40-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.94",
        "heading": "Entertainer's Pack (40 GP)",
        "lineStart": 6652,
        "lineEnd": 6654
      },
      "section": "6.94",
      "rulesText": "An Entertainer's Pack contains the following items: Backpack, Bedroll, Bell, Bullseye Lantern, 3 Costumes, Mirror, 8 flasks of Oil, 9 days of Rations, Tinderbox, and Waterskin."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-95-explorers-pack-10-gp",
      "@type": "Rule",
      "name": "Explorer's Pack (10 GP)",
      "slug": "6-95-explorers-pack-10-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.95",
        "heading": "Explorer's Pack (10 GP)",
        "lineStart": 6656,
        "lineEnd": 6658
      },
      "section": "6.95",
      "rulesText": "An Explorer's Pack contains the following items: Backpack, Bedroll, 2 flasks of Oil, 10 days of Rations, Rope, Tinderbox, 10 Torches, and Waterskin."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-96-flask-2-cp",
      "@type": "Rule",
      "name": "Flask (2 CP)",
      "slug": "6-96-flask-2-cp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.96",
        "heading": "Flask (2 CP)",
        "lineStart": 6660,
        "lineEnd": 6662
      },
      "section": "6.96",
      "rulesText": "A Flask holds up to 1 pint."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-97-grappling-hook-2-gp",
      "@type": "Rule",
      "name": "Grappling Hook (2 GP)",
      "slug": "6-97-grappling-hook-2-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.97",
        "heading": "Grappling Hook (2 GP)",
        "lineStart": 6664,
        "lineEnd": 6666
      },
      "section": "6.97",
      "rulesText": "As a Utilize action, you can throw the Grappling Hook at a railing, a ledge, or another catch within 50 feet of yourself, and the hook catches on if you succeed on a DC 13 Dexterity (Acrobatics) check. If you tied a Rope to the hook, you can then climb it."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-98-healers-kit-5-gp",
      "@type": "Rule",
      "name": "Healer's Kit (5 GP)",
      "slug": "6-98-healers-kit-5-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.98",
        "heading": "Healer's Kit (5 GP)",
        "lineStart": 6668,
        "lineEnd": 6670
      },
      "section": "6.98",
      "rulesText": "A Healer's Kit has ten uses. As a Utilize action, you can expend one of its uses to stabilize an Unconscious creature that has 0 Hit Points without needing to make a Wisdom (Medicine) check."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/6-99-holy-symbol-varies",
      "@type": "Rule",
      "name": "Holy Symbol (Varies)",
      "slug": "6-99-holy-symbol-varies",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Equipment",
        "section": "6.99",
        "heading": "Holy Symbol (Varies)",
        "lineStart": 6672,
        "lineEnd": 6684
      },
      "section": "6.99",
      "rulesText": "A Holy Symbol takes one of the forms in the Holy Symbol table and is be jeweled or painted to channel divine magic. A Cleric or Paladin can use a Holy Symbol as a Spellcasting Focus.\n\nThe table indicates whether a Holy Symbol needs to be held, worn, or borne on fabric (such as a tab-ard or banner) or a Shield.\n\nHoly Symbols",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/6-99-holy-symbols"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-1-spells",
      "@type": "Rule",
      "name": "Spells",
      "slug": "7-1-spells",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.1",
        "heading": "Spells",
        "lineStart": 7153,
        "lineEnd": 7153
      },
      "section": "7.1"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-10-using-a-higher-level-spell-slot",
      "@type": "Rule",
      "name": "Using a Higher-Level Spell Slot",
      "slug": "7-10-using-a-higher-level-spell-slot",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.10",
        "heading": "Using a Higher-Level Spell Slot",
        "lineStart": 7214,
        "lineEnd": 7218
      },
      "section": "7.10",
      "rulesText": "When a spellcaster casts a spell using a slot that is of a higher level than the spell, the spell takes on the higher level for that casting. For instance, if a Wizard casts Magic Missile using a level 2 slot, that Magic Missile is level 2. Effectively, the spell expands to fill the slot it is put into.\n\nSome spells, such as Magic Missile and Cure Wounds, have more powerful effects when cast at a higher level, as detailed in a spell's description."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-11-school-of-magic",
      "@type": "Rule",
      "name": "School of Magic",
      "slug": "7-11-school-of-magic",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.11",
        "heading": "School of Magic",
        "lineStart": 7220,
        "lineEnd": 7235
      },
      "section": "7.11",
      "rulesText": "Each spell belongs to a school of magic. The schools are listed in the Schools of Magic table. These categories help describe spells but have no rules of their own, although some other rules refer to them.\n\nSchools of Magic",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/7-11-schools-of-magic"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-12-class-spell-lists",
      "@type": "Rule",
      "name": "Class Spell Lists",
      "slug": "7-12-class-spell-lists",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.12",
        "heading": "Class Spell Lists",
        "lineStart": 7237,
        "lineEnd": 7239
      },
      "section": "7.12",
      "rulesText": "If a spell is on a class's spell list, the class's name appears in parentheses after the spell's school of magic. Some features add a spell to a character's spell list even if the character isn't a member of a class in the parentheses."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-13-casting-time",
      "@type": "Rule",
      "name": "Casting Time",
      "slug": "7-13-casting-time",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.13",
        "heading": "Casting Time",
        "lineStart": 7241,
        "lineEnd": 7243
      },
      "section": "7.13",
      "rulesText": "Most spells require the Magic action to cast, but some spells require a Bonus Action, a Reaction, or 1 minute or more. A spell's Casting Time entry specifies which of those is required."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-14-one-spell-with-a-spell-slot-per-turn",
      "@type": "Rule",
      "name": "One Spell with a Spell Slot per Turn",
      "slug": "7-14-one-spell-with-a-spell-slot-per-turn",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.14",
        "heading": "One Spell with a Spell Slot per Turn",
        "lineStart": 7245,
        "lineEnd": 7247
      },
      "section": "7.14",
      "rulesText": "On a turn, you can expend only one spell slot to cast a spell. This rule means you can't, for example, cast a spell with a spell slot using the Magic action and another one using a Bonus Action on the same turn."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-15-reaction-and-bonus-action-triggers",
      "@type": "Rule",
      "name": "Reaction and Bonus Action Triggers",
      "slug": "7-15-reaction-and-bonus-action-triggers",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.15",
        "heading": "Reaction and Bonus Action Triggers",
        "lineStart": 7249,
        "lineEnd": 7251
      },
      "section": "7.15",
      "rulesText": "A spell that has a casting time of a Reaction is cast in response to a trigger that is defined in the spell's Casting Time entry. Some spells that have a casting time of a Bonus Action are also cast in response to a trigger defined in the spell."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-16-longer-casting-times",
      "@type": "Rule",
      "name": "Longer Casting Times",
      "slug": "7-16-longer-casting-times",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.16",
        "heading": "Longer Casting Times",
        "lineStart": 7253,
        "lineEnd": 7257
      },
      "section": "7.16",
      "rulesText": "Certain spells - including a spell cast as a Ritual - require more time to cast: minutes or even hours. While you cast a spell with a casting time of 1 minute or more, you must take the Magic action on each of your turns, and you must maintain Concentration (see “Rules Glossary”) while you do so. If\n\nyour Concentration is broken, the spell fails, but you don't expend a spell slot. To cast the spell again, you must start over."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-17-range",
      "@type": "Rule",
      "name": "Range",
      "slug": "7-17-range",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.17",
        "heading": "Range",
        "lineStart": 7259,
        "lineEnd": 7271
      },
      "section": "7.17",
      "rulesText": "A spell's range indicates how far from the spellcaster the spell's effect can originate, and the spell's description specifies which part of the effect is limited by the range.\n\nA range usually takes one of the following forms:\n\nDistance. The range is expressed in feet.\n\nTouch. The spell's effect originates on something, as defined by the spell, that the spellcaster must touch within their reach.\n\nSelf. The spell is cast on the spellcaster or emanates from them, as specified in the spell.\n\nIf a spell has movable effects, they aren't restricted by its range unless the spell's description says otherwise."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-18-components",
      "@type": "Rule",
      "name": "Components",
      "slug": "7-18-components",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.18",
        "heading": "Components",
        "lineStart": 7273,
        "lineEnd": 7275
      },
      "section": "7.18",
      "rulesText": "A spell's components are physical requirements the spellcaster must meet to cast the spell. Each spell's description indicates whether it requires Verbal (V), Somatic (S), or Material (M) components. If the spellcaster can't provide one or more of a spell's components, the spellcaster can't cast the spell."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-19-verbal-v",
      "@type": "Rule",
      "name": "Verbal (V)",
      "slug": "7-19-verbal-v",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.19",
        "heading": "Verbal (V)",
        "lineStart": 7277,
        "lineEnd": 7279
      },
      "section": "7.19",
      "rulesText": "A Verbal component is the chanting of esoteric words that sound like nonsense to the uninitiated. The words must be uttered in a normal speaking voice. The words themselves aren't the source of the spell's power; rather, the particular combination of sounds, with specific pitch and resonance, sets the threads of magic in motion. Thus, a creature who is gagged or in an area of magical silence can't cast a spell with a Verbal component."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-2-gaining-spells",
      "@type": "Rule",
      "name": "Gaining Spells",
      "slug": "7-2-gaining-spells",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.2",
        "heading": "Gaining Spells",
        "lineStart": 7155,
        "lineEnd": 7157
      },
      "section": "7.2",
      "rulesText": "Before you can cast a spell, you must have the spell prepared in your mind or have access to the spell from a magic item, such as a Spell Scroll. Your features specify which spells you have access to, if any; whether you always have certain spells prepared; and whether you can change the list of spells you have prepared."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-20-somatic-s",
      "@type": "Rule",
      "name": "Somatic (S)",
      "slug": "7-20-somatic-s",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.20",
        "heading": "Somatic (S)",
        "lineStart": 7281,
        "lineEnd": 7283
      },
      "section": "7.20",
      "rulesText": "A Somatic component is a forceful gesticulation or an intricate set of gestures. A spellcaster must use at least one of their hands to perform these movements."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-21-material-m",
      "@type": "Rule",
      "name": "Material (M)",
      "slug": "7-21-material-m",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.21",
        "heading": "Material (M)",
        "lineStart": 7285,
        "lineEnd": 7291
      },
      "section": "7.21",
      "rulesText": "A Material component is a particular material used in a spell's casting, as specified in parentheses in the Components entry. These materials aren't consumed by the spell unless the spell's description states otherwise. The spellcaster must have a hand free to access them, but it can be the same hand used to perform Somatic components, if any.\n\nIf a spell doesn't consume its materials and doesn't specify a cost for them, a spellcaster can use a Component Pouch (see \"Equipment\") instead of providing the materials specified in the spell, or the\n\nspellcaster can substitute a Spellcasting Focus if the caster has a feature that allows that substitution. To use a Component Pouch, you must have a hand free to reach into it, and to use a Spellcasting Focus, you must hold it unless its description says otherwise (see “Equipment” for descriptions)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-22-duration",
      "@type": "Rule",
      "name": "Duration",
      "slug": "7-22-duration",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.22",
        "heading": "Duration",
        "lineStart": 7293,
        "lineEnd": 7301
      },
      "section": "7.22",
      "rulesText": "A spell's duration is the length of time the spell persists after it is cast. A duration typically takes one of the following forms:\n\nConcentration. A duration that requires Concentration follows the Concentration rules (see “Rules Glossary”).\n\nInstantaneous. An instantaneous duration means the spell's magic appears only for a moment and then disappears.\n\nTime Span. A duration that provides a time span specifies how long the spell lasts in rounds, minutes, hours, or the like. For example, a Duration entry might say “1 minute,” meaning the spell ends after 1 minute has passed. While a time-span spell that you cast is ongoing, you can dismiss it (no action required) if you don’t have the Incapacitated condition."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-23-effects",
      "@type": "Rule",
      "name": "Effects",
      "slug": "7-23-effects",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.23",
        "heading": "Effects",
        "lineStart": 7303,
        "lineEnd": 7305
      },
      "section": "7.23",
      "rulesText": "The effects of a spell are detailed after its duration entry. Those details present exactly what the spell does, which ignores mundane physical laws; any outcomes beyond those effects are under the GM's purview. Whatever the effects, they typically deal with targets, saving throws, attack rolls, or all three, each of which is detailed below."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-24-targets",
      "@type": "Rule",
      "name": "Targets",
      "slug": "7-24-targets",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.24",
        "heading": "Targets",
        "lineStart": 7307,
        "lineEnd": 7321
      },
      "section": "7.24",
      "rulesText": "A typical spell requires the caster to pick one or more targets to be affected by the spell's magic. A spell's description says whether the spell targets creatures, objects, or something else.\n\nA Clear Path to the Target. To target something with a spell, a caster must have a clear path to it, so it can't be behind Total Cover.\n\nTargeting Yourself. If a spell targets a creature of your choice, you can choose yourself unless the creature must be Hostile or specifically a creature other than you.\n\nAreas of Effect. Some spells, such as Thunder-wave, cover an area called an area of effect, which is defined in “Rules Glossary.” The area determines what the spell targets. The description of a spell specifies whether it has an area of effect, which is typically one of these shapes: Cone, Cube, Cylinder, Emanation, Line, or Sphere.\n\nAwareness of Being Targeted. Unless a spell has a perceptible effect, a creature doesn't know it was targeted by the spell. An effect like lightning is obvious, but a more subtle effect, such as an attempt to read thoughts, goes unnoticed unless a spell's description says otherwise.\n\nInvalid Targets. If you cast a spell on someone or something that can't be affected by it, nothing happens to that target, but if you used a spell slot to cast the spell, the slot is still expended.\n\nIf the spell normally has no effect on a target that succeeds on a saving throw, the invalid target appears to have succeeded on its saving throw, even though it didn't attempt one (giving no hint that the creature is an invalid target). Otherwise, you perceive that the spell did nothing to the target."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-25-saving-throws",
      "@type": "Rule",
      "name": "Saving Throws",
      "slug": "7-25-saving-throws",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.25",
        "heading": "Saving Throws",
        "lineStart": 7323,
        "lineEnd": 7327
      },
      "section": "7.25",
      "rulesText": "Many spells specify that a target makes a saving throw to avoid some or all of a spell's effects. The spell specifies the ability that the target uses for the save and what happens on a success or failure. Here's how to calculate the DC for your spells:\n\nSpell save DC = 8 + your spellcasting ability modifier + your Proficiency Bonus"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-26-attack-rolls",
      "@type": "Rule",
      "name": "Attack Rolls",
      "slug": "7-26-attack-rolls",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.26",
        "heading": "Attack Rolls",
        "lineStart": 7329,
        "lineEnd": 7333
      },
      "section": "7.26",
      "rulesText": "Some spells require the caster to make an attack roll to determine whether the spell hits a target. Here's how to calculate the attack modifier for your spells:\n\nSpell attack modifier = your spellcasting ability modifier + your Proficiency Bonus"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-27-combining-spell-effects",
      "@type": "Rule",
      "name": "Combining Spell Effects",
      "slug": "7-27-combining-spell-effects",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.27",
        "heading": "Combining Spell Effects",
        "lineStart": 7335,
        "lineEnd": 7337
      },
      "section": "7.27",
      "rulesText": "The effects of different spells add together while their durations overlap. In contrast, the effects of the same spell cast multiple times don't combine. Instead, the most potent effect - such as the highest bonus - from those castings applies while their durations overlap. The most recent effect applies if the castings are equally potent and their durations overlap. For example, if two Clerics cast Bless on the same target, that target gains the spell's benefit only once; the target doesn't receive two bonus dice. But if the durations of the spells overlap, the effect continues until the duration of the second Bless ends."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-28-identifying-an-ongoing-spell",
      "@type": "Rule",
      "name": "IDENTIFYING AN ONGOING SPELL",
      "slug": "7-28-identifying-an-ongoing-spell",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.28",
        "heading": "IDENTIFYING AN ONGOING SPELL",
        "lineStart": 7339,
        "lineEnd": 7341
      },
      "section": "7.28",
      "rulesText": "You can try to identify a non-instantaneous spell by its observable effects if its duration is ongoing. To identify it, you must take the Study action and succeed on a DC 15 Intelligence (Arcana) check."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-29-spell-descriptions",
      "@type": "Rule",
      "name": "Spell Descriptions",
      "slug": "7-29-spell-descriptions",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.29",
        "heading": "Spell Descriptions",
        "lineStart": 7343,
        "lineEnd": 7343
      },
      "section": "7.29"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-3-preparing-spells",
      "@type": "Rule",
      "name": "Preparing Spells",
      "slug": "7-3-preparing-spells",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.3",
        "heading": "Preparing Spells",
        "lineStart": 7159,
        "lineEnd": 7176
      },
      "section": "7.3",
      "rulesText": "If you have a list of level 1+ spells you prepare, your spellcasting feature specifies when you can change the list and the number of spells you can change, as summarized in the Spell Preparation by Class table.\n\nSpell Preparation by Class\n\nMost spellcasting monsters don't change their lists of prepared spells, but the GM is free to alter them.",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/7-3-spell-preparation-by-class"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-4-always-prepared-spells",
      "@type": "Rule",
      "name": "Always-Prepared Spells",
      "slug": "7-4-always-prepared-spells",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.4",
        "heading": "Always-Prepared Spells",
        "lineStart": 7178,
        "lineEnd": 7180
      },
      "section": "7.4",
      "rulesText": "Certain features might give you a spell that you always have prepared. If you also have a list of prepared spells that you can change, a spell that you always have prepared doesn't count against the number of spells on that list."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-5-casting-spells",
      "@type": "Rule",
      "name": "Casting Spells",
      "slug": "7-5-casting-spells",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.5",
        "heading": "Casting Spells",
        "lineStart": 7182,
        "lineEnd": 7184
      },
      "section": "7.5",
      "rulesText": "Each spell description has a series of entries that provide the details needed to cast the spell. The following sections explain each of those entries, which follow a spell's name."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-6-casting-in-armor",
      "@type": "Rule",
      "name": "CASTING IN ARMOR",
      "slug": "7-6-casting-in-armor",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.6",
        "heading": "CASTING IN ARMOR",
        "lineStart": 7186,
        "lineEnd": 7188
      },
      "section": "7.6",
      "rulesText": "You must have training with any armor you are wearing to cast spells while wearing it. You are otherwise too hampered by the armor for spellcasting."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-7-spell-level",
      "@type": "Rule",
      "name": "Spell Level",
      "slug": "7-7-spell-level",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.7",
        "heading": "Spell Level",
        "lineStart": 7190,
        "lineEnd": 7192
      },
      "section": "7.7",
      "rulesText": "Every spell has a level from 0 to 9, which is indicated in a spell's description. A spell's level is an indicator of how powerful it is. Cantrips - simple spells that can be cast almost by rote - are level 0. The rules for each spellcasting class say when its members gain access to spells of certain levels."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-8-spell-slots",
      "@type": "Rule",
      "name": "Spell Slots",
      "slug": "7-8-spell-slots",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.8",
        "heading": "Spell Slots",
        "lineStart": 7194,
        "lineEnd": 7200
      },
      "section": "7.8",
      "rulesText": "Spellcasting is taxing, so a spellcaster can cast only a limited number of level 1+ spells before resting. Spell slots are the main way a spellcaster's magical potential is represented. Each spellcasting class gives its members a limited number of spell slots of certain spell levels. For example, a level 3 Wizard has four level 1 spell slots and two level 2 slots.\n\nWhen you cast a spell, you expend a slot of that spell's level or higher, effectively \"filling\" a slot with the spell. Imagine a spell slot is a groove of a certain size - small for a level 1 slot and larger for a higher-level spell. A level 1 spell fits into a slot of any size, but a level 2 spell fits only into a slot that's at least level 2. So when a level 3 Wizard casts Magic Missile, a level 1 spell, that Wizard spends one of four level 1 slots and has three remaining.\n\nFinishing a Long Rest restores any expended spell slots."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/7-9-casting-without-slots",
      "@type": "Rule",
      "name": "Casting without Slots",
      "slug": "7-9-casting-without-slots",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Spells",
        "section": "7.9",
        "heading": "Casting without Slots",
        "lineStart": 7202,
        "lineEnd": 7212
      },
      "section": "7.9",
      "rulesText": "There are several ways to cast a spell without expending a spell slot:\n\nCantrips. A cantrip is cast without a spell slot.\n\nRituals. Certain spells have the Ritual tag in the Casting Time entry. Such a spell can be cast following the normal rules for spellcasting, or it can be cast as a Ritual. The Ritual version of a spell takes 10 minutes longer to cast than normal, but it doesn't expend a spell slot. To cast a spell as a Ritual, a spellcaster must have it prepared.\n\nSpecial Abilities. Some characters and monsters have special abilities that allow them to cast specific spells without a spell slot. This casting is usually limited in another way, such as being able to cast the spell a limited number of times per day.\n\nMagic Items. Spell Scrolls and some other magic items contain spells that can be cast without a spell slot. The description of such an item specifies how many times a spell can be cast from it."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-1-rules-glossary",
      "@type": "Rule",
      "name": "Rules Glossary",
      "slug": "8-1-rules-glossary",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.1",
        "heading": "Rules Glossary",
        "lineStart": 12727,
        "lineEnd": 12727
      },
      "section": "8.1"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-10-ally",
      "@type": "Rule",
      "name": "Ally",
      "slug": "8-10-ally",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.10",
        "heading": "Ally",
        "lineStart": 12813,
        "lineEnd": 12815
      },
      "section": "8.10",
      "rulesText": "A creature is your ally if it is a member of your adventuring party, your friend, on your side in combat, or a creature that the rules or the GM designates as your ally."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-100-long-rest",
      "@type": "Rule",
      "name": "Long Rest",
      "slug": "8-100-long-rest",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.100",
        "heading": "Long Rest",
        "lineStart": 13421,
        "lineEnd": 13446
      },
      "section": "8.100",
      "rulesText": "A Long Rest is a period of extended downtime - at least 8 hours - available to any creature. During a Long Rest, you sleep for at least 6 hours and perform no more than 2 hours of light activity, such as reading, talking, eating, or standing watch.\n\nDuring sleep, you have the Unconscious condition. After you finish a Long Rest, you must wait at least 16 hours before starting another one.\n\nBenefits of the Rest. To start a Long Rest, you must have at least 1 Hit Point. When you finish the rest, you gain the following benefits:\n\nRegain All HP. You regain all lost Hit Points and all spent Hit Point Dice. If your Hit Point maximum was reduced, it returns to normal.\n\nAbility Scores Restored. If any of your ability scores were reduced, they return to normal.\n\nExhaustion Reduced. If you have the Exhaustion condition, its level decreases by 1.\n\nSpecial Feature. Some features are recharged by a Long Rest. If you have such a feature, it recharges in the way specified in its description.\n\nInterrupting the Rest. A Long Rest is stopped by the following interruptions:\n\n- Rolling Initiative\n- Casting a spell other than a cantrip\n- Taking any damage\n- 1 hour of walking or other physical exertion\n\nIf you rested at least 1 hour before the interruption, you gain the benefits of a Short Rest. See also “Short Rest.”\n\nYou can resume a Long Rest immediately after an interruption. If you do so, the rest requires 1 additional hour per interruption to finish."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-101-magic-action",
      "@type": "Rule",
      "name": "Magic [Action]",
      "slug": "8-101-magic-action",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.101",
        "heading": "Magic [Action]",
        "lineStart": 13448,
        "lineEnd": 13452
      },
      "section": "8.101",
      "rulesText": "When you take the Magic action, you cast a spell that has a casting time of an action or use a feature or magic item that requires a Magic action to be activated.\n\nIf you cast a spell that has a casting time of 1 minute or longer, you must take the Magic action on each turn of that casting, and you must maintain Concentration while you do so. If your Concentration is broken, the spell fails, but you don't expend a spell slot. See also “Concentration.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-102-magical-effect",
      "@type": "Rule",
      "name": "Magical Effect",
      "slug": "8-102-magical-effect",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.102",
        "heading": "Magical Effect",
        "lineStart": 13454,
        "lineEnd": 13456
      },
      "section": "8.102",
      "rulesText": "An effect is magical if it is created by a spell, a magic item, or a phenomenon that a rule labels as magical."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-103-malnutrition-hazard",
      "@type": "Rule",
      "name": "Malnutrition [Hazard]",
      "slug": "8-103-malnutrition-hazard",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.103",
        "heading": "Malnutrition [Hazard]",
        "lineStart": 13458,
        "lineEnd": 13470
      },
      "section": "8.103",
      "rulesText": "A creature needs an amount of food per day based on its size, as shown in the Food Needs per Day table. A creature that eats but consumes less than half the required food for a day must succeed on a DC 10 Constitution saving throw or gain 1 Exhaustion level at the day's end. A creature that eats nothing for 5 days automatically gains 1 Exhaustion level at the end of the fifth day as well as an additional level at the end of each subsequent day without food.\n\nExhaustion caused by malnutrition can't be removed until the creature eats the full amount of food required for a day. See also \"Exhaustion.\"\n\nFood Needs per Day",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/8-103-food-needs-per-day"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-104-monster",
      "@type": "Rule",
      "name": "Monster",
      "slug": "8-104-monster",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.104",
        "heading": "Monster",
        "lineStart": 13472,
        "lineEnd": 13474
      },
      "section": "8.104",
      "rulesText": "A monster is a creature controlled by the GM, even if the creature is benevolent. See also “Creature” and “NPC.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-105-nonplayer-character",
      "@type": "Rule",
      "name": "Nonplayer Character",
      "slug": "8-105-nonplayer-character",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.105",
        "heading": "Nonplayer Character",
        "lineStart": 13476,
        "lineEnd": 13478
      },
      "section": "8.105",
      "rulesText": "A nonplayer character (NPC) is a monster that has a personal name and a distinct personality. See also \"Monster.\""
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-106-object",
      "@type": "Rule",
      "name": "Object",
      "slug": "8-106-object",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.106",
        "heading": "Object",
        "lineStart": 13480,
        "lineEnd": 13482
      },
      "section": "8.106",
      "rulesText": "An object is a nonliving, distinct thing. Composite things, like buildings, comprise more than one object. See also “Breaking Objects.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-107-occupied-space",
      "@type": "Rule",
      "name": "Occupied Space",
      "slug": "8-107-occupied-space",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.107",
        "heading": "Occupied Space",
        "lineStart": 13484,
        "lineEnd": 13486
      },
      "section": "8.107",
      "rulesText": "A space is occupied if a creature is in it or if it is completely filled by objects."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-108-opportunity-attacks",
      "@type": "Rule",
      "name": "Opportunity Attacks",
      "slug": "8-108-opportunity-attacks",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.108",
        "heading": "Opportunity Attacks",
        "lineStart": 13488,
        "lineEnd": 13490
      },
      "section": "8.108",
      "rulesText": "You can make an Opportunity Attack when a creature that you can see leaves your reach using its action, its Bonus Action, its Reaction, or one of its speeds. To make the Opportunity Attack, take a Reaction to make one melee attack with a weapon or an Unarmed Strike against the provoking creature. The attack occurs right before the creature leaves your reach. See also “Playing the Game” (“Combat”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-11-area-of-effect",
      "@type": "Rule",
      "name": "Area of Effect",
      "slug": "8-11-area-of-effect",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.11",
        "heading": "Area of Effect",
        "lineStart": 12817,
        "lineEnd": 12835
      },
      "section": "8.11",
      "rulesText": "The descriptions of many spells and other features specify that they have an area of effect, which typically has one of six shapes. These shapes are defined elsewhere in this glossary:\n\nCone\n\nCylinder\n\nLine\n\nCube\n\nEmanation\n\nSphere\n\nAn area of effect has a point of origin, a location from which the effect's energy erupts. The rules for each shape specify how to position its point of origin. If all straight lines extending from the point of origin to a location in the area of effect are blocked, that location isn't included in the area of effect. To block a line, an obstruction must provide Total Cover. See also \"Cover.\"\n\nIf the creator of an area of effect places it at an unseen point and an obstruction - such as a wall - is between the creator and that point, the point of origin comes into being on the near side of the obstruction."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-110-passive-perception",
      "@type": "Rule",
      "name": "Passive Perception",
      "slug": "8-110-passive-perception",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.110",
        "heading": "Passive Perception",
        "lineStart": 13506,
        "lineEnd": 13510
      },
      "section": "8.110",
      "rulesText": "Passive Perception is a score that reflects a creature's general awareness of its surroundings. The GM uses this score when determining whether a creature notices something without consciously making a Wisdom (Perception) check.\n\nA creature's Passive Perception equals 10 plus the creature's Wisdom (Perception) check bonus. If the creature has Advantage on such checks, increase the score by 5. If the creature has Disadvantage on them, decrease the score by 5. For example, a level 1 character with a Wisdom of 15 and proficiency in Perception has a Passive Perception of 14 ( 10 + 2 + 2 ). If that character has Advantage on Wisdom (Perception) checks, the score becomes 19."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-111-per-day",
      "@type": "Rule",
      "name": "Per Day",
      "slug": "8-111-per-day",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.111",
        "heading": "Per Day",
        "lineStart": 13512,
        "lineEnd": 13514
      },
      "section": "8.111",
      "rulesText": "If a rule says you can use something a certain number of times per day, that means you must finish a Long Rest to use it again after you run out of uses."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-113-player-character",
      "@type": "Rule",
      "name": "Player Character",
      "slug": "8-113-player-character",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.113",
        "heading": "Player Character",
        "lineStart": 13534,
        "lineEnd": 13536
      },
      "section": "8.113",
      "rulesText": "A player character is a character controlled by a player. See also “Character Creation.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-115-possession",
      "@type": "Rule",
      "name": "Possession",
      "slug": "8-115-possession",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.115",
        "heading": "Possession",
        "lineStart": 13544,
        "lineEnd": 13546
      },
      "section": "8.115",
      "rulesText": "Some effects cause a creature to be possessed by another creature or entity. A possessing effect defines how the possession operates. Possession can be prevented by the Protection from Evil and Good spell and ended by the Dispel Evil and Good spell."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-116-proficiency",
      "@type": "Rule",
      "name": "Proficiency",
      "slug": "8-116-proficiency",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.116",
        "heading": "Proficiency",
        "lineStart": 13548,
        "lineEnd": 13550
      },
      "section": "8.116",
      "rulesText": "If you have proficiency with something, you can add your Proficiency Bonus to any D20 Test you make using that thing. A creature might have proficiency in a skill or saving throw or with a weapon or tool. See also “Playing the Game” (“Proficiency”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-118-reach",
      "@type": "Rule",
      "name": "Reach",
      "slug": "8-118-reach",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.118",
        "heading": "Reach",
        "lineStart": 13560,
        "lineEnd": 13562
      },
      "section": "8.118",
      "rulesText": "A creature has a reach of 5 feet unless a rule says otherwise."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-119-reaction",
      "@type": "Rule",
      "name": "Reaction",
      "slug": "8-119-reaction",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.119",
        "heading": "Reaction",
        "lineStart": 13564,
        "lineEnd": 13566
      },
      "section": "8.119",
      "rulesText": "A Reaction is a special action taken in response to a trigger defined in the Reaction's description. You can take a Reaction on another creature's turn, and if you take it on your turn, you can do so even if you also take an action, a Bonus Action, or both. Once you take a Reaction, you can't take another one until the start of your next turn. The Opportunity Attack is a Reaction available to all creatures. See also \"Opportunity Attacks\" and \"Playing the Game\" (\"Actions\")."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-12-armor-class",
      "@type": "Rule",
      "name": "Armor Class",
      "slug": "8-12-armor-class",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.12",
        "heading": "Armor Class",
        "lineStart": 12837,
        "lineEnd": 12841
      },
      "section": "8.12",
      "rulesText": "An Armor Class (AC) is the target number for an attack roll. AC represents how difficult it is to hit a target.\n\nYour base AC calculation is 10 plus your Dexterity modifier. If a rule gives you another base AC calculation, you choose which calculation to use; you can't use more than one. See also \"Attack Roll.\""
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-120-ready-action",
      "@type": "Rule",
      "name": "Ready [Action]",
      "slug": "8-120-ready-action",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.120",
        "heading": "Ready [Action]",
        "lineStart": 13568,
        "lineEnd": 13576
      },
      "section": "8.120",
      "rulesText": "You take the Ready action to wait for a particular circumstance before you act. To do so, you take this action on your turn, which lets you act by taking a Reaction before the start of your next turn.\n\nFirst, you decide what perceivable circumstance will trigger your Reaction. Then, you choose the action you will take in response to that trigger, or you choose to move up to your Speed in response to it. Examples include “If the cultist steps on the trapdoor, I'll pull the lever that opens it,\" and \"If the zombie steps next to me, I move away.\"\n\nWhen the trigger occurs, you can either take your Reaction right after the trigger finishes or ignore the trigger.\n\nWhen you Ready a spell, you cast it as normal (expending any resources used to cast it) but hold its energy, which you release with your Reaction when the trigger occurs. To be readied, a spell must have a casting time of an action, and holding on to the spell's magic requires Concentration, which you can maintain up to the start of your next turn. If your Concentration is broken, the spell dissipates without taking effect."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-121-resistance",
      "@type": "Rule",
      "name": "Resistance",
      "slug": "8-121-resistance",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.121",
        "heading": "Resistance",
        "lineStart": 13578,
        "lineEnd": 13580
      },
      "section": "8.121",
      "rulesText": "If you have Resistance to a damage type, damage of that type is halved against you (round down). Resistance is applied only once to an instance of damage. See also “Playing the Game” (“Damage and Healing”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-123-ritual",
      "@type": "Rule",
      "name": "Ritual",
      "slug": "8-123-ritual",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.123",
        "heading": "Ritual",
        "lineStart": 13592,
        "lineEnd": 13594
      },
      "section": "8.123",
      "rulesText": "If you have a spell prepared that has the Ritual tag, you can cast that spell as a Ritual. The Ritual version of a spell takes 10 minutes longer to cast than normal. It also doesn't expend a spell slot, which means the ritual version of a spell can't be cast at a higher level. See also \"Spells.\""
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-124-round-down",
      "@type": "Rule",
      "name": "Round Down",
      "slug": "8-124-round-down",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.124",
        "heading": "Round Down",
        "lineStart": 13596,
        "lineEnd": 13598
      },
      "section": "8.124",
      "rulesText": "Whenever you divide or multiply a number in the game, round down if you end up with a fraction, even if the fraction is one-half or greater. Some rules make an exception and tell you to round up."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-125-save",
      "@type": "Rule",
      "name": "Save",
      "slug": "8-125-save",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.125",
        "heading": "Save",
        "lineStart": 13600,
        "lineEnd": 13602
      },
      "section": "8.125",
      "rulesText": "Save is another name for a saving throw. See also \"Saving Throw.\""
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-126-saving-throw",
      "@type": "Rule",
      "name": "Saving Throw",
      "slug": "8-126-saving-throw",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.126",
        "heading": "Saving Throw",
        "lineStart": 13604,
        "lineEnd": 13606
      },
      "section": "8.126",
      "rulesText": "A saving throw - also called a save - represents an attempt to avoid or resist a threat. You normally make a saving throw only when a rule requires you to do so, but you can decide to fail the save without rolling. The result of a save is detailed in the effect that allowed it. If a target is forced to make a save and lacks the ability score used by it, the target automatically fails. See also “Playing the Game” (“D20 Tests”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-127-search-action",
      "@type": "Rule",
      "name": "Search [Action]",
      "slug": "8-127-search-action",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.127",
        "heading": "Search [Action]",
        "lineStart": 13608,
        "lineEnd": 13619
      },
      "section": "8.127",
      "rulesText": "When you take the Search action, you make a Wisdom check to discern something that isn't obvious. The Search table suggests which skills are applicable when you take this action, depending on what you're trying to detect.\n\nSearch",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/8-127-search"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-128-shape-shifting",
      "@type": "Rule",
      "name": "Shape-Shifting",
      "slug": "8-128-shape-shifting",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.128",
        "heading": "Shape-Shifting",
        "lineStart": 13621,
        "lineEnd": 13623
      },
      "section": "8.128",
      "rulesText": "If an effect, such as Wild Shape or the Polymorph spell, lets you shape-shift, its description specifies what happens to you. Unless that description says otherwise, any ongoing effects on you - conditions, spells, curses, and the like - carry over from one form to the other. You revert to your true form if you die."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-129-short-rest",
      "@type": "Rule",
      "name": "Short Rest",
      "slug": "8-129-short-rest",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.129",
        "heading": "Short Rest",
        "lineStart": 13625,
        "lineEnd": 13641
      },
      "section": "8.129",
      "rulesText": "A Short Rest is a 1-hour period of downtime, during which a creature does nothing more strenuous than reading, talking, eating, or standing watch. To start a Short Rest, you must have at least 1 Hit Point.\n\nBenefits of the Rest. When you finish the rest, you gain the following benefits:\n\nSpend Hit Point Dice. You can spend one or more of your Hit Point Dice to regain Hit Points. For each Hit Point Die you spend in this way, roll the die and add your Constitution modifier to it. You regain Hit Points equal to the total (minimum of 1 Hit Point). You can decide to spend an additional Hit Point Die after each roll.\n\nSpecial Feature. Some features are recharged by a Short Rest. If you have such a feature, it recharges in the way specified in its description.\n\nInterrupting the Rest. A Short Rest is stopped by the following interruptions:\n\n- Rolling Initiative\n- Casting a spell other than a cantrip\n- Taking any damage\n\nAn interrupted Short Rest confers no benefits."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-13-armor-training",
      "@type": "Rule",
      "name": "Armor Training",
      "slug": "8-13-armor-training",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.13",
        "heading": "Armor Training",
        "lineStart": 12843,
        "lineEnd": 12845
      },
      "section": "8.13",
      "rulesText": "Armor training allows you to use armor of a certain category without the following drawbacks. If you wear Light, Medium, or Heavy armor and lack training with it, you have Disadvantage on any D20 Test that involves Strength or Dexterity, and you can't cast spells. If you use a Shield and lack training with it, you don't gain its AC bonus. See also \"Disadvantage\" and \"Equipment\" (\"Armor\")."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-130-simultaneous-effects",
      "@type": "Rule",
      "name": "Simultaneous Effects",
      "slug": "8-130-simultaneous-effects",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.130",
        "heading": "Simultaneous Effects",
        "lineStart": 13643,
        "lineEnd": 13645
      },
      "section": "8.130",
      "rulesText": "If two or more things happen at the same time on a turn, the person at the game table - player or GM - whose turn it is decides the order in which those things happen. For example, if two effects occur at the start of a player character's turn, the player decides which of the effects happens first."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-131-size",
      "@type": "Rule",
      "name": "Size",
      "slug": "8-131-size",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.131",
        "heading": "Size",
        "lineStart": 13647,
        "lineEnd": 13649
      },
      "section": "8.131",
      "rulesText": "A creature or an object belongs to a size category: Tiny, Small, Medium, Large, Huge, or Gargantuan. A creature's size determines how much space the creature occupies in combat. An object's size affects its Hit Points. See also \"Breaking Objects\" and \"Playing the Game\" (\"Combat\")."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-132-skill",
      "@type": "Rule",
      "name": "Skill",
      "slug": "8-132-skill",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.132",
        "heading": "Skill",
        "lineStart": 13651,
        "lineEnd": 13653
      },
      "section": "8.132",
      "rulesText": "A skill is an area of specialization associated with an ability check. If you have proficiency in a skill, you can add your Proficiency Bonus when you make an ability check associated with that skill. See also “Playing the Game” (“Proficiency”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-133-speed",
      "@type": "Rule",
      "name": "Speed",
      "slug": "8-133-speed",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.133",
        "heading": "Speed",
        "lineStart": 13655,
        "lineEnd": 13661
      },
      "section": "8.133",
      "rulesText": "A creature has a Speed, which is the distance in feet the creature can cover when it moves on its turn. See also “Climbing,” “Crawling,” “Flying,” “Jumping,” “Swimming” and “Playing the Game” (“Combat”).\n\nSpecial Speeds. Some creatures have special speeds, such as a Burrow Speed, Climb Speed, Fly Speed, or Swim Speed, each of which is defined in this glossary. If you have more than one speed, choose which one to use when you move; you can switch between the speeds during your move. Whenever you switch, subtract the distance already moved from the new speed. The result determines how much farther you can move. If the result is 0 or less, you can't use the new speed during the current move. For example, if you have a Speed of 30 and a Fly Speed of 40, you could fly 10 feet, walk 10 feet, and leap into the air to fly 20 feet more.\n\nChanges to Your Speeds. If an effect increases or decreases your Speed for a time, any special speed you have increases or decreases by an equal amount for the same duration. For example, if your Speed is reduced to 0 and you have a Climb Speed, your Climb Speed is also reduced to 0. Similarly, if your Speed is halved and you have a Fly Speed, your Fly Speed is also halved."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-134-spell",
      "@type": "Rule",
      "name": "Spell",
      "slug": "8-134-spell",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.134",
        "heading": "Spell",
        "lineStart": 13663,
        "lineEnd": 13665
      },
      "section": "8.134",
      "rulesText": "A spell is a magical effect that has the characteristics described in “Spells.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-135-spell-attack",
      "@type": "Rule",
      "name": "Spell Attack",
      "slug": "8-135-spell-attack",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.135",
        "heading": "Spell Attack",
        "lineStart": 13667,
        "lineEnd": 13669
      },
      "section": "8.135",
      "rulesText": "A spell attack is an attack roll made as part of a spell or another magical effect. See also “Spells” (“Casting Spells”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-136-spellcasting-focus",
      "@type": "Rule",
      "name": "Spellcasting Focus",
      "slug": "8-136-spellcasting-focus",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.136",
        "heading": "Spellcasting Focus",
        "lineStart": 13671,
        "lineEnd": 13673
      },
      "section": "8.136",
      "rulesText": "A Spellcasting Focus is an object that certain creatures can use in place of a spell's Material components if those materials aren't consumed by the spell and don't have a cost specified. Some classes allow its members to use certain types of Spellcasting Focuses. See also \"Spells\" (\"Casting Spells\")."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-137-sphere-area-of-effect",
      "@type": "Rule",
      "name": "Sphere [Area of Effect]",
      "slug": "8-137-sphere-area-of-effect",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.137",
        "heading": "Sphere [Area of Effect]",
        "lineStart": 13675,
        "lineEnd": 13679
      },
      "section": "8.137",
      "rulesText": "A Sphere is an area of effect that extends in straight lines from a point of origin outward in all directions. The effect that creates a Sphere specifies the distance it extends as the radius of the Sphere.\n\nA Sphere's point of origin is included in the Sphere's area of effect."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-138-stable",
      "@type": "Rule",
      "name": "Stable",
      "slug": "8-138-stable",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.138",
        "heading": "Stable",
        "lineStart": 13681,
        "lineEnd": 13683
      },
      "section": "8.138",
      "rulesText": "A creature is Stable if it has 0 Hit Points but isn't required to make Death Saving Throws. See also \"Playing the Game\" (\"Damage and Healing\")."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-139-stat-block",
      "@type": "Rule",
      "name": "Stat Block",
      "slug": "8-139-stat-block",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.139",
        "heading": "Stat Block",
        "lineStart": 13685,
        "lineEnd": 13727
      },
      "section": "8.139",
      "rulesText": "A stat block contains the game statistics of a monster. Each stat block includes the following information presented after the monster's name.\n\nSize. A monster is Tiny, Small, Medium, Large, Huge, or Gargantuan. See also \"Size.\"\n\nCreature Type. This entry notes the family of beings a monster belongs to, along with any descriptive tags. See also “Creature Type.”\n\nAlignment. An alignment is suggested for the monster, with the GM determining its actual alignment. See also “Alignment.”\n\nAC, Initiative, and HP. These entries give the monster's Armor Class, Initiative, and Hit Points, which are detailed in \"Playing the Game.\" In parentheses after the Hit Points, the monster's Hit Point Dice are provided, along with the contribution of its Constitution, if any, to its Hit Points. Following the Initiative modifier is an Initiative score. Some creatures that are created by magic lack Hit Dice and Initiative information.\n\nSpeed. Here the monster's Speed is provided, along with any special speeds. See also \"Burrow Speed,\" \"Climb Speed,\" \"Fly Speed,\" and \"Swim Speed.\"\n\nAbility Scores. A table provides the monster's ability scores, modifiers, and saving throw modifiers, all of which are detailed in \"Playing the Game.\"\n\nSkills. This entry lists the monster's skill proficiencies, if any. See also \"Playing the Game\" (\"Proficiency\").\n\nResistances and Vulnerabilities. These entries list the monster's Resistances and Vulnerabilities, if any. See also \"Resistance\" and \"Vulnerability.\"\n\nImmunities. This section lists the monster's damage and condition Immunities, if any. See also \"Immunity.\"\n\nGear. If the monster has any equipment that can be given away or retrieved, it's listed in this entry.\n\nSenses. This entry lists the monster's special senses, such as Darkvision, and its Passive Perception. See also \"Passive Perception.\"\n\nLanguages. This entry lists any languages the monster knows.\n\nCR. Challenge Rating summarizes the threat a monster poses and is detailed in “Monsters.” The Experience Points characters receive for defeating a monster and its Proficiency Bonus follow. Some creatures that are created by magic have no CR. See also “Challenge Rating” and “Experience Points.”\n\nTraits. The monster's traits, if any, are features that are active at all times or in certain situations.\n\nActions. The monster can take these actions in addition to those detailed in this glossary. See also \"Playing the Game\" (\"Actions\").\n\nBonus Actions. If the monster has Bonus Action options, they are listed in this section.\n\nReactions. If the monster can take special Reactions, those are listed in this section.\n\nAttack Notation. The entry for a monster's attack starts by identifying whether the attack is a melee or a ranged attack and then provides the attack roll's bonus, its reach or range, and what happens on a hit. An attack is against one target unless its entry says otherwise.\n\nSaving Throw Effect Notation. If an effect forces a saving throw, the effect's entry starts by identifying the kind of saving throw required and then provides the save's DC, a description of which creatures must make the save, and what happens on a failed or a successful save.\n\nDamage Notation. A stat block usually provides both a static number and a die expression for each instance of damage. For example, an attack might deal 4 (1d4 + 2) damage on a hit. The GM determines whether you use the static number or the die expression in parentheses; you don't use both."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-14-attack-action",
      "@type": "Rule",
      "name": "Attack [Action]",
      "slug": "8-14-attack-action",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.14",
        "heading": "Attack [Action]",
        "lineStart": 12847,
        "lineEnd": 12853
      },
      "section": "8.14",
      "rulesText": "When you take the Attack action, you can make one attack roll with a weapon or an Unarmed Strike.\n\nEquipping and Unequipping Weapons. You can either equip or unequip one weapon when you make an attack as part of this action. You do so either before or after the attack. If you equip a weapon before an attack, you don't need to use it for that attack. Equipping a weapon includes drawing it from a sheath or picking it up. Unequipping a weapon includes sheathing, stowing, or dropping it.\n\nMoving between Attacks. If you move on your turn and have a feature, such as Extra Attack, that gives you more than one attack as part of the Attack action, you can use some or all of that movement to move between those attacks."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-140-study-action",
      "@type": "Rule",
      "name": "Study [Action]",
      "slug": "8-140-study-action",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.140",
        "heading": "Study [Action]",
        "lineStart": 13729,
        "lineEnd": 13743
      },
      "section": "8.140",
      "rulesText": "When you take the Study action, you make an Intelligence check to study your memory, a book, a clue, or another source of knowledge and call to mind an important piece of information about it.\n\nThe Areas of Knowledge table suggests which skills are applicable to various areas of knowledge.\n\nAreas of Knowledge",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/8-140-areas-of-knowledge"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-142-suffocation-hazard",
      "@type": "Rule",
      "name": "Suffocation [Hazard]",
      "slug": "8-142-suffocation-hazard",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.142",
        "heading": "Suffocation [Hazard]",
        "lineStart": 13755,
        "lineEnd": 13757
      },
      "section": "8.142",
      "rulesText": "A creature can hold its breath for a number of minutes equal to 1 plus its Constitution modifier (minimum of 30 seconds) before suffocation begins. When a creature runs out of breath or is choking, it gains 1 Exhaustion level at the end of each of its turns. When a creature can breathe again, it removes all levels of Exhaustion it gained from suffocating."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-143-surprise",
      "@type": "Rule",
      "name": "Surprise",
      "slug": "8-143-surprise",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.143",
        "heading": "Surprise",
        "lineStart": 13759,
        "lineEnd": 13761
      },
      "section": "8.143",
      "rulesText": "If a creature is caught unawares by the start of combat, that creature is surprised, which causes it to have Disadvantage on its Initiative roll. See also “Playing the Game” (“Combat”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-144-swimming",
      "@type": "Rule",
      "name": "Swimming",
      "slug": "8-144-swimming",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.144",
        "heading": "Swimming",
        "lineStart": 13763,
        "lineEnd": 13765
      },
      "section": "8.144",
      "rulesText": "While you're swimming, each foot of movement costs 1 extra foot (2 extra feet in Difficult Terrain). You ignore this extra cost if you have a Swim Speed and use it to swim. At the GM's option, moving any distance in rough water might require a successful DC 15 Strength (Athletics) check."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-145-swim-speed",
      "@type": "Rule",
      "name": "Swim Speed",
      "slug": "8-145-swim-speed",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.145",
        "heading": "Swim Speed",
        "lineStart": 13767,
        "lineEnd": 13769
      },
      "section": "8.145",
      "rulesText": "A Swim Speed can be used to swim without expending the extra movement normally associated with swimming. See also “Swimming” and “Speed.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-146-target",
      "@type": "Rule",
      "name": "Target",
      "slug": "8-146-target",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.146",
        "heading": "Target",
        "lineStart": 13771,
        "lineEnd": 13773
      },
      "section": "8.146",
      "rulesText": "A target is the creature or object targeted by an attack roll, forced to make a saving throw by an effect, or selected to receive the effects of a spell or another phenomenon."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-147-telepathy",
      "@type": "Rule",
      "name": "Telepathy",
      "slug": "8-147-telepathy",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.147",
        "heading": "Telepathy",
        "lineStart": 13775,
        "lineEnd": 13781
      },
      "section": "8.147",
      "rulesText": "Telepathy is a magical ability that allows a creature to communicate mentally with another creature within a specified range. Unless a rule states otherwise, the contacted creature doesn't need to share a language with the telepath to understand this communication, but the contacted creature must be able to understand at least one language or be telepathic itself to understand.\n\nA telepath doesn't need to see a contacted creature, and the telepath can start or end the telepathic contact at any time (no action required). Telepathic contact can't be initiated and is immediately broken if either the telepath or the other creature has the Incapacitated condition. Telepathic contact is also broken if the contacted creature is no longer within the telepathy's range or if the telepath contacts a different creature within range.\n\nA creature without telepathy can receive telepathic messages but can't initiate a telepathic conversation. Once a telepathic conversation starts, the non-telepath can communicate mentally to the telepath until the telepathic connection ends."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-148-teleportation",
      "@type": "Rule",
      "name": "Teleportation",
      "slug": "8-148-teleportation",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.148",
        "heading": "Teleportation",
        "lineStart": 13783,
        "lineEnd": 13791
      },
      "section": "8.148",
      "rulesText": "Teleportation is a special kind of magical transportation. If you teleport, you disappear and reappear elsewhere instantly, without moving through the intervening space. This transportation doesn't expend movement unless a rule tells you otherwise, and teleportation never provokes Opportunity Attacks.\n\nWhen you teleport, all the equipment you're wearing and carrying teleports with you. If you're touching another creature when you teleport, that creature doesn't teleport with you unless the teleportation effect says otherwise.\n\nIf the destination space of your teleportation is occupied by another creature or blocked by a solid obstacle, you instead appear in the nearest unoccupied space of your choice.\n\nThe description of a teleportation effect tells you if you must see the teleportation's destination."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-149-temporary-hit-points",
      "@type": "Rule",
      "name": "Temporary Hit Points",
      "slug": "8-149-temporary-hit-points",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.149",
        "heading": "Temporary Hit Points",
        "lineStart": 13793,
        "lineEnd": 13795
      },
      "section": "8.149",
      "rulesText": "Temporary Hit Points are granted by certain effects and act as a buffer against losing real Hit Points. See also “Playing the Game” (“Damage and Healing”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-15-attack-roll",
      "@type": "Rule",
      "name": "Attack Roll",
      "slug": "8-15-attack-roll",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.15",
        "heading": "Attack Roll",
        "lineStart": 12855,
        "lineEnd": 12857
      },
      "section": "8.15",
      "rulesText": "An attack roll is a D20 Test that represents making an attack with a weapon, an Unarmed Strike, or a spell. See also “Playing the Game” (“D20 Tests”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-150-tremorsense",
      "@type": "Rule",
      "name": "Tremorsense",
      "slug": "8-150-tremorsense",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.150",
        "heading": "Tremorsense",
        "lineStart": 13797,
        "lineEnd": 13801
      },
      "section": "8.150",
      "rulesText": "A creature with Tremorsense can pinpoint the location of creatures and moving objects within a specific range, provided that the creature with Tremorsense and anything it is detecting are both in contact with the same surface (such as the ground, a wall, or a ceiling) or the same liquid.\n\nTremorsense can't detect creatures or objects in the air, and it doesn't count as a form of sight."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-151-truesight",
      "@type": "Rule",
      "name": "Truesight",
      "slug": "8-151-truesight",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.151",
        "heading": "Truesight",
        "lineStart": 13803,
        "lineEnd": 13815
      },
      "section": "8.151",
      "rulesText": "If you have Truesight, your vision is enhanced within a specified range. Within that range, your vision pierces through the following:\n\nDarkness. You can see in normal and magical Darkness.\n\nInvisibility. You see creatures and objects that have the Invisible condition.\n\nVisual Illusions. Visual illusions appear transparent to you, and you automatically succeed on saving throws against them.\n\nTransformations. You discern the true form of any creature or object you see that has been transformed by magic.\n\nEthereal Plane. You see into the Ethereal Plane."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-152-unarmed-strike",
      "@type": "Rule",
      "name": "Unarmed Strike",
      "slug": "8-152-unarmed-strike",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.152",
        "heading": "Unarmed Strike",
        "lineStart": 13817,
        "lineEnd": 13827
      },
      "section": "8.152",
      "rulesText": "Instead of using a weapon to make a melee attack, you can use a punch, kick, headbutt, or similar forceful blow. In game terms, this is an Unarmed Strike - a melee attack that involves you using your body to damage, grapple, or shove a target within 5 feet of you.\n\nWhenever you use your Unarmed Strike, choose one of the following options for its effect.\n\nDamage. You make an attack roll against the target. Your bonus to the roll equals your Strength modifier plus your Proficiency Bonus. On a hit, the target takes Bludgeoning damage equal to 1 plus your Strength modifier.\n\nGrapple. The target must succeed on a Strength or Dexterity saving throw (it chooses which), or it has the Grappled condition. The DC for the saving throw and any escape attempts equals 8 plus your Strength modifier and Proficiency Bonus. This grapple is possible only if the target is no more than one size larger than you and if you have a hand free to grab it. See also “Grappling.”\n\nShove. The target must succeed on a Strength or Dexterity saving throw (it chooses which), or you either push it 5 feet away or cause it to have the Prone condition. The DC for the saving throw equals 8 plus your Strength modifier and Proficiency Bonus. This shove is possible only if the target is no more than one size larger than you."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-154-unoccupied-space",
      "@type": "Rule",
      "name": "Unoccupied Space",
      "slug": "8-154-unoccupied-space",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.154",
        "heading": "Unoccupied Space",
        "lineStart": 13845,
        "lineEnd": 13847
      },
      "section": "8.154",
      "rulesText": "A space is unoccupied if no creatures are in it and it isn't completely filled by objects."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-155-utilize-action",
      "@type": "Rule",
      "name": "Utilize [Action]",
      "slug": "8-155-utilize-action",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.155",
        "heading": "Utilize [Action]",
        "lineStart": 13849,
        "lineEnd": 13851
      },
      "section": "8.155",
      "rulesText": "You normally interact with an object while doing something else, such as when you draw a sword as part of the Attack action. When an object requires an action for its use, you take the Utilize action."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-156-vulnerability",
      "@type": "Rule",
      "name": "Vulnerability",
      "slug": "8-156-vulnerability",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.156",
        "heading": "Vulnerability",
        "lineStart": 13853,
        "lineEnd": 13855
      },
      "section": "8.156",
      "rulesText": "If you have Vulnerability to a damage type, damage of that type is doubled against you. Vulnerability is applied only once to an instance of damage. See also \"Playing the Game\" (\"Damage and Healing\")."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-157-weapon",
      "@type": "Rule",
      "name": "Weapon",
      "slug": "8-157-weapon",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.157",
        "heading": "Weapon",
        "lineStart": 13857,
        "lineEnd": 13859
      },
      "section": "8.157",
      "rulesText": "A weapon is an object that is in the Simple or Martial weapon category. See also “Equipment” (“Weapons”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-158-weapon-attack",
      "@type": "Rule",
      "name": "Weapon Attack",
      "slug": "8-158-weapon-attack",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.158",
        "heading": "Weapon Attack",
        "lineStart": 13861,
        "lineEnd": 13865
      },
      "section": "8.158",
      "rulesText": "A weapon attack is an attack roll made with a weapon. See also \"Weapon.\"\n\n---"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-16-attitude",
      "@type": "Rule",
      "name": "Attitude",
      "slug": "8-16-attitude",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.16",
        "heading": "Attitude",
        "lineStart": 12859,
        "lineEnd": 12861
      },
      "section": "8.16",
      "rulesText": "A monster has a starting attitude toward a player character: Friendly, Hostile, or Indifferent. See also \"Friendly,\" \"Hostile,\" \"Indifferent,\" and \"Influence.\""
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-17-attunement",
      "@type": "Rule",
      "name": "Attunement",
      "slug": "8-17-attunement",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.17",
        "heading": "Attunement",
        "lineStart": 12863,
        "lineEnd": 12865
      },
      "section": "8.17",
      "rulesText": "Some magic items require a creature to form a bond - called Attunement - with them before the creature can use an item's magical properties. A creature can have Attunement with no more than three magic items at a time. See also “Equipment” (“Magic Items”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-19-blindsight",
      "@type": "Rule",
      "name": "Blindsight",
      "slug": "8-19-blindsight",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.19",
        "heading": "Blindsight",
        "lineStart": 12875,
        "lineEnd": 12877
      },
      "section": "8.19",
      "rulesText": "If you have Blindsight, you can see within a specific range without relying on physical sight. Within that range, you can see anything that isn't behind Total Cover even if you have the Blinded condition or are in Darkness. Moreover, in that range, you can see something that has the Invisible condition."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-2-glossary-conventions",
      "@type": "Rule",
      "name": "Glossary Conventions",
      "slug": "8-2-glossary-conventions",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.2",
        "heading": "Glossary Conventions",
        "lineStart": 12729,
        "lineEnd": 12778
      },
      "section": "8.2",
      "rulesText": "The glossary uses the following conventions:\n\nTags in Brackets. Some entries have a tag in brackets after the entry's name, as in \"Attack [Action].\" A tag - Action, Area of Effect, Attitude, Condition, or Hazard - indicates that a rule is part of a family of rules. The tags also have glossary entries.\n\n\"You.\" The game's rules - in this glossary and elsewhere - often talk about something happening to you in the game world. That \"you\" refers to the creature or object that the rule applies to in a particular moment of play. For example, the \"you\" in the Prone condition is a creature that currently has that condition.\n\n\"See Also.\" Some glossary entries include a See also section that points to other entries in the glossary, to other parts of this document, or both.\n\nNo Obsolete Terms. The glossary contains definitions of current rules terms only. If you're looking for a term from an earlier version of the fifth edition rules, consult the index.\n\nAbbreviations. The abbreviations listed below appear in this glossary and elsewhere in the rules.",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/8-2-glossary-conventions-table-1"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/8-2-glossary-conventions-table-2"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-20-bloodied",
      "@type": "Rule",
      "name": "Bloodied",
      "slug": "8-20-bloodied",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.20",
        "heading": "Bloodied",
        "lineStart": 12879,
        "lineEnd": 12881
      },
      "section": "8.20",
      "rulesText": "A creature is Bloodied while it has half its Hit Points or fewer remaining."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-21-bonus-action",
      "@type": "Rule",
      "name": "Bonus Action",
      "slug": "8-21-bonus-action",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.21",
        "heading": "Bonus Action",
        "lineStart": 12883,
        "lineEnd": 12885
      },
      "section": "8.21",
      "rulesText": "A Bonus Action is a special action that you can take on the same turn that you take an action. You can't take more than one Bonus Action on a turn, and you have a Bonus Action to take only if a rule explicitly says so. See also \"Playing the Game\" (\"Actions\")."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-22-breaking-objects",
      "@type": "Rule",
      "name": "Breaking Objects",
      "slug": "8-22-breaking-objects",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.22",
        "heading": "Breaking Objects",
        "lineStart": 12887,
        "lineEnd": 12917
      },
      "section": "8.22",
      "rulesText": "Objects can be harmed by attacks and by some spells, using the rules below. If an object is exceedingly fragile, the GM may allow a creature to break it automatically with the Attack or Utilize action.\n\nArmor Class. The Object Armor Class table suggests ACs for various substances.\n\nObject Armor Class\n\nHit Points. An object is destroyed when it has 0 Hit Points. The Object Hit Points table suggests Hit Points for fragile and resilient objects that are Large or smaller. To track Hit Points for a Huge or Gargantuan object, divide it into Large or smaller sections, and track each section's Hit Points separately. The GM determines whether destroying part of an object causes the whole thing to collapse.\n\nObject Hit Points\n\nDamage Types and Objects. Objects have Immunity to Poison and Psychic damage. The GM might decide that some damage types are more or less effective against an object. For example, Bludgeoning damage works well for smashing things but not for cutting. Paper or cloth objects might have Vulnerability to Fire damage.\n\nDamage Threshold. Big objects, such as castle walls, often have extra resilience represented by a damage threshold. See also “Damage Threshold.”\n\nNo Ability Scores. An object lacks ability scores unless a rule assigns scores to the object. Without ability scores, an object can't make ability checks, and it fails all saving throws.",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/8-22-object-armor-class"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/8-22-object-hit-points"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-23-bright-light",
      "@type": "Rule",
      "name": "Bright Light",
      "slug": "8-23-bright-light",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.23",
        "heading": "Bright Light",
        "lineStart": 12919,
        "lineEnd": 12921
      },
      "section": "8.23",
      "rulesText": "Bright Light is normal illumination. See also “Playing the Game” (“Exploration”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-24-burning-hazard",
      "@type": "Rule",
      "name": "Burning [Hazard]",
      "slug": "8-24-burning-hazard",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.24",
        "heading": "Burning [Hazard]",
        "lineStart": 12923,
        "lineEnd": 12925
      },
      "section": "8.24",
      "rulesText": "A burning creature or object takes 1d4 Fire damage at the start of each of its turns. As an action, you can extinguish fire on yourself by giving yourself the Prone condition and rolling on the ground. The fire also goes out if it is doused, submerged, or suffocated."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-25-burrow-speed",
      "@type": "Rule",
      "name": "Burrow Speed",
      "slug": "8-25-burrow-speed",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.25",
        "heading": "Burrow Speed",
        "lineStart": 12927,
        "lineEnd": 12929
      },
      "section": "8.25",
      "rulesText": "A creature that has a Burrow Speed can use that speed to move through sand, earth, mud, or ice. The creature can't burrow through solid rock unless the creature has a trait that allows it to do so. See also \"Speed.\""
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-26-campaign",
      "@type": "Rule",
      "name": "Campaign",
      "slug": "8-26-campaign",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.26",
        "heading": "Campaign",
        "lineStart": 12931,
        "lineEnd": 12933
      },
      "section": "8.26",
      "rulesText": "A campaign is a series of adventures. See also \"Adventure.\""
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-27-cantrip",
      "@type": "Rule",
      "name": "Cantrip",
      "slug": "8-27-cantrip",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.27",
        "heading": "Cantrip",
        "lineStart": 12935,
        "lineEnd": 12937
      },
      "section": "8.27",
      "rulesText": "A cantrip is a level 0 spell, which is cast without a spell slot. See also “Spells.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-28-carrying-capacity",
      "@type": "Rule",
      "name": "Carrying Capacity",
      "slug": "8-28-carrying-capacity",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.28",
        "heading": "Carrying Capacity",
        "lineStart": 12939,
        "lineEnd": 12953
      },
      "section": "8.28",
      "rulesText": "Your size and Strength score determine the maximum weight in pounds that you can carry, as shown in the Carrying Capacity table. The table also shows the maximum weight you can drag, lift, or push.\n\nWhile dragging, lifting, or pushing weight in excess of the maximum weight you can carry, your Speed can be no more than 5 feet.\n\nCarrying Capacity",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/8-28-carrying-capacity"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-29-challenge-rating",
      "@type": "Rule",
      "name": "Challenge Rating",
      "slug": "8-29-challenge-rating",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.29",
        "heading": "Challenge Rating",
        "lineStart": 12955,
        "lineEnd": 12957
      },
      "section": "8.29",
      "rulesText": "Challenge Rating (CR) summarizes the threat a monster poses to a group of four player characters. Compare a monster's CR to the characters' level. If the CR is higher, the monster is likely a danger. If the CR is lower, the monster likely poses little threat. But circumstances and the number of player characters can significantly alter how threatening a monster is in actual play. \"Gameplay Toolbox\" (\"Combat Encounters\") provides guidance to the GM on using CR while planning potential combat encounters. See also \"Stat Block.\""
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-3-rules-definitions",
      "@type": "Rule",
      "name": "Rules Definitions",
      "slug": "8-3-rules-definitions",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.3",
        "heading": "Rules Definitions",
        "lineStart": 12780,
        "lineEnd": 12782
      },
      "section": "8.3",
      "rulesText": "Here are definitions of various rules."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-30-character-sheet",
      "@type": "Rule",
      "name": "Character Sheet",
      "slug": "8-30-character-sheet",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.30",
        "heading": "Character Sheet",
        "lineStart": 12959,
        "lineEnd": 12961
      },
      "section": "8.30",
      "rulesText": "A character sheet is a paper or digital record that you use to track your character's information. See also \"Character Creation.\""
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-32-climbing",
      "@type": "Rule",
      "name": "Climbing",
      "slug": "8-32-climbing",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.32",
        "heading": "Climbing",
        "lineStart": 12971,
        "lineEnd": 12975
      },
      "section": "8.32",
      "rulesText": "While you're climbing, each foot of movement costs 1 extra foot (2 extra feet in Difficult Terrain). You ignore this extra cost if you have a Climb Speed and use it to climb.\n\nAt the GM's option, climbing a slippery surface or one with few handholds might require a successful DC 15 Strength (Athletics) check."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-33-climb-speed",
      "@type": "Rule",
      "name": "Climb Speed",
      "slug": "8-33-climb-speed",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.33",
        "heading": "Climb Speed",
        "lineStart": 12977,
        "lineEnd": 12979
      },
      "section": "8.33",
      "rulesText": "A Climb Speed can be used in place of Speed to traverse a vertical surface without expending the extra movement normally associated with climbing. See also “Climbing” and “Speed.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-34-concentration",
      "@type": "Rule",
      "name": "Concentration",
      "slug": "8-34-concentration",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.34",
        "heading": "Concentration",
        "lineStart": 12981,
        "lineEnd": 12989
      },
      "section": "8.34",
      "rulesText": "Some spells and other effects require Concentration to remain active, as specified in their descriptions. If the effect's creator loses Concentration, the effect ends. If the effect has a maximum duration, the effect's description specifies how long the creator can concentrate on it: up to 1 minute, 1 hour, or some other duration. The creator can end Concentration at any time (no action required). The following factors break Concentration.\n\nAnother Concentration Effect. You lose Concentration on an effect the moment you start casting a spell that requires Concentration or activate another effect that requires Concentration.\n\nDamage. If you take damage, you must succeed on a Constitution saving throw to maintain Concentration. The DC equals 10 or half the damage taken (round down), whichever number is higher, up to a maximum DC of 30.\n\nIncapacitated or Dead. Your Concentration ends if you have the Incapacitated condition or you die."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-35-condition",
      "@type": "Rule",
      "name": "Condition",
      "slug": "8-35-condition",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.35",
        "heading": "Condition",
        "lineStart": 12991,
        "lineEnd": 13002
      },
      "section": "8.35",
      "rulesText": "A condition is a temporary game state. The definition of a condition says how it affects its recipient, and various rules define how to end a condition. This glossary defines these conditions:\n\nA condition doesn't stack with itself; a recipient either has a condition or doesn't. The Exhaustion condition is an exception to that rule.",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/8-35-condition-table-1"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-36-cone-area-of-effect",
      "@type": "Rule",
      "name": "Cone [Area of Effect]",
      "slug": "8-36-cone-area-of-effect",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.36",
        "heading": "Cone [Area of Effect]",
        "lineStart": 13004,
        "lineEnd": 13008
      },
      "section": "8.36",
      "rulesText": "A Cone is an area of effect that extends in straight lines from a point of origin in a direction its creator chooses. A Cone's width at any point along its length is equal to that point's distance from the point of origin. For example, a Cone is 15 feet wide at a point along its length that is 15 feet from the point of origin. The effect that creates a Cone specifies its maximum length.\n\nA Cone's point of origin isn't included in the area of effect unless its creator decides otherwise."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-37-cover",
      "@type": "Rule",
      "name": "Cover",
      "slug": "8-37-cover",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.37",
        "heading": "Cover",
        "lineStart": 13010,
        "lineEnd": 13012
      },
      "section": "8.37",
      "rulesText": "Cover provides a degree of protection to a target behind it. There are three degrees of cover, each of which provides a different benefit to a target: Half Cover (+2 bonus to AC and Dexterity saving throws), Three-Quarters Cover (+5 bonus to AC and Dexterity saving throws), and Total Cover (can't be targeted directly). If behind more than one degree of cover, a target benefits only from the most protective degree. See also “Playing the Game” (“Combat”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-38-crawling",
      "@type": "Rule",
      "name": "Crawling",
      "slug": "8-38-crawling",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.38",
        "heading": "Crawling",
        "lineStart": 13014,
        "lineEnd": 13016
      },
      "section": "8.38",
      "rulesText": "While you're crawling, each foot of movement costs 1 extra foot (2 extra feet in Difficult Terrain). See also \"Speed.\""
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-39-creature",
      "@type": "Rule",
      "name": "Creature",
      "slug": "8-39-creature",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.39",
        "heading": "Creature",
        "lineStart": 13018,
        "lineEnd": 13020
      },
      "section": "8.39",
      "rulesText": "Any being in the game, including a player's character, is a creature. See also \"Creature Type.\""
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-4-ability-check",
      "@type": "Rule",
      "name": "Ability Check",
      "slug": "8-4-ability-check",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.4",
        "heading": "Ability Check",
        "lineStart": 12784,
        "lineEnd": 12786
      },
      "section": "8.4",
      "rulesText": "An ability check is a D20 Test that represents using one of the six abilities - or a specific skill associated with an ability - to overcome a challenge. See also “Playing the Game” (“D20 Tests” and “Proficiency”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-40-creature-type",
      "@type": "Rule",
      "name": "Creature Type",
      "slug": "8-40-creature-type",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.40",
        "heading": "Creature Type",
        "lineStart": 13022,
        "lineEnd": 13033
      },
      "section": "8.40",
      "rulesText": "Every creature, including every player character, has a tag in the rules that identifies the type of creature it is. Most player characters are of the Humanoid type. These are the game's creature types:\n\nThe types don't have rules themselves, but some rules in the game affect creatures of certain types in different ways.",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/8-40-creature-type-table-1"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-41-critical-hit",
      "@type": "Rule",
      "name": "Critical Hit",
      "slug": "8-41-critical-hit",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.41",
        "heading": "Critical Hit",
        "lineStart": 13035,
        "lineEnd": 13037
      },
      "section": "8.41",
      "rulesText": "If you roll a 20 on the d20 for an attack roll, you score a Critical Hit, and the attack hits regardless of any modifiers or the target's AC. A Critical Hit lets you roll extra dice for the attack's damage against the target. Roll all of the attack's damage dice twice and add them together. Then add any relevant modifiers. See also \"Playing the Game\" (\"Damage and Healing\")."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-42-cube-area-of-effect",
      "@type": "Rule",
      "name": "Cube [Area of Effect]",
      "slug": "8-42-cube-area-of-effect",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.42",
        "heading": "Cube [Area of Effect]",
        "lineStart": 13039,
        "lineEnd": 13043
      },
      "section": "8.42",
      "rulesText": "A Cube is an area of effect that extends in straight lines from a point of origin located anywhere on a face of the Cube. The effect that creates a Cube specifies its size, which is the length of each side.\n\nA Cube's point of origin isn't included in the area of effect unless its creator decides otherwise."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-43-curses",
      "@type": "Rule",
      "name": "Curses",
      "slug": "8-43-curses",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.43",
        "heading": "Curses",
        "lineStart": 13045,
        "lineEnd": 13047
      },
      "section": "8.43",
      "rulesText": "Some game effects curse a creature or an object. The effect that confers a curse defines what the curse does. Curses can be removed by the Remove Curse and Greater Restoration spells or other magic that explicitly ends curses."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-44-cylinder-area-of-effect",
      "@type": "Rule",
      "name": "Cylinder [Area of Effect]",
      "slug": "8-44-cylinder-area-of-effect",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.44",
        "heading": "Cylinder [Area of Effect]",
        "lineStart": 13049,
        "lineEnd": 13053
      },
      "section": "8.44",
      "rulesText": "A Cylinder is an area of effect that extends in straight lines from a point of origin located at the center of the circular top or bottom of the Cylinder. The effect that creates a Cylinder specifies the radius of the Cylinder's base and the Cylinder's height.\n\nA Cylinder's point of origin is included in the area of effect."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-45-d20-test",
      "@type": "Rule",
      "name": "D20 Test",
      "slug": "8-45-d20-test",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.45",
        "heading": "D20 Test",
        "lineStart": 13055,
        "lineEnd": 13057
      },
      "section": "8.45",
      "rulesText": "D20 Tests encompass the three main d20 rolls of the game: ability checks, attack rolls, and saving throws. If something in the game affects D20 Tests, it affects all three of these rolls. The GM determines whether a D20 Test is warranted in a given circumstance. See also “Playing the Game” (“D20 Tests”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-46-damage",
      "@type": "Rule",
      "name": "Damage",
      "slug": "8-46-damage",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.46",
        "heading": "Damage",
        "lineStart": 13059,
        "lineEnd": 13061
      },
      "section": "8.46",
      "rulesText": "Damage represents harm that causes a creature or an object to lose Hit Points."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-47-damage-roll",
      "@type": "Rule",
      "name": "Damage Roll",
      "slug": "8-47-damage-roll",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.47",
        "heading": "Damage Roll",
        "lineStart": 13063,
        "lineEnd": 13065
      },
      "section": "8.47",
      "rulesText": "A damage roll is a die roll, adjusted by any applicable modifiers, that deals damage to a target. See also \"Playing the Game\" (\"Damage and Healing\")."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-48-damage-threshold",
      "@type": "Rule",
      "name": "Damage Threshold",
      "slug": "8-48-damage-threshold",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.48",
        "heading": "Damage Threshold",
        "lineStart": 13067,
        "lineEnd": 13069
      },
      "section": "8.48",
      "rulesText": "A creature or an object that has a damage threshold has Immunity to all damage unless it takes an amount of damage from a single attack or effect equal to or greater than its damage threshold, in which case it takes that entire instance of damage. Any damage that fails to meet or exceed the damage threshold is superficial and doesn't reduce Hit Points. For example, if an object has a damage threshold of 10, the object takes no damage if 9 damage is dealt to it, since that damage fails to exceed the threshold. If the same object is dealt 11 damage, it takes all of that damage."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-49-damage-types",
      "@type": "Rule",
      "name": "Damage Types",
      "slug": "8-49-damage-types",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.49",
        "heading": "Damage Types",
        "lineStart": 13071,
        "lineEnd": 13094
      },
      "section": "8.49",
      "rulesText": "Attacks and other harmful effects deal different types of damage. Damage types have no rules of their own, but other rules, such as Resistance, rely on the types. The Damage Types table offers examples to help a GM assign a type to a new effect.\n\nDamage Types",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/8-49-damage-types"
        },
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/8-49-damage-types-2"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-5-ability-score-and-modifier",
      "@type": "Rule",
      "name": "Ability Score and Modifier",
      "slug": "8-5-ability-score-and-modifier",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.5",
        "heading": "Ability Score and Modifier",
        "lineStart": 12788,
        "lineEnd": 12790
      },
      "section": "8.5",
      "rulesText": "A creature has six ability scores - Strength, Dexterity, Constitution, Intelligence, Wisdom, and Charisma - each of which has a corresponding modifier. Add the modifier when you make a D20 Test with the corresponding ability or when a rule asks you to do so. See also “Playing the Game” (“The Six Abilities”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-50-darkness",
      "@type": "Rule",
      "name": "Darkness",
      "slug": "8-50-darkness",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.50",
        "heading": "Darkness",
        "lineStart": 13096,
        "lineEnd": 13098
      },
      "section": "8.50",
      "rulesText": "An area of Darkness is Heavily Obscured. See also “Heavily Obscured” and “Playing the Game” (“Exploration”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-51-darkvision",
      "@type": "Rule",
      "name": "Darkvision",
      "slug": "8-51-darkvision",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.51",
        "heading": "Darkvision",
        "lineStart": 13100,
        "lineEnd": 13102
      },
      "section": "8.51",
      "rulesText": "If you have Darkvision, you can see in Dim Light within a specified range as if it were Bright Light and in Darkness within that range as if it were Dim Light. You discern colors in that Darkness only as shades of gray. See also “Playing the Game” (“Exploration”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-52-dash-action",
      "@type": "Rule",
      "name": "Dash [Action]",
      "slug": "8-52-dash-action",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.52",
        "heading": "Dash [Action]",
        "lineStart": 13104,
        "lineEnd": 13108
      },
      "section": "8.52",
      "rulesText": "When you take the Dash action, you gain extra movement for the current turn. The increase equals your Speed after applying any modifiers. With a Speed of 30 feet, for example, you can move up to 60 feet on your turn if you Dash. If your Speed of 30 feet is reduced to 15 feet, you can move up to 30 feet this turn if you Dash.\n\nIf you have a special speed, such as a Fly Speed or Swim Speed, you can use that speed instead of your Speed when you take this action. You choose which speed to use each time you take it. See also “Speed.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-53-dead",
      "@type": "Rule",
      "name": "Dead",
      "slug": "8-53-dead",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.53",
        "heading": "Dead",
        "lineStart": 13110,
        "lineEnd": 13114
      },
      "section": "8.53",
      "rulesText": "A dead creature has no Hit Points and can't regain them unless it is first revived by magic such as the Raise Dead or Revivify spell. When such a spell is cast, the spirit knows who is casting it and can refuse. The spirit of a dead creature has left the body and departed for the Outer Planes, and reviving the creature requires calling the spirit back.\n\nIf the creature returns to life, the revival effect determines the creature's current Hit Points. Unless otherwise stated, the creature returns to life with any conditions, magical contagions, or curses that were affecting it at death if the durations of those effects are still ongoing. If the creature died with any Exhaustion levels, it returns with 1 fewer level. If the creature had Attunement to one or more magic items, it is no longer attuned to them."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-55-death-saving-throw",
      "@type": "Rule",
      "name": "Death Saving Throw",
      "slug": "8-55-death-saving-throw",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.55",
        "heading": "Death Saving Throw",
        "lineStart": 13122,
        "lineEnd": 13124
      },
      "section": "8.55",
      "rulesText": "A player character must make a Death Saving Throw (also called a Death Save) if they start their turn with 0 Hit Points. See also “Playing the Game” (“Damage and Healing”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-56-dehydration-hazard",
      "@type": "Rule",
      "name": "Dehydration [Hazard]",
      "slug": "8-56-dehydration-hazard",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.56",
        "heading": "Dehydration [Hazard]",
        "lineStart": 13126,
        "lineEnd": 13136
      },
      "section": "8.56",
      "rulesText": "A creature requires an amount of water per day based on its size, as shown in the Water Needs per Day table. A creature that drinks less than half the required water for a day gains 1 Exhaustion level at the day's end. Exhaustion caused by dehydration can't be removed until the creature drinks the full amount of water required for a day. See also \"Exhaustion.\"\n\nWater Needs per Day",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/8-56-water-needs-per-day"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-57-difficult-terrain",
      "@type": "Rule",
      "name": "Difficult Terrain",
      "slug": "8-57-difficult-terrain",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.57",
        "heading": "Difficult Terrain",
        "lineStart": 13138,
        "lineEnd": 13149
      },
      "section": "8.57",
      "rulesText": "If a space is Difficult Terrain, every foot of movement in that space costs 1 extra foot. For example, moving 5 feet through Difficult Terrain costs 10 feet of movement. Difficult Terrain isn't cumulative; either a space is Difficult Terrain or it isn't.\n\nA space is Difficult Terrain if the space contains any of the following or something similar:\n\n- A creature that isn’t Tiny or your ally\n- Furniture that is sized for creatures of your size or larger\n- Heavy snow, ice, rubble, or undergrowth\n- Liquid that's between shin- and waist-deep\n- A narrow opening sized for a creature one size smaller than you\n- A slope of 20 degrees or more"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-58-difficulty-class",
      "@type": "Rule",
      "name": "Difficulty Class",
      "slug": "8-58-difficulty-class",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.58",
        "heading": "Difficulty Class",
        "lineStart": 13151,
        "lineEnd": 13153
      },
      "section": "8.58",
      "rulesText": "A Difficulty Class (DC) is the target number for an ability check or a saving throw. See also “Playing the Game” (“D20 Tests”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-59-dim-light",
      "@type": "Rule",
      "name": "Dim Light",
      "slug": "8-59-dim-light",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.59",
        "heading": "Dim Light",
        "lineStart": 13155,
        "lineEnd": 13157
      },
      "section": "8.59",
      "rulesText": "An area with Dim Light is Lightly Obscured. See also “Lightly Obscured” and “Playing the Game” (“Exploration”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-6-action",
      "@type": "Rule",
      "name": "Action",
      "slug": "8-6-action",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.6",
        "heading": "Action",
        "lineStart": 12792,
        "lineEnd": 12799
      },
      "section": "8.6",
      "rulesText": "On your turn, you can take one action. Choose which action to take from those below or from the special actions provided by your features. See also “Playing the Game” (“Actions”). These actions are defined elsewhere in this glossary:",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/8-6-action-table-1"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-60-disadvantage",
      "@type": "Rule",
      "name": "Disadvantage",
      "slug": "8-60-disadvantage",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.60",
        "heading": "Disadvantage",
        "lineStart": 13159,
        "lineEnd": 13161
      },
      "section": "8.60",
      "rulesText": "If you have Disadvantage on a D20 Test, roll two d20s and use the lower roll. A roll can't be affected by more than one Disadvantage, and Advantage and Disadvantage on the same roll cancel each other. See also \"Playing the Game\" (\"D20 Tests\")."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-61-disengage-action",
      "@type": "Rule",
      "name": "Disengage [Action]",
      "slug": "8-61-disengage-action",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.61",
        "heading": "Disengage [Action]",
        "lineStart": 13163,
        "lineEnd": 13165
      },
      "section": "8.61",
      "rulesText": "If you take the Disengage action, your movement doesn't provoke Opportunity Attacks for the rest of the current turn."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-62-dodge-action",
      "@type": "Rule",
      "name": "Dodge [Action]",
      "slug": "8-62-dodge-action",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.62",
        "heading": "Dodge [Action]",
        "lineStart": 13167,
        "lineEnd": 13171
      },
      "section": "8.62",
      "rulesText": "If you take the Dodge action, you gain the following benefits: until the start of your next turn, any attack roll made against you has Disadvantage if you can see the attacker, and you make Dexterity saving throws with Advantage.\n\nYou lose these benefits if you have the Incapacitated condition or if your Speed is 0."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-63-emanation-area-of-effect",
      "@type": "Rule",
      "name": "Emanation [Area of Effect]",
      "slug": "8-63-emanation-area-of-effect",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.63",
        "heading": "Emanation [Area of Effect]",
        "lineStart": 13173,
        "lineEnd": 13179
      },
      "section": "8.63",
      "rulesText": "An Emanation is an area of effect that extends in straight lines from a creature or an object in all directions. The effect that creates an Emanation specifies the distance it extends.\n\nAn Emanation moves with the creature or object that is its origin unless it is an instantaneous or a stationary effect.\n\nAn Emanation's origin (creature or object) isn't included in the area of effect unless its creator decides otherwise."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-64-encounter",
      "@type": "Rule",
      "name": "Encounter",
      "slug": "8-64-encounter",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.64",
        "heading": "Encounter",
        "lineStart": 13181,
        "lineEnd": 13183
      },
      "section": "8.64",
      "rulesText": "An encounter is a scene in an adventure that is part of at least one of the game's three pillars: social interaction, exploration, or combat. See also \"Playing the Game\" (\"Social Interaction,\" \"Exploration,\" and \"Combat\")."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-65-enemy",
      "@type": "Rule",
      "name": "Enemy",
      "slug": "8-65-enemy",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.65",
        "heading": "Enemy",
        "lineStart": 13185,
        "lineEnd": 13187
      },
      "section": "8.65",
      "rulesText": "A creature is your enemy if it fights against you in combat, actively works to harm you, or is designated as your enemy by the rules or GM."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-67-experience-points",
      "@type": "Rule",
      "name": "Experience Points",
      "slug": "8-67-experience-points",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.67",
        "heading": "Experience Points",
        "lineStart": 13201,
        "lineEnd": 13203
      },
      "section": "8.67",
      "rulesText": "As they overcome challenges and complete adventures, characters earn Experience Points (XP), which are awarded by the Game Master. When a character's XP total crosses certain thresholds, the character's level increases. See also “Level Advancement.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-68-expertise",
      "@type": "Rule",
      "name": "Expertise",
      "slug": "8-68-expertise",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.68",
        "heading": "Expertise",
        "lineStart": 13205,
        "lineEnd": 13211
      },
      "section": "8.68",
      "rulesText": "Expertise is a feature that enhances your use of a skill proficiency. When you make an ability check with a skill proficiency in which you have Expertise, your Proficiency Bonus is doubled for that check unless the bonus is doubled by another feature.\n\nIf you gain Expertise, you gain it in one skill in which you have proficiency. You can't have Expertise in the same skill proficiency more than once.\n\nSee also “Playing the Game” (“Proficiency”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-69-falling-hazard",
      "@type": "Rule",
      "name": "Falling [Hazard]",
      "slug": "8-69-falling-hazard",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.69",
        "heading": "Falling [Hazard]",
        "lineStart": 13213,
        "lineEnd": 13217
      },
      "section": "8.69",
      "rulesText": "A creature that falls takes 1d6 Bludgeoning damage at the end of the fall for every 10 feet it fell, to a maximum of 20d6. When the creature lands, it has the Prone condition unless it avoids taking any damage from the fall.\n\nA creature that falls into water or another liquid can use its Reaction to make a DC 15 Strength (Athletics) or Dexterity (Acrobatics) check to hit the surface head or feet first. On a successful check, any damage resulting from the fall is halved."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-7-advantage",
      "@type": "Rule",
      "name": "Advantage",
      "slug": "8-7-advantage",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.7",
        "heading": "Advantage",
        "lineStart": 12801,
        "lineEnd": 12803
      },
      "section": "8.7",
      "rulesText": "If you have Advantage on a D20 Test, roll two d20s, and use the higher roll. A roll can't be affected by more than one Advantage, and Advantage and Disadvantage on the same roll cancel each other. See also \"Playing the Game\" (\"D20 Tests\")."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-70-flying",
      "@type": "Rule",
      "name": "Flying",
      "slug": "8-70-flying",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.70",
        "heading": "Flying",
        "lineStart": 13219,
        "lineEnd": 13221
      },
      "section": "8.70",
      "rulesText": "A variety of effects allow a creature to fly. While flying, you fall if you have the Incapacitated or Prone condition or your Fly Speed is reduced to 0. You can stay aloft in those circumstances if you can hover. See also “Falling” and “Fly Speed.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-71-fly-speed",
      "@type": "Rule",
      "name": "Fly Speed",
      "slug": "8-71-fly-speed",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.71",
        "heading": "Fly Speed",
        "lineStart": 13223,
        "lineEnd": 13225
      },
      "section": "8.71",
      "rulesText": "A Fly Speed can be used to travel through the air. While you have a Fly Speed, you can stay aloft until you land, fall, or die. See also “Flying” and “Speed.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-72-friendly-attitude",
      "@type": "Rule",
      "name": "Friendly [Attitude]",
      "slug": "8-72-friendly-attitude",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.72",
        "heading": "Friendly [Attitude]",
        "lineStart": 13227,
        "lineEnd": 13229
      },
      "section": "8.72",
      "rulesText": "A Friendly creature views you favorably. You have Advantage on an ability check to influence a Friendly creature. See also “Influence.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-75-grappling",
      "@type": "Rule",
      "name": "Grappling",
      "slug": "8-75-grappling",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.75",
        "heading": "Grappling",
        "lineStart": 13249,
        "lineEnd": 13257
      },
      "section": "8.75",
      "rulesText": "A creature can grapple another creature. Characters typically grapple by using an Unarmed Strike. Many monsters have special attacks that allow them to quickly grapple prey. However a grapple is initiated, it follows these rules. See also “Unarmed Strike” and “Grappled.”\n\nGrappled Condition. Successfully grappling a creature gives it the Grappled condition.\n\nOne Grapple per Hand. A creature must have a hand free to grapple another creature. Some stat blocks and game effects allow a creature to grapple using a tentacle, a maw, or another body part. Whatever part a grappler uses, it can grapple only one creature at a time with that part, and the grappler can't use that part to target another creature unless it ends the grapple.\n\nEnding a Grapple. A Grappled creature can use its action to make a Strength (Athletics) or Dexterity (Acrobatics) check against the grapple's escape DC, ending the condition on itself on a success. The condition also ends if the grappler has the Incapacitated condition or if the distance between the Grappled target and the grappler exceeds the grapple's range. In addition, the grappler can release the target at any time (no action required)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-76-hazard",
      "@type": "Rule",
      "name": "Hazard",
      "slug": "8-76-hazard",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.76",
        "heading": "Hazard",
        "lineStart": 13259,
        "lineEnd": 13261
      },
      "section": "8.76",
      "rulesText": "A hazard is an environmental danger. See also \"Burning,\" \"Dehydration,\" \"Falling,\" \"Malnutrition,\" and \"Suffocation.\""
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-77-healing",
      "@type": "Rule",
      "name": "Healing",
      "slug": "8-77-healing",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.77",
        "heading": "Healing",
        "lineStart": 13263,
        "lineEnd": 13265
      },
      "section": "8.77",
      "rulesText": "Healing is how you regain Hit Points. See also “Playing the Game” (“Damage and Healing”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-78-heavily-obscured",
      "@type": "Rule",
      "name": "Heavily Obscured",
      "slug": "8-78-heavily-obscured",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.78",
        "heading": "Heavily Obscured",
        "lineStart": 13267,
        "lineEnd": 13269
      },
      "section": "8.78",
      "rulesText": "You have the Blinded condition while trying to see something in a Heavily Obscured space. See also “Blinded,” “Darkness,” and “Playing the Game” (“Exploration”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-79-help-action",
      "@type": "Rule",
      "name": "Help [Action]",
      "slug": "8-79-help-action",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.79",
        "heading": "Help [Action]",
        "lineStart": 13271,
        "lineEnd": 13279
      },
      "section": "8.79",
      "rulesText": "When you take the Help action, you do one of the following.\n\nAssist an Ability Check. Choose one of your skill or tool proficiencies and one ally who is near\n\nenough for you to assist verbally or physically when they make an ability check. That ally has Advantage on the next ability check they make with the chosen skill or tool. This benefit expires if the ally doesn't use it before the start of your next turn. The GM has final say on whether your assistance is possible.\n\nAssist an Attack Roll. You momentarily distract an enemy within 5 feet of you, giving Advantage to the next attack roll by one of your allies against that enemy. This benefit expires at the start of your next turn."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-8-adventure",
      "@type": "Rule",
      "name": "Adventure",
      "slug": "8-8-adventure",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.8",
        "heading": "Adventure",
        "lineStart": 12805,
        "lineEnd": 12807
      },
      "section": "8.8",
      "rulesText": "An adventure is a series of encounters. A story emerges through playing them. See also \"Encounter.\""
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-80-heroic-inspiration",
      "@type": "Rule",
      "name": "Heroic Inspiration",
      "slug": "8-80-heroic-inspiration",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.80",
        "heading": "Heroic Inspiration",
        "lineStart": 13281,
        "lineEnd": 13285
      },
      "section": "8.80",
      "rulesText": "If you (a player character) have Heroic Inspiration, you can expend it to reroll any die immediately after rolling it, and you must use the new roll.\n\nIf you gain Heroic Inspiration but already have it, it's lost unless you give it to a player character who lacks it."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-81-hide-action",
      "@type": "Rule",
      "name": "Hide [Action]",
      "slug": "8-81-hide-action",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.81",
        "heading": "Hide [Action]",
        "lineStart": 13287,
        "lineEnd": 13293
      },
      "section": "8.81",
      "rulesText": "With the Hide action, you try to hide yourself. To do so, you must succeed on a DC 15 Dexterity (Stealth) check while you're Heavily Obscured or behind Three-Quarters Cover or Total Cover, and you must be out of any enemy's line of sight; if you can see a creature, you can discern whether it can see you.\n\nOn a successful check, you have the Invisible condition while hidden. Make note of your check's total, which is the DC for a creature to find you with a Wisdom (Perception) check.\n\nYou stop being hidden immediately after any of the following occurs: you make a sound louder than a whisper, an enemy finds you, you make an attack roll, or you cast a spell with a Verbal component."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-82-high-jump",
      "@type": "Rule",
      "name": "High Jump",
      "slug": "8-82-high-jump",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.82",
        "heading": "High Jump",
        "lineStart": 13295,
        "lineEnd": 13299
      },
      "section": "8.82",
      "rulesText": "When you make a High Jump, you leap into the air a number of feet equal to 3 plus your Strength modifier (minimum of 0 feet) if you move at least 10 feet on foot immediately before the jump. When you make a standing High Jump, you can jump only half that distance. Either way, each foot of the jump costs a foot of movement.\n\nYou can extend your arms half your height above yourself during the jump. Thus, you can reach a distance equal to the height of the jump plus 1 1/2 times your height."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-83-hit-point-dice",
      "@type": "Rule",
      "name": "Hit Point Dice",
      "slug": "8-83-hit-point-dice",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.83",
        "heading": "Hit Point Dice",
        "lineStart": 13301,
        "lineEnd": 13303
      },
      "section": "8.83",
      "rulesText": "Hit Point Dice, or Hit Dice for short, help determine a player character's Hit Point maximum, as explained in “Character Creation.” Most monsters also have Hit Dice. A creature can spend Hit Dice during a Short Rest to regain Hit Points. See also “Short Rest.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-84-hit-points",
      "@type": "Rule",
      "name": "Hit Points",
      "slug": "8-84-hit-points",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.84",
        "heading": "Hit Points",
        "lineStart": 13305,
        "lineEnd": 13307
      },
      "section": "8.84",
      "rulesText": "Hit Points (HP) are a measure of how difficult it is to kill or destroy a creature or an object. Damage reduces Hit Points, and healing restores them. You can't have more Hit Points than your Hit Point maximum, and you can't have less than 0. See also \"Breaking Objects\" and \"Playing the Game\" (\"Damage and Healing\")."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-85-hostile-attitude",
      "@type": "Rule",
      "name": "Hostile [Attitude]",
      "slug": "8-85-hostile-attitude",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.85",
        "heading": "Hostile [Attitude]",
        "lineStart": 13309,
        "lineEnd": 13311
      },
      "section": "8.85",
      "rulesText": "A Hostile creature views you unfavorably. You have Disadvantage on an ability check to influence a Hostile creature. See also “Influence.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-86-hover",
      "@type": "Rule",
      "name": "Hover",
      "slug": "8-86-hover",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.86",
        "heading": "Hover",
        "lineStart": 13313,
        "lineEnd": 13315
      },
      "section": "8.86",
      "rulesText": "Some creatures can hover, as noted in their stat blocks, and some spells and other effects grant the ability to hover. Hovering while flying prevents you from falling in certain circumstances. See also \"Flying.\""
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-87-illusions",
      "@type": "Rule",
      "name": "Illusions",
      "slug": "8-87-illusions",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.87",
        "heading": "Illusions",
        "lineStart": 13317,
        "lineEnd": 13321
      },
      "section": "8.87",
      "rulesText": "Spells and other effects sometimes create magical illusions. Such an effect defines what the illusion does and which senses or mental faculties it deceives.\n\nIf an illusion manifests in space, the illusion is insubstantial and weightless, yet it seems to be affected by the environment as if the illusion were real unless the effect that created it specifies otherwise. For example, a visual illusion of a creature casts shadows and reflections, and wind appears to affect the illusory creature. Similarly, an audible illusion echoes in an echoey space."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-88-immunity",
      "@type": "Rule",
      "name": "Immunity",
      "slug": "8-88-immunity",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.88",
        "heading": "Immunity",
        "lineStart": 13323,
        "lineEnd": 13325
      },
      "section": "8.88",
      "rulesText": "If you have Immunity to a damage type or a condition, it doesn't affect you in any way."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-89-improvised-weapons",
      "@type": "Rule",
      "name": "Improvised Weapons",
      "slug": "8-89-improvised-weapons",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.89",
        "heading": "Improvised Weapons",
        "lineStart": 13327,
        "lineEnd": 13337
      },
      "section": "8.89",
      "rulesText": "An improvised weapon is an object wielded as a makeshift weapon, such as broken glass, a table leg, or a frying pan. A Simple or Martial weapon also counts as an improvised weapon if it's wielded in a way contrary to its design; if you use a Ranged weapon to make a melee attack or throw a Melee weapon that lacks the Thrown property, the weapon counts as an improvised weapon. An improvised weapon follows the rules below.\n\nProficiency. Don't add your Proficiency Bonus to attack rolls with an improvised weapon.\n\nDamage. On a hit, the weapon deals 1d4 damage of a type the GM thinks is appropriate for the object.\n\nRange. If you throw the weapon, it has a normal range of 20 feet and a long range of 60 feet.\n\nWeapon Equivalents. If an improvised weapon resembles a Simple or Martial weapon, the GM may say it functions as that weapon and uses that weapon's rules. For example, the GM could treat a table leg as a Club."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-9-alignment",
      "@type": "Rule",
      "name": "Alignment",
      "slug": "8-9-alignment",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.9",
        "heading": "Alignment",
        "lineStart": 12809,
        "lineEnd": 12811
      },
      "section": "8.9",
      "rulesText": "A creature's alignment broadly describes its ethical attitudes and ideals. Alignment is a combination of two factors: one identifies morality (good, evil, or neutral), and the other describes attitudes toward order (lawful, chaotic, or neutral). These factors allow for nine possible combinations, such as Lawful Good and Neutral Evil. See also “Character Creation” (“Create Your Character”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-91-indifferent-attitude",
      "@type": "Rule",
      "name": "Indifferent [Attitude]",
      "slug": "8-91-indifferent-attitude",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.91",
        "heading": "Indifferent [Attitude]",
        "lineStart": 13351,
        "lineEnd": 13353
      },
      "section": "8.91",
      "rulesText": "An Indifferent creature has no desire to help or hinder you. Indifferent is the default attitude of a monster. See also “Influence.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-92-influence-action",
      "@type": "Rule",
      "name": "Influence [Action]",
      "slug": "8-92-influence-action",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.92",
        "heading": "Influence [Action]",
        "lineStart": 13355,
        "lineEnd": 13373
      },
      "section": "8.92",
      "rulesText": "With the Influence action, you urge a monster to do something. Describe or roleplay how you're communicating with the monster. Are you trying to deceive, intimidate, amuse, or gently persuade? The GM then determines whether the monster feels willing, unwilling, or hesitant due to your interaction; this determination establishes whether an ability check is necessary, as explained below.\n\nWilling. If your urging aligns with the monster's desires, no ability check is necessary; the monster fulfills your request in a way it prefers.\n\nUnwilling. If your urging is repugnant to the monster or counter to its alignment, no ability check is necessary; it doesn't comply.\n\nHesitant. If you urge the monster to do something that it is hesitant to do, you must make an ability check, which is affected by the monster's attitude: Indifferent, Friendly, or Hostile, each of which is defined in this glossary. The Influence Checks table suggests which ability check to make based on how you're interacting with the monster. The GM chooses the check, which has a default DC equal to 15 or the monster's Intelligence score, whichever is higher. On a successful check, the monster does as urged. On a failed check, you must wait 24 hours (or a duration set by the GM) before urging it in the same way again.\n\nInfluence Checks",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/8-92-influence-checks"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-93-initiative",
      "@type": "Rule",
      "name": "Initiative",
      "slug": "8-93-initiative",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.93",
        "heading": "Initiative",
        "lineStart": 13375,
        "lineEnd": 13379
      },
      "section": "8.93",
      "rulesText": "Initiative determines the order of turns during combat. The combat rules in “Playing the Game” explain how to roll Initiative.\n\nSometimes a GM might have combatants use their Initiative scores instead of rolling Initiative. Your Initiative score equals 10 plus your Dexterity modifier. If you have Advantage on Initiative rolls, increase your Initiative score by 5. If you have Disadvantage on those rolls, decrease that score by 5. See also “Playing the Game” (“Combat”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-95-jumping",
      "@type": "Rule",
      "name": "Jumping",
      "slug": "8-95-jumping",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.95",
        "heading": "Jumping",
        "lineStart": 13391,
        "lineEnd": 13393
      },
      "section": "8.95",
      "rulesText": "When you jump, you make either a Long Jump (horizontal) or a High Jump (vertical). See also “Long Jump” and “High Jump.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-96-knocking-out-a-creature",
      "@type": "Rule",
      "name": "Knocking Out a Creature",
      "slug": "8-96-knocking-out-a-creature",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.96",
        "heading": "Knocking Out a Creature",
        "lineStart": 13395,
        "lineEnd": 13399
      },
      "section": "8.96",
      "rulesText": "When you would reduce a creature to 0 Hit Points with a melee attack, you can instead reduce the creature to 1 Hit Point. The creature then has the Unconscious condition and starts a Short Rest.\n\nThe creature remains Unconscious until it regains any Hit Points or until someone uses an action to administer first aid to it, which requires a successful DC 10 Wisdom (Medicine) check."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-97-lightly-obscured",
      "@type": "Rule",
      "name": "Lightly Obscured",
      "slug": "8-97-lightly-obscured",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.97",
        "heading": "Lightly Obscured",
        "lineStart": 13401,
        "lineEnd": 13403
      },
      "section": "8.97",
      "rulesText": "You have Disadvantage on Wisdom (Perception) checks to see something in a Lightly Obscured space. See also “Dim Light” and “Playing the Game” (“Exploration”)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-98-line-area-of-effect",
      "@type": "Rule",
      "name": "Line [Area of Effect]",
      "slug": "8-98-line-area-of-effect",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.98",
        "heading": "Line [Area of Effect]",
        "lineStart": 13405,
        "lineEnd": 13409
      },
      "section": "8.98",
      "rulesText": "A Line is an area of effect that extends from a point of origin in a straight path along its length and covers an area defined by its width. The effect that creates a Line specifies its length and width.\n\nA Line's point of origin isn't included in the area of effect unless its creator decides otherwise."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/8-99-long-jump",
      "@type": "Rule",
      "name": "Long Jump",
      "slug": "8-99-long-jump",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Rules Glossary",
        "section": "8.99",
        "heading": "Long Jump",
        "lineStart": 13411,
        "lineEnd": 13419
      },
      "section": "8.99",
      "rulesText": "When you make a Long Jump, you leap horizontally a number of feet up to your Strength score if you\n\nmove at least 10 feet immediately before the jump. When you make a standing Long Jump, you can leap only half that distance. Either way, each foot you jump costs a foot of movement.\n\nIf you land in Difficult Terrain, you must succeed on a DC 10 Dexterity (Acrobatics) check or have the Prone condition.\n\nThis Long Jump rule assumes that the height of the jump doesn't matter, such as a jump across a stream or chasm. At your GM's option, you must succeed on a DC 10 Strength (Athletics) check to clear a low obstacle (no taller than a quarter of the jump's distance), such as a hedge or low wall. Otherwise, you hit the obstacle."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-1-gameplay-toolbox",
      "@type": "Rule",
      "name": "Gameplay Toolbox",
      "slug": "9-1-gameplay-toolbox",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.1",
        "heading": "Gameplay Toolbox",
        "lineStart": 13867,
        "lineEnd": 13867
      },
      "section": "9.1"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-10-2-choose-a-feat",
      "@type": "Rule",
      "name": "2: Choose a Feat",
      "slug": "9-10-2-choose-a-feat",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.10",
        "heading": "2: Choose a Feat",
        "lineStart": 13940,
        "lineEnd": 13942
      },
      "section": "9.10",
      "rulesText": "Choose one feat from the Origin category. See “Origin Feats” for examples of Origin feats."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-11-3-choose-skill-proficiencies",
      "@type": "Rule",
      "name": "3: Choose Skill Proficiencies",
      "slug": "9-11-3-choose-skill-proficiencies",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.11",
        "heading": "3: Choose Skill Proficiencies",
        "lineStart": 13944,
        "lineEnd": 13946
      },
      "section": "9.11",
      "rulesText": "Choose two skills appropriate for the background. There needn't be a relationship between the skill proficiencies a background grants and the ability scores it increases."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-12-4-choose-a-tool-proficiency",
      "@type": "Rule",
      "name": "4: Choose a Tool Proficiency",
      "slug": "9-12-4-choose-a-tool-proficiency",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.12",
        "heading": "4: Choose a Tool Proficiency",
        "lineStart": 13948,
        "lineEnd": 13950
      },
      "section": "9.12",
      "rulesText": "Choose one tool used in the practice of the background or often associated with it."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-13-5-choose-equipment",
      "@type": "Rule",
      "name": "5: Choose Equipment",
      "slug": "9-13-5-choose-equipment",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.13",
        "heading": "5: Choose Equipment",
        "lineStart": 13952,
        "lineEnd": 13954
      },
      "section": "9.13",
      "rulesText": "Assemble a package of equipment worth 50 GP (including unspent gold). Don't include Martial weapons or armor, as characters get them from their class choices."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-14-curses-and",
      "@type": "Rule",
      "name": "Curses and",
      "slug": "9-14-curses-and",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.14",
        "heading": "Curses and",
        "lineStart": 13956,
        "lineEnd": 13956
      },
      "section": "9.14"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-15-magical-contagions",
      "@type": "Rule",
      "name": "Magical Contagions",
      "slug": "9-15-magical-contagions",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.15",
        "heading": "Magical Contagions",
        "lineStart": 13958,
        "lineEnd": 13962
      },
      "section": "9.15",
      "rulesText": "A curse is a magical burden that lasts for a specified time or until it is ended by some means. A magical contagion is an adverse effect of magical origin that is contagious by definition.\n\nThe following sections discuss curses and magical contagions in detail."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-16-curses",
      "@type": "Rule",
      "name": "Curses",
      "slug": "9-16-curses",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.16",
        "heading": "Curses",
        "lineStart": 13964,
        "lineEnd": 13966
      },
      "section": "9.16",
      "rulesText": "A curse typically takes one of the forms detailed below."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-17-bestow-curse",
      "@type": "Rule",
      "name": "Bestow Curse",
      "slug": "9-17-bestow-curse",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.17",
        "heading": "Bestow Curse",
        "lineStart": 13968,
        "lineEnd": 13972
      },
      "section": "9.17",
      "rulesText": "The simplest curses are created by the Bestow Curse spell. The effects of such curses are limited and can be ended by the Remove Curse spell.\n\nBestow Curse provides useful benchmarks for gauging the potency of other curses. A curse that lasts for 1 minute equates to a level 3 spell, while one that lasts until dispelled equates to a level 9 spell."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-18-cursed-creatures",
      "@type": "Rule",
      "name": "Cursed Creatures",
      "slug": "9-18-cursed-creatures",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.18",
        "heading": "Cursed Creatures",
        "lineStart": 13974,
        "lineEnd": 13978
      },
      "section": "9.18",
      "rulesText": "Some monsters are associated with curses, whether as part of their origins or due to their ability to spread curses - werewolves being a prime example.\n\nYou decide how a spell like Remove Curse affects a creature with accursed origins. For example, you might decide that a mummy was created through a curse and it can be destroyed permanently only by casting Remove Curse on its corpse."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-19-cursed-magic-items",
      "@type": "Rule",
      "name": "Cursed Magic Items",
      "slug": "9-19-cursed-magic-items",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.19",
        "heading": "Cursed Magic Items",
        "lineStart": 13980,
        "lineEnd": 13982
      },
      "section": "9.19",
      "rulesText": "Cursed magic items are created deliberately or originate as the result of supernatural events. Such items are detailed in “Magic Items.”"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-2-travel-pace",
      "@type": "Rule",
      "name": "Travel Pace",
      "slug": "9-2-travel-pace",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.2",
        "heading": "Travel Pace",
        "lineStart": 13869,
        "lineEnd": 13890
      },
      "section": "9.2",
      "rulesText": "A group of characters can travel overland at a Normal, Fast, or Slow pace, as described in “Playing the Game.” During any journey stage, the predominant terrain determines the characters’ maximum travel pace, as shown in the Maximum Pace column of the Travel Terrain table. Certain factors can affect a group’s travel pace.\n\nTravel Terrain\n\n*Appropriate equipment (such as skis) is necessary to keep up a Fast pace in Arctic terrain.\n† Characters' rate of travel while waterborne depends on the vehicle carrying them; see “Vehicles.”",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/9-2-travel-terrain"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-20-narrative-curses",
      "@type": "Rule",
      "name": "Narrative Curses",
      "slug": "9-20-narrative-curses",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.20",
        "heading": "Narrative Curses",
        "lineStart": 13984,
        "lineEnd": 13988
      },
      "section": "9.20",
      "rulesText": "A curse might manifest during an adventure when a creature's violation of a taboo warrants supernatural punishment, such as breaking a vow, defiling a tomb, or murdering an innocent. Such a curse can have any effects you design, or it might be a customized version of another type of curse discussed in this section.\n\nA creature affected by such a curse should know why they're being punished and be able to learn how to end their curse, likely by symbolically righting the wrong they committed. How a spell like Remove Curse affects a curse that's part of your adventure is up to you - the spell might merely suppress the effects of the curse for a time. Regardless, narrative curses should feel like rare, potent magic rooted in the lore of your campaign."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-21-environmental-curses",
      "@type": "Rule",
      "name": "Environmental Curses",
      "slug": "9-21-environmental-curses",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.21",
        "heading": "Environmental Curses",
        "lineStart": 13990,
        "lineEnd": 13998
      },
      "section": "9.21",
      "rulesText": "Some locations are so suffused with evil that anyone who lingers there is burdened with a curse. Demonic Possession is one example of an environmental curse.\n\nDemonic Possession. Demonic Possession arises from the chaos and evil of the Abyss and commonly besets creatures that interact with demonic objects or linger in desecrated locations, where demonic spirits await victims.\n\nA creature that becomes the target of Demonic Possession must succeed on a DC 15 Charisma saving throw or be possessed by a bodiless demonic entity. Whenever the possessed creature rolls a 1 on a D20 Test, the demonic entity takes control of the creature and determines the creature's behavior thereafter. At the end of each of the possessed creature's later turns, the creature makes a DC 15 Charisma saving throw, regaining control of itself on a success.\n\nAfter finishing a Long Rest, a creature with Demonic Possession makes a DC 15 Charisma saving throw. On a successful save, the effect ends on the creature. A Dispel Evil and Good spell or any magic that removes a curse also ends the effect on it."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-22-magical-contagions",
      "@type": "Rule",
      "name": "Magical Contagions",
      "slug": "9-22-magical-contagions",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.22",
        "heading": "Magical Contagions",
        "lineStart": 14000,
        "lineEnd": 14002
      },
      "section": "9.22",
      "rulesText": "Alchemists, potion brewers, and areas of wild magic are credited with creating the first magical contagions. An outbreak of such a contagion can form the basis of an adventure as characters search for a cure and try to stop the contagion's spread."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-23-rest-and-recuperation",
      "@type": "Rule",
      "name": "Rest and Recuperation",
      "slug": "9-23-rest-and-recuperation",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.23",
        "heading": "Rest and Recuperation",
        "lineStart": 14004,
        "lineEnd": 14006
      },
      "section": "9.23",
      "rulesText": "If a creature infected with a magical contagion spends 3 days recuperating - engaging in no activities that would interrupt a Long Rest - the creature makes a DC 15 Constitution saving throw at the end of the recuperation period. On a successful save, the creature has Advantage on saving throws to fight off the magical contagion for the next 24 hours."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-24-example-contagions",
      "@type": "Rule",
      "name": "Example Contagions",
      "slug": "9-24-example-contagions",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.24",
        "heading": "Example Contagions",
        "lineStart": 14008,
        "lineEnd": 14010
      },
      "section": "9.24",
      "rulesText": "The following examples show how magical contagions can work. Feel free to alter the saving throw DCs, effects, and other characteristics of these contagions to suit your campaign."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-25-cackle-fever",
      "@type": "Rule",
      "name": "Cackle Fever",
      "slug": "9-25-cackle-fever",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.25",
        "heading": "Cackle Fever",
        "lineStart": 14012,
        "lineEnd": 14024
      },
      "section": "9.25",
      "rulesText": "Magical Contagion\n\nCheaply made potions and elixirs are sometimes tainted by Cackle Fever, which affects Humanoids only (gnomes are strangely immune). A creature suffers the following effects 1d4 days after infection:\n\nFever. The creature gains 1 Exhaustion level, which lasts until the contagion ends on the creature.\n\nUncontrollable Laughter. While the creature has the Exhaustion condition, the creature makes a DC 13 Constitution saving throw each time it takes damage other than Psychic damage. On a failed save, the creature takes 5 (1d10) Psychic damage and has the Incapacitated condition as it laughs uncontrollably. At the end of each of its turns, the creature repeats the save, ending the effect on itself on a success. After 1 minute, it succeeds automatically.\n\nFighting the Contagion. At the end of each Long Rest, an infected creature makes a DC 13 Constitution saving throw. After the creature succeeds on three of these saves, the contagion ends on it, and the creature is immune to Cackle Fever for 1 year.\n\nSpreading the Contagion. Any Humanoid (other than a gnome) that starts its turn within a 10-foot Emanation originating from a creature infected with Cackle Fever must succeed on a DC 10 Constitution saving throw or also become infected with the contagion. On a successful save, the Humanoid can't catch the contagion from that particular infected creature for the next 24 hours."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-26-sewer-plague",
      "@type": "Rule",
      "name": "Sewer Plague",
      "slug": "9-26-sewer-plague",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.26",
        "heading": "Sewer Plague",
        "lineStart": 14026,
        "lineEnd": 14038
      },
      "section": "9.26",
      "rulesText": "Magical Contagion\n\nFouled potions and alchemical waste can give rise to Sewer Plague, which incubates in sewers and refuse heaps and is sometimes transmitted by creatures that dwell in such areas, including otyu-ghs and rats. Any Humanoid that is wounded by a creature that carries the contagion or that comes into contact with contaminated filth or offal must succeed on a DC 11 Constitution saving throw or become infected with Sewer Plague. A creature suffers the following effects 1d4 days after infection:\n\nFatigue. The creature gains 1 Exhaustion level.\n\nWeakness. While the creature has any Exhaustion levels, it regains only half the normal number of Hit Points from spending Hit Point Dice.\n\nRestlessness. While the creature has any Exhaustion levels, finishing a Long Rest neither restores lost Hit Points nor reduces the creature's Exhaustion level.\n\nFighting the Contagion. Daily at dawn, an infected creature makes a DC 11 Constitution saving throw. On a failed save, the creature gains 1 Exhaustion level as its fatigue worsens. On a successful save, the creature's Exhaustion level decreases by 1. If the creature's Exhaustion level is reduced to 0, the contagion ends on the creature."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-27-sight-rot",
      "@type": "Rule",
      "name": "Sight Rot",
      "slug": "9-27-sight-rot",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.27",
        "heading": "Sight Rot",
        "lineStart": 14040,
        "lineEnd": 14048
      },
      "section": "9.27",
      "rulesText": "Magical Contagion\n\nAny Beast or Humanoid that drinks water tainted by Sight Rot must succeed on a DC 15 Constitution saving throw or have the Blinded condition until the contagion ends.\n\nFighting the Contagion. Magic such as a Heal or Lesser Restoration spell ends the contagion immediately. A character who is proficient with an Herbalism Kit can use it to create one dose of nonmagical ointment, which takes 1 hour. When applied to the eyes of a creature suffering from Sight Rot, the ointment suppresses the contagion on that creature for 24 hours. If the contagion is suppressed in this way for a total of 72 hours (requiring three doses and applications of the ointment), the contagion ends on the creature.\n\nSpreading the Contagion. Any Humanoid that makes skin contact with a creature infected with Sight Rot must succeed on a DC 15 Constitution saving throw or also become infected with the contagion. On a successful save, the Humanoid can't catch the contagion from that particular infected creature for the next 24 hours."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-28-environmental-effects-deep-water",
      "@type": "Rule",
      "name": "Environmental Effects Deep Water",
      "slug": "9-28-environmental-effects-deep-water",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.28",
        "heading": "Environmental Effects Deep Water",
        "lineStart": 14050,
        "lineEnd": 14052
      },
      "section": "9.28",
      "rulesText": "Swimming through deep water (more than 100 feet deep) presents additional challenges because of the water's pressure and cold temperature. After each hour of swimming in deep water, a creature that lacks a Swim Speed must succeed on a DC 10 Constitution saving throw or gain 1 Exhaustion level."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-29-extreme-cold",
      "@type": "Rule",
      "name": "Extreme Cold",
      "slug": "9-29-extreme-cold",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.29",
        "heading": "Extreme Cold",
        "lineStart": 14054,
        "lineEnd": 14056
      },
      "section": "9.29",
      "rulesText": "When the temperature is 0 degrees Fahrenheit or lower, a creature exposed to the extreme cold must succeed on a DC 10 Constitution saving throw at the end of each hour or gain 1 Exhaustion level. Creatures that have Resistance or Immunity to Cold damage automatically succeed on the save."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-3-good-roads",
      "@type": "Rule",
      "name": "Good Roads",
      "slug": "9-3-good-roads",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.3",
        "heading": "Good Roads",
        "lineStart": 13892,
        "lineEnd": 13894
      },
      "section": "9.3",
      "rulesText": "The presence of a good road increases the group's maximum pace by one step (from Slow to Normal or from Normal to Fast)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-30-extreme-heat",
      "@type": "Rule",
      "name": "Extreme Heat",
      "slug": "9-30-extreme-heat",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.30",
        "heading": "Extreme Heat",
        "lineStart": 14058,
        "lineEnd": 14060
      },
      "section": "9.30",
      "rulesText": "When the temperature is 100 degrees Fahrenheit or higher, a creature exposed to the extreme heat and without access to drinkable water must succeed on a Constitution saving throw at the end of each hour or gain 1 Exhaustion level. The DC is 5 for the first hour and increases by 1 for each additional hour. Creatures wearing Medium or Heavy armor have Disadvantage on the save. Creatures that have Resistance or Immunity to Fire damage automatically succeed on the save."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-31-frigid-water",
      "@type": "Rule",
      "name": "Frigid Water",
      "slug": "9-31-frigid-water",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.31",
        "heading": "Frigid Water",
        "lineStart": 14062,
        "lineEnd": 14064
      },
      "section": "9.31",
      "rulesText": "A creature can be immersed in frigid water for a number of minutes equal to its Constitution score before suffering any ill effects. Each additional minute spent in frigid water requires the creature to succeed on a DC 10 Constitution saving throw or gain 1 Exhaustion level. Creatures with Resistance or Immunity to Cold damage automatically succeed on the save, as do creatures that are naturally adapted to living in ice-cold water."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-32-heavy-precipitation",
      "@type": "Rule",
      "name": "Heavy Precipitation",
      "slug": "9-32-heavy-precipitation",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.32",
        "heading": "Heavy Precipitation",
        "lineStart": 14066,
        "lineEnd": 14068
      },
      "section": "9.32",
      "rulesText": "Everything within an area of heavy rain or heavy snowfall is Lightly Obscured, and creatures in the area have Disadvantage on all Wisdom (Perception) checks. Heavy rain also extinguishes open flames."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-33-high-altitude",
      "@type": "Rule",
      "name": "High Altitude",
      "slug": "9-33-high-altitude",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.33",
        "heading": "High Altitude",
        "lineStart": 14070,
        "lineEnd": 14074
      },
      "section": "9.33",
      "rulesText": "Traveling at altitudes of 10,000 feet or higher above sea level is taxing for most creatures because of the reduced amount of oxygen in the air. Each hour such a creature spends traveling at high altitude counts as 2 hours for the purpose of determining how long that creature can travel (see “Travel Pace”).\n\nCreatures can become acclimated to a high altitude by spending 30 days or more at this elevation. Creatures can't become acclimated to elevations above 20,000 feet unless they are native to such environments."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-34-slippery-ice",
      "@type": "Rule",
      "name": "Slippery Ice",
      "slug": "9-34-slippery-ice",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.34",
        "heading": "Slippery Ice",
        "lineStart": 14076,
        "lineEnd": 14078
      },
      "section": "9.34",
      "rulesText": "Slippery ice is Difficult Terrain. A creature that moves onto slippery ice for the first time on a turn or starts its turn there must succeed on a DC 10 Dexterity saving throw or have the Prone condition."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-35-strong-wind",
      "@type": "Rule",
      "name": "Strong Wind",
      "slug": "9-35-strong-wind",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.35",
        "heading": "Strong Wind",
        "lineStart": 14080,
        "lineEnd": 14084
      },
      "section": "9.35",
      "rulesText": "Strong wind imposes Disadvantage on ranged attack rolls with weapons. It also extinguishes open flames and disperses fog. A flying creature in a strong wind must land at the end of its turn or fall.\n\nA strong wind in a desert can create a sandstorm that imposes Disadvantage on Wisdom (Perception) checks."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-36-thin-ice",
      "@type": "Rule",
      "name": "Thin Ice",
      "slug": "9-36-thin-ice",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.36",
        "heading": "Thin Ice",
        "lineStart": 14086,
        "lineEnd": 14088
      },
      "section": "9.36",
      "rulesText": "Thin ice has a weight tolerance of 3d10 × 10 pounds per 10-foot-square area. Whenever the total weight on an area of thin ice exceeds its tolerance, the ice in that area breaks. All creatures on broken ice fall through. Below the ice is frigid water (see “Frigid Water” above)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-37-fear-and-mental-stress",
      "@type": "Rule",
      "name": "Fear and Mental Stress",
      "slug": "9-37-fear-and-mental-stress",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.37",
        "heading": "Fear and Mental Stress",
        "lineStart": 14090,
        "lineEnd": 14094
      },
      "section": "9.37",
      "rulesText": "Due to the nature of their vocation, adventurers tend to be less susceptible to fear and mental stress than common folk. Whereas a farmer might flee in terror from a bear or an apparition, adventurers are made of sterner stuff. That said, certain creatures and game effects can terrify or fray the mind of even the most stalwart adventurer.\n\nIf you plan to use any of these rules, discuss them with your players at the start of the campaign."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-38-fear-effects",
      "@type": "Rule",
      "name": "Fear Effects",
      "slug": "9-38-fear-effects",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.38",
        "heading": "Fear Effects",
        "lineStart": 14096,
        "lineEnd": 14114
      },
      "section": "9.38",
      "rulesText": "Whenever the characters encounter something that is supernaturally frightful, use the Frightened condition as the baseline effect. Fear effects typically require a Wisdom saving throw, with a save DC based on how terrifying the situation is. The Sample Fear DCs table provides some examples.\n\nSample Fear DCs\n\nTypically, a Frightened creature repeats the saving throw at the end of each of its turns, ending the effect on itself on a success.\n\nAt your discretion, a Frightened creature might be subject to other effects as long as the Frightened condition lasts. Consider these examples:\n\n- The Frightened creature must take the Dash action on each of its turns and uses its movement to get farther away from the source of its fear.\n- Attack rolls against the Frightened creature have Advantage.\n- The Frightened creature can do only one of the following on each of its turns: move, take an action, or take a Bonus Action.",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/9-38-sample-fear-dcs"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-39-mental-stress-effects",
      "@type": "Rule",
      "name": "Mental Stress Effects",
      "slug": "9-39-mental-stress-effects",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.39",
        "heading": "Mental Stress Effects",
        "lineStart": 14116,
        "lineEnd": 14128
      },
      "section": "9.39",
      "rulesText": "When a character is subjected to an effect that causes intense mental stress, Psychic damage is the best way to emulate that effect.\n\nThe Sample Mental Stress Effects table provides a few examples of such effects, with suggested saving throw DCs and damage. Mental stress can usually be resisted with a successful Wisdom save, but sometimes an Intelligence or Charisma save is more appropriate. On a successful save, a character might take half as much damage instead of no damage, at your discretion.\n\nSample Mental Stress Effects",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/9-39-sample-mental-stress-effects"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-4-slower-travelers",
      "@type": "Rule",
      "name": "Slower Travelers",
      "slug": "9-4-slower-travelers",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.4",
        "heading": "Slower Travelers",
        "lineStart": 13896,
        "lineEnd": 13898
      },
      "section": "9.4",
      "rulesText": "The group must move at a Slow pace if any group member's Speed is reduced to half or less of normal."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-40-prolonged-effects",
      "@type": "Rule",
      "name": "Prolonged Effects",
      "slug": "9-40-prolonged-effects",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.40",
        "heading": "Prolonged Effects",
        "lineStart": 14130,
        "lineEnd": 14138
      },
      "section": "9.40",
      "rulesText": "Exposure to mental stress can cause prolonged effects. Consider the following possibilities.\n\nShort-Term Effects. The character has the Frightened, Incapacitated, or Stunned condition for 1d10 minutes. This condition might be accompanied by alarming behavior or hallucinations. These effects can be suppressed with the Calm Emotions spell or removed by the Lesser Restoration spell.\n\nLong-Term Effects. The character has Disadvantage on some or all ability checks for 1d10 × 10 hours, stemming from an unwillingness or inability to exert a particular set of abilities. The character might feel enervated and unable to exert much Strength, for example, or become so suspicious of others that Charisma checks are more difficult. These effects can be suppressed with the Calm Emotions spell or removed by the Lesser Restoration spell.\n\nIndefinite Effects. An indefinite effect is a long-term effect (see above) that lasts until removed by a Greater Restoration spell. It can be suppressed by a Calm Emotions spell."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-41-poison",
      "@type": "Rule",
      "name": "Poison",
      "slug": "9-41-poison",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.41",
        "heading": "Poison",
        "lineStart": 14140,
        "lineEnd": 14150
      },
      "section": "9.41",
      "rulesText": "Given their insidious and deadly nature, poisons are a favorite tool among assassins and evil creatures. Poisons come in the following four types:\n\nContact. Contact poison can be smeared on an object and remains potent until it is touched or washed off. A creature that touches contact poison with exposed skin suffers its effects.\n\nIngested. A creature must swallow an entire dose of ingested poison to suffer its effects. The dose can be delivered in food or a liquid. You may decide that a partial dose has a reduced effect, such as allowing Advantage on the saving throw or dealing only half as much damage on a failed save.\n\nInhaled. Poisonous powders and gases take effect when inhaled. Blowing the powder or releasing the gas subjects creatures in a 5-foot Cube to its effect. The resulting cloud dissipates immediately afterward. Holding one's breath is ineffective against inhaled poisons, as they affect nasal membranes, tear ducts, and other parts of the body.\n\nInjury. Injury poison can be applied as a Bonus Action to a weapon, a piece of ammunition, or similar object. The poison remains potent until delivered through a wound or washed off. A creature that takes Piercing or Slashing damage from an object coated with the poison is exposed to its effects."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-42-purchasing-poison",
      "@type": "Rule",
      "name": "Purchasing Poison",
      "slug": "9-42-purchasing-poison",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.42",
        "heading": "Purchasing Poison",
        "lineStart": 14152,
        "lineEnd": 14154
      },
      "section": "9.42",
      "rulesText": "In some settings, laws prohibit the possession and use of poison, but an illicit dealer or unscrupulous apothecary might keep a hidden stash. Characters with criminal contacts might be able to acquire poison easily. Other characters might have to make extensive inquiries and pay bribes before they acquire the poison they seek."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-43-harvesting-poison",
      "@type": "Rule",
      "name": "Harvesting Poison",
      "slug": "9-43-harvesting-poison",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.43",
        "heading": "Harvesting Poison",
        "lineStart": 14156,
        "lineEnd": 14158
      },
      "section": "9.43",
      "rulesText": "A character can attempt to harvest poison from a venomous creature that is dead or has the Incapacitated condition. The effort takes 1d6 minutes, after which the character makes a DC 20 Intelligence (Nature) check using a Poisoner's Kit. On a successful check, the character harvests enough poison for a single dose, and no additional poison can be harvested from that creature. On a failed check, the character is unable to extract any poison. If the character fails the check by 5 or more, the character is subjected to the creature's poison."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-44-sample-poisons",
      "@type": "Rule",
      "name": "Sample Poisons",
      "slug": "9-44-sample-poisons",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.44",
        "heading": "Sample Poisons",
        "lineStart": 14160,
        "lineEnd": 14162
      },
      "section": "9.44",
      "rulesText": "Example poisons are detailed here in alphabetical order. Each poison's description includes the suggested price for a single dose of the poison, its type (contact, ingested, inhaled, or injury), and a description of the poison's debilitating effects."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-45-assassins-blood-150-gp",
      "@type": "Rule",
      "name": "Assassin's Blood (150 GP)",
      "slug": "9-45-assassins-blood-150-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.45",
        "heading": "Assassin's Blood (150 GP)",
        "lineStart": 14164,
        "lineEnd": 14168
      },
      "section": "9.45",
      "rulesText": "Ingested Poison\n\nA creature subjected to Assassin's Blood makes a DC 10 Constitution saving throw. On a failed save, the creature takes 6 (1d12) Poison damage and has the Poisoned condition for 24 hours. On a successful save, the creature takes half as much damage only."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-46-burnt-othur-fumes-500-gp",
      "@type": "Rule",
      "name": "Burnt Othur Fumes (500 GP)",
      "slug": "9-46-burnt-othur-fumes-500-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.46",
        "heading": "Burnt Othur Fumes (500 GP)",
        "lineStart": 14170,
        "lineEnd": 14174
      },
      "section": "9.46",
      "rulesText": "Inhaled Poison\n\nA creature subjected to Burnt Othur Fumes must succeed on a DC 13 Constitution saving throw or take 10 (3d6) Poison damage, and it must repeat the save at the start of each of its turns. On each successive failed save, the creature takes 3 (1d6) Poison damage. After three successful saves, the poison ends."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-47-crawler-mucus-200-gp",
      "@type": "Rule",
      "name": "Crawler Mucus (200 GP)",
      "slug": "9-47-crawler-mucus-200-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.47",
        "heading": "Crawler Mucus (200 GP)",
        "lineStart": 14176,
        "lineEnd": 14180
      },
      "section": "9.47",
      "rulesText": "Contact Poison\n\nA creature subjected to Crawler Mucus must succeed on a DC 13 Constitution saving throw or have the Poisoned condition for 1 minute. The creature also has the Paralyzed condition while Poisoned in this way. The creature repeats the save at the end of each of its turns, ending the effect on itself on a success."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-48-essence-of-ether-300-gp",
      "@type": "Rule",
      "name": "Essence of Ether (300 GP)",
      "slug": "9-48-essence-of-ether-300-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.48",
        "heading": "Essence of Ether (300 GP)",
        "lineStart": 14182,
        "lineEnd": 14186
      },
      "section": "9.48",
      "rulesText": "Inhaled Poison\n\nA creature subjected to Essence of Ether must succeed on a DC 15 Constitution saving throw or have the Poisoned condition for 8 hours. The creature also has the Unconscious condition while Poisoned in this way. The creature wakes up if it takes damage or if another creature takes an action to shake it awake."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-49-malice-250-gp",
      "@type": "Rule",
      "name": "Malice (250 GP)",
      "slug": "9-49-malice-250-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.49",
        "heading": "Malice (250 GP)",
        "lineStart": 14188,
        "lineEnd": 14192
      },
      "section": "9.49",
      "rulesText": "Inhaled Poison\n\nA creature subjected to Malice must succeed on a DC 15 Constitution saving throw or have the Poisoned condition for 1 hour. The creature also has the Blinded condition while Poisoned in this way."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-5-extended-travel",
      "@type": "Rule",
      "name": "Extended Travel",
      "slug": "9-5-extended-travel",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.5",
        "heading": "Extended Travel",
        "lineStart": 13900,
        "lineEnd": 13902
      },
      "section": "9.5",
      "rulesText": "Characters can push themselves to travel for more than 8 hours per day, at the risk of tiring. At the end of each additional hour of travel beyond 8 hours, each character must succeed on a Constitution saving throw or gain 1 Exhaustion level. The DC is 10 plus 1 for each hour past 8 hours."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-50-midnight-tears-1-500-gp",
      "@type": "Rule",
      "name": "Midnight Tears (1,500 GP)",
      "slug": "9-50-midnight-tears-1-500-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.50",
        "heading": "Midnight Tears (1,500 GP)",
        "lineStart": 14194,
        "lineEnd": 14200
      },
      "section": "9.50",
      "rulesText": "Ingested Poison\n\nA creature that ingests Midnight Tears suffers no effect until the stroke of midnight. Any effect that\n\nends the Poisoned condition neutralizes this poison. If the poison hasn't been neutralized before midnight, the creature makes a DC 17 Constitution saving throw, taking 31 (9d6) Poison damage on a failed save or half as much damage on a successful one."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-51-oil-of-taggit-400-gp",
      "@type": "Rule",
      "name": "Oil of Taggit (400 GP)",
      "slug": "9-51-oil-of-taggit-400-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.51",
        "heading": "Oil of Taggit (400 GP)",
        "lineStart": 14202,
        "lineEnd": 14206
      },
      "section": "9.51",
      "rulesText": "Contact Poison\n\nA creature subjected to Oil of Taggit must succeed on a DC 13 Constitution saving throw or have the Poisoned condition for 24 hours. The creature also has the Unconscious condition while Poisoned in this way. It wakes up if it takes damage."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-52-pale-tincture-250-gp",
      "@type": "Rule",
      "name": "Pale Tincture (250 GP)",
      "slug": "9-52-pale-tincture-250-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.52",
        "heading": "Pale Tincture (250 GP)",
        "lineStart": 14208,
        "lineEnd": 14212
      },
      "section": "9.52",
      "rulesText": "Ingested Poison\n\nA creature subjected to Pale Tincture must succeed on a DC 16 Constitution saving throw or take 3 (1d6) Poison damage and have the Poisoned condition. The Poisoned creature repeats the save every 24 hours, taking 3 (1d6) Poison damage on a failed save. The damage the poison deals can't be healed by any means while the creature remains Poisoned. After seven successful saves against the poison, the creature is no longer Poisoned."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-53-purple-worm-poison-2-000-gp",
      "@type": "Rule",
      "name": "Purple Worm Poison (2,000 GP)",
      "slug": "9-53-purple-worm-poison-2-000-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.53",
        "heading": "Purple Worm Poison (2,000 GP)",
        "lineStart": 14214,
        "lineEnd": 14218
      },
      "section": "9.53",
      "rulesText": "Injury Poison\n\nA creature subjected to Purple Worm Poison makes a DC 21 Constitution saving throw, taking 35 (10d6) Poison damage on a failed save or half as much damage on a successful one."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-54-serpent-venom-200-gp",
      "@type": "Rule",
      "name": "Serpent Venom (200 GP)",
      "slug": "9-54-serpent-venom-200-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.54",
        "heading": "Serpent Venom (200 GP)",
        "lineStart": 14220,
        "lineEnd": 14226
      },
      "section": "9.54",
      "rulesText": "Injury Poison\n\nA creature subjected to Serpent Venom must succeed on a DC 11 Constitution saving throw, taking\n\n10 (3d6) Poison damage on a failed save or half as much damage on a successful one."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-55-spiders-sting-200-gp",
      "@type": "Rule",
      "name": "Spider's Sting (200 GP)",
      "slug": "9-55-spiders-sting-200-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.55",
        "heading": "Spider's Sting (200 GP)",
        "lineStart": 14228,
        "lineEnd": 14232
      },
      "section": "9.55",
      "rulesText": "Injury Poison\n\nA creature subjected to Spider's Sting must succeed on a DC 13 Constitution saving throw or have the Poisoned condition for 1 hour. If the creature fails the save by 5 or more, the creature also has the Unconscious condition while Poisoned in this way. The creature wakes up if it takes damage or if another creature takes an action to shake it awake."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-56-torpor-600-gp",
      "@type": "Rule",
      "name": "Torpor (600 GP)",
      "slug": "9-56-torpor-600-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.56",
        "heading": "Torpor (600 GP)",
        "lineStart": 14234,
        "lineEnd": 14238
      },
      "section": "9.56",
      "rulesText": "Ingested Poison\n\nA creature subjected to Torpor poison must succeed on a DC 15 Constitution saving throw or have the Poisoned condition for 4d6 hours. The creature's Speed is halved while the creature is Poisoned in this way."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-57-truth-serum-150-gp",
      "@type": "Rule",
      "name": "Truth Serum (150 GP)",
      "slug": "9-57-truth-serum-150-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.57",
        "heading": "Truth Serum (150 GP)",
        "lineStart": 14240,
        "lineEnd": 14244
      },
      "section": "9.57",
      "rulesText": "Ingested Poison\n\nA creature subjected to Truth Serum must succeed on a DC 11 Constitution saving throw or have the Poisoned condition for 1 hour. The Poisoned creature can't knowingly communicate a lie."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-58-wyvern-poison-1-200-gp",
      "@type": "Rule",
      "name": "Wyvern Poison (1,200 GP)",
      "slug": "9-58-wyvern-poison-1-200-gp",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.58",
        "heading": "Wyvern Poison (1,200 GP)",
        "lineStart": 14246,
        "lineEnd": 14250
      },
      "section": "9.58",
      "rulesText": "Injury Poison\n\nA creature subjected to Wyvern Poison makes a DC 14 Constitution saving throw, taking 24 (7d6) Poisson damage on a failed save or half as much damage on a successful one."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-59-traps",
      "@type": "Rule",
      "name": "Traps",
      "slug": "9-59-traps",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.59",
        "heading": "Traps",
        "lineStart": 14252,
        "lineEnd": 14256
      },
      "section": "9.59",
      "rulesText": "Traps should be used sparingly, lest they lose their charm. A hidden pit can be a fun surprise, but too many traps in an adventure can lead players to become overly cautious, which slows down the game.\n\nThe best traps are fleeting distractions that skilled characters can overcome in a short amount of time or deadly puzzles that require quick thinking and teamwork to overcome. Traps that are undetectable and inescapable are rarely fun."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-6-special-movement",
      "@type": "Rule",
      "name": "Special Movement",
      "slug": "9-6-special-movement",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.6",
        "heading": "Special Movement",
        "lineStart": 13904,
        "lineEnd": 13916
      },
      "section": "9.6",
      "rulesText": "If a party can travel at a high Speed for an extended time, as with a spell such as Wind Walk or a magic item such as a Carpet of Flying, translate the party's Speed into travel rates using these rules:\n\nMiles per hour = Speed ÷ 10\n\nMiles per day (Normal pace) = Miles per hour × number of hours traveled (typically 8)\n\nFast pace = Miles per day × 1½ (round down)\n\nSlow pace = Miles per day × 2/3 (round down)\n\nIf the characters are flying or their special movement allows them to ignore Difficult Terrain, they can move at a Fast pace regardless of the terrain."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-60-parts-of-a-trap",
      "@type": "Rule",
      "name": "Parts of a Trap",
      "slug": "9-60-parts-of-a-trap",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.60",
        "heading": "Parts of a Trap",
        "lineStart": 14258,
        "lineEnd": 14268
      },
      "section": "9.60",
      "rulesText": "The description of a trap includes the following parts after the trap's name:\n\nSeverity and Levels. A trap is designated as a nuisance or as deadly for characters of certain levels. A nuisance trap is unlikely to seriously harm characters of the indicated levels, whereas a deadly trap can grievously damage characters of the indicated levels.\n\nTrigger. Traps are often set to go off when a creature enters an area or touches an object. Examples of triggers include stepping on a pressure plate, crossing a trip wire, turning a doorknob, or using the wrong key in a lock.\n\nDuration. Some traps have durations expressed in rounds, minutes, or hours. Others specify that their effects last until the trap is destroyed or dispelled. If a trap's duration is instantaneous, its effect is resolved instantly. If a trap resets after activating, that fact is noted in this entry. A trap is otherwise inert after activation.\n\nUse caution when introducing a trap to characters of a level lower than the trap's level range. A trap that is a nuisance at one level range could be deadly to characters of a lower level range."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-61-example-traps",
      "@type": "Rule",
      "name": "Example Traps",
      "slug": "9-61-example-traps",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.61",
        "heading": "Example Traps",
        "lineStart": 14270,
        "lineEnd": 14272
      },
      "section": "9.61",
      "rulesText": "Traps are presented in alphabetical order."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-62-collapsing-roof",
      "@type": "Rule",
      "name": "Collapsing Roof",
      "slug": "9-62-collapsing-roof",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.62",
        "heading": "Collapsing Roof",
        "lineStart": 14274,
        "lineEnd": 14296
      },
      "section": "9.62",
      "rulesText": "Deadly Trap (Levels 1–4)\n\nTrigger: A creature crosses a trip wire\n\nDuration: Instantaneous\n\nThis trap uses a trip wire to collapse an unstable section of ceiling. The trip wire is 3 inches off the ground and stretches between two weak supports that topple when the trip wire is pulled.\n\nThe first creature that crosses the trip wire causes the supports to topple and the unstable section of ceiling to collapse. Each creature beneath the unstable section of ceiling must succeed on a DC 13 Dexterity saving throw, taking 11 (2d10) Bludgeoning damage on a failed save or half as much damage\n\non a successful one. Rubble from the collapse turns the trapped area into Difficult Terrain.\n\nDetect and Disarm. As a Search action, a creature can examine the trapped area and make a DC 11 Wisdom (Perception) check, detecting the trip wire and the unstable section of ceiling on a successful check. Once detected, the trip wire can be easily cut or avoided (no ability check required).\n\nAt Higher Levels. You can scale the trap for higher levels by increasing the damage and the save DC, as shown in the following table.",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/9-62-collapsing-roof-table-1"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-63-falling-net",
      "@type": "Rule",
      "name": "Falling Net",
      "slug": "9-63-falling-net",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.63",
        "heading": "Falling Net",
        "lineStart": 14298,
        "lineEnd": 14316
      },
      "section": "9.63",
      "rulesText": "Nuisance Trap (Levels 1–4)\n\nTrigger: A creature crosses a trip wire\n\nDuration: Instantaneous\n\nA falling net trap uses a trip wire to release a weighted, 10-foot-square Net suspended from the ceiling. The trip wire is 3 inches off the ground and stretches between two columns or trees.\n\nThe first creature that crosses the trip wire causes the Net to fall on it. The target must succeed on a DC 10 Dexterity saving throw or have the Restrained condition until it escapes. The target succeeds automatically if it's Huge or larger. A creature can take an action to make a DC 10 Strength (Athletics) check, freeing itself or another creature within its reach from the Net on a successful check.\n\nDetect and Disarm. As a Search action, a creature can examine the trapped area and make a DC 11 Wisdom (Perception) check, detecting the trip wire and the suspended Net on a successful check. Once detected, the trip wire can be easily cut or avoided (no ability check required).\n\nDestroy the Net. Reducing the Net to 0 Hit Points frees any creature trapped in it (see “Adventuring Gear” for the Net’s statistics).\n\nSet the Trap. A creature that has Thieves' Tools and all the trap's components (including a Net) can try to set a falling net trap, doing so with a successful DC 13 Dexterity (Sleight of Hand) check. Each attempt to set this trap takes 10 minutes.\n\nAt Higher Levels. You can scale the trap for higher levels by increasing the weight of the Net, which increases the save DC and the DC of the Strength (Athletics) check as follows: DC 12 at levels 5–10, DC 14 at levels 11–16, or DC 16 at levels 17–20."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-64-fire-casting-statue",
      "@type": "Rule",
      "name": "Fire-Casting Statue",
      "slug": "9-64-fire-casting-statue",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.64",
        "heading": "Fire-Casting Statue",
        "lineStart": 14318,
        "lineEnd": 14338
      },
      "section": "9.64",
      "rulesText": "Deadly Trap (Levels 1-4)\n\nTrigger: A creature moves onto a pressure plate\n\nDuration: Instantaneous, and the trap resets at the start of the next turn\n\nWhen a creature moves onto this trap's pressure plate for the first time on a turn or starts its turn there, a nearby statue exhales a 15-foot Cone of magical flame. The statue can look like anything, such as a dragon or a wizard. Each creature in the Cone must succeed on a DC 15 Dexterity saving throw, taking 11 (2d10) Fire damage on a failed save or half as much damage on a successful one.\n\nDetect and Disarm. A Detect Magic spell reveals an aura of Evocation magic around the statue. As a Search action, a creature within 5 feet of the statue can examine it and make a DC 10 Wisdom (Perception) check, detecting a tiny glyph on the statue on a successful check. Once the glyph is found, a character can take a Study action to examine it and make a DC 15 Intelligence (Arcana) check, ascertaining that the glyph means “fire” on a successful check. As an action, a character can use a sharp tool to deface the glyph, which disarms the trap.\n\nAs a Search action, a creature can examine the section of floor that forms the pressure plate and make a DC 15 Wisdom (Perception) check, detecting the pressure plate on a successful check. Wedging an Iron Spike or similar object under the pressure plate prevents the trap from triggering.\n\nAt Higher Levels. You can scale the trap for higher levels by increasing the damage and the area of effect, as shown in the following table.",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/9-64-fire-casting-statue-table-1"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-65-hidden-pit",
      "@type": "Rule",
      "name": "Hidden Pit",
      "slug": "9-65-hidden-pit",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.65",
        "heading": "Hidden Pit",
        "lineStart": 14340,
        "lineEnd": 14361
      },
      "section": "9.65",
      "rulesText": "Nuisance Trap (Levels 1–4)\n\nTrigger: A creature moves onto the pit's lid\nDuration: Instantaneous\n\nThis 10-foot-deep pit has a hinged lid constructed from material identical to the surrounding floor. When a creature moves onto the lid, it swings open like a trapdoor, causing the creature to fall into the pit. The lid remains open thereafter.\n\nA creature that falls into the pit takes 3 (1d6) Bludgeoning damage from the fall.\n\nDetect and Disarm. As a Study action, a creature can examine the section of floor that forms the pit's lid and make a DC 15 Intelligence (Investigation) check, detecting the pit on a successful check. Once the pit is detected, an Iron Spike or a similar object can be wedged between the pit's lid and the surrounding floor to prevent the lid from opening, thereby making it safe to cross. The cover can also be held shut using Arcane Lock or similar magic.\n\nEscape. A creature needs a Climb Speed, climbing gear, or magic such as Spider Climb to scale the pit's smooth walls. You can make the pit easier to escape by adding cracks in the walls big enough to serve as handholds and footholds.\n\nAt Higher Levels. You can scale the trap for higher levels by increasing the pit's depth and damage, as shown in the following table.",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/9-65-hidden-pit-table-1"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-66-poisoned-darts",
      "@type": "Rule",
      "name": "Poisoned Darts",
      "slug": "9-66-poisoned-darts",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.66",
        "heading": "Poisoned Darts",
        "lineStart": 14363,
        "lineEnd": 14378
      },
      "section": "9.66",
      "rulesText": "Deadly Trap (Levels 1–4)\n\nTrigger: A creature moves onto a pressure plate\nDuration: Instantaneous, and the trap resets at the start of the next turn if it has activated fewer than three times\n\nWhen a creature moves onto this trap's pressure plate for the first time on a turn, poisoned darts shoot from tubes embedded in the surrounding walls. The holes that house these tubes are obscured by dust and cobwebs or skillfully hidden amid bas-reliefs, murals, or frescoes.\n\nEach creature in the darts' path must succeed on a DC 13 Dexterity saving throw or be struck by 1d3 darts, taking 3 (1d6) Poison damage per dart.\n\nDetect and Disarm. As a Search action, a creature can examine the walls and make a DC 15 Wisdom (Perception) check, detecting the holes on a successful check. Plugging all the holes with wax, cloth, or detritus prevents the darts from firing.\n\nAs a Search action, a creature can examine the section of floor that forms the pressure plate and make a DC 15 Wisdom (Perception) check, detecting the pressure plate on a successful check. Wedging an Iron Spike or a similar object under the pressure plate prevents the trap from triggering.\n\nAt Higher Levels. You can scale the trap for higher levels by increasing each dart's Poison damage as follows: 7 (2d6) at levels 5-10, 14 (4d6) at levels 11-16, or 24 (7d6) at levels 17-20."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-67-poisoned-needle",
      "@type": "Rule",
      "name": "Poisoned Needle",
      "slug": "9-67-poisoned-needle",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.67",
        "heading": "Poisoned Needle",
        "lineStart": 14380,
        "lineEnd": 14402
      },
      "section": "9.67",
      "rulesText": "Nuisance Trap (Levels 1–4)\n\nTrigger: A creature opens the trap's lock improperly or fails to disarm the trap\n\nDuration: Instantaneous\n\nA poisoned needle is hidden in a lock. When a creature opens the lock with any object other than the proper key, the needle springs out and stabs the creature. The creature makes a DC 11 Constitution saving throw. On a failed save, the creature takes 5 (1d10) Poison damage and has the Poisoned\n\ncondition for 1 hour. On a successful save, the creature takes half as much damage only.\n\nAvoid. The trap doesn't trigger if the lock is opened using a Knock spell or similar magic.\n\nDetect and Disarm. As a Search action, a creature can examine the trapped lock and make a DC 15 Wisdom (Perception) check, detecting the needle on a successful check. Once the trap is detected, a character can take an action to try to disarm the trap, doing so with a successful DC 15 Dexterity (Sleight of Hand) check. On a failed check, the creature triggers the trap.\n\nAt Higher Levels. You can scale the trap for higher levels by increasing the damage and the save DC, as shown in the following table.",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/9-67-poisoned-needle-table-1"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-68-rolling-stone",
      "@type": "Rule",
      "name": "Rolling Stone",
      "slug": "9-68-rolling-stone",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.68",
        "heading": "Rolling Stone",
        "lineStart": 14404,
        "lineEnd": 14421
      },
      "section": "9.68",
      "rulesText": "Deadly Trap (Levels 11–16) or Nuisance Trap (Levels 17–20)\n\nTrigger: A creature moves onto a pressure plate\nDuration: Until the stone stops rolling\n\nWhen a creature moves onto a hidden pressure plate, a 5-foot-radius orb of solid stone is released from a secret compartment and begins to roll. The stone and all creatures nearby roll Initiative; the stone gets a +8 bonus on its Initiative roll.\n\nOn its turn, the stone moves 60 feet in one direction, changing course if redirected by an obstacle. The stone can move through creatures' spaces, and creatures can move through the stone's space, treating it as Difficult Terrain. Whenever the stone enters a creature's space for the first time on a turn or a creature enters the stone's space while the stone is rolling, that creature must succeed on a DC 15 Dexterity saving throw or take 55 (10d10) Bludgeoning damage and have the Prone condition.\n\nThe stone stops when it hits a wall or similar barrier. It can't go around corners, but creative dungeon builders incorporate curving turns into nearby passages that allow the stone to keep moving.\n\nDetect and Disarm. As a Study action, a creature can examine the section of floor that forms the pressure plate and make a DC 15 Intelligence (Investigation) check, deducing the pressure plate's function on a successful check. Wedging an Iron Spike or a similar object under the pressure plate prevents the trap from triggering.\n\nDestroy the Stone. The stone is a Large object that has AC 17, HP 100, a Damage Threshold of 10, and Immunity to Poison and Psychic damage.\n\nSlow the Stone. As an action, a creature can try to slow down the stone with a DC 20 Strength (Athletics) check. If the check is successful, the distance the stone moves on its turn is reduced by 15 feet. If that distance drops to 0, it stops moving and is no longer a threat."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-69-spiked-pit",
      "@type": "Rule",
      "name": "Spiked Pit",
      "slug": "9-69-spiked-pit",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.69",
        "heading": "Spiked Pit",
        "lineStart": 14423,
        "lineEnd": 14444
      },
      "section": "9.69",
      "rulesText": "Deadly Trap (Levels 1–4)\n\nTrigger: A creature moves onto the pit's lid\nDuration: Instantaneous\n\nA 10-foot-deep pit has a hinged lid constructed from material identical to the surrounding floor. When a creature moves onto the lid, it swings open like a trapdoor, causing the creature to fall into the pit, which has sharpened wooden or metal spikes at the bottom. The lid remains open thereafter.\n\nA creature that falls into the pit lands at the bottom and takes 3 (1d6) Bludgeoning damage from the fall plus 9 (2d8) Piercing damage from the spikes.\n\nDetect and Disarm. As a Study action, a creature can examine the section of floor that forms the pit's lid and make a DC 15 Intelligence (Investigation) check, detecting the pit on a successful check. Once the hidden pit is detected, an Iron Spike or a similar object can be wedged between the pit's lid and the surrounding floor to prevent the lid from opening, thereby making it safe to cross. The cover can also be held shut using an Arcane Lock spell or similar magic.\n\nEscape. A creature needs a Climb Speed, climbing gear, or magic such as a Spider Climb spell to scale the pit's smooth walls. You can make the pit easier to escape by adding cracks in the walls big enough to serve as handholds and footholds.\n\nAt Higher Levels. You can scale the trap for higher levels by increasing the pit's depth and damage, as shown in the following table.",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/9-69-spiked-pit-table-1"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-7-vehicles",
      "@type": "Rule",
      "name": "Vehicles",
      "slug": "9-7-vehicles",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.7",
        "heading": "Vehicles",
        "lineStart": 13918,
        "lineEnd": 13920
      },
      "section": "9.7",
      "rulesText": "Characters traveling in a vehicle use the vehicle's speed in miles per hour (as shown in “Equipment”) to determine their rate of travel, and they don't choose a travel pace."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-70-combat-encounters",
      "@type": "Rule",
      "name": "Combat Encounters",
      "slug": "9-70-combat-encounters",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.70",
        "heading": "Combat Encounters",
        "lineStart": 14446,
        "lineEnd": 14456
      },
      "section": "9.70",
      "rulesText": "The following features can make a combat encounter more interesting or challenging:\n\nChanges in Elevation. Terrain features that provide a change of elevation (such as stacks of empty crates, ledges, and balconies) reward clever positioning and encourage characters to jump, climb, fly, or teleport.\n\nDefensive Positions. Enemies in hard-to-reach locations or defensive positions force characters who normally attack at range to move around.\n\nMixed Monster Groups. When different types of monsters work together, they can combine their abilities - just like characters with different classes and origins. A diverse force is more powerful.\n\nReasons to Move. Use features that encourage characters and their enemies to move around, such as chandeliers, kegs of gunpowder or oil, and rolling stone traps."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-71-combat-encounter-difficulty",
      "@type": "Rule",
      "name": "Combat Encounter Difficulty",
      "slug": "9-71-combat-encounter-difficulty",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.71",
        "heading": "Combat Encounter Difficulty",
        "lineStart": 14458,
        "lineEnd": 14460
      },
      "section": "9.71",
      "rulesText": "Use the following guidelines to create a combat encounter of a desired level of difficulty."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-72-step-1-choose-a-difficulty",
      "@type": "Rule",
      "name": "Step 1: Choose a Difficulty",
      "slug": "9-72-step-1-choose-a-difficulty",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.72",
        "heading": "Step 1: Choose a Difficulty",
        "lineStart": 14462,
        "lineEnd": 14470
      },
      "section": "9.72",
      "rulesText": "Three categories describe the range of encounter difficulty:\n\nLow Difficulty. An encounter of low difficulty is likely to have one or two scary moments for the players, but their characters should emerge victorious with no casualties. One or more of them might need to use healing resources, however. As a rough guideline, a single monster generally presents a low-difficulty challenge for a party of four characters whose level equals the monster's Challenge Rating.\n\nModerate Difficulty. Absent healing and other resources, an encounter of moderate difficulty could go badly for the adventurers. Weaker characters might get taken out of the fight, and there's a slim chance that one or more characters might die.\n\nHigh Difficulty. A high-difficulty encounter could be lethal for one or more characters. To survive it, the characters will need smart tactics, quick thinking, and maybe even a little luck."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-73-step-2-determine-your-xp-budget",
      "@type": "Rule",
      "name": "Step 2: Determine Your XP Budget",
      "slug": "9-73-step-2-determine-your-xp-budget",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.73",
        "heading": "Step 2: Determine Your XP Budget",
        "lineStart": 14472,
        "lineEnd": 14500
      },
      "section": "9.73",
      "rulesText": "Using the XP Budget per Character table, cross-reference the party's level with the desired encounter difficulty. Multiply the number in the table by the number of characters in the party to get your XP budget for the encounter.\n\nXP Budget per Character",
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/9-73-xp-budget-per-character"
        }
      ]
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-74-step-3-spend-your-budget",
      "@type": "Rule",
      "name": "Step 3: Spend Your Budget",
      "slug": "9-74-step-3-spend-your-budget",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.74",
        "heading": "Step 3: Spend Your Budget",
        "lineStart": 14502,
        "lineEnd": 14519
      },
      "section": "9.74",
      "rulesText": "Every creature has an XP value in its stat block. When you add a creature to your combat encounter, deduct its XP from your XP budget to determine how many XP you have left to spend. Spend as much of your XP budget as you can without going over. It's OK if you have a few unspent XP left over. Examples are given below:\n\nExample 1. A low-difficulty encounter for four level 1 characters has an XP budget of 50 × 4 , for a total of 200 XP. With that, you could build any of the following encounters:\n\n- 1 Bugbear Warrior (200 XP)\n- 2 Giant Wasps (100 XP each), for 200 XP total\n- 6 Giant Rats (25 XP each), for 150 XP total\n\nExample 2. A moderate-difficulty encounter for five level 3 characters has an XP budget of 225 × 5 , for a total of 1,125 XP. With that, you could build either of these encounters:\n\n- 2 Druids (450 XP each) and 9 Stirges (25 XP each), for 1,125 XP total\n- 1 Wight (700 XP), 1 Warhorse Skeleton (100 XP), and 6 Skeletons (50 XP each), for 1,100 XP total\n\nExample 3. A high-difficulty encounter for six level 15 characters has an XP budget of 7,800 × 6 , for a total of 46,800 XP. With that, you could build this encounter:\n\n- 2 Adult Red Dragons (18,000 XP each) and 2 Fire Giants (5,000 XP each), for 46,000 XP total"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-75-troubleshooting",
      "@type": "Rule",
      "name": "Troubleshooting",
      "slug": "9-75-troubleshooting",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.75",
        "heading": "Troubleshooting",
        "lineStart": 14521,
        "lineEnd": 14523
      },
      "section": "9.75",
      "rulesText": "When creating and running combat encounters, keep the following in mind."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-76-many-creatures",
      "@type": "Rule",
      "name": "Many Creatures",
      "slug": "9-76-many-creatures",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.76",
        "heading": "Many Creatures",
        "lineStart": 14525,
        "lineEnd": 14527
      },
      "section": "9.76",
      "rulesText": "The more creatures in an encounter, the higher the risk that a lucky streak on their part could deal more damage to the characters than you expect. If your encounter includes more than two creatures per character, include fragile creatures that can be defeated quickly. This guideline is especially important for characters of level 1 or 2."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-77-adjustments",
      "@type": "Rule",
      "name": "Adjustments",
      "slug": "9-77-adjustments",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.77",
        "heading": "Adjustments",
        "lineStart": 14529,
        "lineEnd": 14531
      },
      "section": "9.77",
      "rulesText": "A player's absence might warrant removing creatures from an encounter to keep it at the intended difficulty. Also, die rolls and other factors can result in an encounter being easier or harder than intended. You can adjust an encounter on the fly, such as by having creatures flee (making the encounter easier) or adding reinforcements (making the encounter harder)."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-78-cr-0-creatures",
      "@type": "Rule",
      "name": "CR 0 Creatures",
      "slug": "9-78-cr-0-creatures",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.78",
        "heading": "CR 0 Creatures",
        "lineStart": 14533,
        "lineEnd": 14535
      },
      "section": "9.78",
      "rulesText": "Creatures that have a CR of 0, particularly ones that are worth 0 XP, should be used sparingly. If you want to include many CR 0 critters in an encounter, use swarms instead."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-79-number-of-stat-blocks",
      "@type": "Rule",
      "name": "Number of Stat Blocks",
      "slug": "9-79-number-of-stat-blocks",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.79",
        "heading": "Number of Stat Blocks",
        "lineStart": 14537,
        "lineEnd": 14539
      },
      "section": "9.79",
      "rulesText": "The best combat encounters often pair one kind of creature with another, such as fire giants paired with hell hounds. Be mindful of the number of stat blocks you need to run the encounter. Referencing more than two or three stat blocks for a single encounter can be daunting, particularly if the creatures are complex."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-8-creating-a-background",
      "@type": "Rule",
      "name": "Creating a Background",
      "slug": "9-8-creating-a-background",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.8",
        "heading": "Creating a Background",
        "lineStart": 13922,
        "lineEnd": 13926
      },
      "section": "9.8",
      "rulesText": "A character's background represents what the character did prior to becoming an adventurer. Creating a unique background or customizing an existing one can reflect the particular theme of your campaign or elements of your world. You can also create a background to help a player craft the story they have in mind for their character.\n\nThis section describes, step by step, how you can create backgrounds tailored for your world and the heroes in it."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-80-powerful-creatures",
      "@type": "Rule",
      "name": "Powerful Creatures",
      "slug": "9-80-powerful-creatures",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.80",
        "heading": "Powerful Creatures",
        "lineStart": 14541,
        "lineEnd": 14543
      },
      "section": "9.80",
      "rulesText": "If your combat encounter includes a creature whose CR is higher than the party's level, be aware that such a creature might deal enough damage with a single action to take out one or more characters. For example, an Ogre (CR 2) can kill a level 1 Wizard with a single blow."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-81-unusual-features",
      "@type": "Rule",
      "name": "Unusual Features",
      "slug": "9-81-unusual-features",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.81",
        "heading": "Unusual Features",
        "lineStart": 14545,
        "lineEnd": 14549
      },
      "section": "9.81",
      "rulesText": "If a monster has a feature that lower-level characters can't easily overcome, consider not adding that monster to an encounter for characters whose level is lower than the monster's Challenge Rating.\n\n---"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/9-9-1-choose-abilities",
      "@type": "Rule",
      "name": "1: Choose Abilities",
      "slug": "9-9-1-choose-abilities",
      "source": {
        "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1"
      },
      "sourceLocator": {
        "chapter": "Gameplay Toolbox",
        "section": "9.9",
        "heading": "1: Choose Abilities",
        "lineStart": 13928,
        "lineEnd": 13938
      },
      "section": "9.9",
      "rulesText": "Choose three abilities that seem appropriate for the background:\n\nStrength or Dexterity. These abilities are ideal for a background involving physical exertion.\n\nConstitution. This ability is ideal for a background that involves endurance or long hours of activity.\n\nIntelligence or Wisdom. One or both abilities are ideal for a background that focuses on cerebral or spiritual matters.\n\nCharisma. This ability is ideal for a background that involves performance or social interaction."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/sources/srd-5-2-1",
      "@type": "Source",
      "name": "System Reference Document 5.2.1",
      "slug": "srd-5-2-1",
      "author": "Wizards of the Coast LLC",
      "srdVersion": "5.2.1",
