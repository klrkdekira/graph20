      "statSections": [
        {
          "name": "Traits",
          "rulesText": "Telepathic Bond. While the homunculus is on the same plane of existence as its master, the two of them can communicate telepathically with each other.",
          "sourceLocator": {
            "chapter": "Monsters A-Z",
            "section": "12.138",
            "heading": "Traits",
            "lineStart": 22297,
            "lineEnd": 22299
          }
        },
        {
          "name": "Actions",
          "rulesText": "Bite. Melee Attack Roll: +4, reach 5 ft. Hit: 1 Piercing damage, and the target is subjected to the following effect. Constitution Saving Throw: DC 12. Failure: The target has the Poisoned condition until the end of the homunculus's next turn. Failure by 5 or More: The target has the Poisoned condition for 1 minute. While Poisoned, the target has the Unconscious condition, which ends early if the target takes any damage.",
          "sourceLocator": {
            "chapter": "Monsters A-Z",
            "section": "12.138",
            "heading": "Actions",
            "lineStart": 22301,
            "lineEnd": 22303
          }
