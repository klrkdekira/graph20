        "heading": "Rakshasa",
        "lineStart": 24138,
        "lineEnd": 24179
      },
      "sizeTypeAlignment": "Medium Fiend, Lawful Evil",
      "sizeAndType": "Medium Fiend",
      "alignment": "Lawful Evil",
      "armorClass": "17",
      "initiative": "+8 (18)",
      "hitPoints": "221 (26d8 + 104)",
      "speed": "40 ft.",
      "skills": "Deception +10, Insight +8, Perception +8",
      "vulnerabilities": "Piercing damage from weapons wielded by creatures under the effect of a Bless spell",
      "immunities": "Charmed, Frightened",
      "senses": "Truesight 60 ft.; Passive Perception 18",
      "languages": "Common, Infernal",
      "challenge": "13 (XP 10,000; PB +5)",
      "armorClassValue": 17,
      "hitPointsValue": 221,
      "hitPointsRoll": {
        "expression": "26d8+104",
        "count": 26,
