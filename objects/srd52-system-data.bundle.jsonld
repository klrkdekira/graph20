              "averageDamage": 8,
              "damageType": "Bludgeoning",
              "damageRoll": {
                "expression": "1d8+4",
                "count": 1,
                "sides": 8,
                "modifier": 4
              }
            },
            {
              "averageDamage": 7,
              "damageType": "Necrotic",
              "damageRoll": {
