      "proficiencyBonus": 3,
      "abilities": {
        "str": {
          "score": 18,
          "modifier": 4,
          "savingThrow": 4
        },
        "dex": {
          "score": 15,
          "modifier": 2,
          "savingThrow": 2
        },
        "con": {
          "score": 16,
