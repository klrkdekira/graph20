      "rulesText": "Wand, Uncommon\n\nThis wand has 3 charges. While holding it, you can expend 1 charge to cast Detect Magic from it. The wand regains 1d3 expended charges daily at dawn."
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/magic-items/wand-of-magic-missiles",
      "@type": "MagicItem",
      "name": "Wand of Magic Missiles",
      "slug": "wand-of-magic-missiles",
