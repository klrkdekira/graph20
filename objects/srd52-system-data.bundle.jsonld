      },
      "sourceLocator": {
        "chapter": "Feats",
        "section": "5.4",
        "heading": "Origin Feats",
        "lineStart": 5769,
        "lineEnd": 5769
      },
      "section": "5.4"
    },
    {
      "@id": "https://cheeleong.dev/graph20/objects/rules/5-9-general-feats",
      "@type": "Rule",
      "name": "General Feats",
      "slug": "5-9-general-feats",
