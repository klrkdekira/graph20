  "sourceLocator": {
    "chapter": "Classes",
    "section": "3.30",
    "heading": "Warlock Subclass: Fiend Patron",
    "lineStart": 4846,
    "lineEnd": 4883
  },
  "htmlPage": {
    "@id": "https://cheeleong.dev/graph20/records/subclasses/fiend-patron/"
  },
  "parentClass": {
    "@id": "https://cheeleong.dev/graph20/objects/classes/warlock"
  },
  "parentClassName": "Warlock",
  "rulesText": "Make a Deal with the Lower Planes\n\nYour pact draws on the Lower Planes, the realms of perdition. You might forge a bargain with a demon lord, an archdevil, or another fiend that is especially mighty. That patron's aims are evil - the corruption or destruction of all things, ultimately including you - and your path is defined by the extent to which you strive against those aims.",
  "features": [
    {
      "level": 3,
      "name": "Dark One's Blessing",
      "rulesText": "When you reduce an enemy to 0 Hit Points, you gain Temporary Hit Points equal to your Charisma modifier plus your Warlock level (minimum of 1 Temporary Hit Point). You also gain this benefit if someone else reduces an enemy within 10 feet of you to 0 Hit Points.",
      "sourceLocator": {
        "chapter": "Classes",
        "section": "3.28",
        "heading": "Level 3: Dark One's Blessing",
        "lineStart": 4852,
        "lineEnd": 4854
      }
    },
    {
      "level": 3,
      "name": "Fiend Spells",
      "rulesText": "The magic of your patron ensures you always have certain spells ready; when you reach a Warlock level specified in the Fiend Spells table, you thereafter always have the listed spells prepared.",
      "sourceLocator": {
        "chapter": "Classes",
        "section": "3.28",
        "heading": "Level 3: Fiend Spells",
        "lineStart": 4856,
        "lineEnd": 4867
      },
      "relatedTables": [
        {
          "@id": "https://cheeleong.dev/graph20/objects/tables/3-28-fiend-spells"
        }
      ]
    },
    {
      "level": 6,
      "name": "Dark One's Own Luck",
      "rulesText": "You can call on your fiendish patron to alter fate in your favor. When you make an ability check or a saving throw, you can use this feature to add 1d10 to your roll. You can do so after seeing the roll but before any of the roll's effects occur.\n\nYou can use this feature a number of times equal to your Charisma modifier (minimum of once), but you can use it no more than once per roll. You regain all expended uses when you finish a Long Rest.",
      "sourceLocator": {
        "chapter": "Classes",
        "section": "3.28",
        "heading": "Level 6: Dark One's Own Luck",
        "lineStart": 4869,
        "lineEnd": 4873
      }
    },
    {
      "level": 10,
      "name": "Fiendish Resilience",
      "rulesText": "Choose one damage type, other than Force, whenever you finish a Short or Long Rest. You have Resistance to that damage type until you choose a different one with this feature.",
      "sourceLocator": {
        "chapter": "Classes",
        "section": "3.28",
        "heading": "Level 10: Fiendish Resilience",
        "lineStart": 4875,
        "lineEnd": 4877
      }
    },
    {
      "level": 14,
      "name": "Hurl Through Hell",
      "rulesText": "Once per turn when you hit a creature with an attack roll, you can try to instantly transport the target through the Lower Planes. The target must succeed on a Charisma saving throw against your spell save DC, or the target disappears and hurtles through a nightmare landscape. The target takes 8d10 Psychic damage if it isn't a Fiend, and it has the Incapacitated condition until the end of your next turn, when it returns to the space it previously occupied or the nearest unoccupied space.\n\nOnce you use this feature, you can't use it again until you finish a Long Rest unless you expend a Pact Magic spell slot (no action required) to restore your use of it.",
      "sourceLocator": {
        "chapter": "Classes",
        "section": "3.28",
        "heading": "Level 14: Hurl Through Hell",
        "lineStart": 4879,
        "lineEnd": 4883
      }
    }
  ],
  "mentionsCondition": [
    {
      "@id": "https://cheeleong.dev/graph20/objects/conditions/incapacitated"
    }
  ]
}
