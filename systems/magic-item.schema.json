{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cheeleong.dev/graph20/systems/magic-item.schema.json",
  "title": "SRD 5.2.1 Magic Item",
  "$ref": "common.schema.json#/$defs/EntityBase",
  "properties": {
    "@type": { "const": "MagicItem" },
    "itemCategory": {
      "enum": [
        "Armor",
        "Potion",
        "Ring",
        "Rod",
        "Scroll",
        "Staff",
        "Wand",
        "Weapon",
        "Wondrous Item"
      ]
    },
    "categoryDetail": { "type": "string", "minLength": 1 },
    "rarity": {
      "enum": [
        "Common",
        "Uncommon",
        "Rare",
        "Very Rare",
        "Legendary",
        "Artifact",
        "Rarity Varies",
        "Varies"
      ]
    },
    "rarities": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "rarity": {
            "enum": ["Common", "Uncommon", "Rare", "Very Rare", "Legendary", "Artifact", "Rarity Varies", "Varies"]
          },
          "variant": { "type": "string", "minLength": 1 }
        },
        "required": ["rarity"],
        "unevaluatedProperties": false
      }
    },
    "requiresAttunement": { "type": "boolean" },
    "attunementNote": { "type": "string", "minLength": 1 },
    "attunementRestriction": { "type": "string", "minLength": 1 },
    "attunementClasses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/NodeReference" }
    },
    "charges": {
      "type": "object",
      "properties": {
        "capacityText": { "type": "string", "minLength": 1 },
        "capacity": { "type": "integer", "minimum": 1 },
        "capacityRoll": { "$ref": "common.schema.json#/$defs/DiceExpression" },
        "rechargeText": { "type": "string", "minLength": 1 }
      },
      "required": ["capacityText"],
      "unevaluatedProperties": false
    },
    "isCursed": { "type": "boolean" },
    "isSentient": { "type": "boolean" },
    "relatedTables": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/NodeReference" }
    },
    "castsSpell": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/NodeReference" }
    },
    "rulesText": { "type": "string", "minLength": 1 }
  },
  "required": ["itemCategory", "requiresAttunement", "isCursed", "isSentient", "rulesText"],
  "oneOf": [
    { "required": ["rarity"], "not": { "required": ["rarities"] } },
    { "required": ["rarities"], "not": { "required": ["rarity"] } }
  ],
  "unevaluatedProperties": false
}
