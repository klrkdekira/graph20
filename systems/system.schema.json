{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cheeleong.dev/graph20/systems/system.schema.json",
  "title": "SRD 5.2.1 aggregate manifest",
  "type": "object",
  "properties": {
    "@context": {
      "const": "https://cheeleong.dev/graph20/systems/context.jsonld"
    },
    "@id": {
      "type": "string",
      "pattern": "^https://cheeleong\\.dev/graph20/objects/[a-z0-9.-]+$"
    },
    "@type": { "const": "SRDSystemData" },
    "version": { "type": "string", "minLength": 1 },
    "metadata": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "srdVersion": { "type": "string" },
        "license": { "const": "CC-BY-4.0" },
        "licenseUrl": { "$ref": "common.schema.json#/$defs/NodeReference" },
        "attributionStatement": { "type": "string" },
        "source": { "$ref": "common.schema.json#/$defs/NodeReference" },
        "sourceDigest": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" },
        "corpusDigest": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" }
      },
      "required": [
        "title",
        "author",
        "srdVersion",
        "license",
        "licenseUrl",
        "attributionStatement",
        "source",
        "sourceDigest",
        "corpusDigest"
      ],
      "unevaluatedProperties": false
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "slug": { "type": "string", "pattern": "^[a-z-]+$" },
          "entityType": { "type": "string", "minLength": 1 },
          "members": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/NodeReference" }
          },
          "schemaReference": { "$ref": "common.schema.json#/$defs/NodeReference" }
        },
        "required": ["name", "slug", "entityType", "members", "schemaReference"],
        "unevaluatedProperties": false
      }
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "version",
    "metadata",
    "collections"
  ],
  "unevaluatedProperties": false
}
