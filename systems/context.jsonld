{
  "@context": {
    "@version": 1.1,
    "@base": "https://cheeleong.dev/graph20/",
    "@vocab": "https://cheeleong.dev/graph20/vocab/#",
    "srd": "https://cheeleong.dev/graph20/vocab/#",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "name": "schema:name",
    "description": "schema:description",
    "slug": "srd:slug",
    "rulesText": "srd:rulesText",
    "source": { "@id": "dcterms:source", "@type": "@id" },
    "htmlPage": { "@id": "schema:url", "@type": "@id" },
    "sourceLocator": "srd:sourceLocator",
    "license": "srd:licenseCode",
    "licenseUrl": { "@id": "srd:licenseUrl", "@type": "@id" },
    "attributionStatement": "srd:attributionStatement",
    "canonicalUrl": { "@id": "srd:canonicalUrl", "@type": "@id" },
    "seeAlso": { "@id": "srd:seeAlso", "@type": "@id", "@container": "@set" },
    "relatedRules": { "@id": "srd:relatedRule", "@type": "@id", "@container": "@set" },
    "relatedTables": { "@id": "srd:relatedTable", "@type": "@id", "@container": "@set" },
    "classes": { "@id": "srd:class", "@type": "@id", "@container": "@set" },
    "subclasses": { "@id": "srd:subclass", "@type": "@id", "@container": "@set" },
    "parentClass": { "@id": "srd:parentClass", "@type": "@id" },
    "parentClassName": "srd:parentClassName",
    "spellList": { "@id": "srd:spellList", "@type": "@id" },
    "fromTable": { "@id": "srd:fromTable", "@type": "@id" },
    "fromRule": { "@id": "srd:fromRule", "@type": "@id" },
    "conditionImmunities": { "@id": "srd:conditionImmunity", "@type": "@id", "@container": "@set" },
    "listsSpell": { "@id": "srd:listsSpell", "@type": "@id", "@container": "@set" },
    "castsSpell": { "@id": "srd:castsSpell", "@type": "@id", "@container": "@set" },
    "mentionsCondition": { "@id": "srd:mentionsCondition", "@type": "@id", "@container": "@set" },
    "grantsFeat": { "@id": "srd:grantsFeat", "@type": "@id" },
    "hasGear": { "@id": "srd:hasGear", "@type": "@id", "@container": "@set" },
    "summons": { "@id": "srd:summons", "@type": "@id", "@container": "@set" },
    "areaShape": { "@id": "srd:areaShape", "@type": "@id" },
    "areaShapes": { "@id": "srd:areaShape", "@type": "@id", "@container": "@set" },
    "grantsTool": { "@id": "srd:grantsTool", "@type": "@id", "@container": "@set" },
    "grantsEquipment": { "@id": "srd:grantsEquipment", "@type": "@id", "@container": "@set" },
    "eldritchInvocations": { "@id": "srd:eldritchInvocation", "@type": "@id", "@container": "@set" },
    "metamagicOptions": { "@id": "srd:metamagicOption", "@type": "@id", "@container": "@set" },
    "hasPart": { "@id": "dcterms:hasPart", "@type": "@id", "@container": "@set" },
    "partOf": { "@reverse": "dcterms:hasPart", "@type": "@id", "@container": "@set" },
    "isListedBy": { "@reverse": "srd:listsSpell", "@type": "@id", "@container": "@set" },
    "isCastBy": { "@reverse": "srd:castsSpell", "@type": "@id", "@container": "@set" },
    "isSummonedBy": { "@reverse": "srd:summons", "@type": "@id", "@container": "@set" },
    "isConditionMentionedBy": { "@reverse": "srd:mentionsCondition", "@type": "@id", "@container": "@set" },
    "isFeatGrantedBy": { "@reverse": "srd:grantsFeat", "@type": "@id", "@container": "@set" },
    "isGearOf": { "@reverse": "srd:hasGear", "@type": "@id", "@container": "@set" },
    "collections": { "@id": "srd:collection", "@container": "@set" },
    "members": { "@id": "srd:member", "@type": "@id", "@container": "@set" },
    "schemaReference": { "@id": "srd:schemaReference", "@type": "@id" },
    "entityType": "srd:entityType",
    "metadata": "srd:metadata",
    "contentDigest": "srd:contentDigest",
    "sourceFile": "srd:sourceFile",
    "srdVersion": "srd:srdVersion"
  }
}
