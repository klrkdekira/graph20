{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cheeleong.dev/graph20/systems/spell.schema.json",
  "title": "SRD 5.2.1 Spell",
  "$ref": "common.schema.json#/$defs/EntityBase",
  "properties": {
    "@type": { "const": "Spell" },
    "level": { "type": "integer", "minimum": 0, "maximum": 9 },
    "school": {
      "enum": [
        "Abjuration",
        "Conjuration",
        "Divination",
        "Enchantment",
        "Evocation",
        "Illusion",
        "Necromancy",
        "Transmutation"
      ]
    },
    "classAvailability": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "castingTime": { "type": "string", "minLength": 1 },
    "range": { "type": "string", "minLength": 1 },
    "components": { "type": "string", "minLength": 1 },
    "duration": { "type": "string", "minLength": 1 },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/NodeReference" }
    },
    "savingThrowAbility": {
      "enum": ["Strength", "Dexterity", "Constitution", "Intelligence", "Wisdom", "Charisma"]
    },
    "damage": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/SpellDamage" }
    },
    "scalesWithSlotLevel": { "type": "boolean" },
    "concentration": { "type": "boolean" },
    "ritual": { "type": "boolean" },
    "rulesText": { "type": "string", "minLength": 1 }
  },
  "required": ["level", "school", "classAvailability", "castingTime", "range", "components", "duration", "rulesText", "scalesWithSlotLevel", "concentration", "ritual"],
  "unevaluatedProperties": false
}
