{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cheeleong.dev/graph20/systems/metamagic-option.schema.json",
  "title": "SRD 5.2.1 Metamagic Option",
  "$ref": "common.schema.json#/$defs/EntityBase",
  "properties": {
    "@type": { "const": "MetamagicOption" },
    "parentClass": { "$ref": "common.schema.json#/$defs/NodeReference" },
    "cost": { "type": "string", "minLength": 1 },
    "sorceryPointCost": { "type": "integer", "minimum": 1 },
    "rulesText": { "type": "string", "minLength": 1 }
  },
  "required": ["parentClass", "cost", "sorceryPointCost", "rulesText"],
  "unevaluatedProperties": false
}
