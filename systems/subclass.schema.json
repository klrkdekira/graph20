{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cheeleong.dev/graph20/systems/subclass.schema.json",
  "title": "SRD 5.2.1 Subclass",
  "$ref": "common.schema.json#/$defs/EntityBase",
  "properties": {
    "@type": { "const": "Subclass" },
    "parentClass": { "$ref": "common.schema.json#/$defs/NodeReference" },
    "parentClassName": { "type": "string", "minLength": 1 },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/LevelFeature" }
    },
    "rulesText": { "type": "string", "minLength": 1 }
  },
  "required": ["parentClass", "parentClassName", "features", "rulesText"],
  "unevaluatedProperties": false
}
