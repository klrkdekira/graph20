{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cheeleong.dev/graph20/systems/area-of-effect.schema.json",
  "title": "SRD 5.2.1 Rules Glossary Area of Effect",
  "$ref": "common.schema.json#/$defs/EntityBase",
  "properties": {
    "@type": { "const": "AreaOfEffect" },
    "rulesText": { "type": "string", "minLength": 1 },
    "effects": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/NamedEffect" } }
  },
  "required": ["rulesText"],
  "unevaluatedProperties": false
}
