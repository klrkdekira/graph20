{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cheeleong.dev/graph20/systems/rule.schema.json",
  "title": "SRD 5.2.1 Rule",
  "$ref": "common.schema.json#/$defs/EntityBase",
  "properties": {
    "@type": { "const": "Rule" },
    "section": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "rulesText": { "type": "string", "minLength": 1 },
    "headingOnly": { "type": "boolean" },
    "ruleCategory": { "enum": ["Trap", "Poison", "Disease", "Curse", "MentalEffect", "EnvironmentalEffect"] },
    "fixedDCs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/FixedDC" }
    },
    "damage": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/SpellDamage" }
    },
    "relatedRules": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/NodeReference" }
    },
    "relatedTables": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/NodeReference" }
    }
  },
  "required": ["section", "rulesText"],
  "unevaluatedProperties": false
}
