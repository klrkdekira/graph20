{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cheeleong.dev/graph20/systems/review-ledger.schema.json",
  "title": "Semantic review ledger",
  "type": "object",
  "properties": {
    "statusDefinitions": { "type": "object" },
    "signalSetDigest": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" },
    "statusCounts": {
      "type": "object",
      "properties": {
        "pending": { "const": 0 },
        "accepted": { "type": "integer", "minimum": 0 },
        "corrected": { "type": "integer", "minimum": 0 },
        "false-positive": { "type": "integer", "minimum": 0 }
      },
      "required": ["pending", "accepted", "corrected", "false-positive"],
      "unevaluatedProperties": false
    },
    "reviewChecks": { "type": "array", "minItems": 1 },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
          "record": { "type": "string", "format": "iri" },
          "category": { "type": "string", "minLength": 1 },
          "match": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sourceLine": { "type": "integer", "minimum": 1 },
          "sourceColumn": { "type": "integer", "minimum": 1 },
          "context": { "type": "string", "minLength": 1 },
          "status": { "enum": ["accepted", "corrected", "false-positive"] },
          "note": { "type": "string", "minLength": 1 }
        },
        "required": ["key", "record", "category", "match", "path", "sourceLine", "sourceColumn", "context", "status", "note"],
        "unevaluatedProperties": false
      }
    }
  },
  "required": ["statusDefinitions", "signalSetDigest", "statusCounts", "reviewChecks", "signals"],
  "unevaluatedProperties": false
}
