{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cheeleong.dev/graph20/systems/background.schema.json",
  "title": "SRD 5.2.1 Background",
  "$ref": "common.schema.json#/$defs/EntityBase",
  "properties": {
    "@type": { "const": "Background" },
    "abilityScores": { "type": "string", "minLength": 1 },
    "abilityScoreOptions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "feat": { "type": "string", "minLength": 1 },
    "grantsFeat": { "$ref": "common.schema.json#/$defs/NodeReference" },
    "skillProficiencies": { "type": "string", "minLength": 1 },
    "toolProficiency": { "type": "string", "minLength": 1 },
    "startingEquipment": { "type": "string", "minLength": 1 },
    "skillProficiencyOptions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "rulesText": { "type": "string", "minLength": 1 }
  },
  "required": [
    "abilityScores",
    "abilityScoreOptions",
    "feat",
    "skillProficiencies",
    "skillProficiencyOptions",
    "toolProficiency",
    "startingEquipment",
    "rulesText"
  ],
  "unevaluatedProperties": false
}
